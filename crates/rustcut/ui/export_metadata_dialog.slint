// The question before a job without tags or rating is saved (src/ui/export/metadata.rs; user decisions Q-G1, D-P9g,
// review 52): the title says what is missing; the rating bar (a click saves the job with that rating) while the rating
// is missing, "Save without" and "Back to editing" (the primary button). Keys: the focus starts on the rating 5 while
// the rating is missing (user review 2026-10-27; Enter saves with 5), else on "Back to editing" (Enter goes back); Left and Right move a visible focus through the ratings and the buttons, Enter
// acts on the focused one; 0-5 save with that rating; Escape and × go back. "Don't ask again" is the setting
// `warnings.missing_metadata` (the panel's "Warn"), no longer a switch in the dialog.

import { DialogFrame, DialogHeader, DialogPanel, DialogState } from "dialog_frame.slint";
import { Theme } from "styles.slint";
import { IconId } from "icons.slint";
import { RatingBar } from "rating_bar.slint";
import { DialogButton } from "export_dialog.slint";
import { Export } from "export_types.slint";

export component MetadataDialog inherits Rectangle {
    // The scrim: the window behind waits.
    background: #000000a0;

    // The focus: 0-5 a rating (only while the rating is missing), 6 "Save without", 7 "Back to editing".
    property <int> focused: Export.meta-ask-rating ? 5 : 7;
    property <int> first: Export.meta-ask-rating ? 0 : 6;

    function act() {
        if root.focused == 7 {
            Export.meta-back();
        } else if root.focused == 6 {
            Export.meta-save();
        } else {
            Export.meta-rate(root.focused);
        }
    }

    // One step to the left (-1) or right (1), around at the ends.
    function move(delta: int) {
        root.focused = root.first + Math.mod(root.focused - root.first + delta + 8 - root.first, 8 - root.first);
    }

    TouchArea { }

    keys := FocusScope {
        init => { self.focus(); }

        key-pressed(event) => {
            if event.text == Key.Escape {
                Export.meta-back();
                return accept;
            }
            if event.text == Key.Return {
                root.act();
                return accept;
            }
            if event.text == Key.LeftArrow {
                root.move(-1);
                return accept;
            }
            if event.text == Key.RightArrow {
                root.move(1);
                return accept;
            }
            if Export.meta-ask-rating && (event.text == "0" || event.text == "1" || event.text == "2"
                || event.text == "3" || event.text == "4" || event.text == "5") {
                Export.meta-rate(event.text.to-float());
                return accept;
            }
            accept
        }

        // Resizable; never smaller than its content, extra height stays free below it.
        card := DialogFrame {
            area-width: root.width;
            area-height: root.height;
            default-width: 420px;
            default-height: content.preferred-height;
            least-width: 340px;
            least-height: content.preferred-height;
            stored-width <=> DialogState.metadata-width;
            stored-height <=> DialogState.metadata-height;

            content := VerticalLayout {
                y: 0;
                height: self.preferred-height;
                padding: 16px;
                spacing: 12px;

                DialogHeader {
                    icon: IconId.panel-tag-rate;
                    title: Export.meta-title;
                    closable: true;
                    close-tooltip: "Back to editing";
                    close => { Export.meta-back(); }
                }

                // The question's content in the dialogs' frame (user decision 2026-10-27, B).
                if Export.meta-ask-rating: DialogPanel {
                    RatingBar {
                        selected-rating: root.focused <= 5 ? root.focused : -1;
                        is-assign-mode: true;
                        has-selection: true;
                        rating-selected(r) => { Export.meta-rate(r); }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    DialogButton {
                        text: "Save without";
                        focused: root.focused == 6;
                        clicked => { Export.meta-save(); }
                    }

                    DialogButton {
                        text: "Back to editing";
                        primary: true;
                        focused: root.focused == 7;
                        clicked => { Export.meta-back(); }
                    }
                }
            }
        }
    }
}
