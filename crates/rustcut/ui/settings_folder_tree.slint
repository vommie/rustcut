// Settings > Target Folders (P11.3, user decision Q-FP2): the folder tree (groups without a path, folders, "Next to the
// source" first) in a virtual list with folding, a star per entry (a place on the folder wheel's first level), inline
// rename (F2 or a double click), drag before, after or into a group, the add buttons and the held delete button whose
// tooltip says that a group goes with everything in it; the selected entry's details beside it
// (`settings_folder_details.slint`). The export card's jump leads here (`settings:export.folders`).

import { ListView } from "std-widgets.slint";
import { Theme } from "styles.slint";
import { AppIcon, IconId, IconSize } from "icons.slint";
import { IconButton, MiddleText, NumberField } from "controls.slint";
import { SettingsCard } from "settings_card.slint";
import { DragArea, DragState } from "drag.slint";
import { JumpFlash } from "jump.slint";
import { TooltipArea } from "tooltip.slint";
import { FolderPicture } from "folder_picture.slint";
import { FolderTreeRowView, FolderTreeUi } from "settings_folder_types.slint";
import { FolderDetails } from "settings_folder_details.slint";

component FolderTreeRow inherits Rectangle {
    in property <FolderTreeRowView> entry;
    // The row takes a drop into its group.
    in property <bool> drop-target;
    callback drag-started(/* window y */ length);
    callback drag-moved(/* window x */ length, /* window y */ length);
    callback drag-ended();
    callback pressed();

    height: FolderTreeUi.row-height;
    border-radius: 4px;
    background: root.entry.selected ? Theme.surface-selected : area.has-hover && !FolderTreeUi.dragging ? Theme.surface-hover
        : transparent;
    border-width: root.drop-target ? 1px : 0px;
    border-color: Theme.primary;

    area := DragArea {
        draggable: !root.entry.source && FolderTreeUi.renaming != root.entry.id;
        pressed-down => { root.pressed(); }
        tapped => { FolderTreeUi.select(root.entry.id); }
        double-tapped => {
            if root.entry.source {
                return;
            }
            FolderTreeUi.rename-start(root.entry.id);
        }
        drag-started(y) => { root.drag-started(y); }
        drag-moved(y) => { root.drag-moved(self.pointer-x, y); }
        drag-ended => { root.drag-ended(); }
    }

    HorizontalLayout {
        padding-left: 2px;
        padding-right: 4px;
        spacing: 6px;

        // The handle: drag the entry to another place in the tree or onto a place of the small wheel (the whole row
        // drags too).
        TooltipArea {
            width: 14px;
            text: root.entry.source ? "\"Next to the source\" stays first; click a place of the small wheel to put it there"
                : "Drag to move it in the tree, or onto a place of the wheel beside";

            if !root.entry.source: AppIcon {
                y: (parent.height - self.height) / 2;
                icon: IconId.drag-grip;
                size: IconSize.sm;
                color: Theme.status-deleted;
            }
        }

        Rectangle {
            width: root.entry.depth * FolderTreeUi.indent;
        }

        // The fold button of a group (a folder keeps the room, so the pictures line up).
        Rectangle {
            width: 16px;

            if root.entry.group: AppIcon {
                icon: root.entry.expanded ? IconId.chevron-down : IconId.chevron-right;
                size: IconSize.sm;
                color: Theme.text-muted;
            }

            if root.entry.group: TouchArea {
                clicked => { FolderTreeUi.toggle(root.entry.id); }
            }
        }

        VerticalLayout {
            alignment: center;

            FolderPicture {
                width: 20px;
                height: 20px;
                picture: root.entry.picture;
                shape: FolderTreeUi.shape;
                tint: FolderTreeUi.tint;
            }
        }

        if FolderTreeUi.renaming == root.entry.id: field := NumberField {
            horizontal-stretch: 1;
            max-width: 100000px;
            spin: false;
            alignment: left;
            text: root.entry.name;
            tooltip: "The entry's name (Enter keeps it, Escape cancels)";
            init => { self.edit(); }
            committed(text) => { return FolderTreeUi.rename(root.entry.id, text); }
            canceled => { FolderTreeUi.rename-end(); }
        }

        if FolderTreeUi.renaming != root.entry.id: HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 8px;

            Text {
                text: root.entry.name;
                color: Theme.text;
                font-size: 12px;
                font-weight: root.entry.group || root.entry.source ? 600 : 400;
                vertical-alignment: center;
                overflow: elide;
                min-width: 40px;
                horizontal-stretch: 0;
                max-width: self.preferred-width;
            }

            MiddleText {
                horizontal-stretch: 1;
                text: root.entry.source ? "The video's own folder" : root.entry.path;
                color: Theme.text-muted;
                font-size: 11px;
            }
        }

        if root.entry.missing: TooltipArea {
            width: 16px;
            text: "The folder does not exist yet: it is made when a job writes into it";

            AppIcon {
                y: (parent.height - self.height) / 2;
                icon: IconId.status-warning;
                size: IconSize.sm;
                color: Theme.accent;
            }
        }

        IconButton {
            icon: root.entry.place >= 0 ? IconId.folder-favorite-set : IconId.folder-favorite;
            checked: root.entry.place >= 0;
            tooltip: root.entry.place >= 0 ? "A favorite: place " + (root.entry.place + 1) + " on the folder wheel (click: no favorite)"
                : "Make it a favorite: a place of its own on the folder wheel's first level";
            clicked => { FolderTreeUi.star(root.entry.id); }
        }
    }
}

component FolderTreeList inherits VerticalLayout {
    // The pointer's window y while dragging (the auto-scroll measures it again).
    property <length> pointer-y: FolderTreeUi.pointer-y;
    // The Settings page scrolled under the dragged entry (`DragState.area` "settings"): measured again.
    property <int> scrolls: DragState.scrolls;

    // Tells Rust where the pointer is over the list (outside it: on the details, the wheel's places).
    function measure() {
        FolderTreeUi.drag-move(root.pointer-y - list.absolute-position.y - list.content-y,
            FolderTreeUi.pointer-x >= frame.absolute-position.x && FolderTreeUi.pointer-x <= frame.absolute-position.x + frame.width
            && root.pointer-y >= frame.absolute-position.y && root.pointer-y <= frame.absolute-position.y + frame.height);
    }

    changed scrolls => {
        if FolderTreeUi.dragging {
            root.measure();
        }
    }

    spacing: 6px;

    HorizontalLayout {
        spacing: 4px;

        IconButton {
            icon: IconId.folder-add;
            tooltip: "Add a folder (the folder dialog; folders can also be dropped here from the file manager)";
            clicked => { FolderTreeUi.add-folder(); }
        }

        IconButton {
            icon: IconId.folder-group-add;
            tooltip: "Add a group (a menu entry without a path that holds folders and groups)";
            clicked => { FolderTreeUi.add-group(); }
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        IconButton {
            icon: IconId.folder-remove;
            hold: true;
            enabled: FolderTreeUi.can-delete;
            tooltip: FolderTreeUi.delete-tip;
            clicked => { FolderTreeUi.delete(); }
        }
    }

    keys := FocusScope {
        height: Math.max(6 * FolderTreeUi.row-height, Math.min(FolderTreeUi.rows.length * FolderTreeUi.row-height + 8px, 420px));
        key-pressed(event) => {
            if FolderTreeUi.renaming >= 0 {
                return reject;
            }
            return FolderTreeUi.key(event.text) ? accept : reject;
        }

        frame := Rectangle {
            border-radius: 4px;
            border-width: 1px;
            border-color: keys.has-focus ? Theme.primary.with-alpha(0.6) : Theme.border;
            clip: true;

            list := ListView {
                x: 1px;
                y: 1px;
                width: parent.width - 2px;
                height: parent.height - 2px;

                for item[index] in FolderTreeUi.rows: FolderTreeRow {
                    entry: item;
                    drop-target: FolderTreeUi.dragging && FolderTreeUi.drop-into == index;
                    pressed => { keys.focus(); }
                    drag-started(y) => {
                        FolderTreeUi.pointer-y = y;
                        DragState.pointer-y = y;
                        FolderTreeUi.drag-start(item.id);
                        root.measure();
                    }
                    drag-moved(x, y) => {
                        FolderTreeUi.pointer-x = x;
                        FolderTreeUi.pointer-y = y;
                        DragState.pointer-y = y;
                        root.measure();
                    }
                    drag-ended => { FolderTreeUi.drag-end(true); }
                }
            }

            // Where the dragged entry would land.
            if FolderTreeUi.dragging && FolderTreeUi.drop-shown && FolderTreeUi.drop-place < 0: Rectangle {
                x: 28px + FolderTreeUi.drop-depth * FolderTreeUi.indent;
                y: 1px + FolderTreeUi.drop-y + list.content-y - 1px;
                width: parent.width - self.x - 8px;
                height: 2px;
                background: Theme.primary;
            }

            if FolderTreeUi.dragging: Rectangle {
                x: 24px;
                y: Math.max(0px, Math.min(parent.height - self.height, root.pointer-y - list.absolute-position.y + 8px));
                width: ghost.preferred-width + 12px;
                height: 20px;
                border-radius: 4px;
                background: Theme.surface-selected.with-alpha(0.85);
                border-width: 1px;
                border-color: Theme.primary.with-alpha(0.6);

                ghost := Text {
                    text: FolderTreeUi.drag-name;
                    color: Theme.text;
                    font-size: 11px;
                }
            }

            // Near an edge the list scrolls while an entry is dragged.
            Timer {
                interval: 30ms;
                running: FolderTreeUi.dragging;
                triggered => {
                    // Only while the pointer is over the list (on the details the page scrolls instead).
                    if FolderTreeUi.pointer-x < frame.absolute-position.x || FolderTreeUi.pointer-x > frame.absolute-position.x + frame.width
                        || root.pointer-y < frame.absolute-position.y || root.pointer-y > frame.absolute-position.y + frame.height {
                        return;
                    }
                    if root.pointer-y < list.absolute-position.y + 24px {
                        list.content-y = Math.min(0px, list.content-y + 8px);
                    } else if root.pointer-y > list.absolute-position.y + list.height - 24px {
                        list.content-y = Math.max(list.visible-height - list.content-height, list.content-y - 8px);
                    } else {
                        return;
                    }
                    root.measure();
                }
            }
        }
    }
}

component FolderTreeCard inherits SettingsCard {
    title: "Target folders";
    description: "Groups hold folders and other groups; a star gives an entry its own place on the folder wheel's first level. Drag an entry before, after or into a group; F2 or a double click renames it. Deleting a group deletes everything in it.";

    // The details stand below the tree (the user's wish 2026-10-28), their small wheel first, so it never moves when
    // the icons open; dragging an entry down to it scrolls the page near its edges.
    VerticalLayout {
        spacing: 12px;

        FolderTreeList { }

        FolderDetails { }
    }
}

/// The card with the flash of the export card's jump over it (the flash covers the card, it takes no room).
export component SettingsFolderTree inherits Rectangle {
    height: card.preferred-height;

    card := FolderTreeCard {
        width: parent.width;
        height: parent.height;
    }

    JumpFlash {
        key: "settings:export.folders";
    }
}
