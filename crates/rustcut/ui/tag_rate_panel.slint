// The Tag & Rate panel (M3.2, P8b, P9.8): RustCut's wrapper around RustView's copied components (ADR-10). RustView's
// `TagPanel` holds a mode toolbar for its library; RustCut's panel is always in assign mode for one job (the next one,
// or a queued job while it is edited, user decision Q-G3) and holds RustCut's own parts: the editing banner, RustView's
// state in the tree's place while it is unavailable or off (the one place it is shown, ADR-6), and PyCutRv's row under
// the history (user decision Q-P8b: last rating, last tags, clear, the "Active" and "Warn" switches, the eye that shows
// the hidden tags, the tag filter; no text between them, P9.8). Without a video and without a queued job being edited
// the parts that tag are locked with RustView's own "no selection" look (D-P9e). Everything comes from the `TagRate`
// global (src/ui/tags/).

import { Theme } from "styles.slint";
import { AppIcon, IconId, IconSize } from "icons.slint";
import { IconButton } from "controls.slint";
import { TooltipHost } from "tooltip.slint";
import { Shortcuts } from "shortcuts.slint";
import { TagRate } from "tag_types.slint";
import { Playback } from "player_types.slint";
import { RatingBar, RatingButton } from "rating_bar.slint";
import { TagSearchFilter } from "tag_search_filter.slint";
import { TagTreeList } from "tag_tree.slint";
import { TagHistoryPanel } from "tag_history_panel.slint";
import { ResizerBar } from "resizer_bar.slint";

/// RustView's state while it is unavailable or switched off, in the tree's place (user request Q-P8b): RustView's gray
/// symbol, the state in one short line (P9.8), a button to the RustView settings at the option behind the state whose
/// tooltip names the error, and Retry. Connecting and connected show nothing: the tree area says "Loading" until the
/// tags arrive.
component ConnectionCard inherits Rectangle {
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.background;

    VerticalLayout {
        padding: 12px;
        spacing: 6px;
        alignment: center;

        HorizontalLayout {
            alignment: center;

            AppIcon {
                icon: IconId.rustview-app;
                size: 45px;
                color: Theme.status-deleted;
            }
        }

        Text {
            text: TagRate.connection-text;
            font-size: 12px;
            font-weight: 600;
            color: TagRate.connection-kind == 2 ? Theme.status-corrupt : Theme.text-muted;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        HorizontalLayout {
            alignment: center;
            spacing: 6px;

            // The RustView settings at the option behind the state (jump mark, Q-N6); the tooltip is the error.
            IconButton {
                icon: IconId.jump-to;
                tooltip: TagRate.connection-error != "" ? TagRate.connection-error : "Open the RustView settings";
                clicked => { TagRate.connection-jump-clicked(); }
            }

            if TagRate.can-retry: IconButton {
                icon: IconId.reload;
                tooltip: "Try to reach RustView now (RustCut also tries again by itself)";
                clicked => { TagRate.retry(); }
            }
        }
    }
}

/// "Editing: <job>" with Apply and Cancel while a queued job's tags are edited.
component EditingBanner inherits Rectangle {
    height: 28px;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.primary;
    background: Theme.primary.with-alpha(0.12);

    host := TooltipHost {
        text: TagRate.editing-tooltip;
    }

    touch := TouchArea {
        changed has-hover => {
            if self.has-hover {
                host.enter();
            } else {
                host.leave();
            }
        }
    }

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 2px;
        spacing: 4px;

        AppIcon {
            y: (parent.height - self.height) / 2;
            icon: IconId.job-tags;
            size: IconSize.sm;
            color: Theme.primary;
        }

        Text {
            text: TagRate.editing-title;
            font-size: 11px;
            font-weight: 600;
            color: Theme.text;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        IconButton {
            y: (parent.height - self.height) / 2;
            icon: IconId.confirm;
            enabled: TagRate.can-apply;
            tooltip: "Apply the tags and the rating to the job";
            clicked => { TagRate.apply-edit(); }
        }

        IconButton {
            y: (parent.height - self.height) / 2;
            icon: IconId.close;
            tooltip: "Cancel: back to the next job's tags";
            shortcut: "Esc";
            clicked => { TagRate.cancel-edit(); }
        }
    }
}

/// The last saved job's rating as a rating button (a click applies it).
component LastRatingButton inherits Rectangle {
    /// A job was saved with a rating.
    in property <bool> available;
    in property <bool> enabled;
    in property <int> rating;
    callback clicked();

    width: 24px;
    height: 24px;

    if root.available: RatingButton {
        width: 100%;
        height: 100%;
        rating: root.rating;
        is-enabled: root.enabled;
    }

    if !root.available: Rectangle {
        border-radius: 4px;
        border-width: 1px;
        border-color: Theme.border;

        AppIcon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            icon: IconId.rating-last;
            size: IconSize.sm;
            color: Theme.status-deleted;
        }
    }

    host := TooltipHost {
        text: root.available ? "Apply the last saved job's rating" : "No job was saved with a rating yet";
    }

    // On top of the button: hover for the tooltip, click for the action.
    touch := TouchArea {
        mouse-cursor: root.available && root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            host.press();
            if root.available && root.enabled {
                root.clicked();
            }
        }
        changed has-hover => {
            if self.has-hover {
                host.enter();
            } else {
                host.leave();
            }
        }
    }
}

/// The row under the history (PyCutRv's place, user decision Q-P8b): the last rating, the last tags and clearing on
/// the left, the switches, the eye and the tag filter on the right; no text between them (P9.8).
component TagToolbar inherits HorizontalLayout {
    /// A video is open or a queued job is edited (D-P9e): the last rating and tags can be applied.
    in property <bool> has-job;
    property <bool> can-tag: root.has-job && (TagRate.active || TagRate.editing-job);

    spacing: 4px;
    height: 24px;

    LastRatingButton {
        available: TagRate.last-rating >= 0;
        enabled: root.can-tag;
        rating: Math.max(0, TagRate.last-rating);
        clicked => { TagRate.apply-last-rating(); }
    }

    IconButton {
        icon: IconId.tags-last;
        enabled: TagRate.has-last-tags && root.can-tag;
        tooltip: TagRate.has-last-tags ? "Apply the last saved job's tags: " + TagRate.last-tags-tooltip
            : "No job was saved with tags yet";
        clicked => { TagRate.apply-last-tags(); }
    }

    IconButton {
        icon: IconId.tags-clear;
        hold: true;
        enabled: TagRate.can-clear;
        tooltip: "Clear the tags and the rating (locked tags stay)";
        clicked => { TagRate.clear(); }
    }

    Rectangle {
        horizontal-stretch: 1;
    }

    // On: a hold switches it off (it changes what RustView learns); off: red, a click switches it on (Q-P8).
    IconButton {
        icon: TagRate.active ? IconId.tagging-on : IconId.tagging-off;
        alert: !TagRate.active;
        hold: TagRate.active;
        tooltip: TagRate.active ? "When the job is saved, its tags and rating are written into RustView for the target file."
            : "Not active. A click switches it on.";
        clicked => { TagRate.toggle-active(); }
    }

    IconButton {
        icon: TagRate.warn ? IconId.warn-on : IconId.warn-off;
        alert: !TagRate.warn;
        hold: TagRate.warn;
        tooltip: TagRate.warn ? "Warn: saving asks when the job has no tags or no rating (while Active is on)."
            : "No warning: jobs without tags or rating are saved without asking. A click switches it on.";
        clicked => { TagRate.toggle-warn(); }
    }

    // The eye only shows or hides the hidden tags; they are chosen in the tag filter (P9.8).
    IconButton {
        icon: IconId.tags-show-hidden;
        enabled: TagRate.has-tree && (TagRate.hidden-count > 0 || TagRate.show-hidden);
        checked: TagRate.show-hidden;
        tooltip: TagRate.eye-tooltip;
        clicked => { TagRate.toggle-show-hidden(); }
    }

    // The tag filter window; the number says how many tags are hidden (user decision Q-P8b).
    IconButton {
        icon: IconId.tags-filter;
        checked: TagRate.hidden-count > 0;
        tooltip: "Tags Filter: choose the tags to hide";
        clicked => { TagRate.open-filter(); }

        if TagRate.hidden-count > 0: Rectangle {
            x: parent.width - self.width / 2 - 3px;
            y: -5px;
            height: 13px;
            width: Math.max(13px, badge.preferred-width + 6px);
            border-radius: 6.5px;
            background: Theme.accent;

            badge := Text {
                text: TagRate.hidden-count > 99 ? "99+" : TagRate.hidden-count;
                font-size: 9px;
                font-weight: 700;
                color: Theme.background;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

export component TagRatePanel inherits Rectangle {
    // The copied history panel reports its width only when it changes; a width laid out before Rust listened would
    // never arrive. Once after the panel is created, it is sent here, and so is the tree area's height (see below).
    Timer {
        interval: 100ms;
        running: true;
        triggered => {
            self.running = false;
            TagRate.history-width-changed(history-panel.width);
            if tree-area.height > 10px {
                TagRate.tree-height-changed(tree-area.height);
            }
        }
    }

    // Not active (and no queued job edited): the job gets nothing of this, so it is dimmed and takes no input.
    property <bool> closed: !TagRate.active && !TagRate.editing-job;
    // Without a video and without a queued job being edited there is nothing to tag (D-P9e): the rating, tagging in
    // the tree, the history's pills and the last rating and tags are locked; the filter, expanding branches, folding
    // the history, clearing, the switches, the eye and the tag filter stay usable.
    property <bool> has-job: Playback.has-video || TagRate.editing-job;

    layout := VerticalLayout {
        padding: 6px;
        spacing: 6px;

        if TagRate.editing-job: EditingBanner { }

        // Always in assign mode for one job (RustView's file selection is RustCut's job).
        rating := RatingBar {
            opacity: root.closed ? 0.4 : 1;
            selected-rating <=> TagRate.rating;
            is-assign-mode: true;
            has-selection: root.has-job;
            rating-selected(r) => { TagRate.rating-clicked(r); }
        }

        // The copied filter fills its parent; it is off while there is no tree to filter (P9.8).
        Rectangle {
            height: 26px;
            opacity: root.closed ? 0.4 : 1;

            filter := TagSearchFilter {
                text <=> TagRate.filter-text;
                is-regex <=> TagRate.filter-regex;
                is-enabled: TagRate.has-tree;
                placeholder-text: "Filter tags...";
                search-changed(text) => { TagRate.filter-changed(text); }
                regex-toggled(r) => { TagRate.filter-regex-toggled(r); }
                escape-pressed => { Shortcuts.release-focus(); }
                accepted(text) => { Shortcuts.release-focus(); }
                changed has-focus => { Shortcuts.editing-changed(self.has-focus); }
            }
        }

        if TagRate.filter-invalid: Text {
            text: "Not a valid regular expression: the filter matches it as plain text.";
            font-size: 10px;
            color: Theme.accent;
            wrap: word-wrap;
        }

        // The tree, RustView's state in its place while RustView is unavailable or switched off (Q-P8b), and what
        // the area says while it has no rows (no tree yet, no tags, no match, all hidden).
        // The copied list reports its height only when it changes, and it is made only when the tree arrives, after
        // its height was laid out: the columns were split for no height and every tag got a column of its own (user
        // report Q-N5). The area, which always exists, reports the height instead; the list's own report stays.
        tree-area := Rectangle {
            vertical-stretch: 1;
            property <bool> card: TagRate.connection-kind == 2 || TagRate.connection-kind == 3;
            changed height => {
                if self.height > 10px {
                    TagRate.tree-height-changed(self.height);
                }
            }

            if self.card: ConnectionCard {
                width: 100%;
                height: 100%;
            }

            if !self.card && TagRate.has-tree: TagTreeList {
                width: 100%;
                height: 100%;
                opacity: root.closed ? 0.4 : 1;
                columns: TagRate.columns;
                is-assign-mode: true;
                has-selection: root.has-job;
                tree-geometry-changed(h) => { TagRate.tree-height-changed(h); }
                tag-clicked(id) => { TagRate.tag-clicked(id); }
                tag-toggle-expand(id) => { TagRate.tag-toggle-expand(id); }
                tag-context-menu(id, x, y) => { TagRate.tag-right-clicked(id); }
            }

            if !self.card && !TagRate.has-tree: Rectangle {
                border-radius: 4px;
                border-width: 1px;
                border-color: Theme.border;
                background: Theme.background;
            }

            if !self.card && (!TagRate.has-tree || TagRate.columns.length == 0): Text {
                x: 12px;
                width: parent.width - 24px;
                text: TagRate.empty-text;
                font-size: 11px;
                color: Theme.text-muted;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }

        history-resizer := ResizerBar {
            is-horizontal: false;
            height: (!TagRate.history-collapsed) ? self.thickness : 0px;
            visible: !TagRate.history-collapsed;

            property <length> start-h: 96px;
            drag-started => {
                self.start-h = TagRate.history-height;
            }
            dragged(delta) => {
                // The history is anchored at the bottom: dragging up makes it taller.
                TagRate.history-height = Math.max(40px, Math.min(500px, self.start-h - delta));
            }
            drag-finished => {
                TagRate.history-resized(TagRate.history-height);
            }
        }

        history-panel := TagHistoryPanel {
            vertical-stretch: 0;
            opacity: root.closed ? 0.4 : 1;
            body-height: TagRate.history-height;
            is-dragging: history-resizer.is-dragging;
            rows: TagRate.history-rows;
            tag-count: TagRate.history-count;
            is-collapsed <=> TagRate.history-collapsed;
            has-selection: root.has-job;
            collapsed-toggled(c) => { TagRate.history-collapsed-changed(c); }
            tag-clicked(id) => { TagRate.history-tag-clicked(id); }
            geometry-changed(w) => { TagRate.history-width-changed(w); }
        }

        TagToolbar {
            has-job: root.has-job;
        }
    }

    // Over the dimmed part (rating, filter, tree, history; not the switches below): no click, no hover, no wheel
    // reaches it, and its tooltip says why.
    if root.closed: Rectangle {
        x: layout.x + rating.x;
        y: layout.y + rating.y;
        width: rating.width;
        height: history-panel.y + history-panel.height - rating.y;

        closed-host := TooltipHost {
            text: "Active is off: jobs are saved without RustView. The tag button at the bottom switches it on.";
        }

        TouchArea {
            mouse-cursor: MouseCursor.not-allowed;
            scroll-event(event) => { reject }
            changed has-hover => {
                if self.has-hover {
                    closed-host.enter();
                } else {
                    closed-host.leave();
                }
            }
        }
    }
}
