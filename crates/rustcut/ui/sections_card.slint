// The Sections card of the Export panel (src/ui/editor/ fills the `Sections` global and handles its callbacks): the current
// section in one row (set the start to the playhead, its start, its end, set the end, add it; the length in the tooltips),
// and the list of added sections with editable times, durations and a held delete button per row (P9.5). Rows are
// selected like the queue's (Ctrl one more, Shift a range), reached through the context menu (Duplicate, Move Up/Down,
// Delete, Select All), dragged to another place (P9.4), and the empty space has a menu for the whole list.
// Buttons are icons with tooltips (user rule 2026-10-23).
// Times: a click seeks there, a double click edits (Enter keeps, Escape cancels; user decision 2026-10-23).

import { Theme } from "styles.slint";
import { IconId, IconSize } from "icons.slint";
import { Shortcuts } from "shortcuts.slint";
import { IconButton, ListWell } from "controls.slint";
import { TooltipHost } from "tooltip.slint";
import { BubbleAnchor } from "bubble.slint";
import { JumpFlash } from "jump.slint";
import { DragArea, DragGhost, DragMotion, DragState, DropGap } from "drag.slint";
import { TextLine } from "controls_text_line.slint";

export struct SectionRowView {
    number: int,
    start: string,
    end: string,
    duration: string,
    selected: bool,
    overlapping: bool,
}

export global Sections {
    // A video is loaded: marks can be set.
    in property <bool> has-media;
    // The current section's marks ("" = not set) and its length for the tooltips ("" without a range).
    in property <string> mark-start;
    in property <string> mark-end;
    in property <string> current-length;
    in property <bool> can-add;
    in property <[SectionRowView]> rows;
    // The count and the total length for the card's header ("2 • 10.500s", P9.1); empty without sections.
    in property <string> summary;
    // The keys of the actions, for the tooltips.
    in property <string> key-set-start;
    in property <string> key-set-end;
    in property <string> key-add;
    in property <string> key-delete;
    // Drag & drop of the rows (P9.4): the rows' shifts, the gap where they land, the ghost under the pointer. A
    // dropped drag snaps the rows into the new order without animation (`drag-instant`).
    in property <bool> dragging;
    in property <[length]> drag-shifts;
    in property <bool> drag-instant;
    in property <length> drag-gap-y;
    in property <length> drag-gap-height;
    in property <length> drag-ghost-y;
    in property <string> drag-title;
    in property <string> drag-detail;
    in property <int> drag-count: 1;
    out property <length> row-height: 26px;
    // The time columns of the list (the header's titles stand over the times).
    out property <length> time-width: 80px;

    // 0 = start, 1 = end.
    callback set-mark(int);
    callback seek-mark(int);
    // A typed time; false = not accepted (the field stays open and turns red).
    callback edit-mark(int, string) -> bool;
    callback add();
    // A click on a row: Ctrl one more or less, Shift a range (as in the queue).
    callback pick(/* row */ int, /* control */ bool, /* shift */ bool);
    callback seek-row(/* row */ int, /* 0 = start, 1 = end */ int);
    callback edit-row(/* row */ int, /* 0 = start, 1 = end */ int, string) -> bool;
    // A field with a refused time is typed in again, or closed without keeping it (its bubble, M6.5c).
    callback mark-typed(int, string);
    callback mark-canceled(int);
    callback row-typed(/* row */ int, /* 0 = start, 1 = end */ int, string);
    callback row-canceled(/* row */ int, /* 0 = start, 1 = end */ int);
    // The row's own held delete button.
    callback delete-row(/* row */ int);
    // A right click on a row (-1 = the empty space) at a window position.
    callback context-menu(/* row */ int, /* x */ length, /* y */ length);
    // A left click on the empty space.
    callback clear-selection();
    // The menu bar's Sections > Clear All Sections (held, P9.12).
    callback clear-all();
    // Drag & drop: the pointer in the list's coordinates (0 = the top of the first row).
    callback drag-start(/* row */ int, /* pointer */ length, /* pitch */ length, /* height */ length);
    callback drag-move(/* pointer */ length);
    callback drag-end();
}

/// A time that seeks on click and turns into a text field on double click. In a list row it can start the row's drag.
export component TimeField inherits Rectangle {
    in property <string> text;
    in property <string> placeholder: "Not set";
    in property <bool> enabled: true;
    in property <string> tooltip;
    in property <string> note;
    // The press may drag the row it is in.
    in property <bool> draggable;
    // The key of the bubble that explains a refused time (`bubble.slint`).
    in property <string> bubble;
    callback clicked(/* control */ bool, /* shift */ bool);
    callback committed(string) -> bool;
    callback typed(string);
    callback canceled();
    callback menu(/* window x */ length, /* window y */ length);
    callback drag-started(/* window y of the press */ length);
    callback drag-moved(/* window y */ length);
    callback drag-ended();

    property <bool> editing;
    property <bool> invalid;

    min-width: 64px;
    height: 22px;
    border-radius: 3px;
    background: root.editing ? Theme.background
        : touch.has-hover && root.enabled ? Theme.surface-hover : transparent;
    border-width: root.editing ? 1px : 0px;
    border-color: root.invalid ? Theme.status-corrupt : Theme.primary;

    function start-edit() {
        input.text = root.text;
        root.invalid = false;
        root.editing = true;
        input.focus();
        input.select-all();
    }

    function finish(keep: bool) {
        if keep && !root.committed(input.text) {
            root.invalid = true;
            return;
        }
        root.editing = false;
        root.invalid = false;
        if !keep {
            root.canceled();
        }
        Shortcuts.release-focus();
    }

    BubbleAnchor {
        key: root.bubble;
    }

    host := TooltipHost {
        text: root.tooltip;
        note: root.note;
    }

    if !root.editing: Text {
        x: 5px;
        width: parent.width - 10px;
        text: root.text == "" ? root.placeholder : root.text;
        color: !root.enabled || root.text == "" ? Theme.status-deleted : Theme.text;
        font-family: "monospace";
        font-size: 12px;
        vertical-alignment: center;
        overflow: elide;
    }

    touch := DragArea {
        enabled: root.enabled && !root.editing;
        draggable: root.draggable;
        mouse-cursor: MouseCursor.pointer;
        pressed-down => { host.press(); }
        tapped(control, shift) => { root.clicked(control, shift); }
        double-tapped => { root.start-edit(); }
        menu(x, y) => { root.menu(x, y); }
        drag-started(y) => { root.drag-started(y); }
        drag-moved(y) => { root.drag-moved(y); }
        drag-ended => { root.drag-ended(); }
        changed has-hover => {
            if self.has-hover {
                host.enter();
            } else {
                host.leave();
            }
        }
    }

    input := TextLine {
        x: 5px;
        width: parent.width - 10px;
        height: parent.height;
        visible: root.editing;
        enabled: root.editing;
        color: Theme.text;
        font-family: "monospace";
        font-size: 12px;
        selection-background-color: Theme.primary.with-alpha(0.4);

        accepted => { root.finish(true); }
        edited => {
            root.invalid = false;
            root.typed(self.text);
        }

        key-pressed(event) => {
            if event.text == Key.Escape {
                root.finish(false);
                return accept;
            }
            reject
        }

        changed has-focus => {
            // Leaving the field keeps a valid time and drops an invalid one.
            if !self.has-focus && root.editing {
                if !root.committed(self.text) {
                    root.invalid = false;
                    root.canceled();
                }
                root.editing = false;
            }
        }
    }
}

/// One mark's time in the current section's row.
component MarkTime inherits TimeField {
    in property <int> which;

    horizontal-stretch: 1;
    text: root.which == 0 ? Sections.mark-start : Sections.mark-end;
    enabled: Sections.has-media;
    tooltip: root.which == 0 ? "Start of the current section" : "End of the current section";
    note: Sections.current-length;
    bubble: root.which == 0 ? "sections.mark.start" : "sections.mark.end";
    clicked => { Sections.seek-mark(root.which); }
    committed(text) => { return Sections.edit-mark(root.which, text); }
    typed(text) => { Sections.mark-typed(root.which, text); }
    canceled => { Sections.mark-canceled(root.which); }
}

/// The current section in one row: set the start, the start, set the end, the end, add (P9.5; each set button before
/// its field, review 2). Both times stretch and stay equally wide; the length is in their tooltips and in the Add
/// button's.
component CurrentSection inherits HorizontalLayout {
    spacing: 4px;

    IconButton {
        icon: IconId.mark-set;
        enabled: Sections.has-media;
        tooltip: "Set the start to the playhead";
        shortcut: Sections.key-set-start;
        clicked => { Sections.set-mark(0); }
    }

    MarkTime {
        which: 0;
    }

    IconButton {
        icon: IconId.mark-set;
        enabled: Sections.has-media;
        tooltip: "Set the end to the playhead";
        shortcut: Sections.key-set-end;
        clicked => { Sections.set-mark(1); }
    }

    MarkTime {
        which: 1;
    }

    IconButton {
        icon: IconId.section-add;
        enabled: Sections.can-add;
        tooltip: Sections.current-length == "" ? "Add the current section to the list"
            : "Add the current section to the list (" + Sections.current-length + ")";
        shortcut: Sections.key-add;
        clicked => { Sections.add(); }
    }
}

component SectionRowItem inherits Rectangle {
    in property <SectionRowView> item;
    in property <int> index;
    // Drag & drop (P9.4): how far the row moves aside while sections are dragged, and whether it is one of them (the
    // ghost shows it under the pointer, so it is hidden here and keeps its place: its fields hold the pointer).
    in property <length> drag-shift;
    in property <bool> lifted;
    callback drag-started(/* window y of the press */ length);
    callback drag-moved(/* window y */ length);
    callback drag-ended();

    height: Sections.row-height;

    body := Rectangle {
        y: root.lifted ? 0px : root.drag-shift;
        animate y { duration: Sections.drag-instant ? 0ms : DragMotion.shift; easing: ease-out; }
        width: parent.width;
        height: parent.height;
        opacity: root.lifted ? 0 : 1;
        border-radius: 3px;
        background: root.item.selected ? Theme.surface-selected
            : area.has-hover && !Sections.dragging ? Theme.surface-hover : transparent;

        // The free space of the row: select, menu, drag.
        area := DragArea {
            tapped(control, shift) => { Sections.pick(root.index, control, shift); }
            menu(x, y) => { Sections.context-menu(root.index, x, y); }
            drag-started(y) => { root.drag-started(y); }
            drag-moved(y) => { root.drag-moved(y); }
            drag-ended => { root.drag-ended(); }
        }

        // The overlap of this section with an earlier one (M6.5c).
        BubbleAnchor {
            key: "sections.row." + root.index;
        }

        HorizontalLayout {
            padding-left: 4px;
            padding-right: 0px;
            spacing: 2px;

            Text {
                text: root.item.number;
                width: 18px;
                color: root.item.overlapping ? Theme.status-corrupt : Theme.text-muted;
                font-size: 11px;
                vertical-alignment: center;
            }

            for which in 2: VerticalLayout {
                alignment: center;

                TimeField {
                    width: Sections.time-width;
                    text: which == 0 ? root.item.start : root.item.end;
                    draggable: true;
                    bubble: "sections.row." + root.index + (which == 0 ? ".start" : ".end");
                    clicked(control, shift) => {
                        Sections.pick(root.index, control, shift);
                        if !control && !shift {
                            Sections.seek-row(root.index, which);
                        }
                    }
                    committed(text) => { return Sections.edit-row(root.index, which, text); }
                    typed(text) => { Sections.row-typed(root.index, which, text); }
                    canceled => { Sections.row-canceled(root.index, which); }
                    menu(x, y) => { Sections.context-menu(root.index, x, y); }
                    drag-started(y) => { root.drag-started(y); }
                    drag-moved(y) => { root.drag-moved(y); }
                    drag-ended => { root.drag-ended(); }
                }
            }

            Text {
                text: root.item.duration;
                horizontal-stretch: 1;
                horizontal-alignment: right;
                color: Theme.text-muted;
                font-family: "monospace";
                font-size: 11px;
                vertical-alignment: center;
                overflow: elide;
            }

            // A small gap after the duration (user review 2026-10-27).
            VerticalLayout {
                alignment: center;
                padding-left: 6px;

                IconButton {
                    icon: IconId.section-delete;
                    icon-size: IconSize.sm;
                    hold: true;
                    tooltip: "Delete this section";
                    clicked => { Sections.delete-row(root.index); }
                }
            }
        }

        // A refused save leads to this section (M6.5e), a duplicate flashes (P9.5).
        JumpFlash {
            key: "sections:" + root.index;
        }
    }
}

component ColumnTitle inherits Text {
    color: Theme.status-deleted;
    font-size: 10px;
    vertical-alignment: center;
}

/// The body of the Sections card.
export component SectionsCardBody inherits Rectangle {
    property <length> row-step: Sections.row-height + 2px;

    // The empty space of the card: a click clears the selection, a right click opens the list's menu.
    TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                Sections.context-menu(-1, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
        clicked => { Sections.clear-selection(); }
    }

    VerticalLayout {
        padding: 8px;
        padding-top: 0px;
        spacing: 6px;

        CurrentSection { }

        // Without sections the card ends under the current section (no hint text, user review 2026-10-27). The
        // titles and the rows stand recessed on the darker ground of the tag tree and the history (P12 block 9).
        if Sections.rows.length > 0: ListWell {
            VerticalLayout {
                padding: 2px;
                spacing: 6px;

                HorizontalLayout {
                    padding-left: 4px;
                    spacing: 2px;
                    height: 14px;

                    ColumnTitle {
                        text: "#";
                        width: 18px;
                    }

                    for title in ["Start", "End"]: Rectangle {
                        width: Sections.time-width;

                        // Over the times, after the field's inner padding.
                        ColumnTitle {
                            x: 5px;
                            height: parent.height;
                            text: title;
                        }
                    }

                    ColumnTitle {
                        text: "Duration";
                        horizontal-stretch: 1;
                        horizontal-alignment: right;
                    }

                    // The delete buttons' column (with its gap) has no caption.
                    Rectangle {
                        width: 32px;
                    }
                }

                list-area := Rectangle {
                    height: list.preferred-height;

                    // The card stack scrolled under the pointer: the pointer is measured again (`DragState.scrolls`).
                    property <int> scrolls: DragState.scrolls;
                    changed scrolls => {
                        if Sections.dragging {
                            Sections.drag-move(DragState.pointer-y - list.absolute-position.y);
                        }
                    }

                    list := VerticalLayout {
                        width: parent.width;
                        height: parent.height;
                        alignment: start;
                        spacing: 2px;

                        for row[index] in Sections.rows: SectionRowItem {
                            item: row;
                            index: index;
                            drag-shift: index < Sections.drag-shifts.length ? Sections.drag-shifts[index] : 0px;
                            lifted: Sections.dragging && row.selected;
                            // Drag & drop (P9.4): window coordinates turn into the list's coordinates.
                            drag-started(y) => {
                                DragState.pointer-y = y;
                                Sections.drag-start(index, y - list.absolute-position.y, root.row-step, Sections.row-height);
                            }
                            drag-moved(y) => {
                                DragState.pointer-y = y;
                                Sections.drag-move(y - list.absolute-position.y);
                            }
                            drag-ended => { Sections.drag-end(); }
                        }
                    }

                    // Where the dragged sections would land (the other rows moved aside).
                    if Sections.dragging: DropGap {
                        x: 0px;
                        y: Sections.drag-gap-y;
                        width: parent.width;
                        height: Math.max(0px, Sections.drag-gap-height - 2px);
                    }

                    // The dragged sections under the pointer.
                    if Sections.dragging: DragGhost {
                        x: 0px;
                        y: Sections.drag-ghost-y;
                        width: parent.width;
                        height: Sections.row-height;
                        title: Sections.drag-title;
                        detail: Sections.drag-detail;
                        count: Sections.drag-count;
                    }
                }
            }
        }
    }
}
