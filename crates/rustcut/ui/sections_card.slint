// The Sections card of the Export panel (src/ui/editor/ fills the `Sections` global and handles its callbacks): the current
// section's start and end (from the playhead with the set buttons or the keys, or typed), adding the section, the list of
// added sections with editable times, durations and the total, and the buttons that move and delete the selected section.
// Buttons are icons with tooltips (user rule 2026-10-23).
// Times: a click seeks there, a double click edits (Enter keeps, Escape cancels; user decision 2026-10-23).

import { Theme } from "styles.slint";
import { AppIcon, IconId, IconSize } from "icons.slint";
import { Shortcuts } from "shortcuts.slint";
import { IconButton, UpDownButton } from "controls.slint";
import { BubbleAnchor } from "bubble.slint";
import { JumpFlash } from "jump.slint";

export struct SectionRowView {
    number: int,
    start: string,
    end: string,
    duration: string,
    selected: bool,
    overlapping: bool,
}

export global Sections {
    // A video is loaded: marks can be set.
    in property <bool> has-media;
    // The current section's marks ("" = not set) and its length ("" without a range).
    in property <string> mark-start;
    in property <string> mark-end;
    in property <string> current-length;
    in property <bool> can-add;
    in property <[SectionRowView]> rows;
    in property <bool> can-move-up;
    in property <bool> can-move-down;
    in property <bool> can-delete;
    // The count and the total length for the card's header ("2 • 10.500s", P9.1); empty without sections.
    in property <string> summary;
    // The keys of the actions, for the tooltips.
    in property <string> key-set-start;
    in property <string> key-set-end;
    in property <string> key-add;
    in property <string> key-delete;

    // 0 = start, 1 = end.
    callback set-mark(int);
    callback seek-mark(int);
    // A typed time; false = not accepted (the field stays open and turns red).
    callback edit-mark(int, string) -> bool;
    callback add();
    callback select(/* row */ int);
    callback seek-row(/* row */ int, /* 0 = start, 1 = end */ int);
    callback edit-row(/* row */ int, /* 0 = start, 1 = end */ int, string) -> bool;
    // A field with a refused time is typed in again, or closed without keeping it (its bubble, M6.5c).
    callback mark-typed(int, string);
    callback mark-canceled(int);
    callback row-typed(/* row */ int, /* 0 = start, 1 = end */ int, string);
    callback row-canceled(/* row */ int, /* 0 = start, 1 = end */ int);
    callback move-up();
    callback move-down();
    callback delete();
}

/// A time that seeks on click and turns into a text field on double click.
export component TimeField inherits Rectangle {
    in property <string> text;
    in property <string> placeholder: "Not set";
    in property <bool> enabled: true;
    // The key of the bubble that explains a refused time (`bubble.slint`).
    in property <string> bubble;
    callback clicked();
    callback committed(string) -> bool;
    callback typed(string);
    callback canceled();

    property <bool> editing;
    property <bool> invalid;

    min-width: 84px;
    height: 22px;
    border-radius: 3px;
    background: root.editing ? Theme.background
        : touch.has-hover && root.enabled ? Theme.surface-hover : transparent;
    border-width: root.editing ? 1px : 0px;
    border-color: root.invalid ? Theme.status-corrupt : Theme.primary;

    function start-edit() {
        input.text = root.text;
        root.invalid = false;
        root.editing = true;
        input.focus();
        input.select-all();
    }

    function finish(keep: bool) {
        if keep && !root.committed(input.text) {
            root.invalid = true;
            return;
        }
        root.editing = false;
        root.invalid = false;
        if !keep {
            root.canceled();
        }
        Shortcuts.release-focus();
    }

    BubbleAnchor {
        key: root.bubble;
    }

    if !root.editing: Text {
        x: 5px;
        width: parent.width - 10px;
        text: root.text == "" ? root.placeholder : root.text;
        color: !root.enabled || root.text == "" ? Theme.status-deleted : Theme.text;
        font-family: "monospace";
        font-size: 12px;
        vertical-alignment: center;
        overflow: elide;
    }

    touch := TouchArea {
        enabled: root.enabled && !root.editing;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
        double-clicked => { root.start-edit(); }
    }

    input := TextInput {
        x: 5px;
        width: parent.width - 10px;
        height: parent.height;
        visible: root.editing;
        enabled: root.editing;
        single-line: true;
        color: Theme.text;
        font-family: "monospace";
        font-size: 12px;
        vertical-alignment: center;
        selection-background-color: Theme.primary.with-alpha(0.4);

        accepted => { root.finish(true); }
        edited => {
            root.invalid = false;
            root.typed(self.text);
        }

        key-pressed(event) => {
            if event.text == Key.Escape {
                root.finish(false);
                return accept;
            }
            reject
        }

        changed has-focus => {
            Shortcuts.editing-changed(self.has-focus);
            // Leaving the field keeps a valid time and drops an invalid one.
            if !self.has-focus && root.editing {
                if !root.committed(self.text) {
                    root.invalid = false;
                    root.canceled();
                }
                root.editing = false;
            }
        }
    }
}

component MarkRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> time;
    in property <int> which;

    spacing: 6px;

    Text {
        text: root.label;
        width: 34px;
        color: Theme.text-muted;
        font-size: 12px;
        vertical-alignment: center;
    }

    field := TimeField {
        horizontal-stretch: 1;
        text: root.time;
        enabled: Sections.has-media;
        bubble: root.which == 0 ? "sections.mark.start" : "sections.mark.end";
        clicked => { Sections.seek-mark(root.which); }
        committed(text) => { return Sections.edit-mark(root.which, text); }
        typed(text) => { Sections.mark-typed(root.which, text); }
        canceled => { Sections.mark-canceled(root.which); }
    }

    IconButton {
        icon: IconId.mark-set;
        enabled: Sections.has-media;
        tooltip: root.which == 0 ? "Set the start to the playhead" : "Set the end to the playhead";
        shortcut: root.which == 0 ? Sections.key-set-start : Sections.key-set-end;
        clicked => { Sections.set-mark(root.which); }
    }
}

component SectionRowItem inherits Rectangle {
    in property <SectionRowView> item;
    in property <int> index;

    height: 24px;
    border-radius: 3px;
    background: root.item.selected ? Theme.surface-selected : touch.has-hover ? Theme.surface-hover : transparent;

    touch := TouchArea {
        clicked => { Sections.select(root.index); }
    }

    // The overlap of this section with an earlier one (M6.5c).
    BubbleAnchor {
        key: "sections.row." + root.index;
    }

    // A refused save leads to this section (M6.5e).
    JumpFlash {
        key: "sections:" + root.index;
    }

    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        spacing: 2px;

        Text {
            text: root.item.number;
            width: 18px;
            color: root.item.overlapping ? Theme.status-corrupt : Theme.text-muted;
            font-size: 11px;
            vertical-alignment: center;
        }

        VerticalLayout {
            alignment: center;
            TimeField {
                text: root.item.start;
                bubble: "sections.row." + root.index + ".start";
                clicked => {
                    Sections.select(root.index);
                    Sections.seek-row(root.index, 0);
                }
                committed(text) => { return Sections.edit-row(root.index, 0, text); }
                typed(text) => { Sections.row-typed(root.index, 0, text); }
                canceled => { Sections.row-canceled(root.index, 0); }
            }
        }

        VerticalLayout {
            alignment: center;
            TimeField {
                text: root.item.end;
                bubble: "sections.row." + root.index + ".end";
                clicked => {
                    Sections.select(root.index);
                    Sections.seek-row(root.index, 1);
                }
                committed(text) => { return Sections.edit-row(root.index, 1, text); }
                typed(text) => { Sections.row-typed(root.index, 1, text); }
                canceled => { Sections.row-canceled(root.index, 1); }
            }
        }

        Text {
            text: root.item.duration;
            horizontal-stretch: 1;
            horizontal-alignment: right;
            color: Theme.text-muted;
            font-family: "monospace";
            font-size: 11px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

component ColumnTitle inherits Text {
    color: Theme.status-deleted;
    font-size: 10px;
    vertical-alignment: center;
}

/// The body of the Sections card.
export component SectionsCardBody inherits VerticalLayout {
    padding: 8px;
    padding-top: 0px;
    spacing: 6px;

    MarkRow {
        label: "Start";
        time: Sections.mark-start;
        which: 0;
    }

    MarkRow {
        label: "End";
        time: Sections.mark-end;
        which: 1;
    }

    HorizontalLayout {
        spacing: 6px;

        IconButton {
            icon: IconId.section-add;
            enabled: Sections.can-add;
            tooltip: "Add the current section (start to end) to the list";
            shortcut: Sections.key-add;
            clicked => { Sections.add(); }
        }

        Text {
            text: Sections.current-length;
            horizontal-stretch: 1;
            horizontal-alignment: right;
            color: Theme.text-muted;
            font-family: "monospace";
            font-size: 11px;
            vertical-alignment: center;
        }
    }

    Rectangle {
        height: 1px;
        background: Theme.border;
    }

    if Sections.rows.length == 0: Text {
        text: "No sections yet: set a start and an end, then add the section.";
        color: Theme.text-muted;
        font-size: 11px;
        wrap: word-wrap;
    }

    if Sections.rows.length > 0: HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        spacing: 2px;
        height: 14px;

        ColumnTitle {
            text: "#";
            width: 18px;
        }

        ColumnTitle {
            text: "Start";
            min-width: 84px;
            horizontal-stretch: 0;
        }

        ColumnTitle {
            text: "End";
            min-width: 84px;
            horizontal-stretch: 0;
        }

        ColumnTitle {
            text: "Duration";
            horizontal-stretch: 1;
            horizontal-alignment: right;
        }
    }

    for row[index] in Sections.rows: SectionRowItem {
        item: row;
        index: index;
    }

    HorizontalLayout {
        spacing: 4px;

        UpDownButton {
            up-enabled: Sections.can-move-up;
            down-enabled: Sections.can-move-down;
            up-tooltip: "Move the selected section up (the output keeps the list order)";
            down-tooltip: "Move the selected section down";
            up => { Sections.move-up(); }
            down => { Sections.move-down(); }
        }

        IconButton {
            icon: IconId.section-delete;
            hold: true;
            enabled: Sections.can-delete;
            tooltip: "Delete the selected section (the key deletes it at once)";
            shortcut: Sections.key-delete;
            clicked => { Sections.delete(); }
        }

        Rectangle {
            horizontal-stretch: 1;
        }
    }
}
