// The data of the Job panel (the inspector of the queue's current job; src/ui/inspector/ fills `Job`), of the Logs
// panel (the job's stored log; src/ui/logs/ fills `Logs`) and of the question before a job replaces the editor's
// open video (src/ui/editing/ fills `JobLoad`; setting `editor.on_job_load = "ask"`).

// A button on a row's right (P9.11): kind 0 play the file, 1 show it in the file manager, 2 open the folder, 3 show
// the profile in Settings.
export struct JobRowButton {
    kind: int,
    tooltip: string,
}

// One label/value row of a section; tone 0 normal, 1 muted, 2 error.
export struct JobRowView {
    label: string,
    value: string,
    tooltip: string,
    tone: int,
    // A file name or folder, cut in the middle.
    path: bool,
    // The value as a badge in the job state's color (the state row, P9.11).
    badge: bool,
    // A status symbol before the value: 0 none, 1 done, 2 failed, 3 waiting, 4 off, 5 removed (RustView, P9.11).
    icon: int,
    // An attribute of the row before it (the codecs' video and audio attributes).
    indent: bool,
    buttons: [JobRowButton],
}

export struct JobSectionView {
    id: string,
    title: string,
    collapsed: bool,
    rows: [JobRowView],
}

export global Job {
    in property <bool> has-job;
    in property <string> title;
    in property <string> state;
    // JobStateKind order (the color), and the render's progress (negative = none).
    in property <int> kind;
    in property <float> progress;
    in property <[JobSectionView]> sections;
    // The job is loaded into the editor right now.
    in property <bool> editing;
    in property <bool> can-edit;
    in property <bool> can-play;
    in property <bool> can-retry;
    in property <bool> can-log;
    in property <string> empty-text;

    callback toggle-section(/* id */ string);
    callback row-button(/* section id */ string, /* row */ int, /* button */ int);
    callback edit();
    callback play();
    callback reveal();
    callback retry();
    callback show-log();
    callback edit-tags();
}

// One line of a log; level 0 info, 1 a note of RustCut, 2 warning, 3 error.
export struct LogLineView {
    number: int,
    text: string,
    level: int,
}

export global Logs {
    // Which log: 0 the queue's current job, 1 RustCut's own log of this run, 2 its RustView part, 3 the messages of
    // this session.
    in property <int> source;
    in property <bool> has-job;
    in property <string> title;
    // Why there is nothing (yet): "The log is stored when the render ends."
    in property <string> note;
    in property <[LogLineView]> lines;
    in property <string> summary;
    in property <string> search;
    in property <bool> errors-only;
    // Stay at the newest line when the log changes.
    in property <bool> follow: true;
    in property <bool> loading;

    callback search-edited(string);
    callback toggle-errors-only();
    callback toggle-follow();
    callback copy();
    callback refresh();
    callback select-source(int);
}

export global JobLoad {
    in property <bool> open;
    in property <string> title;
    in property <string> text;
    callback replace();
    callback cancel();
}
