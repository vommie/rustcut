// The question when RustCut is closed while a job renders (`general.confirm_quit_while_rendering`, user decision Q-P1):
// keep rendering (Escape), quit when the queue is done, or quit now (held, user decision Q-Q4: the render stops and the
// job starts again at the next start).

import { Theme } from "styles.slint";
import { AppIcon, IconId, IconSize } from "icons.slint";
import { DialogButton } from "export_dialog.slint";
import { HoldLogic, HoldRing } from "hold.slint";
import { Power } from "power_types.slint";

/// A dialog button that acts only when held.
component HoldButton inherits Rectangle {
    in property <string> text;
    callback confirmed();

    height: 30px;
    min-width: 84px;
    preferred-width: label.preferred-width + 28px;
    horizontal-stretch: 0;
    border-radius: 5px;
    background: touch.pressed ? Theme.surface-selected : touch.has-hover ? Theme.surface-hover : Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;

    logic := HoldLogic {
        pressed: touch.pressed;
        confirmed => { root.confirmed(); }
    }

    HoldRing {
        progress: logic.progress;
        flash: logic.flash;
        border-radius: root.border-radius;
    }

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                logic.pressed-down();
            }
        }
        clicked => { logic.released-click(); }
    }

    label := Text {
        x: (parent.width - self.width) / 2 + logic.nudge;
        text: root.text;
        color: Theme.text;
        font-weight: 600;
        vertical-alignment: center;
        height: parent.height;
    }
}

export component QuitDialog inherits Rectangle {
    background: #000000a0;

    TouchArea { }

    keys := FocusScope {
        init => { self.focus(); }

        key-pressed(event) => {
            if event.text == Key.Escape {
                Power.keep();
                return accept;
            }
            accept
        }

        card := Rectangle {
            width: Math.min(500px, root.width - 40px);
            height: Math.min(content.preferred-height, root.height - 40px);
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            border-radius: 8px;
            background: Theme.surface-variant;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000080;
            clip: true;

            content := VerticalLayout {
                padding: 16px;
                spacing: 12px;

                HorizontalLayout {
                    spacing: 12px;

                    AppIcon {
                        icon: IconId.when-done;
                        size: IconSize.xl;
                        color: Theme.accent;
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 4px;

                        Text {
                            text: "Quit while rendering?";
                            color: Theme.text;
                            font-size: 15px;
                            font-weight: 700;
                            wrap: word-wrap;
                        }

                        Text {
                            text: Power.ask-text;
                            color: Theme.text-muted;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    HoldButton {
                        text: "Quit now";
                        confirmed => { Power.quit-now(); }
                    }

                    DialogButton {
                        text: "Quit when done";
                        clicked => { Power.quit-when-done(); }
                    }

                    DialogButton {
                        text: "Keep rendering";
                        primary: true;
                        clicked => { Power.keep(); }
                    }
                }
            }
        }
    }
}
