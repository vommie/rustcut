// The question when RustCut is closed while a job renders (`general.confirm_quit_while_rendering`, user decision Q-P1):
// keep rendering (Escape), quit when the queue is done, or quit now (held, user decision Q-Q4: the render stops and the
// job starts again at the next start). When the queue gets done while it is open, it says so and RustCut quits by
// itself after a short countdown (Q-P3); "Stay" (Escape) keeps RustCut open.

import { DialogFrame, DialogState } from "dialog_frame.slint";
import { Theme } from "styles.slint";
import { AppIcon, IconId, IconSize } from "icons.slint";
import { DialogButton } from "export_dialog.slint";
import { HoldLogic, HoldRing } from "hold.slint";
import { Power } from "power_types.slint";

/// A dialog button that acts only when held.
component HoldButton inherits Rectangle {
    in property <string> text;
    callback confirmed();

    height: 30px;
    min-width: 84px;
    preferred-width: label.preferred-width + 28px;
    horizontal-stretch: 0;
    border-radius: 5px;
    background: touch.pressed ? Theme.surface-selected : touch.has-hover ? Theme.surface-hover : Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;

    logic := HoldLogic {
        pressed: touch.pressed;
        confirmed => { root.confirmed(); }
    }

    HoldRing {
        progress: logic.progress;
        flash: logic.flash;
        border-radius: root.border-radius;
    }

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                logic.pressed-down();
            }
        }
        clicked => { logic.released-click(); }
    }

    label := Text {
        x: (parent.width - self.width) / 2 + logic.nudge;
        text: root.text;
        color: Theme.text;
        font-weight: 600;
        vertical-alignment: center;
        height: parent.height;
    }
}

export component QuitDialog inherits Rectangle {
    background: #000000a0;

    TouchArea { }

    keys := FocusScope {
        init => { self.focus(); }

        key-pressed(event) => {
            if event.text == Key.Escape {
                Power.keep();
                return accept;
            }
            accept
        }

        // Resizable; never smaller than its content, extra height stays free below it.
        card := DialogFrame {
            area-width: root.width;
            area-height: root.height;
            default-width: 500px;
            default-height: content.preferred-height;
            least-width: 360px;
            least-height: content.preferred-height;
            stored-width <=> DialogState.quit-width;
            stored-height <=> DialogState.quit-height;

            content := VerticalLayout {
                y: 0;
                height: self.preferred-height;
                padding: 16px;
                spacing: 12px;

                HorizontalLayout {
                    spacing: 12px;

                    AppIcon {
                        icon: IconId.when-done;
                        size: IconSize.xl;
                        color: Theme.accent;
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 4px;

                        Text {
                            text: Power.ask-loss ? "Jobs would be lost"
                                : Power.ask-done ? "Nothing to wait for anymore" : "Quit while rendering?";
                            color: Theme.text;
                            font-size: 15px;
                            font-weight: 700;
                            wrap: word-wrap;
                        }

                        Text {
                            text: Power.ask-text;
                            color: Theme.text-muted;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    if Power.ask-loss: HoldButton {
                        text: "Quit and lose them";
                        confirmed => { Power.quit-now(); }
                    }

                    if Power.ask-loss: DialogButton {
                        text: "Stay";
                        primary: true;
                        clicked => { Power.keep(); }
                    }

                    if !Power.ask-done && !Power.ask-loss: HoldButton {
                        text: "Quit now";
                        confirmed => { Power.quit-now(); }
                    }

                    if !Power.ask-done && !Power.ask-loss: DialogButton {
                        text: "Quit when done";
                        clicked => { Power.quit-when-done(); }
                    }

                    if !Power.ask-done && !Power.ask-loss: DialogButton {
                        text: "Keep rendering";
                        primary: true;
                        clicked => { Power.keep(); }
                    }

                    if Power.ask-done && !Power.ask-loss: DialogButton {
                        text: "Stay";
                        clicked => { Power.keep(); }
                    }

                    if Power.ask-done && !Power.ask-loss: DialogButton {
                        text: "Quit now";
                        primary: true;
                        clicked => { Power.quit-now(); }
                    }
                }
            }
        }
    }
}
