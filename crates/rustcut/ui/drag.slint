// Drag & drop of list rows (P9.4, the user's review note): the parts every list shares. src/ui/drag/ is the pure model
// (where the dragged rows land, how far the others move aside, the edge scrolling). A list shifts its rows by the
// model's `shifts` (each row animates its own move), hides the dragged rows, draws `DropGap` where they would land and
// `DragGhost` under the pointer, and while a drag runs asks `DragLogic.scroll-step` every 16 ms how far to scroll.
// Escape cancels a drag (main.slint asks `DragState`).

import { Theme } from "styles.slint";

export global DragLogic {
    // How far the list scrolls in one tick for the pointer at `pointer` (0 = its top edge) in a list `view` high:
    // negative up, positive down (src/ui/drag/model.rs `auto_scroll`).
    pure callback scroll-step(/* pointer */ length, /* view */ length) -> length;
}

export global DragState {
    // A drag runs somewhere in this window: Escape cancels it.
    in property <bool> active;
    callback cancel();
}

/// How long a row takes to move aside.
export global DragMotion {
    out property <duration> shift: 140ms;
}

/// Where the dragged rows would land: a faint outline as high as the dragged block.
export component DropGap inherits Rectangle {
    border-radius: 4px;
    background: Theme.primary.with-alpha(0.08);
    border-width: 1px;
    border-color: Theme.primary.with-alpha(0.55);
}

/// A dashed outline (Slint draws no dashed borders): dashes along the four edges.
component DashedFrame inherits Rectangle {
    in property <color> stroke;
    property <length> dash: 5px;
    property <length> step: 9px;

    for i in Math.floor(root.width / root.step): Rectangle {
        x: i * root.step;
        y: 0;
        width: root.dash;
        height: 1px;
        background: root.stroke;
    }

    for i in Math.floor(root.width / root.step): Rectangle {
        x: i * root.step;
        y: root.height - 1px;
        width: root.dash;
        height: 1px;
        background: root.stroke;
    }

    for i in Math.floor(root.height / root.step): Rectangle {
        x: 0;
        y: i * root.step;
        width: 1px;
        height: root.dash;
        background: root.stroke;
    }

    for i in Math.floor(root.height / root.step): Rectangle {
        x: root.width - 1px;
        y: i * root.step;
        width: 1px;
        height: root.dash;
        background: root.stroke;
    }
}

/// The dragged rows under the pointer: semi-transparent with a dashed outline (the user's wish), the grabbed row's
/// title, a second outline behind it and "+n" when several rows move.
export component DragGhost inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <int> count: 1;

    if root.count > 1: DashedFrame {
        x: 4px;
        y: 4px;
        width: parent.width;
        height: parent.height;
        stroke: Theme.primary.with-alpha(0.5);
    }

    Rectangle {
        background: Theme.surface-selected.with-alpha(0.6);

        DashedFrame {
            stroke: Theme.primary;
        }

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 8px;

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 1px;

                Text {
                    text: root.title;
                    color: Theme.text;
                    font-weight: 600;
                    overflow: elide;
                }

                if root.detail != "": Text {
                    text: root.detail;
                    color: Theme.text-muted;
                    font-size: 11px;
                    overflow: elide;
                }
            }

            if root.count > 1: VerticalLayout {
                alignment: center;

                Rectangle {
                    width: badge.preferred-width + 12px;
                    height: 18px;
                    border-radius: 9px;
                    background: Theme.primary;

                    badge := Text {
                        text: "+" + (root.count - 1);
                        color: Theme.background;
                        font-size: 11px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
