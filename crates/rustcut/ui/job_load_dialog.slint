// The question before a queued job replaces the editor's draft (src/ui/editing/; setting `editor.draft_on_load = "ask"`,
// user decision Q-Q3): replace it, keep it for later (it comes back when the editing ends), or cancel (Escape).

import { DialogFrame, DialogState } from "dialog_frame.slint";
import { Theme } from "styles.slint";
import { AppIcon, IconId, IconSize } from "icons.slint";
import { DialogButton } from "export_dialog.slint";
import { JobLoad } from "job_types.slint";

export component JobLoadDialog inherits Rectangle {
    // The scrim: the window behind waits.
    background: #000000a0;

    TouchArea { }

    keys := FocusScope {
        init => { self.focus(); }

        key-pressed(event) => {
            if event.text == Key.Escape {
                JobLoad.cancel();
                return accept;
            }
            if event.text == Key.Return {
                JobLoad.replace();
                return accept;
            }
            accept
        }

        // Resizable; never smaller than its content, extra height stays free below it.
        card := DialogFrame {
            area-width: root.width;
            area-height: root.height;
            default-width: 460px;
            default-height: content.preferred-height;
            least-width: 360px;
            least-height: content.preferred-height;
            stored-width <=> DialogState.job-load-width;
            stored-height <=> DialogState.job-load-height;

            content := VerticalLayout {
                y: 0;
                height: self.preferred-height;
                padding: 16px;
                spacing: 12px;

                HorizontalLayout {
                    spacing: 12px;

                    AppIcon {
                        icon: IconId.job-edit;
                        size: IconSize.xl;
                        color: Theme.accent;
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 4px;

                        Text {
                            text: JobLoad.title;
                            color: Theme.text;
                            font-size: 15px;
                            font-weight: 700;
                            wrap: word-wrap;
                        }

                        Text {
                            text: JobLoad.text;
                            color: Theme.text-muted;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    DialogButton {
                        text: "Cancel";
                        clicked => { JobLoad.cancel(); }
                    }

                    DialogButton {
                        text: "Keep for later";
                        clicked => { JobLoad.set-aside(); }
                    }

                    DialogButton {
                        text: "Replace";
                        primary: true;
                        clicked => { JobLoad.replace(); }
                    }
                }
            }
        }
    }
}
