// The question before a queued job replaces the open video with its sections (src/ui/editing/; setting
// `editor.on_job_load = "ask"`, user decisions Q-Q3, Q-N10): replace it or cancel (Escape or ×).

import { DialogFrame, DialogHeader, DialogState } from "dialog_frame.slint";
import { Theme } from "styles.slint";
import { IconId } from "icons.slint";
import { DialogButton } from "export_dialog.slint";
import { JobLoad } from "job_types.slint";

export component JobLoadDialog inherits Rectangle {
    // The scrim: the window behind waits.
    background: #000000a0;

    TouchArea { }

    keys := FocusScope {
        init => { self.focus(); }

        key-pressed(event) => {
            if event.text == Key.Escape {
                JobLoad.cancel();
                return accept;
            }
            if event.text == Key.Return {
                JobLoad.replace();
                return accept;
            }
            accept
        }

        // Resizable; never smaller than its content, extra height stays free below it.
        card := DialogFrame {
            area-width: root.width;
            area-height: root.height;
            default-width: 460px;
            default-height: content.preferred-height;
            least-width: 360px;
            least-height: content.preferred-height;
            stored-width <=> DialogState.job-load-width;
            stored-height <=> DialogState.job-load-height;

            content := VerticalLayout {
                y: 0;
                height: self.preferred-height;
                padding: 16px;
                spacing: 12px;

                DialogHeader {
                    icon: IconId.job-edit;
                    title: JobLoad.title;
                    text: JobLoad.text;
                    closable: true;
                    close => { JobLoad.cancel(); }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    DialogButton {
                        text: "Cancel";
                        clicked => { JobLoad.cancel(); }
                    }

                    DialogButton {
                        text: "Replace";
                        primary: true;
                        clicked => { JobLoad.replace(); }
                    }
                }
            }
        }
    }
}
