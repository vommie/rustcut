// The keymap's side in Slint (src/ui/keymap/, src/ui/editor/): the key labels of the menu bar's entries (set from the
// keymap; since P9.12's own menu bar they are only labels: every key reaches the keymap through the main window's key
// scope), and the entry for every key press no focused element took.

export global Shortcuts {
    in property <string> open;
    in property <string> save;
    in property <string> quit;
    in property <string> settings;
    in property <string> toggle-pause;
    in property <string> frame-back;
    in property <string> frame-forward;
    in property <string> toggle-mute;
    in property <string> reload;
    in property <string> set-start;
    in property <string> set-end;
    in property <string> go-to-start;
    in property <string> go-to-end;
    in property <string> add-section;
    in property <string> previous-cut;
    in property <string> next-cut;
    in property <string> zoom-in;
    in property <string> zoom-out;
    in property <string> zoom-fit;
    in property <string> thumbnails;
    in property <string> filter-preview;
    in property <string> filter-keep;
    in property <string> filter-reset;
    in property <string> probe-render;
    in property <string> crop-edit;
    in property <string> auto-crop;
    in property <string> rotate-left;
    in property <string> rotate-right;
    in property <string> mirror-horizontal;
    in property <string> mirror-vertical;

    // A key press that no focused element took; true when it ran (or deliberately ignored) a keymap action.
    callback key-pressed(/* text */ string, /* control */ bool, /* alt */ bool, /* shift */ bool, /* meta */ bool,
        /* repeat */ bool) -> bool;
    // A key was released (only Ctrl matters: holding it over the video edits the crop).
    callback key-released(/* text */ string);
    // A modal dialog opened or closed: the keymap's keys must not act behind it (P8).
    callback modal-changed(bool);
    // Gives the keyboard back to the shortcuts (Enter or Escape in a field, a click on the video or the timeline).
    callback release-focus();
    // A menu item without a shortcut of its own: the keymap action with this id.
    callback run(string);
}
