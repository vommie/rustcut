// The banner over the top of the video (M6.5, user decisions Q-N8): a state that holds (the probe plays, the job cannot
// be saved, the file does not play). Full width of the video, lying on it, tinted in its level's color, with the
// symbol, the title, the detail over several lines, its buttons, "‹ 1 / 3 ›" when several hold, and × (hidden until
// the state changes). It slides down like a curtain (or fades, or simply shows) and a new error lights up once.

import { Theme } from "styles.slint";
import { AppIcon, IconId, IconSize } from "icons.slint";
import { Notices, NoticeLook } from "notice_types.slint";
import { NoticeButton, NoticeIcon, NoticeProgress } from "notice_parts.slint";

export component NoticeBanner inherits Rectangle {
    // The height it takes now (the toasts on the video move below it).
    out property <length> shown-height: root.height;

    property <color> accent: NoticeLook.color(Notices.banner.level);
    property <bool> curtain: Notices.banner-animation == 0;
    property <bool> fade: Notices.banner-animation == 1;
    property <int> pulse: Notices.banner-pulse;
    property <bool> lit;

    height: Notices.has-banner || !root.curtain ? inner.preferred-height : 0px;
    animate height { duration: root.curtain ? 220ms : 0ms; easing: ease-out; }
    opacity: Notices.has-banner ? 1 : 0;
    animate opacity { duration: root.fade ? 200ms : root.curtain ? 120ms : 0ms; }
    // Gone means gone: an invisible banner must not take the video's clicks.
    visible: Notices.has-banner || (root.curtain ? self.height > 0 : self.opacity > 0);
    clip: true;

    changed pulse => {
        root.lit = true;
        dim.running = true;
    }

    dim := Timer {
        interval: 420ms;
        running: false;
        triggered => {
            self.running = false;
            root.lit = false;
        }
    }

    inner := Rectangle {
        y: root.curtain ? root.height - self.height : 0px;
        height: self.preferred-height;
        background: root.accent.mix(Theme.surface, 0.2);
        border-width: 1px;
        border-color: root.accent.with-alpha(root.lit ? 0.95 : 0.5);
        animate border-color { duration: root.lit ? 120ms : 700ms; }

        // The pulse: the tint lights up once.
        Rectangle {
            background: root.accent.with-alpha(root.lit ? 0.28 : 0);
            animate background { duration: root.lit ? 120ms : 700ms; }
        }

        touch := TouchArea {
            mouse-cursor: Notices.banner.clickable ? MouseCursor.pointer : MouseCursor.default;
            clicked => {
                if Notices.banner.clickable {
                    Notices.banner-clicked();
                }
            }
        }

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 8px;
            padding-top: 7px;
            padding-bottom: 7px;
            spacing: 10px;

            VerticalLayout {
                alignment: start;
                padding-top: 1px;

                AppIcon {
                    icon: NoticeLook.icon(Notices.banner.level);
                    size: IconSize.md;
                    color: root.accent;
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 3px;
                alignment: center;

                HorizontalLayout {
                    spacing: 8px;

                    Text {
                        text: Notices.banner.title;
                        color: Theme.text;
                        font-weight: 700;
                        overflow: elide;
                        min-width: 0px;
                        horizontal-stretch: 1;
                    }

                    if Notices.banner.since != "": Text {
                        text: Notices.banner.since;
                        color: Theme.text-muted;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }

                if Notices.banner.detail != "": Text {
                    text: Notices.banner.detail;
                    color: Theme.text-muted;
                    font-size: 12px;
                    wrap: TextWrap.word-wrap;
                    min-width: 0px;
                }

                if Notices.banner.progress >= 0: NoticeProgress {
                    progress: Notices.banner.progress;
                    tint: root.accent;
                }
            }

            HorizontalLayout {
                spacing: 6px;
                alignment: center;

                if Notices.banner.action-1 != "": VerticalLayout {
                    alignment: center;

                    NoticeButton {
                        text: Notices.banner.action-1;
                        jump: Notices.banner.jump-1;
                        accent: root.accent;
                        clicked => { Notices.banner-action(0); }
                    }
                }

                if Notices.banner.action-2 != "": VerticalLayout {
                    alignment: center;

                    NoticeButton {
                        text: Notices.banner.action-2;
                        jump: Notices.banner.jump-2;
                        accent: root.accent;
                        clicked => { Notices.banner-action(1); }
                    }
                }

                if Notices.banner.action-3 != "": VerticalLayout {
                    alignment: center;

                    NoticeButton {
                        text: Notices.banner.action-3;
                        jump: Notices.banner.jump-3;
                        accent: root.accent;
                        clicked => { Notices.banner-action(2); }
                    }
                }

                if Notices.banner-count > 1: HorizontalLayout {
                    spacing: 2px;
                    alignment: center;

                    NoticeIcon {
                        icon: IconId.chevron-left;
                        tooltip: "Previous message";
                        clicked => { Notices.page-banners(-1); }
                    }

                    Text {
                        text: (Notices.banner-index + 1) + " / " + Notices.banner-count;
                        color: Theme.text-muted;
                        font-size: 12px;
                        vertical-alignment: center;
                    }

                    NoticeIcon {
                        icon: IconId.chevron-right;
                        tooltip: "Next message";
                        clicked => { Notices.page-banners(1); }
                    }
                }

                VerticalLayout {
                    alignment: center;

                    NoticeIcon {
                        icon: IconId.close;
                        tooltip: "Hide until it changes";
                        clicked => { Notices.banner-closed(); }
                    }
                }
            }
        }
    }
}
