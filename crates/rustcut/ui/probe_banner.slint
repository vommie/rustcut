// The banner above the video while the player shows the probe render instead of the source (user decision Q-E1): what
// the probe is and the way back. Set from src/ui/probe/; Escape does the same as the button.

import { Theme } from "styles.slint";
import { AppIcon, IconId, IconSize } from "icons.slint";
import { IconButton } from "controls.slint";
import { Probe } from "render_types.slint";

export component ProbeBanner inherits Rectangle {
    background: Theme.primary.with-alpha(0.14);
    height: Probe.playing ? 34px : 0;
    clip: true;

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.primary.with-alpha(0.4);
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 8px;

        VerticalLayout {
            alignment: center;

            AppIcon {
                icon: IconId.probe-render;
                size: IconSize.md;
                color: Theme.primary;
            }
        }

        Text {
            horizontal-stretch: 1;
            text: Probe.banner;
            color: Theme.text;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }

        VerticalLayout {
            alignment: center;

            IconButton {
                icon: IconId.probe-back;
                tooltip: "Back to the source (the timeline and the marks work again)";
                shortcut: "Esc";
                clicked => { Probe.back(); }
            }
        }
    }
}
