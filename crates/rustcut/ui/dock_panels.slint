// Contents of the dock panels. The real panels arrive with their milestones (HANDOFF.md section 7); until then each panel
// says what it will hold. Panels read their data from globals, so the dock can place them in any group.

import { Theme } from "styles.slint";
import { AppIcon, IconId, IconSize } from "icons.slint";
import { Dock, DockCardView } from "dock_types.slint";
import { MediaInfoPanelView } from "media_info_panel.slint";

/// A collapsible card inside a panel (its state is part of the dock layout).
component DockCard inherits Rectangle {
    in property <DockCardView> card;

    border-radius: 6px;
    background: Theme.surface-variant;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;

    VerticalLayout {
        header := Rectangle {
            height: 28px;

            TouchArea {
                clicked => { Dock.card-toggled(root.card.id); }
            }

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 6px;

                AppIcon {
                    y: (parent.height - self.height) / 2;
                    icon: root.card.collapsed ? IconId.chevron-right : IconId.chevron-down;
                    size: IconSize.sm;
                    color: Theme.text-muted;
                }

                Text {
                    text: root.card.title;
                    font-size: 12px;
                    font-weight: 600;
                    color: Theme.text;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
            }
        }

        if !root.card.collapsed: Rectangle {
            height: 56px;

            Text {
                x: 10px;
                width: parent.width - 20px;
                text: root.card.note;
                color: Theme.text-muted;
                font-size: 11px;
                wrap: word-wrap;
                vertical-alignment: center;
            }
        }
    }
}

/// A panel that is not built yet.
component PanelPlaceholder inherits Rectangle {
    in property <string> title;
    in property <string> note;

    VerticalLayout {
        alignment: center;
        padding: 12px;
        spacing: 4px;

        Text {
            text: root.title;
            color: Theme.text;
            font-size: 13px;
            font-weight: 600;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        Text {
            text: root.note;
            color: Theme.text-muted;
            font-size: 11px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}

/// Cards stacked from the top.
component CardStack inherits Rectangle {
    in property <[DockCardView]> cards;

    Flickable {
        content-height: stack.preferred-height;

        stack := VerticalLayout {
            padding: 6px;
            spacing: 6px;
            alignment: start;

            for card in root.cards: DockCard {
                card: card;
            }
        }
    }
}

/// The content of the panel `key`.
export component DockPanelContent inherits Rectangle {
    in property <string> key;

    if root.key == "export": CardStack {
        cards: Dock.export-cards;
    }
    if root.key == "render-settings": PanelPlaceholder {
        title: "Render Settings";
        note: "Render profiles and encoder options arrive with milestone M2.5.";
    }
    if root.key == "queue": PanelPlaceholder {
        title: "Queue";
        note: "The job queue arrives with milestones M2.6 and M4.1.";
    }
    if root.key == "tag-rate": PanelPlaceholder {
        title: "Tag & Rate";
        note: "RustView's tag tree and rating bar arrive with milestone M3.2.";
    }
    if root.key == "media-info": MediaInfoPanelView { }
    if root.key == "logs": PanelPlaceholder {
        title: "Logs";
        note: "App, render and RustView logs arrive with a later milestone.";
    }
}
