// Contents of the dock panels. Panels read their data from globals, so the dock can place them in any group.

import { Theme } from "styles.slint";
import { IconButton } from "controls.slint";
import { Export } from "export_types.slint";
import { DragLogic, DragState } from "drag.slint";
import { AppIcon, IconId, IconSize } from "icons.slint";
import { Dock, DockCardView } from "dock_types.slint";
import { Playback } from "player_types.slint";
import { Jump, JumpFlash } from "jump.slint";
import { BubbleAnchor, BubbleLayer } from "bubble.slint";
import { MediaInfoPanelView } from "media_info_panel.slint";
import { Sections, SectionsCardBody } from "sections_card.slint";
import { FiltersCardBody } from "filters_card.slint";
import { Filters } from "filters_types.slint";
import { TooltipArea } from "tooltip.slint";
import { FinalizeCardBody } from "export_card.slint";
import { QueuePanel } from "queue_panel.slint";
import { JobPanel } from "job_panel.slint";
import { LogsPanel } from "logs_panel.slint";
import { TagRatePanel } from "tag_rate_panel.slint";
import { RenderAudioBody, RenderExpertBody, RenderProbeBody, RenderProfileBody, RenderVideoBody } from "render_cards.slint";

/// A short summary at the right of a card's header ("2 • 10.500s"): the digits keep their width.
component CardHeaderText inherits Text {
    horizontal-stretch: 0;
    color: Theme.text-muted;
    font-size: 11px;
    vertical-alignment: center;
}

/// A collapsible card inside a panel (its state is part of the dock layout).
component DockCard inherits Rectangle {
    in property <DockCardView> card;

    // The state manager (M6.5e): without a video the card's body is dimmed and takes no input (its header still folds).
    property <bool> gated: root.card.needs-video && !Playback.has-video;

    border-radius: 6px;
    background: Theme.surface-variant;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;

    VerticalLayout {
        header := Rectangle {
            height: 28px;

            TouchArea {
                clicked => { Dock.card-toggled(root.card.id); }
            }

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 6px;

                AppIcon {
                    y: (parent.height - self.height) / 2;
                    icon: root.card.collapsed ? IconId.chevron-right : IconId.chevron-down;
                    size: IconSize.sm;
                    color: Theme.text-muted;
                }

                Text {
                    text: root.card.title;
                    font-size: 12px;
                    font-weight: 600;
                    color: Theme.text;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }

                // The card's own text and buttons, right-aligned in its header (P9.1, the review's general note).
                if root.card.id == "sections": CardHeaderText {
                    text: Sections.summary;
                }

                // Clearing the list after a save is decided where the sections are (P9.5, Q-P9).
                if root.card.id == "sections": VerticalLayout {
                    alignment: center;

                    IconButton {
                        icon: IconId.clear-sections;
                        checked: Export.clear-sections;
                        tooltip: Export.clear-sections ? "The section list is cleared after each save"
                            : "The sections stay after a save";
                        clicked => { Export.toggle-clear-sections(); }
                    }
                }

                // The output size, the preview, keep and reset of the filters (Q-P9.13 A).
                if root.card.id == "filters": TooltipArea {
                    text: Filters.output-tooltip;
                    horizontal-stretch: 0;
                    min-width: 0;
                    preferred-width: output.preferred-width;

                    output := CardHeaderText {
                        width: parent.width;
                        height: parent.height;
                        text: Filters.output;
                        color: Filters.output-warning ? Theme.status-corrupt : Theme.text-muted;
                        overflow: elide;
                    }

                    // The output size's bubble (odd, or no multiple of the codec's blocks; P9.14).
                    BubbleAnchor {
                        key: "filters.header";
                    }
                }

                if root.card.id == "filters": HorizontalLayout {
                    spacing: 2px;

                    VerticalLayout {
                        alignment: center;

                        IconButton {
                            icon: Filters.preview ? IconId.filter-preview : IconId.filter-preview-off;
                            checked: Filters.preview;
                            tooltip: Filters.preview ? "The player shows the filters (click: show the video without them)"
                                : "The player shows the video without filters (click: show them)";
                            shortcut: Filters.key-preview;
                            clicked => { Filters.set-preview(!Filters.preview); }
                        }
                    }

                    VerticalLayout {
                        alignment: center;

                        IconButton {
                            icon: Filters.keep ? IconId.filter-kept : IconId.filter-keep;
                            checked: Filters.keep;
                            tooltip: Filters.keep ? "The filters stay for the next video and the next start (click: start each video without filters)"
                                : "Keep these filters for the next video and the next start";
                            shortcut: Filters.key-keep;
                            clicked => { Filters.set-keep(!Filters.keep); }
                        }
                    }

                    VerticalLayout {
                        alignment: center;

                        IconButton {
                            icon: IconId.filter-reset;
                            hold: true;
                            tooltip: "Reset every filter: off, default values, default order (the key resets at once)";
                            shortcut: Filters.key-reset;
                            clicked => { Filters.reset(); }
                        }
                    }
                }
            }
        }

        if !root.card.collapsed && root.card.id == "sections": SectionsCardBody {
            opacity: root.gated ? 0.4 : 1;
        }

        if !root.card.collapsed && root.card.id == "filters": FiltersCardBody {
            opacity: root.gated ? 0.4 : 1;
        }

        if !root.card.collapsed && root.card.id == "render-profile": RenderProfileBody {
            opacity: root.gated ? 0.4 : 1;
        }

        if !root.card.collapsed && root.card.id == "render-video": RenderVideoBody {
            opacity: root.gated ? 0.4 : 1;
        }

        if !root.card.collapsed && root.card.id == "render-audio": RenderAudioBody {
            opacity: root.gated ? 0.4 : 1;
        }

        if !root.card.collapsed && root.card.id == "render-expert": RenderExpertBody {
            opacity: root.gated ? 0.4 : 1;
        }

        if !root.card.collapsed && root.card.id == "render-probe": RenderProbeBody {
            opacity: root.gated ? 0.4 : 1;
        }

        if !root.card.collapsed && root.card.id == "finalize": FinalizeCardBody {
            opacity: root.gated ? 0.4 : 1;
        }
    }

    // A message leads to the whole card ("export:sections", M6.5e).
    JumpFlash {
        key: "export:" + root.card.id;
    }

    // Over the dimmed body: no click, no hover, no wheel reaches its controls.
    if root.gated && !root.card.collapsed: Rectangle {
        y: header.height;
        height: parent.height - header.height;

        // No message (Q-N8 #21): the dimmed card says it by itself.
        TouchArea {
            mouse-cursor: MouseCursor.not-allowed;
            scroll-event(event) => { reject }
        }
    }
}

/// Cards stacked from the top, with the bubbles of their inputs over them (M6.5c).
component CardStack inherits Rectangle {
    in property <[DockCardView]> cards;
    // The panel's key: the bubble layer draws this area's bubbles.
    in property <string> area;

    // A jump mark reached a row in these cards: it scrolls into view (`jump.slint`).
    property <int> jump: Jump.target-serial;
    changed jump => {
        if Jump.inside(flick.absolute-position.x, flick.width, flick.absolute-position.y + flick.content-y, flick.content-height) {
            flick.content-y = Jump.scroll-to(flick.absolute-position.y + flick.content-y, flick.content-y, flick.height, flick.content-height);
        }
    }

    flick := Flickable {
        content-height: stack.preferred-height;
        // While rows of a card are dragged the stack does not take the gesture for scrolling (its edges scroll it).
        interactive: !DragState.active;
        // An options menu of the Filters card hangs from a button in this stack: it follows the button (Q-P9n).
        changed content-y => {
            if Filters.menu-kind != "" && Filters.menu-anchor-x >= self.absolute-position.x
                && Filters.menu-anchor-x < self.absolute-position.x + self.width
                && Filters.menu-anchor-y + Filters.menu-anchor-height > self.absolute-position.y
                && Filters.menu-anchor-y < self.absolute-position.y + self.height {
                Filters.stack-top = self.absolute-position.y;
                Filters.stack-bottom = self.absolute-position.y + self.height;
                Filters.stack-scrolls += 1;
            }
        }

        stack := VerticalLayout {
            padding: 6px;
            spacing: 6px;
            alignment: start;

            for card in root.cards: DockCard {
                card: card;
            }
        }
    }

    // A list in these cards is dragged (P9.5): near the top and bottom edge the stack scrolls along, faster toward the
    // edge, and counts the scroll so the list measures the pointer again.
    Timer {
        interval: 16ms;
        running: DragState.active && DragState.area == root.area;
        triggered => {
            let step = DragLogic.scroll-step(DragState.pointer-y - flick.absolute-position.y, flick.height);
            let to = Math.max(Math.min(0px, flick.height - flick.content-height), Math.min(0px, flick.content-y - step));
            // Only a real move: setting the same place again would end the row's pointer grab.
            if to != flick.content-y {
                flick.content-y = to;
                DragState.scrolls += 1;
            }
        }
    }

    BubbleLayer {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        area: root.area;
    }
}

/// The content of the panel `key`.
export component DockPanelContent inherits Rectangle {
    in property <string> key;

    if root.key == "export": CardStack {
        cards: Dock.export-cards;
        area: "export";
    }
    if root.key == "render-settings": CardStack {
        cards: Dock.render-cards;
        area: "render-settings";
    }
    if root.key == "queue": QueuePanel { }
    if root.key == "tag-rate": TagRatePanel { }
    if root.key == "media-info": MediaInfoPanelView { }
    if root.key == "job": JobPanel { }
    if root.key == "logs": LogsPanel { }
}
