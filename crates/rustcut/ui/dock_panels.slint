// Contents of the dock panels. Panels read their data from globals, so the dock can place them in any group.

import { Theme } from "styles.slint";
import { AppIcon, IconId, IconSize } from "icons.slint";
import { Dock, DockCardView } from "dock_types.slint";
import { MediaInfoPanelView } from "media_info_panel.slint";
import { SectionsCardBody } from "sections_card.slint";
import { FiltersCardBody } from "filters_card.slint";
import { FinalizeCardBody } from "export_card.slint";
import { QueuePanel } from "queue_panel.slint";
import { JobPanel } from "job_panel.slint";
import { LogsPanel } from "logs_panel.slint";
import { TagRatePanel } from "tag_rate_panel.slint";
import { RenderAudioBody, RenderExpertBody, RenderProbeBody, RenderProfileBody, RenderVideoBody } from "render_cards.slint";

/// A collapsible card inside a panel (its state is part of the dock layout).
component DockCard inherits Rectangle {
    in property <DockCardView> card;

    border-radius: 6px;
    background: Theme.surface-variant;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;

    VerticalLayout {
        header := Rectangle {
            height: 28px;

            TouchArea {
                clicked => { Dock.card-toggled(root.card.id); }
            }

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 6px;

                AppIcon {
                    y: (parent.height - self.height) / 2;
                    icon: root.card.collapsed ? IconId.chevron-right : IconId.chevron-down;
                    size: IconSize.sm;
                    color: Theme.text-muted;
                }

                Text {
                    text: root.card.title;
                    font-size: 12px;
                    font-weight: 600;
                    color: Theme.text;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
            }
        }

        if !root.card.collapsed && root.card.id == "sections": SectionsCardBody { }

        if !root.card.collapsed && root.card.id == "filters": FiltersCardBody { }

        if !root.card.collapsed && root.card.id == "render-profile": RenderProfileBody { }

        if !root.card.collapsed && root.card.id == "render-video": RenderVideoBody { }

        if !root.card.collapsed && root.card.id == "render-audio": RenderAudioBody { }

        if !root.card.collapsed && root.card.id == "render-expert": RenderExpertBody { }

        if !root.card.collapsed && root.card.id == "render-probe": RenderProbeBody { }

        if !root.card.collapsed && root.card.id == "finalize": FinalizeCardBody { }
    }
}

/// Cards stacked from the top.
component CardStack inherits Rectangle {
    in property <[DockCardView]> cards;

    Flickable {
        content-height: stack.preferred-height;

        stack := VerticalLayout {
            padding: 6px;
            spacing: 6px;
            alignment: start;

            for card in root.cards: DockCard {
                card: card;
            }
        }
    }
}

/// The content of the panel `key`.
export component DockPanelContent inherits Rectangle {
    in property <string> key;

    if root.key == "export": CardStack {
        cards: Dock.export-cards;
    }
    if root.key == "render-settings": CardStack {
        cards: Dock.render-cards;
    }
    if root.key == "queue": QueuePanel { }
    if root.key == "tag-rate": TagRatePanel { }
    if root.key == "media-info": MediaInfoPanelView { }
    if root.key == "job": JobPanel { }
    if root.key == "logs": LogsPanel { }
}
