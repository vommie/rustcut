// The conflict dialog of saving a job (src/ui/export/dialog.rs, dialog_view.rs, previews.rs; user decisions Q-X1 and
// Q-X6): modal, with tabs. "Decision" shows the existing file with its picture (a click plays it, the "i" has the
// details) or the queued jobs that write the file, and the primary ways out; "Other name" the other free name and a
// typed one; "Similar files" a list of every file of the name's numbered series and the other names that start like
// it, each with its picture; "Queue" the jobs that write the file when it also exists. The footer (how far the
// pictures are, Cancel, Save) stays. Keys: 1-6 pick a choice (its tab shows), Up/Down move, Tab/Shift+Tab switch tabs, Enter saves,
// Escape cancels.

import { Theme } from "styles.slint";
import { AppIcon, IconId, IconSize } from "icons.slint";
import { IconButton, MiddleText } from "controls.slint";
import { SmoothScrollArea } from "smooth_scroll_view.slint";
import { GlobalTooltip, TooltipArea } from "tooltip.slint";
import { Export } from "export_types.slint";
import { DialogButton, DialogTabs, OptionRow, PreviewPicture, PreviewRow, SimilarGroup } from "export_dialog_parts.slint";
import { DialogFrame, DialogHeader, DialogState } from "dialog_frame.slint";

export { DialogButton }

/// One fact about the target: an icon, a title and what follows.
component FactBlock inherits Rectangle {
    in property <IconId> icon;
    in property <color> tint: Theme.text-muted;

    border-radius: 5px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;

    HorizontalLayout {
        padding: 8px;
        spacing: 8px;

        AppIcon {
            icon: root.icon;
            size: IconSize.md;
            color: root.tint;
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 3px;

            @children
        }
    }
}

/// The jobs in the queue that write the same file.
component QueuedJobs inherits FactBlock {
    icon: IconId.panel-queue;
    tint: Theme.accent;

    Text {
        text: Export.dialog-jobs-title;
        color: Theme.text;
        font-size: 12px;
        font-weight: 600;
    }

    for job in Export.dialog-jobs: HorizontalLayout {
        spacing: 8px;

        Text {
            width: 40px;
            text: job.id;
            color: Theme.text-muted;
            font-size: 11px;
        }

        MiddleText {
            horizontal-stretch: 1;
            text: job.name;
            font-size: 11px;
        }

        Text {
            text: job.state;
            color: job.running ? Theme.primary : Theme.text-muted;
            font-size: 11px;
        }
    }
}

/// The existing file: its picture and what it is, the buttons on the right (review 50 #5, P9.3).
component ExistingFile inherits Rectangle {
    border-radius: 5px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;

    HorizontalLayout {
        padding: 8px;
        spacing: 12px;

        VerticalLayout {
            alignment: center;

            PreviewPicture {
                width: 192px;
                preview: Export.dialog-existing;
                play => { Export.dialog-open-file(0, 0, false); }
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 4px;

            TooltipArea {
                text: Export.dialog-existing.name;
                height: 18px;

                MiddleText {
                    width: parent.width;
                    height: parent.height;
                    text: Export.dialog-existing.name;
                    font-size: 13px;
                    font-weight: 700;
                }
            }

            Text {
                text: Export.dialog-existing.facts;
                color: Theme.text-muted;
                font-size: 11px;
                overflow: elide;
            }

            if Export.dialog-existing.date != "": Text {
                text: "Modified " + Export.dialog-existing.date;
                color: Theme.text-muted;
                font-size: 11px;
            }
        }

        VerticalLayout {
            alignment: center;

            HorizontalLayout {
                spacing: 4px;

                IconButton {
                    icon: IconId.play-file;
                    tooltip: "Play the existing file in the default player";
                    clicked => { Export.dialog-open-file(0, 0, false); }
                }

                IconButton {
                    icon: IconId.reveal-file;
                    tooltip: "Show the existing file in the file manager";
                    clicked => { Export.dialog-open-file(0, 0, true); }
                }
            }
        }
    }
}

export component ConflictDialog inherits Rectangle {
    // The scrim: the window behind waits.
    background: #000000a0;

    TouchArea { }

    keys := FocusScope {
        // A tooltip of the window behind (the pointer rested on a button) never stays over the dialog.
        init => {
            GlobalTooltip.hide-cold();
            self.focus();
        }

        key-pressed(event) => {
            // A key may switch the tab or close the dialog under a details tooltip: it goes first.
            GlobalTooltip.hide-cold();
            if event.text == Key.Escape {
                Export.dialog-cancel();
                return accept;
            }
            if event.text == Key.Return {
                Export.dialog-confirm();
                return accept;
            }
            if event.text == Key.UpArrow {
                Export.dialog-step(-1);
                return accept;
            }
            if event.text == Key.DownArrow {
                Export.dialog-step(1);
                return accept;
            }
            if event.text == Key.Tab {
                Export.dialog-cycle-tab(1);
                self.focus();
                return accept;
            }
            if event.text == Key.Backtab {
                Export.dialog-cycle-tab(-1);
                self.focus();
                return accept;
            }
            if event.text == "1" || event.text == "2" || event.text == "3" || event.text == "4" || event.text == "5"
                || event.text == "6" {
                Export.dialog-select(event.text.to-float() - 1);
                self.focus();
                return accept;
            }
            accept
        }

        card := DialogFrame {
            area-width: root.width;
            area-height: root.height;
            default-width: 680px;
            default-height: 560px;
            least-width: 520px;
            least-height: 360px;
            stored-width <=> DialogState.conflict-width;
            stored-height <=> DialogState.conflict-height;

            content := VerticalLayout {
                padding: 14px;
                spacing: 10px;

                // Header: the symbol centered with the title, × cancels (or closes when only looking).
                DialogHeader {
                    icon: Export.dialog-browse && !Export.dialog-has-existing && !Export.dialog-known-mode ? IconId.target-folder
                        : IconId.status-warning;
                    tint: Export.dialog-browse && !Export.dialog-has-existing && !Export.dialog-known-mode ? Theme.text-muted : Theme.accent;
                    title: Export.dialog-title;
                    // The known-source dialog: when the video was cut first and how many files came of it.
                    text: Export.dialog-known-mode ? Export.dialog-text : "";
                    closable: true;
                    close-tooltip: Export.dialog-browse ? "Close" : "Cancel";
                    close => { Export.dialog-cancel(); }

                    // The whole path; a long folder is cut in the middle so the file name always shows.
                    if !Export.dialog-known-mode: TooltipArea {
                        text: Export.dialog-path;
                        height: 18px;

                        HorizontalLayout {
                            alignment: start;

                            Text {
                                horizontal-stretch: 1;
                                max-width: self.preferred-width;
                                min-width: 24px;
                                text: Export.dialog-folder;
                                color: Theme.text-muted;
                                font-size: 12px;
                                overflow: elide;
                            }

                            Text {
                                horizontal-stretch: 0;
                                text: Export.dialog-file-tail;
                                color: Theme.text;
                                font-size: 12px;
                                overflow: elide;
                            }
                        }
                    }
                }

                DialogTabs {
                    tabs: Export.dialog-tabs;
                    current: Export.dialog-tab;
                    picked(index) => {
                        GlobalTooltip.hide-cold();
                        Export.dialog-set-tab(index);
                        keys.focus();
                    }
                }

                // The tab: laid out from the top, free space below; it scrolls (with a visible bar) when the dialog is
                // smaller than what it shows. Its size never changes the dialog's.
                tab-area := SmoothScrollArea {
                    vertical-stretch: 1;
                    content-width: self.width;
                    content-height: tab-content.preferred-height;
                    scrollbar-size: 7px;

                    tab-content := VerticalLayout {
                        alignment: start;
                        spacing: 8px;
                        // Room for the scroll bar (a padding that followed it would loop through the height).
                        padding-right: 12px;

                        if Export.dialog-tab-kind == 0 && Export.dialog-has-existing: ExistingFile { }

                        if Export.dialog-tab-kind == 0 && !Export.dialog-has-existing && Export.dialog-jobs.length > 0:
                            QueuedJobs { }

                        if Export.dialog-tab-kind == 0 && Export.dialog-browse && !Export.dialog-has-existing
                            && Export.dialog-jobs.length == 0: Text {
                            text: "No file has this name yet.";
                            color: Theme.text-muted;
                            font-size: 12px;
                        }

                        if Export.dialog-tab-kind == 0 && !Export.dialog-browse: VerticalLayout {
                            spacing: 2px;

                            Text {
                                text: "Save the job as";
                                color: Theme.text-muted;
                                font-size: 11px;
                                font-weight: 600;
                            }

                            for option in Export.dialog-tab-options: OptionRow {
                                option: option;
                                selected: option.key == Export.dialog-selected;
                                typed: Export.dialog-typed;
                                picked => { Export.dialog-select(option.key); }
                                confirmed => { Export.dialog-confirm(); }
                                typed-changed(text) => { Export.dialog-type(text); }
                            }
                        }

                        if Export.dialog-tab-kind == 2 && Export.dialog-series.length > 0: SimilarGroup {
                            title: "Numbered like this name";
                            count-badge: Export.dialog-series.length;
                            files: Export.dialog-series;
                            picture-width: Export.dialog-tile-width * 1px;
                            is-collapsed <=> DialogState.conflict-series-folded;
                        }

                        if Export.dialog-tab-kind == 2 && Export.dialog-others.length > 0: SimilarGroup {
                            title: Export.dialog-others-title;
                            count-badge: Export.dialog-others.length;
                            files: Export.dialog-others;
                            picture-width: Export.dialog-tile-width * 1px;
                            is-collapsed <=> DialogState.conflict-others-folded;
                        }

                        if Export.dialog-tab-kind == 3: QueuedJobs { }

                        if Export.dialog-tab-kind == 4: VerticalLayout {
                            for file[index] in Export.dialog-known: PreviewRow {
                                preview: file;
                                picture-width: Export.dialog-tile-width * 1px;
                                separated: index > 0;
                            }
                        }
                    }
                }

                // Footer.
                HorizontalLayout {
                    spacing: 8px;

                    // How far the pictures are (empty when they are done).
                    Text {
                        horizontal-stretch: 1;
                        text: Export.dialog-previews-progress;
                        color: Theme.text-muted;
                        font-size: 11px;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    if Export.dialog-known-mode: DialogButton {
                        text: "Open another video";
                        clicked => { Export.dialog-open-other(); }
                    }

                    if !Export.dialog-browse: DialogButton {
                        text: "Cancel";
                        clicked => { Export.dialog-cancel(); }
                    }

                    DialogButton {
                        text: Export.dialog-confirm-text;
                        primary: true;
                        enabled: Export.dialog-can-confirm;
                        max-width: 300px;
                        clicked => { Export.dialog-confirm(); }
                    }
                }
            }
        }
    }
}
