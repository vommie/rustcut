// The toasts (M6.5, user decisions Q-N8): cards that come in from the side of their position, show their level's
// color and symbol, the title and the detail (the whole text while the pointer rests on them, which also stops their
// time), the time, a count for repeats, the buttons, a line with the time left, × and, for hints and confirmations,
// "Don't show again". A click leads to the cause, a right click opens the context menu. The layer places them as the
// settings say (six positions, five ways to stack) and never takes clicks outside the cards. Data: `Notices`.

import { Theme } from "styles.slint";
import { AppIcon, IconId, IconSize } from "icons.slint";
import { Notices, NoticeLook, ToastView } from "notice_types.slint";
import { NoticeButton, NoticeIcon, NoticeProgress } from "notice_parts.slint";

export global ToastMetrics {
    out property <length> width: 320px;
    out property <length> gap: 8px;
    out property <length> margin: 12px;
    // How far a card behind the front one of the deck is moved.
    out property <length> deck-step: 8px;
}

component ToastCard inherits Rectangle {
    in property <ToastView> toast;
    // Where it comes from (its way in) and whether it moves at all.
    in property <length> from-x;
    in property <length> from-y;
    in property <bool> animated: true;
    // A card behind the deck's front one: only its frame and stripe, as high as the front card (`forced-height`).
    in property <bool> shell;
    in property <length> forced-height;
    out property <length> natural-height: body.preferred-height;

    property <color> accent: NoticeLook.color(root.toast.level);
    property <bool> appeared;
    // The line of the time left runs (it starts a frame after the card, and again when the time starts over).
    property <bool> go;
    property <int> timer-serial: root.toast.timer;
    property <bool> present: root.appeared && !root.toast.leaving;

    height: root.forced-height > 0 ? root.forced-height : body.preferred-height;

    changed timer-serial => {
        root.go = false;
        restart.running = true;
    }

    // Changing a property right after the card exists lets Slint animate the way in.
    Timer {
        interval: 16ms;
        running: true;
        triggered => {
            self.running = false;
            root.appeared = true;
            root.go = true;
        }
    }

    restart := Timer {
        interval: 16ms;
        running: false;
        triggered => {
            self.running = false;
            root.go = true;
        }
    }

    card := Rectangle {
        x: root.present ? 0 : root.from-x;
        y: root.present ? 0 : root.from-y;
        width: parent.width;
        height: parent.height;
        opacity: root.present ? 1 : 0;
        animate x, y, opacity { duration: root.animated ? 200ms : 0ms; easing: ease-out; }
        background: Theme.surface;
        border-radius: 8px;
        border-width: 1px;
        border-color: touch.has-hover ? root.accent.with-alpha(0.55) : Theme.surface-selected;
        drop-shadow-blur: 14px;
        drop-shadow-color: #00000090;
        drop-shadow-offset-y: 4px;

        touch := TouchArea {
            mouse-cursor: root.toast.clickable ? MouseCursor.pointer : MouseCursor.default;
            clicked => {
                if root.toast.clickable {
                    Notices.toast-clicked(root.toast.id);
                }
            }
            pointer-event(event) => {
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                    Notices.toast-menu(root.toast.id, self.absolute-position.x + self.mouse-x,
                        self.absolute-position.y + self.mouse-y);
                }
            }
            changed has-hover => {
                Notices.toast-hover(root.toast.id, self.has-hover);
            }

            // A shell behind the deck's front card shows no words.
            Rectangle {
                opacity: root.shell ? 0 : 1;

                body := VerticalLayout {
                    padding-left: 14px;
                    padding-right: 8px;
                    padding-top: 8px;
                    padding-bottom: 10px;
                    spacing: 6px;

                    HorizontalLayout {
                        spacing: 8px;

                        VerticalLayout {
                            alignment: start;
                            padding-top: 1px;

                            AppIcon {
                                icon: NoticeLook.icon(root.toast.level);
                                size: IconSize.md;
                                color: root.accent;
                            }
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;
                            alignment: start;

                            Text {
                                text: root.toast.title;
                                color: Theme.text;
                                font-weight: 700;
                                wrap: touch.has-hover ? TextWrap.word-wrap : TextWrap.no-wrap;
                                overflow: elide;
                                min-width: 0px;
                            }

                            if root.toast.detail != "": Text {
                                text: root.toast.detail;
                                color: Theme.text-muted;
                                font-size: 12px;
                                wrap: touch.has-hover ? TextWrap.word-wrap : TextWrap.no-wrap;
                                overflow: elide;
                                min-width: 0px;
                            }
                        }

                        VerticalLayout {
                            alignment: start;
                            spacing: 2px;

                            HorizontalLayout {
                                alignment: end;
                                spacing: 2px;

                                if root.toast.count > 1: Rectangle {
                                    width: count-text.preferred-width + 10px;
                                    height: 18px;
                                    y: 1px;
                                    border-radius: 9px;
                                    background: root.accent.with-alpha(0.2);

                                    count-text := Text {
                                        text: "×" + root.toast.count;
                                        color: root.accent;
                                        font-size: 11px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                        horizontal-alignment: center;
                                    }
                                }

                                if root.toast.mutable && touch.has-hover: NoticeIcon {
                                    icon: IconId.notice-mute;
                                    tooltip: "Don't show this kind of message again (Settings > Messages brings it back)";
                                    clicked => { Notices.toast-mute(root.toast.id); }
                                }

                                NoticeIcon {
                                    icon: IconId.close;
                                    tooltip: "Close";
                                    clicked => { Notices.toast-closed(root.toast.id); }
                                }
                            }

                            Text {
                                text: root.toast.time;
                                color: Theme.status-deleted;
                                font-size: 11px;
                                horizontal-alignment: right;
                            }
                        }
                    }

                    if root.toast.progress >= 0: NoticeProgress {
                        progress: root.toast.progress;
                        tint: root.accent;
                    }

                    if root.toast.action-1 != "": HorizontalLayout {
                        padding-left: 24px;
                        spacing: 6px;
                        alignment: start;

                        NoticeButton {
                            text: root.toast.action-1;
                            accent: root.accent;
                            clicked => { Notices.toast-action(root.toast.id, 0); }
                        }

                        if root.toast.action-2 != "": NoticeButton {
                            text: root.toast.action-2;
                            accent: root.accent;
                            clicked => { Notices.toast-action(root.toast.id, 1); }
                        }

                        if root.toast.action-3 != "": NoticeButton {
                            text: root.toast.action-3;
                            accent: root.accent;
                            clicked => { Notices.toast-action(root.toast.id, 2); }
                        }
                    }
                }
            }
        }

        // The level's stripe on the left.
        Rectangle {
            x: 0;
            width: 4px;
            height: parent.height;
            background: root.accent;
            border-top-left-radius: 8px;
            border-bottom-left-radius: 8px;
        }

        // The time left: it runs down linearly, stops while the pointer rests on the card.
        if root.toast.remaining >= 0 && !root.shell: Rectangle {
            x: 6px;
            y: parent.height - 4px;
            height: 2px;
            border-radius: 1px;
            width: (parent.width - 14px) * ((root.go && root.toast.running) ? 0 : root.toast.remaining);
            animate width { duration: (root.go && root.toast.running) ? root.toast.left-ms * 1ms : 0ms; easing: linear; }
            background: root.accent.with-alpha(0.55);
        }
    }
}

// "+2 more", "Show fewer", the pager.
component StackChip inherits Rectangle {
    in property <string> text;
    callback clicked();

    height: 22px;
    width: label.preferred-width + 18px;
    border-radius: 11px;
    background: touch.has-hover ? Theme.surface-hover : Theme.surface;
    border-width: 1px;
    border-color: Theme.surface-selected;
    drop-shadow-blur: 8px;
    drop-shadow-color: #00000070;

    label := Text {
        text: root.text;
        color: Theme.text-muted;
        font-size: 12px;
        font-weight: 600;
        vertical-alignment: center;
        horizontal-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component ToastLayer inherits Rectangle {
    // The video area in layer coordinates; a banner over its top and the status line keep their room.
    in property <length> video-x;
    in property <length> video-y;
    in property <length> video-width;
    in property <length> video-height;
    in property <length> top-inset;
    in property <length> bottom-inset;

    property <int> pos: Notices.position;
    property <bool> right: root.pos == 0 || root.pos == 2 || root.pos == 4 || root.pos == 5;
    property <bool> bottom: root.pos == 2 || root.pos == 3 || root.pos == 5;
    property <bool> on-video: root.pos <= 3;
    property <length> w: ToastMetrics.width;
    property <length> anchor-x: root.on-video
        ? (root.right ? root.video-x + root.video-width - root.w - ToastMetrics.margin
            : root.video-x + (root.video-width - root.w) / 2)
        : root.width - root.w - ToastMetrics.margin;
    property <length> anchor-top: root.on-video ? root.video-y + root.top-inset + 10px : 10px;
    property <length> anchor-bottom: root.on-video ? root.video-y + root.video-height - 10px
        : root.height - root.bottom-inset - 10px;
    // The way in: from the side for the right positions, from above or below for the centered ones; "drop" always
    // falls from above, "fade" stays in place.
    property <length> in-x: Notices.animation == 0 && root.right ? 32px : 0px;
    property <length> in-y: Notices.animation == 2 ? -28px
        : Notices.animation == 0 && !root.right ? (root.bottom ? 24px : -24px) : 0px;
    property <bool> animated: Notices.animation != 3;
    property <bool> deck: Notices.stacking == 3 && !Notices.expanded;
    // The deck's front card reports its height; the cards behind it take the same.
    property <length> front-height: 72px;
    property <length> deck-height: root.front-height + ToastMetrics.deck-step * Math.max(0, Notices.toasts.length - 1);

    background: transparent;

    // The cards live inside one touch area: the pointer over any of them fans the deck out, and the layer itself
    // takes no clicks.
    area := TouchArea {
        x: Math.max(4px, root.anchor-x);
        y: root.bottom ? root.anchor-bottom - self.height : root.anchor-top;
        width: root.w;
        height: root.deck ? root.deck-height : column.preferred-height;
        changed has-hover => {
            if Notices.stacking == 3 && Notices.toasts.length > 1 {
                Notices.set-expanded(self.has-hover);
            }
        }

        column := VerticalLayout {
            visible: !root.deck;
            width: root.w;
            height: self.preferred-height;
            spacing: ToastMetrics.gap;

            if Notices.summary: ToastCard {
                toast: {
                    id: -1,
                    level: Notices.summary-level,
                    title: Notices.summary-text,
                    detail: "Click to see them",
                    remaining: -1,
                    progress: -1,
                    clickable: true,
                    count: 1,
                };
                from-x: root.in-x;
                from-y: root.in-y;
                animated: root.animated;
            }

            // The column and the deck both keep their cards (only one is visible), so fanning the deck out under the
            // pointer re-creates nothing and the pointer stays "over" the area.
            VerticalLayout {
                spacing: ToastMetrics.gap;

                for toast in Notices.toasts: ToastCard {
                    toast: toast;
                    from-x: root.in-x;
                    from-y: root.in-y;
                    animated: root.animated;
                }
            }

            if Notices.more > 0 || Notices.pages > 1 || (Notices.expanded && Notices.stacking != 3)
                : HorizontalLayout {
                alignment: end;
                spacing: 6px;

                if Notices.pages > 1: NoticeIcon {
                    icon: IconId.chevron-left;
                    tooltip: "Previous message";
                    clicked => { Notices.page-toasts(-1); }
                }

                if Notices.pages > 1: Text {
                    text: (Notices.page + 1) + " / " + Notices.pages;
                    color: Theme.text-muted;
                    font-size: 12px;
                    vertical-alignment: center;
                }

                if Notices.pages > 1: NoticeIcon {
                    icon: IconId.chevron-right;
                    tooltip: "Next message";
                    clicked => { Notices.page-toasts(1); }
                }

                if Notices.more > 0 && Notices.stacking != 3: StackChip {
                    text: "+" + Notices.more + " more";
                    clicked => { Notices.set-expanded(true); }
                }

                if Notices.expanded && Notices.stacking != 3: StackChip {
                    text: "Show fewer";
                    clicked => { Notices.set-expanded(false); }
                }
            }
        }

        // The deck: the front card (depth 0) lies on top of the others.
        Rectangle {
            visible: root.deck;
            width: root.w;
            height: parent.height;

            for toast in Notices.toasts: ToastCard {
                shell: toast.depth > 0;
                forced-height: toast.depth > 0 ? root.front-height : 0px;
                init => {
                    if self.toast.depth == 0 {
                        root.front-height = self.natural-height;
                    }
                }
                changed natural-height => {
                    if self.toast.depth == 0 {
                        root.front-height = self.natural-height;
                    }
                }
                x: toast.depth * ToastMetrics.deck-step;
                y: root.bottom ? parent.height - self.height - toast.depth * ToastMetrics.deck-step
                    : toast.depth * ToastMetrics.deck-step;
                width: root.w - 2 * toast.depth * ToastMetrics.deck-step;
                opacity: 1 - toast.depth * 0.2;
                z: -toast.depth;
                toast: toast;
                from-x: root.in-x;
                from-y: root.in-y;
                animated: root.animated;
            }
        }
    }
}
