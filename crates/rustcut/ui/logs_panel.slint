// The Logs panel (src/ui/logs/ fills `Logs`; user decision Q-Q1, M4.3): the stored log of the queue's current job
// (RustCut's notes and ffmpeg's lines), RustCut's own log of this run, or its RustView part; errors red and warnings
// yellow, with a search, "errors only", following the newest line and Copy. No line numbers (P9.11).

import { ListView } from "std-widgets.slint";
import { Theme } from "styles.slint";
import { AppIcon, IconId, IconSize } from "icons.slint";
import { IconButton, MiddleText } from "controls.slint";
import { TooltipHost } from "tooltip.slint";
import { SearchField } from "search_field.slint";
import { Logs, LogLineView } from "job_types.slint";

component LogLine inherits Rectangle {
    in property <LogLineView> line;
    // Every row asks for the list's content width: the list takes it from the rows' minimum and scrolls sideways. The
    // row itself stays as wide as the list, so its children set their own width.
    in property <length> content-width;
    // The part of the row the panel shows: the tooltip stands there, not at the row's far end.
    in property <length> shown-x;
    in property <length> shown-width;

    min-width: root.content-width;
    height: 17px;

    host := TooltipHost {
        x: root.shown-x;
        width: root.shown-width;
        text: root.line.text;
    }

    Text {
        x: 4px;
        width: root.content-width - 8px;
        text: root.line.text;
        color: root.line.level == 3 ? Theme.status-corrupt : root.line.level == 2 ? Theme.accent
            : root.line.level == 1 ? Theme.primary : Theme.text-muted;
        font-size: 11px;
        font-family: "monospace";
        vertical-alignment: center;
        overflow: clip;
    }

    TouchArea {
        width: root.content-width;

        changed has-hover => {
            if self.has-hover {
                host.enter();
            } else {
                host.leave();
            }
        }
    }
}

export component LogsPanel inherits Rectangle {
    // The content's width comes from one measured line (src/ui/logs/lines.rs picks it), with a little room for a line of
    // about the same length that happens to be wider.
    property <length> content-width: Math.max(list.visible-width, longest.preferred-width * 1.03 + 8px);

    changed content-width => {
        list.content-x = Math.min(0px, Math.max(list.content-x, list.visible-width - root.content-width));
    }

    longest := Text {
        visible: false;
        text: Logs.longest;
        font-size: 11px;
        font-family: "monospace";
    }

    VerticalLayout {
        padding: 6px;
        spacing: 6px;

        HorizontalLayout {
            spacing: 4px;

            IconButton {
                icon: IconId.job-details;
                checked: Logs.source == 0;
                tooltip: "The log of the job chosen in the queue";
                clicked => { Logs.select-source(0); }
            }

            IconButton {
                icon: IconId.panel-logs;
                checked: Logs.source == 1;
                tooltip: "RustCut's own log of this run";
                clicked => { Logs.select-source(1); }
            }

            IconButton {
                icon: IconId.rustview-connected;
                checked: Logs.source == 2;
                tooltip: "The RustView link's log of this run";
                clicked => { Logs.select-source(2); }
            }

            IconButton {
                icon: IconId.log-messages;
                checked: Logs.source == 3;
                tooltip: "The messages of this session";
                clicked => { Logs.select-source(3); }
            }

            IconButton {
                icon: IconId.plugin;
                checked: Logs.source == 4;
                tooltip: "The plugins' log of this run (the search finds one plugin by its id)";
                clicked => { Logs.select-source(4); }
            }

            MiddleText {
                horizontal-stretch: 1;
                text: Logs.has-job ? Logs.title : "No job chosen";
                color: Logs.has-job ? Theme.text : Theme.status-deleted;
                font-weight: 600;
            }

            IconButton {
                icon: IconId.reload;
                enabled: Logs.source == 0 && Logs.has-job && !Logs.loading;
                tooltip: "Read the job's log again";
                clicked => { Logs.refresh(); }
            }
        }

        HorizontalLayout {
            spacing: 4px;

            SearchField {
                horizontal-stretch: 1;
                // The field keeps this width: the row's width without the buttons beside it.
                field-width: Math.max(60px, parent.width - 118px);
                text: Logs.search;
                placeholder-text: "Search the log";
                enable-regex-toggle: false;
                show-search-icon: true;
                clear-tooltip: "Clear the search (Esc)";
                search-changed(text) => { Logs.search-edited(text); }
                cleared => { Logs.search-edited(""); }
            }

            IconButton {
                icon: IconId.status-warning;
                checked: Logs.errors-only;
                tooltip: Logs.errors-only ? "Showing errors and warnings only: show every line" : "Show errors and warnings only";
                clicked => { Logs.toggle-errors-only(); }
            }

            IconButton {
                icon: IconId.log-shareable;
                checked: Logs.shareable;
                tooltip: Logs.shareable
                    ? "The shareable copy: file names, folders, tags, user and host, MD5 sums and titles are replaced (click: the original)"
                    : "Show the shareable copy (names and paths replaced, safe to send)";
                clicked => { Logs.toggle-shareable(); }
            }

            IconButton {
                icon: IconId.log-follow;
                checked: Logs.follow;
                tooltip: Logs.follow ? "Staying at the newest line" : "Stay at the newest line";
                clicked => { Logs.toggle-follow(); }
            }

            IconButton {
                icon: IconId.copy;
                enabled: Logs.lines.length > 0;
                tooltip: "Copy the shown lines to the clipboard";
                clicked => { Logs.copy(); }
            }
        }

        Text {
            text: Logs.note != "" ? Logs.note : Logs.summary;
            color: Theme.text-muted;
            font-size: 11px;
            overflow: elide;
        }

        Rectangle {
            vertical-stretch: 1;
            border-radius: 4px;
            background: Theme.background;
            border-width: 1px;
            border-color: Theme.border;

            list := ListView {
                changed content-height => {
                    if Logs.follow {
                        self.content-y = Math.min(0px, self.visible-height - self.content-height);
                    }
                }

                for line in Logs.lines: LogLine {
                    line: line;
                    content-width: root.content-width;
                    shown-x: -list.content-x;
                    shown-width: list.visible-width;
                }
            }
        }
    }
}
