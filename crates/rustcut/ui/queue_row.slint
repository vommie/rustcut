// A row of the queue list and the table's column header (queue_panel.slint puts them together). A row is either the
// compact two-line form (name and state; folder, profile and length, or ETA, size and speed while rendering with the
// percentage on the right, or the failure) or a table line with one cell per column of `Queue.columns`; the state cell
// carries the render's progress, the last column a held delete button (P9.6).
// Click selects (Ctrl adds, Shift a range), a double click acts (play, log, details), a right click opens the context
// menu, and a drag moves the selected jobs.

import { Theme } from "styles.slint";
import { AppIcon, IconId, IconSize } from "icons.slint";
import { TooltipHost } from "tooltip.slint";
import { MiddleText } from "controls_text.slint";
import { IconButton } from "controls.slint";
import { Queue, QueueColumnView, QueueRowView } from "queue_types.slint";
import { JumpFlash } from "jump.slint";
import { DragMotion } from "drag.slint";

// waiting, held, rendering, paused, finished, failed, canceled
export global QueueColors {
    // The fixed symbol of a state (review 2), in the same order.
    pure public function icon(kind: int) -> IconId {
        if kind == 1 { return IconId.state-held; }
        if kind == 2 { return IconId.state-rendering; }
        if kind == 3 { return IconId.state-paused; }
        if kind == 4 { return IconId.state-finished; }
        if kind == 5 { return IconId.state-failed; }
        if kind == 6 { return IconId.state-canceled; }
        return IconId.state-waiting;
    }

    pure public function of(kind: int) -> color {
        if kind == 2 { return Theme.primary; }
        if kind == 3 { return Theme.accent; }
        if kind == 4 { return Theme.status-ok; }
        if kind == 5 { return Theme.status-corrupt; }
        if kind == 6 || kind == 1 { return Theme.status-deleted; }
        return Theme.text-muted;
    }
}

/// A thin progress bar.
component Progress inherits Rectangle {
    in property <float> value;
    in property <color> bar;

    height: 3px;
    border-radius: 1.5px;
    background: root.value >= 0 ? Theme.surface-selected : transparent;

    Rectangle {
        x: 0;
        width: parent.width * Math.clamp(root.value, 0, 1);
        border-radius: 1.5px;
        background: root.bar;
    }
}

export component QueueRow inherits Rectangle {
    in property <QueueRowView> job;
    in property <int> index;
    // The state's word beside its symbol (a wide panel); the tooltip names it either way.
    in property <bool> state-words: true;
    // Drag & drop (P9.4): how far the row moves aside while jobs are dragged and whether it is one of them (the ghost
    // shows it under the pointer, so it is hidden here). The drag reports window coordinates.
    in property <length> drag-shift;
    in property <bool> lifted;
    callback drag-started(/* window y of the press */ length);
    callback drag-moved(/* window y */ length);
    callback drag-ended();

    property <color> state-color: QueueColors.of(root.job.kind);
    property <bool> ctrl;
    property <bool> shift;
    property <bool> dragging;
    // This press became a drag: its release is no click.
    property <bool> dragged;
    property <length> press-y;
    property <length> press-window-y;

    height: Queue.row-height;

    body := Rectangle {
        y: root.drag-shift;
        animate y { duration: Queue.drag-instant ? 0ms : DragMotion.shift; easing: ease-out; }
        width: parent.width;
        height: parent.height;
        opacity: root.lifted ? 0 : 1;

        border-radius: 4px;
        // The job loaded into the editor stays highlighted until the editing ends (M6.5e, Q-N8 #33).
        background: root.job.selected ? (root.job.editing ? Theme.accent.with-alpha(0.22) : Theme.surface-selected)
            : root.job.editing ? Theme.accent.with-alpha(0.12)
            : touch.has-hover && !root.dragging ? Theme.surface-hover : transparent;
        border-width: root.job.editing ? 1px : 0px;
        border-color: Theme.accent.with-alpha(0.75);

        host := TooltipHost {
            text: root.job.tooltip;
        }

        // The job the Job and Logs panels show.
        if root.job.current: Rectangle {
            x: 0;
            y: 4px;
            width: 2px;
            height: parent.height - 8px;
            border-radius: 1px;
            background: Theme.primary;
        }

        if Queue.compact: VerticalLayout {
            padding-left: 8px;
            padding-right: 8px;
            padding-top: 4px;
            padding-bottom: 4px;
            spacing: 2px;

            HorizontalLayout {
                spacing: 6px;

                MiddleText {
                    horizontal-stretch: 1;
                    text: root.job.name;
                    font-weight: 600;
                }

                HorizontalLayout {
                    horizontal-stretch: 0;
                    spacing: 4px;

                    if root.job.moving: VerticalLayout {
                        alignment: center;

                        AppIcon {
                            icon: IconId.job-move;
                            size: IconSize.sm;
                            color: Theme.primary;
                        }
                    }

                    VerticalLayout {
                        alignment: center;

                        AppIcon {
                            icon: QueueColors.icon(root.job.kind);
                            size: IconSize.sm;
                            color: root.state-color;
                        }
                    }

                    if root.state-words: Text {
                        text: root.job.state;
                        color: root.state-color;
                        font-size: 11px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }

            HorizontalLayout {
                spacing: 6px;

                Text {
                    horizontal-stretch: 1;
                    text: root.job.detail;
                    color: root.job.kind == 5 ? Theme.status-corrupt : Theme.text-muted;
                    font-size: 11px;
                    overflow: elide;
                }

                // The render's percentage keeps its width and its place on the right (no jitter).
                if root.job.percent != "": Text {
                    width: 36px;
                    text: root.job.percent;
                    color: root.state-color;
                    font-size: 11px;
                    font-weight: 600;
                    horizontal-alignment: right;
                }
            }

            Progress {
                value: root.job.progress;
                bar: root.state-color;
            }
        }

        if !Queue.compact: Rectangle {
            x: 8px;
            width: parent.width - 16px;

            for column[i] in Queue.columns: Rectangle {
                x: column.x;
                width: column.width;

                if column.id == "state": Rectangle {
                    y: parent.height - 6px;
                    height: 3px;

                    Progress {
                        width: parent.width;
                        value: root.job.progress;
                        bar: root.state-color;
                    }
                }

                // A file that waits to move (P12 block 7): its mark before the name.
                if column.id == "name" && root.job.moving: AppIcon {
                    x: 0px;
                    icon: IconId.job-move;
                    size: IconSize.sm;
                    color: Theme.primary;
                }

                // Names and folders are cut in the middle (P9.1).
                if column.id == "name" || column.id == "folder": MiddleText {
                    x: column.id == "name" && root.job.moving ? 20px : 0px;
                    width: parent.width - self.x;
                    height: parent.height;
                    text: root.job.cells[i];
                    color: column.id == "name" ? Theme.text : Theme.text-muted;
                    font-weight: column.id == "name" ? 600 : 400;
                }

                if column.id != "name" && column.id != "folder" && column.id != "remove": Text {
                    width: parent.width;
                    text: root.job.cells[i];
                    color: column.id == "state" ? root.state-color
                        : column.id == "name" ? Theme.text : Theme.text-muted;
                    font-size: 12px;
                    font-weight: column.id == "name" || column.id == "state" ? 600 : 400;
                    horizontal-alignment: column.right ? right : left;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }


        // A failed job's toast leads here (M6.5e): the row flashes once it is in view.
        JumpFlash {
            key: "queue:" + root.job.id;
        }
    }

    // On top of the texts: selection, double click, context menu, drag. Outside the moving body, so a row that moves
    // aside or is lifted keeps the pointer it holds (P9.4).
    touch := TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                host.press();
                if event.button == PointerEventButton.right {
                    if !root.job.selected {
                        Queue.select(root.job.id, false, false);
                    }
                    Queue.context-menu(root.job.id, self.absolute-position.x + self.mouse-x,
                        self.absolute-position.y + self.mouse-y);
                } else if event.button == PointerEventButton.left {
                    root.ctrl = event.modifiers.control;
                    root.shift = event.modifiers.shift;
                    root.press-y = self.mouse-y;
                    root.press-window-y = self.absolute-position.y + self.mouse-y;
                    root.dragging = false;
                    root.dragged = false;
                }
            }
            if event.kind == PointerEventKind.up && event.button == PointerEventButton.left && root.dragging {
                root.dragging = false;
                root.drag-ended();
            }
        }
        moved => {
            if self.pressed && (root.dragging || Math.abs(self.mouse-y - root.press-y) > 6px) {
                if !root.dragging {
                    root.dragging = true;
                    root.dragged = true;
                    if !root.job.selected {
                        Queue.select(root.job.id, false, false);
                    }
                    root.drag-started(root.press-window-y);
                }
                root.drag-moved(self.absolute-position.y + self.mouse-y);
            }
        }
        clicked => {
            if !root.dragged {
                Queue.select(root.job.id, root.ctrl, root.shift);
            }
        }
        double-clicked => {
            Queue.double-clicked(root.job.id);
        }
        changed has-hover => {
            if self.has-hover {
                host.enter();
            } else {
                host.leave();
            }
        }
    }

    // The table's held delete buttons, over the row's pointer area (they move with the row while jobs are dragged).
    if !Queue.compact: Rectangle {
        x: 8px;
        y: root.drag-shift;
        animate y { duration: Queue.drag-instant ? 0ms : DragMotion.shift; easing: ease-out; }
        width: parent.width - 16px;
        height: parent.height;
        opacity: root.lifted ? 0 : 1;

        for column in Queue.columns: Rectangle {
            x: column.x;
            width: column.width;

            if column.id == "remove": IconButton {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                icon: IconId.job-remove;
                icon-size: IconSize.sm;
                hold: true;
                enabled: root.job.removable;
                tooltip: root.job.removable ? "Remove the job from the queue (its files stay)"
                    : "Remove the job (cancel it first: it renders)";
                clicked => { Queue.remove-row(root.job.id); }
            }
        }
    }
}

/// The table's titles; a resizable column's right edge can be dragged.
export component QueueHeader inherits Rectangle {
    height: 22px;

    Rectangle {
        x: 8px;
        width: parent.width - 16px;

        for column in Queue.columns: Rectangle {
            x: column.x;
            width: column.width;

            title-host := TooltipHost {
                text: column.tooltip;
            }

            Text {
                width: parent.width;
                text: column.title;
                color: Theme.text-muted;
                font-size: 11px;
                font-weight: 600;
                horizontal-alignment: column.right ? right : left;
                vertical-alignment: center;
                overflow: elide;
            }

            TouchArea {
                changed has-hover => {
                    if self.has-hover {
                        title-host.enter();
                    } else {
                        title-host.leave();
                    }
                }
            }

            if column.resizable: TouchArea {
                // The edge moves with the width: the drag is measured in window coordinates.
                property <length> start-x;
                x: parent.width - 2px;
                width: 8px;
                mouse-cursor: MouseCursor.col-resize;
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down {
                        self.start-x = self.absolute-position.x + self.mouse-x;
                        Queue.column-resize-started(column.id);
                    }
                }
                moved => {
                    if self.pressed {
                        Queue.column-resized(column.id, self.absolute-position.x + self.mouse-x - self.start-x);
                    }
                }
            }
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }
}
