// A row of the queue list and the table's column header (queue_panel.slint puts them together). A row is either the
// compact two-line form (name and state; folder, profile and length, or ETA, size and speed while rendering, or the
// failure) or a table line with one cell per column of `Queue.columns`; the state cell carries the render's progress.
// Click selects (Ctrl adds, Shift a range), a double click acts (play, log, details), a right click opens the context
// menu, and a drag moves the selected jobs.

import { Theme } from "styles.slint";
import { AppIcon, IconId, IconSize } from "icons.slint";
import { TooltipHost } from "tooltip.slint";
import { Queue, QueueColumnView, QueueRowView } from "queue_types.slint";
import { JumpFlash } from "jump.slint";

// waiting, held, rendering, paused, finished, failed, canceled
export global QueueColors {
    pure public function of(kind: int) -> color {
        if kind == 2 { return Theme.primary; }
        if kind == 3 { return Theme.accent; }
        if kind == 4 { return Theme.status-ok; }
        if kind == 5 { return Theme.status-corrupt; }
        if kind == 6 || kind == 1 { return Theme.status-deleted; }
        return Theme.text-muted;
    }
}

/// A thin progress bar.
component Progress inherits Rectangle {
    in property <float> value;
    in property <color> bar;

    height: 3px;
    border-radius: 1.5px;
    background: root.value >= 0 ? Theme.surface-selected : transparent;

    Rectangle {
        x: 0;
        width: parent.width * Math.clamp(root.value, 0, 1);
        border-radius: 1.5px;
        background: root.bar;
    }
}

export component QueueRow inherits Rectangle {
    in property <QueueRowView> job;
    in property <int> index;
    // The pointer moved while pressed (in the row's coordinates); the list turns it into a drop position.
    callback drag-moved(/* row */ int, /* y in the row */ length);
    callback drag-ended();

    property <color> state-color: QueueColors.of(root.job.kind);
    property <bool> ctrl;
    property <bool> shift;
    property <bool> dragging;
    property <length> press-y;

    height: Queue.row-height;
    border-radius: 4px;
    // The job loaded into the editor stays highlighted until the editing ends (M6.5e, Q-N8 #33).
    background: root.job.selected ? (root.job.editing ? Theme.accent.with-alpha(0.22) : Theme.surface-selected)
        : root.job.editing ? Theme.accent.with-alpha(0.12)
        : touch.has-hover && !root.dragging ? Theme.surface-hover : transparent;
    border-width: root.job.editing ? 1px : 0px;
    border-color: Theme.accent.with-alpha(0.75);

    host := TooltipHost {
        text: root.job.tooltip;
    }

    // The job the Job and Logs panels show.
    if root.job.current: Rectangle {
        x: 0;
        y: 4px;
        width: 2px;
        height: parent.height - 8px;
        border-radius: 1px;
        background: Theme.primary;
    }

    if Queue.compact: VerticalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 2px;

        HorizontalLayout {
            spacing: 6px;

            if root.job.editing: AppIcon {
                icon: IconId.job-edit;
                size: IconSize.sm;
                color: Theme.accent;
            }

            Text {
                horizontal-stretch: 1;
                text: root.job.name;
                color: Theme.text;
                font-size: 12px;
                font-weight: 600;
                overflow: elide;
            }

            Text {
                text: root.job.state;
                color: root.state-color;
                font-size: 11px;
                font-weight: 600;
            }
        }

        Text {
            text: root.job.detail;
            color: root.job.kind == 5 ? Theme.status-corrupt : Theme.text-muted;
            font-size: 11px;
            overflow: elide;
        }

        Progress {
            value: root.job.progress;
            bar: root.state-color;
        }
    }

    if !Queue.compact: Rectangle {
        x: 8px;
        width: parent.width - 16px;

        for column[i] in Queue.columns: Rectangle {
            x: column.x;
            width: column.width;

            if column.id == "state": Rectangle {
                y: parent.height - 6px;
                height: 3px;

                Progress {
                    width: parent.width;
                    value: root.job.progress;
                    bar: root.state-color;
                }
            }

            if column.id == "name" && root.job.editing: AppIcon {
                x: 0;
                y: (parent.height - self.height) / 2;
                icon: IconId.job-edit;
                size: IconSize.sm;
                color: Theme.accent;
            }

            Text {
                x: column.id == "name" && root.job.editing ? 18px : 0px;
                width: parent.width - self.x;
                text: root.job.cells[i];
                color: column.id == "state" ? root.state-color
                    : column.id == "name" ? Theme.text : Theme.text-muted;
                font-size: 12px;
                font-weight: column.id == "name" || column.id == "state" ? 600 : 400;
                horizontal-alignment: column.right ? right : left;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }

    // On top of the texts: selection, double click, context menu, drag.
    touch := TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                host.press();
                if event.button == PointerEventButton.right {
                    if !root.job.selected {
                        Queue.select(root.job.id, false, false);
                    }
                    Queue.context-menu(root.job.id, self.absolute-position.x + self.mouse-x,
                        self.absolute-position.y + self.mouse-y);
                } else if event.button == PointerEventButton.left {
                    root.ctrl = event.modifiers.control;
                    root.shift = event.modifiers.shift;
                    root.press-y = self.mouse-y;
                    root.dragging = false;
                }
            }
            if event.kind == PointerEventKind.up && event.button == PointerEventButton.left && root.dragging {
                root.dragging = false;
                root.drag-ended();
            }
        }
        moved => {
            if self.pressed && (root.dragging || Math.abs(self.mouse-y - root.press-y) > 6px) {
                if !root.dragging {
                    root.dragging = true;
                    if !root.job.selected {
                        Queue.select(root.job.id, false, false);
                    }
                }
                root.drag-moved(root.index, self.mouse-y);
            }
        }
        clicked => {
            if !root.dragging {
                Queue.select(root.job.id, root.ctrl, root.shift);
            }
        }
        double-clicked => {
            Queue.double-clicked(root.job.id);
        }
        changed has-hover => {
            if self.has-hover {
                host.enter();
            } else {
                host.leave();
            }
        }
    }

    // A failed job's toast leads here (M6.5e): the row flashes once it is in view.
    JumpFlash {
        key: "queue:" + root.job.id;
    }
}

/// The table's titles; a resizable column's right edge can be dragged.
export component QueueHeader inherits Rectangle {
    height: 22px;

    Rectangle {
        x: 8px;
        width: parent.width - 16px;

        for column in Queue.columns: Rectangle {
            x: column.x;
            width: column.width;

            title-host := TooltipHost {
                text: column.tooltip;
            }

            Text {
                width: parent.width;
                text: column.title;
                color: Theme.text-muted;
                font-size: 11px;
                font-weight: 600;
                horizontal-alignment: column.right ? right : left;
                vertical-alignment: center;
                overflow: elide;
            }

            TouchArea {
                changed has-hover => {
                    if self.has-hover {
                        title-host.enter();
                    } else {
                        title-host.leave();
                    }
                }
            }

            if column.resizable: TouchArea {
                // The edge moves with the width: the drag is measured in window coordinates.
                property <length> start-x;
                x: parent.width - 2px;
                width: 8px;
                mouse-cursor: MouseCursor.col-resize;
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down {
                        self.start-x = self.absolute-position.x + self.mouse-x;
                        Queue.column-resize-started(column.id);
                    }
                }
                moved => {
                    if self.pressed {
                        Queue.column-resized(column.id, self.absolute-position.x + self.mouse-x - self.start-x);
                    }
                }
            }
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }
}
