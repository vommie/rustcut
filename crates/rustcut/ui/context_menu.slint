// RustCut's context menu (src/ui/menu/ fills `ContextMenu`): one menu at a time over the whole window, in RustView's
// style (28 px rows with an icon slot, separators, a muted shortcut, one level of submenus). Entries that delete or
// discard something are held, not clicked (hold.slint, user decision Q-Q4). A click outside, a right click outside or
// Escape closes it.

import { Theme } from "styles.slint";
import { AppIcon, IconId, IconSize } from "icons.slint";
import { GlobalTooltip, TooltipHost } from "tooltip.slint";
import { HoldConfirm, HoldLogic, HoldRing } from "hold.slint";

export struct MenuItemView {
    id: string,
    title: string,
    icon: IconId,
    // 0 action, 1 separator, 2 submenu
    kind: int,
    enabled: bool,
    hold: bool,
    tooltip: string,
    shortcut: string,
    // The submenu's level (an index into `ContextMenu.levels`), -1 for other rows.
    level: int,
}

export struct MenuLevelView {
    items: [MenuItemView],
}

export global ContextMenu {
    in property <bool> open;
    // Where it was asked for, in window coordinates.
    in property <length> x;
    in property <length> y;
    in property <[MenuItemView]> items;
    in property <[MenuLevelView]> levels;
    callback activated(/* id */ string);
    callback dismissed();
}

component MenuRow inherits Rectangle {
    in property <MenuItemView> item;
    in property <bool> active;
    callback activated();
    callback hovered();

    property <bool> usable: root.item.enabled && root.item.kind != 1;
    property <color> text-color: !root.item.enabled ? Theme.status-deleted
        : logic.progress > 0 ? HoldConfirm.color.mix(Theme.text, logic.progress)
        : Theme.text;

    height: root.item.kind == 1 ? 7px : 28px;
    border-radius: 4px;
    clip: true;
    background: root.usable && (touch.has-hover || root.active) ? Theme.surface-hover : transparent;

    host := TooltipHost {
        text: root.item.tooltip;
        shortcut: "";
    }

    logic := HoldLogic {
        pressed: touch.pressed;
        enabled: root.usable && root.item.kind == 0;
        hold: root.item.hold;
        confirmed => { root.activated(); }
        short-click => {
            GlobalTooltip.show(root.item.tooltip, "", root.absolute-position.x + 24px,
                root.absolute-position.y + root.height + 2px);
        }
    }

    if root.item.hold: HoldRing {
        progress: logic.progress;
        flash: logic.flash;
        ring: false;
    }

    if root.item.kind == 1: Rectangle {
        y: 3px;
        height: 1px;
        background: Theme.border;
    }

    // The menu is as wide as its widest row.
    min-width: content.preferred-width;

    content := HorizontalLayout {
        visible: root.item.kind != 1;
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;

        Rectangle {
            width: 16px;

            if root.item.icon != IconId.none: AppIcon {
                x: (parent.width - self.width) / 2 + logic.nudge;
                y: (parent.height - self.height) / 2;
                icon: root.item.icon;
                size: IconSize.sm;
                color: root.text-color;
            }
        }

        Text {
            horizontal-stretch: 1;
            text: root.item.title;
            color: root.text-color;
            font-size: 12px;
            vertical-alignment: center;
        }

        if root.item.shortcut != "": Text {
            horizontal-stretch: 0;
            text: root.item.shortcut;
            color: Theme.text-muted;
            font-size: 11px;
            vertical-alignment: center;
        }

        if root.item.kind == 2: Rectangle {
            width: 12px;

            AppIcon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                icon: IconId.chevron-right;
                size: IconSize.sm;
                color: root.item.enabled ? Theme.text-muted : Theme.status-deleted;
            }
        }
    }

    touch := TouchArea {
        enabled: root.item.kind != 1;
        mouse-cursor: root.usable ? MouseCursor.pointer : MouseCursor.default;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                host.leave();
                logic.pressed-down();
            }
        }
        clicked => {
            if root.item.kind == 2 {
                root.hovered();
            } else {
                logic.released-click();
            }
        }
        changed has-hover => {
            if self.has-hover {
                host.enter();
                root.hovered();
            } else {
                host.leave();
            }
        }
    }
}

component MenuPanel inherits Rectangle {
    in property <[MenuItemView]> items;
    // The row whose submenu is open (-1 none).
    in property <int> active-row: -1;
    callback row-hovered(/* row */ int, /* level */ int, /* y of the row */ length);

    width: Math.clamp(list.preferred-width, 180px, 380px);
    height: list.preferred-height;
    background: Theme.surface-variant;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.border;
    drop-shadow-blur: 12px;
    drop-shadow-color: #00000080;

    // Clicks between the rows stay inside the menu.
    TouchArea { }

    list := VerticalLayout {
        padding: 4px;
        spacing: 0px;

        for item[i] in root.items: MenuRow {
            item: item;
            active: i == root.active-row;
            hovered => { root.row-hovered(i, item.kind == 2 && item.enabled ? item.level : -1, self.y); }
            activated => { ContextMenu.activated(item.id); }
        }
    }
}

/// The open menu over the whole window.
export component ContextMenuLayer inherits Rectangle {
    property <int> level: -1;
    property <int> level-row: -1;
    property <length> level-y;

    visible: ContextMenu.open;

    changed visible => {
        root.level = -1;
        root.level-row = -1;
        if self.visible {
            GlobalTooltip.hide();
            keys.focus();
        }
    }

    // A click or a right click outside the menu closes it.
    TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                ContextMenu.dismissed();
            }
        }
    }

    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                ContextMenu.dismissed();
                return accept;
            }
            accept
        }
    }

    top := MenuPanel {
        x: Math.max(0px, Math.min(ContextMenu.x, root.width - self.width - 4px));
        y: Math.max(0px, Math.min(ContextMenu.y, root.height - self.height - 4px));
        items: ContextMenu.items;
        active-row: root.level-row;
        row-hovered(row, level, y) => {
            root.level = level;
            root.level-row = level >= 0 ? row : -1;
            root.level-y = y;
        }
    }

    if root.level >= 0: MenuPanel {
        // Beside the top level, on the right unless there is no room (then on the left).
        x: top.x + top.width + self.width + 2px <= root.width ? top.x + top.width - 2px : Math.max(0px, top.x - self.width + 2px);
        y: Math.max(0px, Math.min(top.y + root.level-y, root.height - self.height - 4px));
        items: ContextMenu.levels[root.level].items;
    }
}
