// RustCut's context menu (src/ui/menu/ fills `ContextMenu`): one menu at a time over the whole window, in RustView's
// style (28 px rows with an icon slot, separators, headings, a muted shortcut, a check mark on the right, one level of
// submenus). Entries that delete or discard something are held, not clicked (hold.slint, user decision Q-Q4). A menu
// that belongs to a button hangs from it with an arrow like a flyout (P9.6, the "when done" menu). A click outside, a
// right click outside or Escape closes it. Positions come in window coordinates; the layer starts below the menu bar.

import { Theme } from "styles.slint";
import { AppIcon, IconId, IconSize } from "icons.slint";
import { GlobalTooltip, TipSide, TooltipHost } from "tooltip.slint";
import { HoldConfirm, HoldLogic, HoldRing } from "hold.slint";
import { TipArrow } from "tooltip_layer.slint";
import { FlyoutLogic } from "flyout.slint";

export struct MenuItemView {
    id: string,
    title: string,
    icon: IconId,
    // 0 action, 1 separator, 2 submenu, 3 heading
    kind: int,
    enabled: bool,
    hold: bool,
    tooltip: string,
    shortcut: string,
    // The submenu's level (an index into `ContextMenu.levels`), -1 for other rows.
    level: int,
    // The icon's color (`MenuTints`; 0 = the text's).
    tint: int,
    // A check mark on the right (the chosen entry).
    checked: bool,
}

/// Colors for icons that say how far an entry goes: 1 green, 2 yellow, 3 orange, 4 red (the "when done" menu, P9.6).
export global MenuTints {
    pure public function of(tint: int) -> color {
        if tint == 1 { return Theme.status-ok; }
        if tint == 2 { return Theme.accent; }
        if tint == 3 { return Theme.status-warn; }
        if tint == 4 { return Theme.status-corrupt; }
        return Theme.text;
    }
}

export struct MenuLevelView {
    items: [MenuItemView],
}

export global ContextMenu {
    in property <bool> open;
    // Where it was asked for, in window coordinates.
    in property <length> x;
    in property <length> y;
    // A menu of a button hangs from it (window coordinates of the button).
    in property <bool> anchored;
    in property <length> anchor-x;
    in property <length> anchor-y;
    in property <length> anchor-width;
    in property <length> anchor-height;
    in property <[MenuItemView]> items;
    in property <[MenuLevelView]> levels;
    callback activated(/* id */ string);
    callback dismissed();
}

component MenuRow inherits Rectangle {
    in property <MenuItemView> item;
    in property <bool> active;
    callback activated();
    callback hovered();

    property <bool> usable: root.item.enabled && root.item.kind != 1;
    property <color> text-color: !root.item.enabled ? Theme.status-deleted
        : logic.progress > 0 ? HoldConfirm.color.mix(Theme.text, logic.progress)
        : Theme.text;

    height: root.item.kind == 1 ? 7px : root.item.kind == 3 ? 24px : 28px;
    border-radius: 4px;
    clip: true;
    background: root.usable && (touch.has-hover || root.active) ? Theme.surface-hover : transparent;

    host := TooltipHost {
        text: root.item.tooltip;
        hold: root.item.hold && root.usable;
        beside: true;
    }

    // A completed hold acts on the release: the menu closes then, so the release never lands on a hidden menu (the next
    // click was lost, P9.12).
    property <bool> pending;

    logic := HoldLogic {
        pressed: touch.pressed;
        enabled: root.usable && root.item.kind == 0;
        hold: root.item.hold;
        confirmed => {
            if touch.pressed {
                root.pending = true;
            } else {
                root.activated();
            }
        }
        short-click => {
            host.reveal();
        }
    }

    if root.item.hold: HoldRing {
        progress: logic.progress;
        flash: logic.flash;
        ring: false;
    }

    if root.item.kind == 1: Rectangle {
        y: 3px;
        height: 1px;
        background: Theme.border;
    }

    // The menu is as wide as its widest row.
    min-width: content.preferred-width;

    if root.item.kind == 3: Text {
        x: 8px;
        width: parent.width - 16px;
        height: parent.height;
        text: root.item.title;
        color: Theme.text-muted;
        font-size: 11px;
        font-weight: 600;
        vertical-alignment: center;
    }

    content := HorizontalLayout {
        visible: root.item.kind != 1 && root.item.kind != 3;
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;

        Rectangle {
            width: 16px;

            if root.item.icon != IconId.none: AppIcon {
                x: (parent.width - self.width) / 2 + logic.nudge;
                y: (parent.height - self.height) / 2;
                icon: root.item.icon;
                size: IconSize.sm;
                color: root.item.tint != 0 && root.item.enabled ? MenuTints.of(root.item.tint) : root.text-color;
            }
        }

        Text {
            horizontal-stretch: 1;
            text: root.item.title;
            color: root.text-color;
            font-size: 12px;
            vertical-alignment: center;
        }

        if root.item.shortcut != "": Text {
            horizontal-stretch: 0;
            text: root.item.shortcut;
            color: Theme.text-muted;
            font-size: 11px;
            vertical-alignment: center;
        }

        if root.item.checked: Rectangle {
            width: 16px;

            AppIcon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                icon: IconId.check;
                size: IconSize.sm;
                color: Theme.primary;
            }
        }

        if root.item.kind == 2: Rectangle {
            width: 12px;

            AppIcon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                icon: IconId.chevron-right;
                size: IconSize.sm;
                color: root.item.enabled ? Theme.text-muted : Theme.status-deleted;
            }
        }
    }

    touch := TouchArea {
        enabled: root.item.kind != 1 && root.item.kind != 3;
        mouse-cursor: root.usable ? MouseCursor.pointer : MouseCursor.default;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.pending = false;
                host.press();
                logic.pressed-down();
            } else if event.kind == PointerEventKind.up && root.pending {
                root.pending = false;
                root.activated();
            }
        }
        clicked => {
            if root.item.kind == 2 {
                root.hovered();
            } else {
                logic.released-click();
            }
        }
        changed has-hover => {
            if self.has-hover {
                host.enter();
                root.hovered();
            } else {
                host.leave();
            }
        }
    }
}

export component MenuPanel inherits Rectangle {
    in property <[MenuItemView]> items;
    // The row whose submenu is open (-1 none).
    in property <int> active-row: -1;
    // The row the keys stand on (the menu bar's menus, P9.12; -1 none).
    in property <int> key-row: -1;
    // Hangs from a menu bar title as one piece with it (Q-P9.12): no border, the top left corner square.
    in property <bool> attached;
    // An arrow to the button it belongs to, above the panel (`arrow-below`) or under it, at `arrow-at` along the edge.
    in property <bool> arrow;
    in property <bool> arrow-below;
    in property <length> arrow-at;
    callback row-hovered(/* row */ int, /* level */ int, /* y of the row */ length);
    callback activated(/* id */ string);

    width: Math.clamp(list.preferred-width, 180px, 380px);
    height: list.preferred-height;
    background: Theme.surface-variant;
    border-radius: 6px;
    border-top-left-radius: root.attached ? 0px : 6px;
    border-width: root.attached ? 0px : 1px;
    border-color: Theme.border;

    // Clicks between the rows stay inside the menu.
    TouchArea { }

    list := VerticalLayout {
        padding: 4px;
        spacing: 0px;

        for item[i] in root.items: MenuRow {
            item: item;
            active: i == root.active-row || i == root.key-row;
            hovered => { root.row-hovered(i, item.kind == 2 && item.enabled ? item.level : -1, self.y); }
            activated => { root.activated(item.id); }
        }
    }

    if root.arrow: TipArrow {
        side: root.arrow-below ? TipSide.below : TipSide.above;
        arrow: root.arrow-at;
        fill: Theme.surface-variant;
        stroke: Theme.border;
        bubble-width: root.width;
        bubble-height: root.height;
    }
}

/// The open menu over the whole window.
export component ContextMenuLayer inherits Rectangle {
    property <int> level: -1;
    property <int> level-row: -1;
    property <length> level-y;

    visible: ContextMenu.open;

    changed visible => {
        root.level = -1;
        root.level-row = -1;
        if self.visible {
            GlobalTooltip.hide-cold();
            keys.focus();
        }
    }

    // A click or a right click outside the menu closes it.
    TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                ContextMenu.dismissed();
            }
        }
    }

    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                ContextMenu.dismissed();
                return accept;
            }
            accept
        }
    }

    // The button's place in the layer (the layer starts below the menu bar).
    property <length> anchor-x: ContextMenu.anchor-x - root.absolute-position.x;
    property <length> anchor-y: ContextMenu.anchor-y - root.absolute-position.y;
    property <bool> below: FlyoutLogic.below(root.anchor-y, ContextMenu.anchor-height, top.height, root.height);

    top := MenuPanel {
        x: ContextMenu.anchored ? FlyoutLogic.left(root.anchor-x, ContextMenu.anchor-width, self.width, root.width)
            : Math.max(0px, Math.min(ContextMenu.x - root.absolute-position.x, root.width - self.width - 4px));
        y: ContextMenu.anchored ? FlyoutLogic.top(root.below, root.anchor-y, ContextMenu.anchor-height, self.height)
            : Math.max(0px, Math.min(ContextMenu.y - root.absolute-position.y, root.height - self.height - 4px));
        arrow: ContextMenu.anchored;
        arrow-below: root.below;
        arrow-at: root.anchor-x + ContextMenu.anchor-width / 2 - self.x;
        items: ContextMenu.items;
        active-row: root.level-row;
        activated(id) => { ContextMenu.activated(id); }
        row-hovered(row, level, y) => {
            root.level = level;
            root.level-row = level >= 0 ? row : -1;
            root.level-y = y;
        }
    }

    if root.level >= 0: MenuPanel {
        // Beside the top level, on the right unless there is no room (then on the left).
        x: top.x + top.width + self.width + 2px <= root.width ? top.x + top.width - 2px : Math.max(0px, top.x - self.width + 2px);
        y: Math.max(0px, Math.min(top.y + root.level-y, root.height - self.height - 4px));
        items: ContextMenu.levels[root.level].items;
        activated(id) => { ContextMenu.activated(id); }
    }
}
