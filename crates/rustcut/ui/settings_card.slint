// Copy of RustView's crates/rustview/ui/settings_card.slint (only the header differs).

import { Theme } from "styles.slint";

/// Reusable grouped card container for setting configurations.
export component SettingsCard inherits Rectangle {
    in property <string> title: "";
    in property <string> description: "";

    background: Theme.surface;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.border;

    VerticalLayout {
        padding: 12px;
        spacing: 10px;

        // The title and the description start where the rows' labels start (a row pads 8px for its hover), so every
        // text of a card has one left edge, also on wrapped lines.
        if root.title != "" : HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;

            Text {
                text: root.title;
                font-weight: 700;
                color: Theme.primary;
            }
        }

        if root.description != "" : HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;

            Text {
                height: measure.preferred-height;
                text: root.description;
                font-size: 11px;
                color: Theme.text-muted;
                wrap: word-wrap;
            }
        }

        @children
    }

    // The description's height at the card's width: a wrapped text's preferred height inside a layout can follow an
    // older width, and the Target Folders card came out a line too short (its rows hung out at the bottom).
    measure := Text {
        visible: false;
        x: 0;
        y: 0;
        width: root.width - 2 * 12px - 2 * 8px;
        text: root.description;
        font-size: 11px;
        wrap: word-wrap;
    }
}
