// The video area: mpv's frame as an image (rustcut-player renders it at exactly this element's size), the crop being
// edited (handles, or the nearest edge in the quick crop, F4; the pointer goes to src/ui/filters/), the play and pause
// symbols (P9.9), the empty state, the non-modal error overlay with Reload (click or F5), and the hint while a file is
// dragged over the window. The mouse wheel changes the volume (its bar shows near the bottom, player_feedback.slint).
// A pointer that rests over the video hides (P12 5.2), unless it is needed.

import { FolderWheel } from "folder_wheel.slint";
import { Theme } from "styles.slint";
import { AppIcon, IconId, IconSize } from "icons.slint";
import { Playback } from "player_types.slint";
import { Filters } from "filters_types.slint";
import { Shortcuts } from "shortcuts.slint";
import { CropCursor, CropOverlay, CropOverlayView, CropPills } from "crop_overlay.slint";
import { VolumeFeedback } from "player_feedback.slint";

/// The symbol of a key over the video (user decision Q-P9.9): a dark translucent disc with the white symbol. One look
/// for every key's feedback (user request 2026-10-27): play or pause, the speaker of the mute key (crossed out when
/// muted), a rating's digit in its color (`Playback.flash-kind` codes).
component PlaySymbol inherits Rectangle {
    in property <bool> play;
    in property <int> kind;
    in property <int> rating;
    in property <string> text;

    width: 72px;
    height: 72px;
    border-radius: 36px;
    background: #11111b99;

    if root.kind <= 2: AppIcon {
        x: (parent.width - self.width) / 2 + (root.kind == 0 && root.play ? 2px : 0px);
        y: (parent.height - self.height) / 2;
        icon: root.kind == 1 ? IconId.volume : root.kind == 2 ? IconId.volume-off : root.play ? IconId.play : IconId.pause;
        size: 36px;
        color: #ffffff;
    }

    // The normalization's key: the wave with the kind's name.
    if root.kind == 4: VerticalLayout {
        alignment: center;
        spacing: 2px;

        HorizontalLayout {
            alignment: center;
            AppIcon {
                icon: IconId.audio-normalize;
                size: 28px;
                color: #ffffff;
            }
        }

        Text {
            text: root.text;
            color: #ffffff;
            font-size: 10px;
            horizontal-alignment: center;
        }
    }

    if root.kind == 3: Rectangle {
        width: 46px;
        height: 46px;
        border-radius: 23px;
        border-width: 3px;
        border-color: Theme.rating-color(root.rating);

        Text {
            text: root.rating;
            color: Theme.rating-color(root.rating);
            font-size: 26px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

export component PlayerView inherits Rectangle {
    in property <image> frame;

    background: Theme.fullscreen-background;
    clip: true;

    Image {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        source: root.frame;
        image-fit: fill;
        visible: Playback.has-video;
    }

    changed width => { CropOverlay.resized(self.width, self.height); }
    changed height => { CropOverlay.resized(self.width, self.height); }
    init => { CropOverlay.resized(self.width, self.height); }

    if CropOverlay.active && Playback.has-video: CropOverlayView {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
    }

    // The pointer rests when it has not moved for the set time, over a video, with nothing that needs it: not while the
    // crop is edited or the pipette waits, not during a press. Menus and dialogs lie over this area, so it has no hover.
    property <bool> resting;
    property <bool> may-rest: Playback.hide-pointer && Playback.has-video && area.has-hover && !area.pressed
        && !CropOverlay.active && !Filters.picking && !FolderWheel.tracking;

    // `restart()` alone does nothing on a stopped timer, so the timer runs whenever the pointer may rest.
    rest-timer := Timer {
        interval: Playback.hide-pointer-ms * 1ms;
        running: root.may-rest && !root.resting;
        triggered => { root.resting = true; }
    }

    function pointer-active() {
        root.resting = false;
        rest-timer.restart();
    }

    changed may-rest => {
        if !self.may-rest {
            root.resting = false;
        }
    }

    changed resting => {
        Playback.pointer-rest-changed(self.absolute-position.x + area.mouse-x, self.absolute-position.y + area.mouse-y);
    }

    area := TouchArea {
        // Where the pointer last was: a repeated event (Rust, `pointer-rest-changed`) does not count as movement.
        property <length> last-x;
        property <length> last-y;

        mouse-cursor: FolderWheel.hide-pointer || root.resting ? MouseCursor.none : CropOverlay.active ? CropCursor.of(CropOverlay.handle, CropOverlay.quick) : MouseCursor.default;

        pointer-event(event) => {
            if event.kind != PointerEventKind.move || self.mouse-x != self.last-x || self.mouse-y != self.last-y {
                self.last-x = self.mouse-x;
                self.last-y = self.mouse-y;
                root.pointer-active();
            }
            if event.kind == PointerEventKind.down {
                Shortcuts.release-focus();
            }
            if !Playback.has-video {
                return;
            }
            // The folder wheel: holding the middle button (P11.5); its pointer is relative to the video's center.
            if event.button == PointerEventButton.middle && event.kind == PointerEventKind.down {
                FolderWheel.pressed(self.mouse-x - self.width / 2 - FolderWheel.shift-x, self.mouse-y - self.height / 2 - FolderWheel.shift-y);
                return;
            }
            if event.button == PointerEventButton.middle && event.kind == PointerEventKind.up {
                FolderWheel.released();
                return;
            }
            if event.kind == PointerEventKind.move && FolderWheel.tracking {
                FolderWheel.moved(self.mouse-x - self.width / 2 - FolderWheel.shift-x, self.mouse-y - self.height / 2 - FolderWheel.shift-y);
                return;
            }
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                CropOverlay.pointer(0, self.mouse-x, self.mouse-y, event.modifiers.control, event.modifiers.shift);
            } else if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                CropOverlay.pointer(1, self.mouse-x, self.mouse-y, event.modifiers.control, event.modifiers.shift);
            } else if event.kind == PointerEventKind.move {
                CropOverlay.pointer(2, self.mouse-x, self.mouse-y, event.modifiers.control, event.modifiers.shift);
            }
        }

        double-clicked => {
            if Playback.has-video && CropOverlay.active {
                CropOverlay.double-clicked(self.mouse-x, self.mouse-y);
            }
        }

        changed has-hover => {
            if !self.has-hover {
                CropOverlay.left();
            }
        }

        scroll-event(event) => {
            if event.delta-y == 0 {
                return reject;
            }
            root.pointer-active();
            Playback.wheel(event.delta-y);
            accept
        }
    }

    // The crop's size and ratio button lie over the pointer area (the button takes its own clicks).
    if CropOverlay.active && Playback.has-video: CropPills {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
    }

    // While paused a faint pause symbol stays in the middle (setting, Q-P9.9: 40 %); not after a frame step and not at
    // the end (user review 2026-10-27).
    // A key's symbol (play/pause, mute, rating) takes its place while it shows; afterwards it is back while the video is
    // still paused (user request 2026-10-27).
    if Playback.has-video && Playback.pause-symbol && Playback.keep-pause-symbol
        && !(flash.phase == 1 || flash.opacity > 0): PlaySymbol {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        play: false;
        opacity: 0.4;
    }

    // A key played or paused the video, muted it or gave a rating: the symbol fades in (0.1 s), stands (0.2 s) and
    // fades out (0.3 s); a new one replaces it at once (Q-P9.9).
    flash := PlaySymbol {
        // 0 = hidden, 1 = fading in and standing, 2 = fading out.
        property <int> phase;

        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        play: Playback.flash-play;
        kind: Playback.flash-kind;
        rating: Playback.flash-rating;
        text: Playback.flash-text;
        visible: self.phase != 0 || self.opacity > 0;
        opacity: self.phase == 1 ? 1 : 0;

        animate opacity {
            duration: self.phase == 1 ? 100ms : 300ms;
            easing: ease-out;
        }

        stand := Timer {
            interval: 300ms;
            running: false;
            triggered => {
                self.running = false;
                flash.phase = 2;
            }
        }
    }

    // The wheel's volume bar (RustView's feedback, user request 2026-10-27).
    if Playback.has-video: VolumeFeedback {
        area-width: parent.width;
        area-height: parent.height;
    }

    property <int> flash-serial: Playback.flash-serial;
    changed flash-serial => {
        flash.phase = 1;
        // `restart()` alone does nothing on a stopped timer: start it, then time it from now.
        stand.running = true;
        stand.restart();
    }

    // No video open: the colorless symbol (96 px, 12 %) and the hint on two lines (Q-P9.9).
    if !Playback.has-file: VerticalLayout {
        alignment: center;
        spacing: 8px;

        HorizontalLayout {
            alignment: center;

            Image {
                width: 96px;
                height: 96px;
                source: @image-url("../assets/app/empty-player.png");
                opacity: 0.12;
            }
        }

        VerticalLayout {
            spacing: 2px;

            Text {
                text: Shortcuts.open != "" ? "Open a video with File > Open (" + Shortcuts.open + ")" : "Open a video with File > Open";
                color: Theme.text-muted;
                horizontal-alignment: center;
            }

            Text {
                text: "or drop it here.";
                color: Theme.text-muted;
                horizontal-alignment: center;
            }
        }
    }

    // A file that does not play: the banner over the video says why (with Reload and the log, M6.5); here the
    // video area keeps the big way back (a click or F5).
    if Playback.error-title != "": Rectangle {
        background: #11111be6;

        TouchArea {
            mouse-cursor: pointer;
            clicked => { Playback.reload(); }
        }

        VerticalLayout {
            alignment: center;
            spacing: 10px;
            padding: 24px;

            HorizontalLayout {
                alignment: center;
                AppIcon {
                    icon: IconId.status-error;
                    size: IconSize.xxl;
                    color: Theme.status-corrupt;
                }
            }

            HorizontalLayout {
                alignment: center;

                reload := Rectangle {
                    width: reload-row.preferred-width + 24px;
                    height: 30px;
                    border-radius: 4px;
                    background: reload-touch.pressed ? Theme.surface-selected
                        : reload-touch.has-hover ? Theme.surface-hover : Theme.surface-variant;
                    border-width: 1px;
                    border-color: Theme.border;

                    reload-touch := TouchArea {
                        clicked => { Playback.reload(); }
                    }

                    reload-row := HorizontalLayout {
                        alignment: center;
                        spacing: 6px;

                        VerticalLayout {
                            alignment: center;
                            AppIcon {
                                icon: IconId.reload;
                                size: IconSize.md;
                            }
                        }

                        Text {
                            text: "Reload (F5)";
                            color: Theme.text;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

    if Playback.drop-hover: Rectangle {
        background: #11111bcc;

        Rectangle {
            x: 12px;
            y: 12px;
            width: parent.width - 24px;
            height: parent.height - 24px;
            border-radius: 8px;
            border-width: 2px;
            border-color: Theme.primary;
        }

        VerticalLayout {
            alignment: center;
            spacing: 8px;

            HorizontalLayout {
                alignment: center;
                AppIcon {
                    icon: IconId.drop-file;
                    size: IconSize.xxl;
                    color: Theme.primary;
                }
            }

            Text {
                text: "Drop to open";
                color: Theme.text;
                font-size: 16px;
                font-weight: 600;
                horizontal-alignment: center;
            }

            if Playback.drop-count > 1: Text {
                text: "Only the first of the " + Playback.drop-count + " files is opened.";
                color: Theme.text-muted;
                horizontal-alignment: center;
            }
        }
    }
}
