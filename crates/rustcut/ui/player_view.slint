// The video area: mpv's frame as an image (rustcut-player renders it at exactly this element's size), the crop being
// edited (handles, or the nearest edge while Ctrl is held; the pointer goes to src/ui/filters/), the play and pause
// symbols (P9.9), the empty state, the non-modal error overlay with Reload (click or F5), and the hint while a file is
// dragged over the window. The mouse wheel changes the volume.

import { Theme } from "styles.slint";
import { AppIcon, IconId, IconSize } from "icons.slint";
import { Playback } from "player_types.slint";
import { Shortcuts } from "shortcuts.slint";
import { CropCursor, CropOverlay, CropOverlayView, CropPills } from "crop_overlay.slint";

/// The play or pause symbol over the video (user decision Q-P9.9): a dark translucent disc with the white symbol.
component PlaySymbol inherits Rectangle {
    in property <bool> play;

    width: 72px;
    height: 72px;
    border-radius: 36px;
    background: #11111b99;

    AppIcon {
        x: (parent.width - self.width) / 2 + (root.play ? 2px : 0px);
        y: (parent.height - self.height) / 2;
        icon: root.play ? IconId.play : IconId.pause;
        size: 36px;
        color: #ffffff;
    }
}

export component PlayerView inherits Rectangle {
    in property <image> frame;

    background: Theme.fullscreen-background;
    clip: true;

    Image {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        source: root.frame;
        image-fit: fill;
        visible: Playback.has-video;
    }

    changed width => { CropOverlay.resized(self.width, self.height); }
    changed height => { CropOverlay.resized(self.width, self.height); }
    init => { CropOverlay.resized(self.width, self.height); }

    if CropOverlay.active && Playback.has-video: CropOverlayView {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
    }

    TouchArea {
        mouse-cursor: CropOverlay.active ? CropCursor.of(CropOverlay.handle, CropOverlay.quick) : MouseCursor.default;

        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                Shortcuts.release-focus();
            }
            if !Playback.has-video {
                return;
            }
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                CropOverlay.pointer(0, self.mouse-x, self.mouse-y, event.modifiers.control, event.modifiers.shift);
            } else if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                CropOverlay.pointer(1, self.mouse-x, self.mouse-y, event.modifiers.control, event.modifiers.shift);
            } else if event.kind == PointerEventKind.move {
                CropOverlay.pointer(2, self.mouse-x, self.mouse-y, event.modifiers.control, event.modifiers.shift);
            }
        }

        double-clicked => {
            if Playback.has-video && CropOverlay.active {
                CropOverlay.double-clicked(self.mouse-x, self.mouse-y);
            }
        }

        changed has-hover => {
            if !self.has-hover {
                CropOverlay.left();
            }
        }

        scroll-event(event) => {
            if event.delta-y == 0 {
                return reject;
            }
            Playback.wheel(event.delta-y);
            accept
        }
    }

    // The crop's size and ratio button lie over the pointer area (the button takes its own clicks).
    if CropOverlay.active && Playback.has-video: CropPills {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
    }

    // While paused a faint pause symbol stays in the middle (setting, Q-P9.9: 40 %).
    if Playback.has-video && Playback.paused && Playback.keep-pause-symbol: PlaySymbol {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        play: false;
        opacity: 0.4;
    }

    // A key played or paused the video: the symbol fades in (0.1 s), stands (0.2 s) and fades out (0.3 s); a new one
    // replaces it at once (Q-P9.9).
    flash := PlaySymbol {
        // 0 = hidden, 1 = fading in and standing, 2 = fading out.
        property <int> phase;

        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        play: Playback.flash-play;
        visible: self.phase != 0 || self.opacity > 0;
        opacity: self.phase == 1 ? 1 : 0;

        animate opacity {
            duration: self.phase == 1 ? 100ms : 300ms;
            easing: ease-out;
        }

        stand := Timer {
            interval: 300ms;
            running: false;
            triggered => {
                self.running = false;
                flash.phase = 2;
            }
        }
    }

    property <int> flash-serial: Playback.flash-serial;
    changed flash-serial => {
        flash.phase = 1;
        // `restart()` alone does nothing on a stopped timer: start it, then time it from now.
        stand.running = true;
        stand.restart();
    }

    // No video open: the colorless symbol (96 px, 12 %) and the hint on two lines (Q-P9.9).
    if !Playback.has-file: VerticalLayout {
        alignment: center;
        spacing: 8px;

        HorizontalLayout {
            alignment: center;

            Image {
                width: 96px;
                height: 96px;
                source: @image-url("../assets/app/empty-player.png");
                opacity: 0.12;
            }
        }

        VerticalLayout {
            spacing: 2px;

            Text {
                text: Shortcuts.open != "" ? "Open a video with File > Open (" + Shortcuts.open + ")" : "Open a video with File > Open";
                color: Theme.text-muted;
                horizontal-alignment: center;
            }

            Text {
                text: "or drop it here.";
                color: Theme.text-muted;
                horizontal-alignment: center;
            }
        }
    }

    // A file that does not play: the banner over the video says why (with Reload and the log, M6.5); here the
    // video area keeps the big way back (a click or F5).
    if Playback.error-title != "": Rectangle {
        background: #11111be6;

        TouchArea {
            mouse-cursor: pointer;
            clicked => { Playback.reload(); }
        }

        VerticalLayout {
            alignment: center;
            spacing: 10px;
            padding: 24px;

            HorizontalLayout {
                alignment: center;
                AppIcon {
                    icon: IconId.status-error;
                    size: IconSize.xxl;
                    color: Theme.status-corrupt;
                }
            }

            HorizontalLayout {
                alignment: center;

                reload := Rectangle {
                    width: reload-row.preferred-width + 24px;
                    height: 30px;
                    border-radius: 4px;
                    background: reload-touch.pressed ? Theme.surface-selected
                        : reload-touch.has-hover ? Theme.surface-hover : Theme.surface-variant;
                    border-width: 1px;
                    border-color: Theme.border;

                    reload-touch := TouchArea {
                        clicked => { Playback.reload(); }
                    }

                    reload-row := HorizontalLayout {
                        alignment: center;
                        spacing: 6px;

                        VerticalLayout {
                            alignment: center;
                            AppIcon {
                                icon: IconId.reload;
                                size: IconSize.md;
                            }
                        }

                        Text {
                            text: "Reload (F5)";
                            color: Theme.text;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

    if Playback.drop-hover: Rectangle {
        background: #11111bcc;

        Rectangle {
            x: 12px;
            y: 12px;
            width: parent.width - 24px;
            height: parent.height - 24px;
            border-radius: 8px;
            border-width: 2px;
            border-color: Theme.primary;
        }

        VerticalLayout {
            alignment: center;
            spacing: 8px;

            HorizontalLayout {
                alignment: center;
                AppIcon {
                    icon: IconId.drop-file;
                    size: IconSize.xxl;
                    color: Theme.primary;
                }
            }

            Text {
                text: "Drop to open";
                color: Theme.text;
                font-size: 16px;
                font-weight: 600;
                horizontal-alignment: center;
            }

            if Playback.drop-count > 1: Text {
                text: "Only the first of the " + Playback.drop-count + " files is opened.";
                color: Theme.text-muted;
                horizontal-alignment: center;
            }
        }
    }
}
