// Small controls shared by the panels: icon buttons with tooltips (icons only; a very short text only where a symbol
// cannot say it, user rule 2026-10-23), field icons and a switch. The number field, the choices, the up/down button and
// the middle-cut text live in their own `controls_*.slint` files and are exported from here too (P9.1).

import { Theme } from "styles.slint";
import { AppIcon, IconId, IconSize } from "icons.slint";
import { TooltipHost } from "tooltip.slint";
import { HoldConfirm, HoldLogic, HoldRing } from "hold.slint";

export { NumberField } from "controls_number.slint";
export { ChoiceButton, MultiChoiceButton, MultiChoiceItem, SegmentedChoice } from "controls_choice.slint";
export { UpDownButton } from "controls_updown.slint";
export { MiddleText, TextLogic, TextSplit } from "controls_text.slint";
export { ControlMetrics } from "controls_base.slint";
export { ListWell } from "controls_list_well.slint";
export { TextLine } from "controls_text_line.slint";

/// A button showing an icon (or a very short text), explained by its tooltip. `checked` draws it pressed in. With
/// `hold` it deletes or discards something and acts only when held (hold.slint, user decision Q-Q4); its tooltip says so.
export component IconButton inherits Rectangle {
    in property <IconId> icon: IconId.none;
    in property <string> text;
    in property <string> tooltip;
    in property <string> shortcut;
    in property <bool> enabled: true;
    in property <bool> checked;
    in property <bool> hold;
    // A switch that is off although it is normally on (the Tag & Rate panel's "Active" and "Warn", user decision
    // Q-P8): red until it is switched on again.
    in property <bool> alert;
    in property <length> icon-size: IconSize.md;
    // The symbol pulses: something runs behind the button (P12 4.1), also while it is disabled.
    in property <bool> pulse;
    // A short glow in `flash-color`: true shows it, false fades it out (a result, P12 4.1).
    in property <bool> flash;
    in property <color> flash-color;
    // Ctrl was held at the last right click (read it in `secondary-clicked`).
    out property <bool> secondary-control;
    callback clicked();
    // A right click (the queue's filter and "when done" buttons reset with it).
    callback secondary-clicked();

    property <color> content-color: root.pulse ? Theme.primary
        : !root.enabled ? Theme.status-deleted
        : logic.progress > 0 ? HoldConfirm.color.mix(Theme.text, logic.progress)
        : root.alert ? Theme.status-corrupt
        : root.checked ? Theme.primary : Theme.text;

    height: 24px;
    width: root.text == "" ? 26px : Math.max(26px, label.preferred-width + 12px);
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 4px;
    background: !root.enabled ? transparent
        : root.alert ? Theme.status-corrupt.with-alpha(touch.has-hover ? 0.3 : 0.18)
        : root.checked ? Theme.primary.with-alpha(0.22)
        : touch.pressed ? Theme.surface-selected : touch.has-hover ? Theme.surface-hover : Theme.surface;
    border-width: 1px;
    border-color: root.alert && root.enabled ? Theme.status-corrupt
        : root.checked && root.enabled ? Theme.primary : Theme.border;
    clip: root.hold;

    host := TooltipHost {
        text: root.tooltip;
        shortcut: root.shortcut;
        hold: root.hold && root.enabled;
    }

    logic := HoldLogic {
        pressed: touch.pressed;
        enabled: root.enabled;
        hold: root.hold;
        confirmed => { root.clicked(); }
        short-click => {
            host.reveal();
        }
    }

    Rectangle {
        border-radius: root.border-radius;
        background: root.flash-color.with-alpha(0.4);
        border-width: 1px;
        border-color: root.flash-color;
        opacity: root.flash ? 1 : 0;
        animate opacity { duration: root.flash ? 0ms : 900ms; }
    }

    if root.hold: HoldRing {
        progress: logic.progress;
        flash: logic.flash;
        border-radius: root.border-radius;
    }

    // Enabled even when the button is not, so a disabled button still explains itself.
    touch := TouchArea {
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                host.press();
                if root.enabled {
                    root.secondary-control = event.modifiers.control;
                    root.secondary-clicked();
                }
            } else if event.kind == PointerEventKind.down {
                host.press();
                logic.pressed-down();
            }
        }
        clicked => {
            logic.released-click();
        }
        changed has-hover => {
            if self.has-hover {
                host.enter();
            } else {
                host.leave();
            }
        }
    }

    if root.icon != IconId.none && root.text == "": AppIcon {
        x: (parent.width - self.width) / 2 + logic.nudge;
        y: (parent.height - self.height) / 2;
        icon: root.icon;
        size: root.icon-size;
        color: root.content-color;
        opacity: root.pulse ? 0.6 + 0.4 * Math.cos(animation-tick() / 1100ms * 360deg) : 1;
    }

    label := Text {
        visible: root.text != "";
        x: (parent.width - self.width) / 2 + logic.nudge;
        text: root.text;
        color: root.content-color;
        font-size: 11px;
        font-weight: 600;
        vertical-alignment: center;
        height: parent.height;
    }

    // A `BubbleAnchor` that explains the button's result (the Messages page's test).
    @children
}

/// The × that closes a dialog or a menu (night questionnaire Q-P9n): flat, without the frame of the icon buttons
/// beside it, so it never reads as one of their actions; a tint only under the pointer.
export component CloseButton inherits Rectangle {
    in property <string> tooltip: "Close";
    in property <string> shortcut: "Esc";
    callback clicked();

    width: 24px;
    height: 24px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 4px;
    background: touch.pressed ? Theme.surface-selected : touch.has-hover ? Theme.surface-hover : transparent;

    host := TooltipHost {
        text: root.tooltip;
        shortcut: root.shortcut;
    }

    AppIcon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        icon: IconId.close;
        size: IconSize.md;
        color: touch.has-hover ? Theme.text : Theme.text-muted;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                host.press();
            }
        }
        clicked => { root.clicked(); }
        changed has-hover => {
            if self.has-hover {
                host.enter();
            } else {
                host.leave();
            }
        }
    }
}

/// An icon that labels a field, with a tooltip.
export component FieldIcon inherits Rectangle {
    in property <IconId> icon;
    in property <string> tooltip;
    in property <bool> enabled: true;

    width: 16px;
    horizontal-stretch: 0;

    host := TooltipHost {
        text: root.tooltip;
    }

    TouchArea {
        changed has-hover => {
            if self.has-hover {
                host.enter();
            } else {
                host.leave();
            }
        }
    }

    AppIcon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        icon: root.icon;
        size: IconSize.sm;
        color: root.enabled ? Theme.text-muted : Theme.status-deleted;
    }
}

/// A switch in the theme colors (RustView's `ToggleSwitch`, crates/rustview/ui/toggle_switch.slint, 30x16 here), with
/// its own click and tooltip.
export component Switch inherits Rectangle {
    in property <bool> checked;
    in property <bool> enabled: true;
    in property <string> tooltip;
    in property <string> shortcut;
    callback toggled();

    width: 30px;
    height: 16px;
    horizontal-stretch: 0;
    border-radius: 8px;
    border-width: 1px;
    border-color: root.checked && root.enabled ? Theme.primary : Theme.border;
    background: !root.enabled ? Theme.surface-variant : root.checked ? Theme.primary : Theme.surface-selected;
    animate background { duration: 120ms; }

    host := TooltipHost {
        text: root.tooltip;
        shortcut: root.shortcut;
    }

    TouchArea {
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            host.press();
            if root.enabled {
                root.toggled();
            }
        }
        changed has-hover => {
            if self.has-hover {
                host.enter();
            } else {
                host.leave();
            }
        }
    }

    Rectangle {
        width: 10px;
        height: 10px;
        border-radius: 5px;
        x: root.checked ? 17px : 3px;
        y: 3px;
        background: !root.enabled ? Theme.text-muted : root.checked ? Theme.background : Theme.text;
        animate x { duration: 120ms; easing: ease-in-out; }
    }
}
