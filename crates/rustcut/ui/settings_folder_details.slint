// The selected entry of Settings > Target Folders (P11.3, user decision Q-FP2): its name, its path (a folder), its
// picture (the first letter, a built-in icon from the grid, or an own image or SVG), its color and its place on the
// folder wheel's first level (the small wheel, P12).

import { ListView } from "std-widgets.slint";
import { Theme } from "styles.slint";
import { AppIcon, IconId, IconSize } from "icons.slint";
import { IconButton, NumberField, SegmentedChoice } from "controls.slint";
import { ColorSwatchButton } from "color_picker_window.slint";
import { SettingsSearch } from "settings_search.slint";
import { TooltipArea } from "tooltip.slint";
import { DragState } from "drag.slint";
import { FolderPicture } from "folder_picture.slint";
import { FolderTreeUi } from "settings_folder_types.slint";
import { WheelFace } from "wheel_face.slint";

component Label inherits Text {
    width: 54px;
    color: Theme.text-muted;
    font-size: 12px;
    vertical-alignment: center;
}

/// The small wheel: the real wheel. Drag a place onto another to move or swap it; a click on a free place puts the
/// selected entry there, a click on a taken one selects it.
component SmallWheel inherits Rectangle {
    property <length> side: FolderTreeUi.wheel-size;
    // The place under an entry dragged from the tree (-1 = none): near the ring, by its angle clockwise from the top.
    property <int> count: FolderTreeUi.wheel-slots.length;
    property <length> dx: FolderTreeUi.pointer-x - self.absolute-position.x - self.width / 2;
    property <length> dy: FolderTreeUi.pointer-y - self.absolute-position.y - self.height / 2;
    property <length> distance: Math.sqrt((root.dx / 1px) * (root.dx / 1px) + (root.dy / 1px) * (root.dy / 1px)) * 1px;
    property <int> hit: !FolderTreeUi.dragging || root.count == 0 || root.distance < FolderTreeUi.wheel-look.inner
        || root.distance > FolderTreeUi.wheel-look.outer * 1.1 ? -1
        : Math.mod(Math.round((Math.atan2(root.dx / 1px, -root.dy / 1px) + 360deg) / (360deg / root.count)), root.count);
    property <bool> claims: area.has-hover || area.pressed;

    changed hit => {
        FolderTreeUi.drop-place = root.hit;
        FolderTreeUi.drop-place-changed();
    }
    // The page does not pan with a press on the wheel (see `DragState.holding`).
    changed claims => {
        DragState.holding = root.claims;
    }

    height: root.side + 8px;

    WheelFace {
        x: (parent.width - root.side) / 2;
        y: 4px;
        look: FolderTreeUi.wheel-look;
        slots: FolderTreeUi.wheel-slots;
        middle: FolderTreeUi.wheel-middle;
        whole-alpha: FolderTreeUi.wheel-alpha;
        whole-zoom: FolderTreeUi.wheel-zoom;
        whole-turn: FolderTreeUi.wheel-turn;
    }

    area := TouchArea {
        x: (parent.width - root.side) / 2;
        y: 4px;
        width: root.side;
        height: root.side;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                FolderTreeUi.wheel-press(self.mouse-x - root.side / 2, self.mouse-y - root.side / 2);
            }
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                FolderTreeUi.wheel-release();
            }
            if event.kind == PointerEventKind.move {
                FolderTreeUi.wheel-move(self.mouse-x - root.side / 2, self.mouse-y - root.side / 2);
                FolderTreeUi.wheel-hover(self.mouse-x - root.side / 2, self.mouse-y - root.side / 2);
            }
        }
        changed has-hover => {
            if !self.has-hover {
                FolderTreeUi.wheel-leave();
            }
        }
    }

    // Frees the place under the pointer: its favorite loses the star.
    if FolderTreeUi.clear-shown: TooltipArea {
        x: area.x + FolderTreeUi.clear-x - self.width / 2;
        y: area.y + FolderTreeUi.clear-y - self.height / 2;
        width: 18px;
        height: 18px;
        text: "Free this place (its entry loses the star)";

        Rectangle {
            border-radius: self.width / 2;
            background: clear.has-hover ? Theme.status-corrupt : Theme.surface-selected;
            border-width: 1px;
            border-color: Theme.surface;

            AppIcon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                icon: IconId.close;
                size: 12px;
                color: clear.has-hover ? Theme.surface : Theme.text;
            }

            clear := TouchArea {
                clicked => { FolderTreeUi.clear-place(FolderTreeUi.clear-index); }
            }
        }
    }

    if FolderTreeUi.ghost: FolderPicture {
        x: area.x + root.side / 2 + FolderTreeUi.ghost-x - self.width / 2;
        y: area.y + root.side / 2 + FolderTreeUi.ghost-y - self.height / 2;
        width: 34px;
        height: 34px;
        picture: FolderTreeUi.ghost-picture;
        shape: 0;
        tint: FolderTreeUi.tint;
    }
}

/// The wheel beside its options: every change shows at once, the scene plays after a change and repeats while the
/// pointer rests on an animation's row.
export component WheelPreview inherits VerticalLayout {
    spacing: 4px;
    alignment: start;

    WheelFace {
        look: FolderTreeUi.wheel-look;
        slots: FolderTreeUi.wheel-slots;
        middle: FolderTreeUi.wheel-middle;
        whole-alpha: FolderTreeUi.wheel-alpha;
        whole-zoom: FolderTreeUi.wheel-zoom;
        whole-turn: FolderTreeUi.wheel-turn;
    }

    HorizontalLayout {
        alignment: center;

        IconButton {
            icon: IconId.play;
            tooltip: "Play the animations again";
            clicked => { FolderTreeUi.play-again(); }
        }
    }
}

export component FolderDetails inherits VerticalLayout {
    property <bool> shown: FolderTreeUi.details.shown;

    spacing: 8px;
    alignment: start;

    if !root.shown: Text {
        text: "Select an entry to change its name, path, picture, color or place on the wheel.";
        color: Theme.text-muted;
        font-size: 12px;
        wrap: word-wrap;
    }

    if root.shown: HorizontalLayout {
        spacing: 10px;

        FolderPicture {
            width: 40px;
            height: 40px;
            picture: FolderTreeUi.details.picture;
            shape: FolderTreeUi.shape;
            tint: FolderTreeUi.tint;
            plate: true;
        }

        VerticalLayout {
            alignment: center;

            Text {
                text: FolderTreeUi.details.name;
                color: Theme.text;
                font-weight: 700;
                overflow: elide;
            }

            Text {
                text: FolderTreeUi.details.source ? "Jobs go next to their source video"
                    : FolderTreeUi.details.group ? (FolderTreeUi.details.contents == 1 ? "A group with 1 entry"
                    : "A group with " + FolderTreeUi.details.contents + " entries")
                    : "A target folder";
                color: Theme.text-muted;
                font-size: 11px;
            }
        }
    }

    if root.shown: HorizontalLayout {
        spacing: 6px;

        Label {
            text: "Wheel";
        }

        IconButton {
            icon: FolderTreeUi.details.place >= 0 ? IconId.folder-favorite-set : IconId.folder-favorite;
            checked: FolderTreeUi.details.place >= 0;
            tooltip: FolderTreeUi.details.place >= 0 ? "A favorite on place " + (FolderTreeUi.details.place + 1) + " (click: no favorite)"
                : "Make it a favorite (a place on the wheel's first level)";
            clicked => { FolderTreeUi.star(FolderTreeUi.details.id); }
        }

        Text {
            text: FolderTreeUi.details.place >= 0 ? "Place " + (FolderTreeUi.details.place + 1) + ": drag it onto another place to move or swap it"
                : "Click a free place, or drag an entry from the tree onto the wheel";
            color: Theme.text-muted;
            font-size: 11px;
            vertical-alignment: center;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }
    }

    if root.shown: SmallWheel { }

    if root.shown && !FolderTreeUi.details.source: HorizontalLayout {
        spacing: 6px;

        Label {
            text: "Name";
        }

        NumberField {
            spin: false;
            alignment: left;
            max-width: 100000px;
            text: FolderTreeUi.details.name;
            placeholder: "Name";
            tooltip: "The name the pickers show (F2 in the tree renames too)";
            committed(text) => { return FolderTreeUi.rename(FolderTreeUi.details.id, text); }
        }
    }

    if root.shown: HorizontalLayout {
        spacing: 6px;

        Label {
            text: "Short";
        }

        NumberField {
            spin: false;
            alignment: left;
            max-width: 100000px;
            text: FolderTreeUi.details.short-name;
            placeholder: FolderTreeUi.details.name;
            tooltip: "The name the folder wheel shows instead (empty: the name)";
            committed(text) => { return FolderTreeUi.set-short-name(text); }
        }
    }

    if root.shown && !FolderTreeUi.details.source && !FolderTreeUi.details.group: HorizontalLayout {
        spacing: 6px;

        Label {
            text: "Path";
        }

        NumberField {
            spin: false;
            alignment: left;
            max-width: 100000px;
            text: FolderTreeUi.details.path;
            placeholder: "/home/you/Videos";
            tooltip: FolderTreeUi.details.missing ? "The folder does not exist yet: it is made when a job writes into it"
                : "The folder's path (a folder that does not exist yet is made when a job writes into it)";
            mark: FolderTreeUi.details.missing ? IconId.status-warning : IconId.none;
            bubble: "settings:folder.path";
            committed(text) => { return FolderTreeUi.set-path(text); }
            typed(text) => { FolderTreeUi.path-typed(text); }
            canceled => { FolderTreeUi.path-canceled(); }
        }

        IconButton {
            icon: IconId.browse;
            tooltip: "Choose the folder";
            clicked => { FolderTreeUi.pick-path(); }
        }
    }

    if root.shown: HorizontalLayout {
        spacing: 6px;

        Label {
            text: "Color";
        }

        if FolderTreeUi.details.has-color: ColorSwatchButton {
            value: FolderTreeUi.details.color;
            tooltip: "The entry's color (wheel fields, the list's stripe, its icon)";
            clicked => { FolderTreeUi.pick-color(); }
        }

        if !FolderTreeUi.details.has-color: IconButton {
            icon: IconId.folder-color;
            tooltip: "No color (the theme's colors): click to choose one";
            clicked => { FolderTreeUi.pick-color(); }
        }

        IconButton {
            icon: IconId.close;
            enabled: FolderTreeUi.details.has-color;
            tooltip: "No color (the theme's colors)";
            clicked => { FolderTreeUi.clear-color(); }
        }

        Rectangle {
            horizontal-stretch: 1;
        }
    }

    if root.shown: HorizontalLayout {
        spacing: 6px;

        Label {
            text: "Picture";
        }

        SegmentedChoice {
            items: ["Letter", "Icon", "Own"];
            current: FolderTreeUi.details.picture-kind;
            tooltip: "The first letter on the color, a built-in icon, or an own image or SVG. Changing this keeps the others.";
            selected(i) => { FolderTreeUi.picture-kind(i); }
        }
    }

    // The own picture: a click chooses another, the held X deletes it.
    if root.shown && FolderTreeUi.details.picture-kind == 2 && FolderTreeUi.details.has-own: HorizontalLayout {
        padding-left: 60px;
        spacing: 12px;
        alignment: start;

        Rectangle {
            width: 120px;
            height: 120px;

            TooltipArea {
                text: "Click to choose another image or SVG";

                FolderPicture {
                    picture: FolderTreeUi.details.own-picture;
                    shape: 1;
                }

                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { FolderTreeUi.pick-file(); }
                }
            }

            IconButton {
                x: parent.width - self.width + 6px;
                y: -6px;
                icon: IconId.close;
                hold: true;
                tooltip: "Delete this picture";
                clicked => { FolderTreeUi.delete-image(); }
            }
        }
    }

    // No own picture yet: a box to choose one (no dialog before it is asked for).
    if root.shown && FolderTreeUi.details.picture-kind == 2 && !FolderTreeUi.details.has-own: HorizontalLayout {
        padding-left: 60px;

        Rectangle {
            height: 96px;
            border-radius: 6px;
            border-width: 1px;
            border-color: choose.has-hover || FolderTreeUi.file-over ? Theme.primary : Theme.border;
            background: FolderTreeUi.file-over ? Theme.primary.with-alpha(0.12) : transparent;

            VerticalLayout {
                alignment: center;
                spacing: 6px;

                HorizontalLayout {
                    alignment: center;

                    AppIcon {
                        icon: IconId.folder-picture-file;
                        size: 22px;
                        color: Theme.text-muted;
                    }
                }

                Text {
                    text: FolderTreeUi.file-over ? "Drop to use this picture" : "Choose an image or SVG, or drop one here";
                    color: Theme.text;
                    font-size: 12px;
                    horizontal-alignment: center;
                }
            }

            choose := TouchArea {
                mouse-cursor: pointer;
                clicked => { FolderTreeUi.pick-file(); }
            }
        }
    }

    if root.shown && FolderTreeUi.details.picture-kind == 1: VerticalLayout {
        spacing: 4px;

        SettingsSearch {
            initial: FolderTreeUi.icon-search;
            placeholder: "Search icons";
            edited(text) => { FolderTreeUi.search-icons(text); }
        }

        Rectangle {
            height: 170px;
            border-radius: 4px;
            border-width: 1px;
            border-color: Theme.border;

            ListView {
                x: 1px;
                y: 1px;
                width: parent.width - 2px;
                height: parent.height - 2px;

                for line in FolderTreeUi.icon-rows: HorizontalLayout {
                    height: 30px;
                    padding-left: 2px;
                    spacing: 2px;
                    alignment: start;

                    for icon in line.icons: TooltipArea {
                        width: 28px;
                        text: icon.name;

                        Rectangle {
                            border-radius: 4px;
                            background: icon.chosen ? Theme.surface-selected : cell.has-hover ? Theme.surface-hover : transparent;
                            border-width: icon.chosen ? 1px : 0px;
                            border-color: Theme.primary;

                            FolderPicture {
                                x: 4px;
                                y: 4px;
                                width: 20px;
                                height: 20px;
                                picture: icon.picture;
                                tint: false;
                            }

                            cell := TouchArea {
                                clicked => { FolderTreeUi.pick-icon(icon.name); }
                            }
                        }
                    }
                }
            }
        }
    }
}
