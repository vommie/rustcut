// The question before a file sent by RustSearch replaces a video with unsaved sections (src/ui/open/app_request.rs;
// setting `dialogs.ask_before_rustsearch_replaces`, 0.0.120). Keep the current video (Escape or ×), discard its sections
// and open the file, or save the sections as a job first and then open the file (Enter).

import { DialogFrame, DialogHeader, DialogPanel, DialogState } from "dialog_frame.slint";
import { Theme } from "styles.slint";
import { IconId } from "icons.slint";
import { DialogButton } from "export_dialog.slint";

export global AppOpen {
    in property <bool> open;
    in property <string> title;
    in property <string> text;
    callback keep();
    callback discard();
    callback save();
}

export component AppOpenDialog inherits Rectangle {
    // The scrim: the window behind waits.
    background: #000000a0;

    TouchArea { }

    keys := FocusScope {
        init => { self.focus(); }

        key-pressed(event) => {
            if event.text == Key.Escape {
                AppOpen.keep();
                return accept;
            }
            if event.text == Key.Return {
                AppOpen.save();
                return accept;
            }
            accept
        }

        // Resizable; never smaller than its content, extra height stays free below it.
        card := DialogFrame {
            area-width: root.width;
            area-height: root.height;
            default-width: 520px;
            default-height: content.preferred-height;
            least-width: 420px;
            least-height: content.preferred-height;
            stored-width <=> DialogState.app-open-width;
            stored-height <=> DialogState.app-open-height;

            content := VerticalLayout {
                y: 0;
                height: self.preferred-height;
                padding: 16px;
                spacing: 12px;

                DialogHeader {
                    icon: IconId.search;
                    title: AppOpen.title;
                    closable: true;
                    close => { AppOpen.keep(); }
                }

                DialogPanel {
                    Text {
                        text: AppOpen.text;
                        color: Theme.text-muted;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    DialogButton {
                        text: "Keep current";
                        clicked => { AppOpen.keep(); }
                    }

                    DialogButton {
                        text: "Discard and open";
                        clicked => { AppOpen.discard(); }
                    }

                    DialogButton {
                        text: "Save and open";
                        primary: true;
                        clicked => { AppOpen.save(); }
                    }
                }
            }
        }
    }
}
