// The data of the Job Finalization card and of the conflict dialog (src/ui/export/ fills `Export` and handles its
// callbacks). The queue panel's global is in queue_types.slint.

// One way out of a target conflict. `file` is the name it leads to; `destructive` replaces or removes something.
export struct ConflictOptionView {
    title: string,
    file: string,
    detail: string,
    enabled: bool,
    destructive: bool,
    // The choice whose file name is typed in the dialog.
    typed: bool,
}

// A queued job that writes the same file.
export struct ConflictJobView {
    id: string,
    name: string,
    state: string,
    running: bool,
}

export global Export {
    // The card.
    in property <bool> has-source;
    in property <[string]> folders;
    in property <int> folder-index;
    in property <string> folder-path;
    in property <bool> can-remove-folder;
    in property <string> name;
    in property <bool> counter-enabled;
    in property <string> counter;
    in property <bool> auto-increment;
    in property <bool> clear-sections;
    // The file the job writes, and what the live check found: 0 free, 1 a hint, 2 a conflict, 3 an error.
    in property <string> file-name;
    in property <int> check-level;
    in property <string> check-text;
    in property <string> check-tooltip;
    in property <bool> can-save;
    in property <string> save-tooltip;
    in property <string> key-save;

    callback select-folder(int);
    callback add-folder();
    callback remove-folder();
    callback name-edited(string);
    callback toggle-counter();
    callback counter-committed(string) -> bool;
    callback counter-stepped(int);
    callback toggle-auto-increment();
    callback toggle-clear-sections();
    callback save();

    // A queued job loaded into the editor (M4.1, user decisions Q-Q2, Q-Q3): the banner over the card, whether Save
    // updates the job (same target) or makes a new one, and whether stopping would drop edits (then it is held).
    in property <bool> editing;
    in property <string> editing-text;
    in property <string> editing-tooltip;
    in property <bool> editing-updates;
    in property <bool> editing-changed;
    callback save-as-new();
    callback stop-editing();

    // The conflict dialog (modal; user decision Q-X1).
    in property <bool> dialog-open;
    in property <string> dialog-title;
    in property <string> dialog-file;
    in property <string> dialog-folder;
    in property <string> dialog-exists;
    in property <string> dialog-jobs-title;
    in property <[ConflictJobView]> dialog-jobs;
    in property <string> dialog-similar;
    in property <string> dialog-similar-tooltip;
    in property <[ConflictOptionView]> dialog-options;
    in property <int> dialog-selected;
    in property <string> dialog-typed;
    in property <string> dialog-dont-ask-text;
    in property <bool> dialog-dont-ask;
    in property <bool> dialog-can-confirm;
    in property <string> dialog-confirm-text;

    // The question before a job without tags or rating is saved (modal; user decision Q-G1).
    in property <bool> meta-open;
    in property <string> meta-title;
    in property <string> meta-text;
    in property <bool> meta-ask-rating;
    in property <bool> meta-dont-ask;
    callback meta-rate(int);
    callback meta-save();
    callback meta-back();
    callback meta-toggle-dont-ask();

    callback dialog-select(int);
    callback dialog-step(int);
    callback dialog-type(string);
    callback dialog-toggle-dont-ask();
    callback dialog-confirm();
    callback dialog-cancel();
    callback dialog-play-existing();
    callback dialog-reveal();
}
