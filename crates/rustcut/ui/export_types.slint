// The data of the Job Finalization card and of the conflict dialog (src/ui/export/ fills `Export` and handles its
// callbacks). The queue panel's global is in queue_types.slint.

import { TabView } from "tabs.slint";
import { TipRow } from "tooltip.slint";

// One way out of a target conflict or a start problem. `file` is the name it leads to; `recommended` adds
// "(Recommended)" after the title (the start dialogs, P9.3).
export struct ConflictOptionView {
    // The index of the choice among all of the dialog's choices (key = index + 1); the tab shows only its own.
    key: int,
    title: string,
    file: string,
    // A file name shown in italics before the detail ("<name> already exists.").
    detail-name: string,
    detail: string,
    enabled: bool,
    recommended: bool,
    // The choice whose file name is typed in the dialog.
    typed: bool,
    // The key's color (user review 2026-10-27): 0 neutral, 1 green (the next free number while the counter
    // auto-iterates), 2 red (overwrites or removes something).
    key-tint: int,
}

// A file of the conflict dialog with its preview (src/ui/export/previews.rs). `state`: 0 loading, 1 picture,
// 2 no picture (`note` says why), 3 not readable.
export struct PreviewView {
    // 1 = the series, 2 = the other names, 3 = the known source's files (0 = the existing file); `index` within the
    // group.
    group: int,
    index: int,
    name: string,
    // The target file itself.
    is-target: bool,
    state: int,
    picture: image,
    // "812 MB · 4:12 · 1920×1080", "812 MB · 4:12", "2026-10-20 14:32".
    facts: string,
    short: string,
    date: string,
    note: string,
    tip-rows: [TipRow],
    // A file RustView knows was made from the source (the known-source dialog, M6.5d): its folder, rating (-1 = none),
    // tag names, whether the file is gone, and the queued job that writes it ("Job #3", "" = none).
    folder: string,
    rating: int,
    tags: string,
    missing: bool,
    job: string,
}

// A queued job that writes the same file.
export struct ConflictJobView {
    id: string,
    name: string,
    state: string,
    running: bool,
}

export global Export {
    // The card.
    in property <bool> has-source;
    in property <string> name;
    // The chosen container's extension (".mkv"), dim inside the name field (P9.7).
    in property <string> extension;
    // The counter is in the file name: the field shows it, an empty field means none (P9.7).
    in property <bool> counter-enabled;
    in property <string> counter;
    in property <bool> auto-increment;
    in property <bool> clear-sections;
    // The live check of the file the job writes shows as a bubble at the name or the folder (M6.5c); Save's tooltip
    // names the file.
    in property <bool> can-save;
    in property <string> save-tooltip;
    in property <string> key-save;

    // The jump to the folder tree in Settings > Target Folders (the field and its list: `FolderList`, P11.4).
    callback edit-folders();
    callback name-edited(string);
    // A typed counter ("" = no counter); false = not accepted.
    callback counter-committed(string) -> bool;
    callback counter-stepped(int);
    callback toggle-auto-increment();
    callback toggle-clear-sections();
    callback save();

    // The conflict dialog (modal; user decision Q-X1).
    in property <bool> dialog-open;
    in property <string> dialog-title;
    in property <string> dialog-file;
    in property <string> dialog-folder;
    // The whole target path, and what follows the folder in it ("/Clip - 01.mkv"): the folder is cut when it is long,
    // never the file name.
    in property <string> dialog-path;
    in property <string> dialog-file-tail;
    in property <bool> dialog-has-existing;
    // The tabs (user decision Q-X6): titles with counts, the shown one and what it is (0 decision, 1 other name,
    // 2 similar files, 3 queue).
    in property <[TabView]> dialog-tabs;
    in property <int> dialog-tab;
    in property <int> dialog-tab-kind;
    in property <[ConflictOptionView]> dialog-tab-options;
    in property <string> dialog-jobs-title;
    in property <[ConflictJobView]> dialog-jobs;
    // The existing file and the "Similar files" groups (the numbered series, the other similar names) with their
    // previews.
    in property <PreviewView> dialog-existing;
    in property <[PreviewView]> dialog-series;
    in property <[PreviewView]> dialog-others;
    in property <string> dialog-others-title;
    // "Reading 12 of 40 files" while previews are read, else empty.
    in property <string> dialog-previews-progress;
    in property <int> dialog-tile-width: 112;
    in property <int> dialog-selected;
    in property <string> dialog-typed;
    in property <bool> dialog-can-confirm;
    // Only looking at the target folder's files (the name check's bubble): no choices, the button closes.
    in property <bool> dialog-browse;
    // The known-source dialog (M6.5d): the files RustView knows were made from the open video, the header's text and
    // "Open another video".
    in property <bool> dialog-known-mode;
    in property <string> dialog-text;
    in property <[PreviewView]> dialog-known;
    callback dialog-open-other();
    in property <string> dialog-confirm-text;

    // The question before a job without tags or rating is saved (modal; user decision Q-G1).
    in property <bool> meta-open;
    in property <string> meta-title;
    in property <bool> meta-ask-rating;
    callback meta-rate(int);
    callback meta-save();
    callback meta-back();

    callback dialog-select(int);
    callback dialog-step(int);
    callback dialog-type(string);
    callback dialog-confirm();
    callback dialog-cancel();
    callback dialog-set-tab(int);
    callback dialog-cycle-tab(int);
    // A file of the dialog: `group` 0 = the existing file, 1 = the series, 2 = the other names; played in the default
    // player or (`reveal`) shown in the file manager.
    callback dialog-open-file(int, int, bool);
}
