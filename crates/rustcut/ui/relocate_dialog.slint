// Moving the target files of jobs (P12 block 7, user decision Q-P12f; src/ui/relocate/): one dialog for one job (folder
// and name) and for several (only the folder). The folder comes from the shared folder select (every target folder and
// its options menu), a typed path or the system's folder dialog. Every check shows before anything happens; a name that
// is taken is decided here ("Add (n)" preselected, "Skip these", "Overwrite" held). The second dialog names the RustView
// records that could not follow their files (the user moves them in RustView).

import { Theme } from "styles.slint";
import { AppIcon, IconId, IconSize } from "icons.slint";
import { IconButton, MiddleText, NumberField } from "controls.slint";
import { DialogFrame, DialogHeader, DialogPanel } from "dialog_frame.slint";
import { DialogButton, OptionRow } from "export_dialog_parts.slint";
import { ConflictOptionView } from "export_types.slint";
import { FolderField, FolderFieldView } from "folder_list.slint";
import { NoticeLook } from "notice_types.slint";
import { SmoothScrollArea } from "smooth_scroll_view.slint";
import { TooltipArea } from "tooltip.slint";
import { Throbber } from "throbber.slint";

// What the move does and what stands in its way, as a symbol with a short value (the details in its tooltip):
// level 0 neutral, 1 fine, 2 warning, 3 error (the notice levels).
export struct RelocateChipView {
    icon: IconId,
    text: string,
    tooltip: string,
    level: int,
}

// A taken name and the name "Add (n)" gives it.
export struct RelocateConflictView {
    file: string,
    numbered: string,
}

// A record that stayed at the old path.
export struct RelocateRecordView {
    from: string,
    to: string,
    reason: string,
}

export global Relocate {
    in-out property <bool> open;
    // Raised when a field of the dialog is done: the dialog takes the keys again.
    in-out property <int> focus-tick;
    in property <string> path-placeholder;
    in property <string> title;
    in property <string> text;
    in property <bool> single;
    in property <FolderFieldView> folder-field;
    in property <string> path;
    in property <string> name;
    in property <string> extension;
    in property <[RelocateChipView]> chips;
    in property <bool> checking;
    // A field's mark (0 none, 2 warning, 3 error) and what it says.
    in property <int> folder-mark;
    in property <string> folder-tip;
    in property <int> name-mark;
    in property <string> name-tip;
    in property <string> conflict-title;
    in property <[RelocateConflictView]> conflicts;
    // The choices for taken names, as the conflict dialog's rows: 0 "Add (n)", 1 "Skip", 2 "Overwrite".
    in property <[ConflictOptionView]> options;
    in property <int> resolution;
    in property <bool> ready;
    in property <string> move-label: "Move";
    // The dialog's size while RustCut runs.
    in-out property <length> width;
    in-out property <length> height;

    callback path-committed(string) -> bool;
    callback path-typed(string);
    callback name-committed(string) -> bool;
    callback name-typed(string);
    callback browse();
    callback set-resolution(int);
    callback confirm();
    callback cancel();

    in-out property <bool> records-open;
    in property <string> records-title;
    in property <[RelocateRecordView]> records;
    callback records-copy();
    callback records-close();
}

component Chip inherits TooltipArea {
    in property <RelocateChipView> chip;

    property <color> tint: root.chip.level == 3 ? Theme.status-corrupt : root.chip.level == 2 ? Theme.accent
        : root.chip.level == 1 ? Theme.status-ok : Theme.text;

    text: root.chip.tooltip;
    height: 24px;
    width: row.preferred-width;

    Rectangle {
        border-radius: 12px;
        background: root.chip.level == 0 ? Theme.surface-variant : root.tint.with-alpha(0.14);
        border-width: 1px;
        border-color: root.chip.level == 0 ? Theme.border : root.tint.with-alpha(0.6);
    }

    row := HorizontalLayout {
        padding-left: 8px;
        padding-right: 10px;
        spacing: 5px;

        VerticalLayout {
            alignment: center;

            AppIcon {
                icon: root.chip.icon;
                size: IconSize.sm;
                color: root.tint;
            }
        }

        Text {
            text: root.chip.text;
            color: root.chip.level == 0 ? Theme.text : root.tint;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

component Label inherits Text {
    width: 46px;
    color: Theme.text-muted;
    font-size: 12px;
    vertical-alignment: center;
}

export component RelocateDialog inherits Rectangle {
    background: #000000a0;

    property <int> focus-tick: Relocate.focus-tick;
    changed focus-tick => { keys.focus(); }

    TouchArea { }

    keys := FocusScope {
        init => { self.focus(); }

        key-pressed(event) => {
            if event.text == Key.Escape {
                Relocate.cancel();
                return accept;
            }
            if event.text == Key.Return && Relocate.ready && Relocate.resolution != 2 {
                Relocate.confirm();
                return accept;
            }
            // 1-3 pick a choice for the taken names, as in the conflict dialog.
            if Relocate.conflicts.length > 0 && (event.text == "1" || event.text == "2" || event.text == "3") {
                if event.text != "3" || Relocate.options[2].enabled {
                    Relocate.set-resolution(event.text.to-float() - 1);
                }
                return accept;
            }
            accept
        }

        DialogFrame {
            area-width: root.width;
            area-height: root.height;
            default-width: 560px;
            default-height: Math.min(content.preferred-height, root.height - 40px);
            least-width: 420px;
            least-height: 260px;
            stored-width <=> Relocate.width;
            stored-height <=> Relocate.height;

            content := VerticalLayout {
                padding: 16px;
                spacing: 10px;

                DialogHeader {
                    icon: IconId.job-move;
                    title: Relocate.title;
                    text: Relocate.text;
                    closable: true;
                    close => { Relocate.cancel(); }
                }

                HorizontalLayout {
                    spacing: 6px;

                    Label {
                        text: "Folder";
                    }

                    FolderField {
                        owner: "relocate";
                        view: Relocate.folder-field;
                    }

                    IconButton {
                        icon: IconId.browse;
                        tooltip: "Choose the folder with the system's folder dialog";
                        clicked => { Relocate.browse(); }
                    }
                }

                HorizontalLayout {
                    spacing: 6px;

                    Label {
                        text: "Path";
                    }

                    NumberField {
                        spin: false;
                        alignment: left;
                        max-width: 100000px;
                        text: Relocate.path;
                        placeholder: Relocate.path-placeholder;
                        tooltip: Relocate.folder-mark > 0 ? Relocate.folder-tip
                            : "The folder's path; a folder that does not exist yet is made";
                        mark: Relocate.folder-mark == 3 ? IconId.status-error : Relocate.folder-mark == 2 ? IconId.status-warning : IconId.none;
                        committed(text) => { return Relocate.path-committed(text); }
                        typed(text) => { Relocate.path-typed(text); }
                    }
                }

                if Relocate.single: HorizontalLayout {
                    spacing: 6px;

                    Label {
                        text: "Name";
                    }

                    NumberField {
                        spin: false;
                        alignment: left;
                        max-width: 100000px;
                        text: Relocate.name;
                        unit: Relocate.extension;
                        tooltip: Relocate.name-mark > 0 ? Relocate.name-tip
                            : "The file's new name; the extension stays";
                        mark: Relocate.name-mark == 3 ? IconId.status-error : Relocate.name-mark == 2 ? IconId.status-warning : IconId.none;
                        committed(text) => { return Relocate.name-committed(text); }
                        typed(text) => { Relocate.name-typed(text); }
                    }
                }

                SmoothScrollArea {
                    vertical-stretch: 1;
                    min-height: 60px;
                    preferred-height: checks.preferred-height;

                    checks := VerticalLayout {
                        spacing: 8px;
                        alignment: start;

                        // What the move does, as symbols (the details in the tooltips); wraps by hand: two rows of chips.
                        if Relocate.chips.length > 0: HorizontalLayout {
                            spacing: 6px;
                            alignment: start;

                            for chip in Relocate.chips: Chip {
                                chip: chip;
                            }
                        }

                        if Relocate.conflicts.length > 0: DialogPanel {
                            VerticalLayout {
                                spacing: 4px;

                                Text {
                                    text: Relocate.conflict-title;
                                    color: Theme.accent;
                                    font-size: 12px;
                                    font-weight: 600;
                                    wrap: word-wrap;
                                }

                                // The conflict dialog's choice rows (the user's wish: they look alike).
                                for option in Relocate.options: OptionRow {
                                    option: option;
                                    selected: option.key == Relocate.resolution;
                                    picked => { Relocate.set-resolution(option.key); }
                                    confirmed => {
                                        if Relocate.ready && Relocate.resolution != 2 {
                                            Relocate.confirm();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    DialogButton {
                        text: "Cancel";
                        clicked => { Relocate.cancel(); }
                    }

                    // While the folders are checked the button shows a throbber instead of its label.
                    if Relocate.checking: Rectangle {
                        width: 84px;
                        height: 30px;
                        border-radius: 5px;
                        background: Theme.surface-variant;
                        border-width: 1px;
                        border-color: Theme.border;

                        Throbber {
                            size: IconSize.md;
                        }
                    }

                    if !Relocate.checking && Relocate.resolution != 2: DialogButton {
                        text: Relocate.move-label;
                        primary: true;
                        enabled: Relocate.ready;
                        clicked => { Relocate.confirm(); }
                    }

                    if !Relocate.checking && Relocate.resolution == 2: IconButton {
                        height: 30px;
                        min-width: 84px;
                        icon: IconId.job-move;
                        text: Relocate.move-label;
                        hold: true;
                        alert: true;
                        enabled: Relocate.ready;
                        tooltip: "Moves and replaces the existing files";
                        clicked => { Relocate.confirm(); }
                    }
                }
            }
        }
    }
}

export component RelocateRecordsDialog inherits Rectangle {
    background: #000000a0;

    TouchArea { }

    FocusScope {
        init => { self.focus(); }

        key-pressed(event) => {
            if event.text == Key.Escape || event.text == Key.Return {
                Relocate.records-close();
                return accept;
            }
            accept
        }

        DialogFrame {
            area-width: root.width;
            area-height: root.height;
            default-width: 600px;
            default-height: Math.min(body.preferred-height, root.height - 40px);
            least-width: 420px;
            least-height: 220px;

            body := VerticalLayout {
                padding: 16px;
                spacing: 10px;

                DialogHeader {
                    icon: IconId.status-warning;
                    tint: Theme.accent;
                    title: Relocate.records-title;
                    text: "RustView could not follow. Move these entries to their new place in RustView.";
                    closable: true;
                    close-tooltip: "Close";
                    close => { Relocate.records-close(); }
                }

                SmoothScrollArea {
                    vertical-stretch: 1;
                    min-height: 60px;
                    preferred-height: rows.preferred-height;

                    rows := VerticalLayout {
                        spacing: 8px;
                        alignment: start;

                        for record in Relocate.records: VerticalLayout {
                            spacing: 2px;

                            MiddleText {
                                text: record.from;
                                color: Theme.text-muted;
                            }

                            MiddleText {
                                text: "→ " + record.to;
                                color: Theme.text;
                            }

                            Text {
                                text: record.reason;
                                color: Theme.status-corrupt;
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    DialogButton {
                        text: "Copy the Paths";
                        clicked => { Relocate.records-copy(); }
                    }

                    DialogButton {
                        text: "OK";
                        primary: true;
                        clicked => { Relocate.records-close(); }
                    }
                }
            }
        }
    }
}
