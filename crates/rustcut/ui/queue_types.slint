// The data of the queue panel (src/ui/queue/ fills `Queue` and handles its callbacks): the rows in their compact or
// table form, the columns that fit, the filter menu (search, rule, states, folders, profiles; P9.6), the overall
// progress, and what the toolbar can do with the selection.

import { MultiChoiceItem } from "controls_choice.slint";

// One row of the queue list.
export struct QueueRowView {
    id: int,
    name: string,
    state: string,
    // JobStateKind order: 0 waiting, 1 held, 2 rendering, 3 paused, 4 finished, 5 failed, 6 canceled.
    kind: int,
    // 0 to 1 while rendering or when finished, negative otherwise.
    progress: float,
    // "45 %" while rendering: the compact form's second row, on the right.
    percent: string,
    // Not rendering: the table's held delete button can remove it.
    removable: bool,
    // The compact form's second line.
    detail: string,
    selected: bool,
    // The job the Job and Logs panels show.
    current: bool,
    // Loaded into the editor.
    editing: bool,
    // Its file waits to move (after its render or behind other moves; the job card names where to, P12 block 7).
    moving: bool,
    // The table form's cells, one per entry of `Queue.columns`.
    cells: [string],
}

// One symbol of the totals line (review 2): a state's symbol with its count ("3/4 finished" in the tooltip).
export struct QueueTotalView {
    kind: int,
    count: int,
    tooltip: string,
}

// One column of the table form (src/ui/queue/columns.rs computes where it sits).
export struct QueueColumnView {
    id: string,
    title: string,
    tooltip: string,
    x: length,
    width: length,
    right: bool,
    // The name stretches; every other column can be dragged wider or narrower.
    resizable: bool,
}

export global Queue {
    in property <[QueueRowView]> rows;
    // Setting `queue.follow_new_jobs`: the list follows new jobs while it stands at the bottom.
    in property <bool> follow-new: true;
    // Two-line rows without a header (a narrow sidebar).
    in property <bool> compact: true;
    in property <[QueueColumnView]> columns;
    in property <length> row-height: 44px;
    in property <string> search;
    in property <bool> filtered;
    // "4 of 12 jobs shown" while a filter is on.
    in property <string> filter-note;
    // The filter menu (P9.6): a flyout from the filter button (window coordinates of the button), its choices with what
    // they show, the rule (ANY instead of ALL) and the number of filters that are set (the button's badge).
    in-out property <bool> filter-open;
    in-out property <length> filter-anchor-x;
    in-out property <length> filter-anchor-y;
    in-out property <length> filter-anchor-width;
    in-out property <length> filter-anchor-height;
    in property <[MultiChoiceItem]> filter-states;
    in property <[MultiChoiceItem]> filter-folders;
    in property <[MultiChoiceItem]> filter-profiles;
    in property <string> filter-states-text: "Any state";
    in property <string> filter-folders-text: "Any target folder";
    in property <string> filter-profiles-text: "Any profile";
    in property <bool> filter-any;
    in property <int> filter-count;
    // The totals line: a symbol per state that occurs; `summary` is the text without jobs ("No jobs").
    in property <[QueueTotalView]> totals;
    in property <string> summary;
    in property <string> empty-text;
    // The overall progress of the current run.
    in property <bool> has-overall;
    in property <float> overall;
    in property <string> overall-text;
    in property <bool> paused;
    in property <bool> pause-after;
    // Something renders and processing is not paused: "pause after the running jobs" can act.
    in property <bool> can-pause-after;
    // What happens when the queue is done (0 nothing, 1 notify, 2 quit, 3 suspend, 4 power off) and its tooltip.
    in property <int> when-done;
    in property <string> when-done-tip;
    // What the toolbar can do with the selection (tooltips with the number of jobs).
    in property <int> selected-count;
    in property <bool> can-edit;
    in property <bool> can-edit-tags;
    in property <string> edit-tags-tooltip: "Edit the job's tags and rating in the Tag & Rate panel";
    in property <bool> can-cancel;
    in property <bool> can-remove;
    in property <bool> can-retry;
    in property <bool> can-hold;
    in property <bool> held;
    in property <bool> can-move-up;
    in property <bool> can-move-down;
    in property <bool> can-remove-finished;
    in property <string> cancel-tooltip;
    in property <string> remove-tooltip;
    in property <string> retry-tooltip;
    in property <string> hold-tooltip;
    in property <string> move-up-tooltip;
    in property <string> move-down-tooltip;
    in property <string> remove-finished-tooltip;
    in property <string> key-move-up;
    in property <string> key-move-down;

    // The list's inner width (the columns follow it).
    callback width-changed(length);
    callback select(/* job id */ int, /* ctrl */ bool, /* shift */ bool);
    callback select-all();
    callback double-clicked(/* job id */ int);
    // A right click on a row (it is selected first unless it already is) or on the empty list (-1).
    callback context-menu(/* job id */ int, /* window x */ length, /* window y */ length);
    // Dragging the selected jobs (P9.4, src/ui/queue/drag.rs with the model of src/ui/drag/): the rows' moves aside
    // (by shown row), the gap where the jobs would land, the ghost under the pointer (content coordinates) with the
    // grabbed job's name and how many move; `drag-instant` makes the rows snap without animation (the new order came).
    in property <bool> dragging;
    in property <[length]> drag-shifts;
    in property <bool> drag-instant;
    in property <length> drag-gap-y;
    in property <length> drag-gap-height;
    in property <length> drag-ghost-y;
    in property <string> drag-title;
    in property <string> drag-detail;
    in property <int> drag-count;
    callback drag-start(/* row */ int, /* pointer, content y */ length, /* row pitch */ length, /* row height */ length);
    callback drag-move(/* pointer, content y */ length);
    callback drag-end();
    callback column-resize-started(/* column id */ string);
    callback column-resized(/* column id */ string, /* delta */ length);
    // An entry of a filter choice (0 states, 1 folders, 2 profiles; entry -1 = any) with Ctrl or without.
    callback filter-pick(/* kind */ int, /* entry */ int, /* control */ bool);
    callback toggle-filter-any();
    callback search-edited(string);
    callback clear-filter();
    // A left click on the list's empty space.
    callback clear-selection();
    // The table's held delete button of a job.
    callback remove-row(/* job id */ int);
    callback toggle-paused();
    callback toggle-pause-after();
    // The "When the queue finishes…" menu hanging from its button (window x, y, width, height); a right click on the
    // button resets it to "Do Nothing".
    callback when-done-menu(length, length, length, length);
    callback when-done-reset();
    // The queue lives only in memory (its database cannot be used, M6.5d): the red line at the top; a click opens the
    // database dialog again.
    in property <string> temporary-line;
    callback temporary-clicked();
    callback cancel();
    callback remove();
    callback retry();
    callback toggle-hold();
    callback move-up();
    callback move-down();
    callback edit();
    callback remove-finished();
    // The Tag & Rate panel edits the selected job's RustView entry (user decision Q-G3).
    callback edit-tags();
}
