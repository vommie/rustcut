// The Job panel (src/ui/inspector/ fills `Job`; user decision Q-Q1): the queue's current job with its state and what
// can be done with it, and its details in foldable sections (job, source, output, sections, filters, codecs, tags and
// rating). Long values are elided; their tooltip has the whole text.

import { Theme } from "styles.slint";
import { AppIcon, IconId, IconSize } from "icons.slint";
import { IconButton } from "controls.slint";
import { TooltipHost } from "tooltip.slint";
import { Job, JobRowView, JobSectionView } from "job_types.slint";
import { QueueColors } from "queue_row.slint";

component DetailRow inherits Rectangle {
    in property <JobRowView> item;

    height: 20px;

    host := TooltipHost {
        text: root.item.tooltip;
    }

    HorizontalLayout {
        spacing: 8px;

        Text {
            width: 76px;
            text: root.item.label;
            color: Theme.text-muted;
            font-size: 11px;
            vertical-alignment: center;
            overflow: elide;
        }

        Text {
            horizontal-stretch: 1;
            text: root.item.value;
            color: root.item.tone == 2 ? Theme.status-corrupt : root.item.tone == 1 ? Theme.text-muted : Theme.text;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    TouchArea {
        changed has-hover => {
            if self.has-hover {
                host.enter();
            } else {
                host.leave();
            }
        }
    }
}

component DetailSection inherits Rectangle {
    in property <JobSectionView> section;

    border-radius: 4px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;

    VerticalLayout {
        padding: 6px;
        padding-top: 2px;
        spacing: 0px;

        Rectangle {
            height: 22px;

            HorizontalLayout {
                spacing: 4px;

                AppIcon {
                    y: (parent.height - self.height) / 2;
                    icon: root.section.collapsed ? IconId.chevron-right : IconId.chevron-down;
                    size: IconSize.sm;
                    color: Theme.text-muted;
                }

                Text {
                    horizontal-stretch: 1;
                    text: root.section.title;
                    color: Theme.text;
                    font-size: 12px;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { Job.toggle-section(root.section.id); }
            }
        }

        if !root.section.collapsed: VerticalLayout {
            for item in root.section.rows: DetailRow {
                item: item;
            }
        }
    }
}

export component JobPanel inherits Rectangle {
    if !Job.has-job: Text {
        x: 12px;
        y: 16px;
        width: parent.width - 24px;
        text: Job.empty-text;
        color: Theme.status-deleted;
        font-size: 11px;
        horizontal-alignment: center;
        wrap: word-wrap;
    }

    if Job.has-job: VerticalLayout {
        padding: 6px;
        spacing: 6px;

        HorizontalLayout {
            spacing: 6px;

            Rectangle {
                width: 8px;

                Rectangle {
                    y: (parent.height - 8px) / 2;
                    height: 8px;
                    border-radius: 4px;
                    background: QueueColors.of(Job.kind);
                }
            }

            Text {
                horizontal-stretch: 1;
                text: Job.title;
                color: Theme.text;
                font-size: 13px;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
            }

            Text {
                text: Job.state;
                color: QueueColors.of(Job.kind);
                font-size: 11px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }

        if Job.progress >= 0: Rectangle {
            height: 3px;
            border-radius: 1.5px;
            background: Theme.surface-selected;

            Rectangle {
                x: 0;
                width: parent.width * Math.clamp(Job.progress, 0, 1);
                border-radius: 1.5px;
                background: QueueColors.of(Job.kind);
            }
        }

        HorizontalLayout {
            spacing: 4px;
            alignment: start;

            if !Job.can-load: IconButton {
                icon: IconId.job-edit;
                enabled: Job.can-edit;
                checked: Job.editing;
                tooltip: Job.editing ? "The job is loaded into the editor" : "Edit the job in the editor (it is held meanwhile)";
                clicked => { Job.edit(); }
            }

            if Job.can-load: IconButton {
                icon: IconId.job-load-new;
                checked: Job.editing;
                tooltip: "Load the job into the editor; saving makes a new job";
                clicked => { Job.load-new(); }
            }

            IconButton {
                icon: IconId.play-file;
                enabled: Job.can-play;
                tooltip: "Play the output in the default player";
                clicked => { Job.play(); }
            }

            IconButton {
                icon: IconId.reveal-file;
                tooltip: "Show the output's folder in the file manager";
                clicked => { Job.reveal(); }
            }

            IconButton {
                icon: IconId.panel-logs;
                enabled: Job.can-log;
                tooltip: "Show the log in the Logs panel";
                clicked => { Job.show-log(); }
            }

            IconButton {
                icon: IconId.job-tags;
                tooltip: "Edit the tags and the rating in the Tag & Rate panel";
                clicked => { Job.edit-tags(); }
            }

            IconButton {
                icon: IconId.job-retry;
                enabled: Job.can-retry;
                tooltip: "Render the job again";
                clicked => { Job.retry(); }
            }

            IconButton {
                icon: IconId.job-duplicate;
                tooltip: "Duplicate the job (the copy waits behind it)";
                clicked => { Job.duplicate(); }
            }
        }

        Flickable {
            vertical-stretch: 1;
            content-height: sections.preferred-height;

            sections := VerticalLayout {
                alignment: start;
                spacing: 6px;

                for section in Job.sections: DetailSection {
                    section: section;
                }
            }
        }
    }
}
