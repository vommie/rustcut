// The transport bar under the timeline: play/pause, frame steps, the current and the total time with the shuttle speed,
// mute and volume (the timeline above it is the seek bar). Everything reads and calls the `Playback` global.

import { Theme } from "styles.slint";
import { AppIcon, IconId, IconSize } from "icons.slint";
import { Playback } from "player_types.slint";
import { PlayerSeekBar } from "player_seek_bar.slint";
import { TooltipHost } from "tooltip.slint";

component TransportButton inherits Rectangle {
    in property <IconId> icon;
    in property <bool> enabled: true;
    in property <length> icon-size: IconSize.md;
    in property <string> tooltip;
    in property <string> shortcut;
    callback clicked();

    width: 30px;
    height: 30px;
    border-radius: 4px;
    background: !root.enabled ? transparent
        : touch.pressed ? Theme.surface-selected
        : touch.has-hover ? Theme.surface-hover : transparent;

    host := TooltipHost {
        text: root.tooltip;
        shortcut: root.shortcut;
    }

    // Enabled even when the button is not, so a disabled button still explains itself.
    touch := TouchArea {
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                host.press();
            }
        }
        clicked => {
            if root.enabled {
                root.clicked();
            }
        }
        changed has-hover => {
            if self.has-hover {
                host.enter();
            } else {
                host.leave();
            }
        }
    }

    AppIcon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        icon: root.icon;
        size: root.icon-size;
        color: !root.enabled ? Theme.status-deleted : touch.has-hover ? Theme.text : Theme.text-muted;
    }
}

component TimeLabel inherits Text {
    color: Playback.has-file ? Theme.text : Theme.status-deleted;
    font-family: "monospace";
    font-size: 12px;
    vertical-alignment: center;
    horizontal-stretch: 0;
}

export component PlayerTransport inherits Rectangle {
    height: 40px;
    background: Theme.surface;

    Rectangle {
        y: 0;
        height: 1px;
        background: Theme.border;
    }

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 10px;
        spacing: 4px;
        alignment: stretch;

        VerticalLayout {
            alignment: center;
            TransportButton {
                icon: Playback.paused ? IconId.play : IconId.pause;
                icon-size: IconSize.lg;
                enabled: Playback.has-file;
                tooltip: Playback.paused ? "Play" : "Pause";
                shortcut: Playback.key-toggle-pause;
                clicked => { Playback.toggle-pause(); }
            }
        }

        VerticalLayout {
            alignment: center;
            TransportButton {
                icon: IconId.frame-back;
                enabled: Playback.has-video;
                tooltip: "One frame back";
                shortcut: Playback.key-frame-back;
                clicked => { Playback.frame-step(true); }
            }
        }

        VerticalLayout {
            alignment: center;
            TransportButton {
                icon: IconId.frame-forward;
                enabled: Playback.has-video;
                tooltip: "One frame forward";
                shortcut: Playback.key-frame-forward;
                clicked => { Playback.frame-step(false); }
            }
        }

        Rectangle { width: 6px; }

        TimeLabel {
            text: Playback.position-text;
        }

        TimeLabel {
            text: "/";
            color: Theme.status-deleted;
        }

        TimeLabel {
            text: Playback.duration-text;
            color: Theme.text-muted;
        }

        if Playback.speed-text != "": VerticalLayout {
            alignment: center;
            Rectangle {
                height: 18px;
                width: speed-label.preferred-width + 12px;
                border-radius: 9px;
                background: Theme.accent.with-alpha(0.18);

                speed-label := Text {
                    text: Playback.speed-text;
                    color: Theme.accent;
                    font-size: 11px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle { horizontal-stretch: 1; }

        Rectangle { width: 10px; }

        VerticalLayout {
            alignment: center;
            TransportButton {
                icon: Playback.muted ? IconId.volume-muted : IconId.volume;
                tooltip: Playback.muted ? "Sound on" : "Mute";
                shortcut: Playback.key-toggle-mute;
                clicked => { Playback.toggle-mute(); }
            }
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            PlayerSeekBar {
                width: 90px;
                track-height: 3px;
                knob-size: 10px;
                value: Playback.volume / 150;
                changed(value, final) => { Playback.set-volume(Math.round(value * 150)); }
            }
        }

        Text {
            text: Playback.volume + "%";
            width: 36px;
            color: Playback.muted ? Theme.status-deleted : Theme.text-muted;
            font-size: 11px;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
    }
}
