// The transport bar under the timeline: play/pause, frame steps, the section buttons (start, end, add), then on the
// right the normalization, the resting pointer, mute and volume, and the current and the total time with the shuttle
// speed (the timeline above it is the seek bar). What fits at the bar's width comes from `Playback.bar-fit`
// (`src/ui/control_bar/layout.rs`, P12 5.4): first the percent goes, then the slider (the speaker opens a popup), then
// the total time; below that the rest moves into a "..." menu, and the current time stands beside the play button.
// Everything reads and calls the `Playback` and `Sections` globals.

import { Theme } from "styles.slint";
import { AppIcon, IconId, IconSize } from "icons.slint";
import { BarFit, Playback, PlayerPopup } from "player_types.slint";
import { DropChevron } from "controls_drop_chevron.slint";
import { PlayerSeekBar } from "player_seek_bar.slint";
import { TooltipHost, TipRow } from "tooltip.slint";
import { Sections } from "sections_card.slint";

export component TransportButton inherits Rectangle {
    in property <IconId> icon;
    in property <bool> enabled: true;
    in property <length> icon-size: IconSize.md;
    in property <string> tooltip;
    in property <string> shortcut;
    in property <string> tip-title;
    in property <[TipRow]> tip-rows;
    in property <string> tip-note;
    // Pressed in: a switch that is on, a choice that is not "none".
    in property <bool> checked;
    // A small arrow says that a menu opens (upward).
    in property <bool> chevron;
    callback clicked();
    callback secondary-clicked();
    callback scrolled(/* delta-y */ length);

    width: root.chevron ? 42px : 30px;
    height: 30px;
    border-radius: 4px;
    background: !root.enabled ? transparent
        : touch.pressed ? Theme.surface-selected
        : root.checked ? Theme.primary.with-alpha(0.22)
        : touch.has-hover ? Theme.surface-hover : transparent;
    border-width: root.checked ? 1px : 0px;
    border-color: Theme.primary;

    host := TooltipHost {
        text: root.tooltip;
        shortcut: root.shortcut;
        title: root.tip-title;
        rows: root.tip-rows;
        note: root.tip-note;
    }

    // Enabled even when the button is not, so a disabled button still explains itself.
    touch := TouchArea {
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                host.press();
                if event.button == PointerEventButton.right && root.enabled {
                    root.secondary-clicked();
                }
            }
        }
        clicked => {
            if root.enabled {
                root.clicked();
            }
        }
        scroll-event(event) => {
            if event.delta-y == 0 {
                return reject;
            }
            root.scrolled(event.delta-y);
            accept
        }
        changed has-hover => {
            if self.has-hover {
                host.enter();
            } else {
                host.leave();
            }
        }
    }

    AppIcon {
        x: root.chevron ? 5px : (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        icon: root.icon;
        size: root.icon-size;
        color: !root.enabled ? Theme.status-deleted
            : root.checked ? Theme.primary
            : touch.has-hover ? Theme.text : Theme.text-muted;
    }

    if root.chevron: DropChevron {
        x: 26px;
        y: 0;
        height: parent.height;
        icon: IconId.chevron-up;
        size: 10px;
        color: root.checked ? Theme.primary : Theme.text-muted;
        line: root.checked ? Theme.primary.with-alpha(0.5) : Theme.text-muted.with-alpha(0.35);
    }
}

component TimeLabel inherits Text {
    color: Playback.has-file ? Theme.text : Theme.status-deleted;
    font-family: "monospace";
    font-size: 12px;
    vertical-alignment: center;
    horizontal-stretch: 0;
}

/// The current time: its right click is a menu (Open in mpv, Copy time, Go to time; P12 5.1).
component PositionLabel inherits TimeLabel {
    // The total time shows here while the bar has no room for it.
    in property <bool> tells-total;

    text: Playback.position-text;

    host := TooltipHost {
        text: (root.tells-total ? "Total " + Playback.duration-text + ". " : "") + "Right click: open in mpv, copy, go to a time";
    }

    touch := TouchArea {
        enabled: Playback.has-file;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                host.press();
                if event.button == PointerEventButton.right {
                    PlayerPopup.anchor-x = root.absolute-position.x;
                    PlayerPopup.anchor-y = root.absolute-position.y;
                    PlayerPopup.anchor-width = root.width;
                    PlayerPopup.anchor-height = root.height;
                    Playback.time-menu(root.absolute-position.x + self.mouse-x, root.absolute-position.y + self.mouse-y);
                }
            }
        }
        changed has-hover => {
            if self.has-hover {
                host.enter();
            } else {
                host.leave();
            }
        }
    }
}

/// The J/L shuttle's speed; a click returns to normal speed.
component SpeedPill inherits VerticalLayout {
    alignment: center;

    Rectangle {
        height: 18px;
        width: speed-label.preferred-width + 12px;
        border-radius: 9px;
        background: Theme.accent.with-alpha(0.18);

        host := TooltipHost {
            text: "Back to normal speed";
        }

        TouchArea {
            mouse-cursor: pointer;
            clicked => {
                host.press();
                Playback.speed-reset();
            }
            changed has-hover => {
                if self.has-hover {
                    host.enter();
                } else {
                    host.leave();
                }
            }
        }

        speed-label := Text {
            text: Playback.speed-text;
            color: Theme.accent;
            font-size: 11px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component BarSeparator inherits VerticalLayout {
    alignment: center;
    Rectangle {
        width: 1px;
        height: 20px;
        background: Theme.border;
    }
}

export component PlayerTransport inherits Rectangle {
    height: 40px;
    background: Theme.surface;

    // The widths the fit depends on: the total time is as wide as the current one, per file.
    time-width := Text {
        visible: false;
        text: Playback.duration-text;
        font-family: "monospace";
        font-size: 12px;
    }

    slash-width := Text {
        visible: false;
        text: "/";
        font-family: "monospace";
        font-size: 12px;
    }

    property <BarFit> fit: Playback.bar-fit(root.width, time-width.preferred-width, slash-width.preferred-width);
    property <bool> speed-shown: Playback.speed-text != "";
    // The speed takes the total time's place while it does not fit beside it (the volume must not jump on every L).
    property <bool> total-shown: root.fit.total && (!root.speed-shown || root.fit.spare >= 48px);

    Rectangle {
        y: 0;
        height: 1px;
        background: Theme.border;
    }

    // In a rectangle of its own: the bar follows the column, so what it shows must not widen the column.
    Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;

        HorizontalLayout {
            padding-left: 6px;
            padding-right: 10px;
            spacing: 4px;
            alignment: stretch;

            VerticalLayout {
                alignment: center;
                TransportButton {
                    icon: Playback.paused ? IconId.play : IconId.pause;
                    icon-size: IconSize.lg;
                    enabled: Playback.has-file;
                    tooltip: Playback.paused ? "Play" : "Pause";
                    shortcut: Playback.key-toggle-pause;
                    clicked => { Playback.toggle-pause(); }
                }
            }

            if root.fit.frames: VerticalLayout {
                alignment: center;
                TransportButton {
                    icon: IconId.frame-back;
                    enabled: Playback.has-video;
                    tooltip: "One frame back";
                    shortcut: Playback.key-frame-back;
                    clicked => { Playback.frame-step(true); }
                }
            }

            if root.fit.frames: VerticalLayout {
                alignment: center;
                TransportButton {
                    icon: IconId.frame-forward;
                    enabled: Playback.has-video;
                    tooltip: "One frame forward";
                    shortcut: Playback.key-frame-forward;
                    clicked => { Playback.frame-step(false); }
                }
            }

            // The sections without keys or the Sections card (user review 2026-10-27): start, end, add. Off without a
            // video; Add only while the marks make a section of at least one frame (`Sections.can-add`).
            if root.fit.sections: BarSeparator { }

            if root.fit.sections: VerticalLayout {
                alignment: center;
                TransportButton {
                    icon: IconId.section-mark-start;
                    enabled: Sections.has-media;
                    tooltip: "Set the section start here";
                    shortcut: Sections.key-set-start;
                    clicked => { Sections.set-mark(0); }
                }
            }

            if root.fit.sections: VerticalLayout {
                alignment: center;
                TransportButton {
                    icon: IconId.section-mark-end;
                    enabled: Sections.has-media;
                    tooltip: "Set the section end here";
                    shortcut: Sections.key-set-end;
                    clicked => { Sections.set-mark(1); }
                }
            }

            if root.fit.sections: VerticalLayout {
                alignment: center;
                TransportButton {
                    icon: IconId.section-add;
                    enabled: Sections.can-add;
                    tooltip: Sections.current-length == "" ? "Add the section" : "Add the section (" + Sections.current-length + ")";
                    shortcut: Sections.key-add;
                    clicked => { Sections.add(); }
                }
            }

            // In the narrowest bars the time stands beside the buttons and the volume at the right end.
            if root.fit.more: Rectangle { width: 4px; }

            if root.fit.more && root.speed-shown: SpeedPill { }

            if root.fit.more: PositionLabel {
                tells-total: true;
            }

            Rectangle { horizontal-stretch: 1; }

            // On the right (user decision 2026-11-01): normalization, pointer, a separator, the volume, then the times.
            if root.fit.audio: VerticalLayout {
                alignment: center;
                normalize := TransportButton {
                    icon: IconId.audio-normalize;
                    chevron: true;
                    checked: Playback.normalized;
                    tip-title: "Audio normalization: " + Playback.normalization-name;
                    tip-rows: [
                        { label: "Right click", value: Playback.normalized ? "None" : "Back to " + Playback.normalization-back },
                    ];
                    tip-note: "Only what you hear in RustCut, never the rendered file.";
                    shortcut: Playback.key-normalization;
                    clicked => {
                        Playback.normalization-menu(self.absolute-position.x, self.absolute-position.y, self.width, self.height);
                    }
                    secondary-clicked => { Playback.normalization-toggle(); }
                }
            }

            if root.fit.audio: VerticalLayout {
                alignment: center;
                TransportButton {
                    icon: Playback.hide-pointer ? IconId.pointer-hide : IconId.pointer-keep;
                    checked: Playback.hide-pointer;
                    tooltip: Playback.hide-pointer ? "The resting pointer hides over the video after " + Playback.hide-pointer-after
                        : "The pointer stays over the video";
                    clicked => { Playback.toggle-hide-pointer(); }
                }
            }

            if root.fit.audio: BarSeparator { }

            VerticalLayout {
                alignment: center;
                TransportButton {
                    // The speaker tells the level, also when there is no slider (P12 5.4).
                    icon: Playback.muted || Playback.volume == 0 ? IconId.volume-muted
                        : Playback.volume < 50 ? IconId.volume-low : IconId.volume;
                    tooltip: root.fit.slider ? (Playback.muted ? "Sound on" : "Mute")
                        : "Volume " + Playback.volume + "%. Right click: " + (Playback.muted ? "sound on" : "mute");
                    shortcut: Playback.key-toggle-mute;
                    clicked => {
                        if root.fit.slider {
                            Playback.toggle-mute();
                        } else {
                            PlayerPopup.anchor-x = self.absolute-position.x;
                            PlayerPopup.anchor-y = self.absolute-position.y;
                            PlayerPopup.anchor-width = self.width;
                            PlayerPopup.anchor-height = self.height;
                            PlayerPopup.volume-open = true;
                        }
                    }
                    secondary-clicked => { Playback.toggle-mute(); }
                    scrolled(delta) => { Playback.wheel(delta); }
                }
            }

            if root.fit.slider: VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                PlayerSeekBar {
                    width: 90px;
                    track-height: 3px;
                    knob-size: 10px;
                    value: Playback.volume / 100;
                    // It clings to 25, 50, 75 and 100 % (Ctrl drags freely; user review 2026-10-27).
                    snap-step: 0.25;
                    snap-range: 0.03;
                    wheel: true;
                    changed(value, final) => { Playback.set-volume(Math.round(value * 100)); }
                    scrolled(delta) => { Playback.wheel(delta); }
                }
            }

            if root.fit.percent: Text {
                text: Playback.volume + "%";
                width: 36px;
                color: Playback.muted ? Theme.status-deleted : Theme.text-muted;
                font-size: 11px;
                vertical-alignment: center;
                horizontal-alignment: right;
            }

            if !root.fit.more: Rectangle { width: 14px; }

            if !root.fit.more && root.speed-shown: SpeedPill { }

            if !root.fit.more: PositionLabel {
                tells-total: !root.total-shown;
            }

            if root.total-shown: TimeLabel {
                text: "/";
                color: Theme.status-deleted;
            }

            if root.total-shown: TimeLabel {
                text: Playback.duration-text;
                color: Theme.text-muted;
            }

            if root.fit.more: VerticalLayout {
                alignment: center;
                TransportButton {
                    icon: IconId.bar-more;
                    tooltip: "More controls";
                    clicked => {
                        Playback.more-menu(self.absolute-position.x, self.absolute-position.y, self.width, self.height, root.fit);
                    }
                }
            }
        }
    }
}
