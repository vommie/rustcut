// The question when RustCut is closed while it renders (src/ui/power/ fills `Power`; user decisions Q-P1, Q-P3). The
// countdown after the queue is a notice (M6.5, `Kind::PowerCountdown`).

export global Power {
    // The close question is open; `ask-done`: the queue answered it and RustCut quits by itself soon (Q-P3).
    in property <bool> asking;
    in property <bool> ask-done;
    in property <string> ask-text;
    callback keep();
    callback quit-when-done();
    callback quit-now();
}
