// A choice of several values shared by the panels (the queue's filter menu, P9.6); moved out of `controls_choice.slint`
// when the long choice list made that file too long (0.0.106).

import { DropChevron } from "controls_drop_chevron.slint";
import { Theme } from "styles.slint";
import { AppIcon, IconId, IconSize } from "icons.slint";
import { TooltipHost } from "tooltip.slint";

/// One entry of a `MultiChoiceButton`: its text, a muted detail on the right (a count), whether it is picked, and a
/// tone (-1 = none) whose symbol and color the owner gives (`tone-icon`, `tone-color`; the queue's job states).
export struct MultiChoiceItem {
    label: string,
    detail: string,
    on: bool,
    tone: int,
}

/// A choice of several values (the queue's filter menu, P9.6): the first entry (`everything`) picks none, a click on an
/// entry picks only it and closes the list, Ctrl+click adds or takes off one value and leaves the list open (Q-P9).
/// The owner says what the button shows (`text`).
export component MultiChoiceButton inherits Rectangle {
    in property <[MultiChoiceItem]> items;
    in property <string> text;
    in property <string> everything;
    in property <string> tooltip;
    in property <bool> enabled: true;
    in property <IconId> icon: IconId.none;
    // An entry was clicked (-1 = `everything`), with Ctrl or without.
    callback picked(/* entry */ int, /* control */ bool);
    // The symbol and color of an entry's tone (shown in a column before the labels when an entry has one).
    pure callback tone-icon(int) -> IconId;
    pure callback tone-color(int) -> color;

    property <bool> any-on: root.text != root.everything;

    height: 24px;
    min-width: 48px;
    horizontal-stretch: 1;
    border-radius: 4px;
    background: !root.enabled ? transparent : touch.pressed ? Theme.surface-selected
        : touch.has-hover ? Theme.surface-hover : Theme.surface;
    border-width: 1px;
    border-color: root.any-on && root.enabled ? Theme.primary.with-alpha(0.7) : Theme.border;

    host := TooltipHost {
        text: root.tooltip;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            host.press();
            popup.show();
        }
        changed has-hover => {
            if self.has-hover {
                host.enter();
            } else {
                host.leave();
            }
        }
    }

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 4px;
        spacing: 4px;

        if root.icon != IconId.none: VerticalLayout {
            alignment: center;
            AppIcon {
                icon: root.icon;
                size: IconSize.sm;
                color: !root.enabled ? Theme.status-deleted : root.any-on ? Theme.primary : Theme.text-muted;
            }
        }

        Text {
            text: root.text;
            color: !root.enabled ? Theme.status-deleted : root.any-on ? Theme.text : Theme.text-muted;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            min-width: 16px;
        }

        DropChevron { }
    }

    // As wide as its longest entry, at least as wide as the button; a Ctrl+click keeps it open.
    popup := PopupWindow {
        x: 0;
        y: root.height + 2px;
        width: Math.max(root.width, list.preferred-width);
        height: list.preferred-height;
        close-policy: close-on-click-outside;

        Rectangle {
            background: Theme.surface;
            border-radius: 4px;
            border-width: 1px;
            border-color: Theme.border;

            list := VerticalLayout {
                padding: 3px;
                spacing: 1px;

                for index in root.items.length + 1: entry := Rectangle {
                    property <bool> on: index == 0 ? !root.any-on : root.items[index - 1].on;
                    property <bool> control;
                    height: 22px;
                    border-radius: 3px;
                    background: item-touch.has-hover ? Theme.surface-hover : transparent;

                    item-touch := TouchArea {
                        pointer-event(event) => {
                            if event.kind == PointerEventKind.down {
                                entry.control = event.modifiers.control;
                            }
                        }
                        clicked => {
                            root.picked(index - 1, entry.control && index > 0);
                            if !entry.control || index == 0 {
                                popup.close();
                            }
                        }
                    }

                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 10px;
                        spacing: 6px;

                        Rectangle {
                            width: 14px;

                            if entry.on: AppIcon {
                                y: (parent.height - self.height) / 2;
                                icon: IconId.check;
                                size: IconSize.sm;
                                color: Theme.primary;
                            }
                        }

                        if index > 0 && root.items[index - 1].tone >= 0: VerticalLayout {
                            alignment: center;

                            AppIcon {
                                icon: root.tone-icon(root.items[index - 1].tone);
                                size: IconSize.sm;
                                color: root.tone-color(root.items[index - 1].tone);
                            }
                        }

                        Text {
                            text: index == 0 ? root.everything : root.items[index - 1].label;
                            color: Theme.text;
                            font-size: 12px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        if index > 0: Text {
                            text: root.items[index - 1].detail;
                            color: Theme.text-muted;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
