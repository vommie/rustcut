// Started as a copy of RustView's crates/rustview/ui/tag_history_panel.slint. RustCut's own since 0.0.72 (no parity check any more, user decision 2026-10-27): change it here freely.

import { Theme } from "styles.slint";
import { TagHistoryItemModel } from "tag_types.slint";
import { TagHistoryItemView } from "tag_history_item.slint";
import { SmoothScrollArea } from "smooth_scroll_view.slint";
import { CollapsiblePanel } from "collapsible_panel.slint";

export { TagHistoryItemView } from "tag_history_item.slint";

/// Collapsible Assigned Tags History panel inheriting from the unified CollapsiblePanel component.
/// Supports smooth ease-in-out height animation, interactive dragging without animation lag,
/// horizontal flow wrapping, and scrollable rows. RustCut 0.0.72: the pills stand at the places Rust computed
/// (`pills`, stable rows) and glide to new places, so a tag used again visibly moves to the front (user request
/// 2026-10-27; a FLIP-style layout animation through Slint's own property animation).
export component TagHistoryPanel inherits CollapsiblePanel {
    in property <[TagHistoryItemModel]> pills: [];
    in property <length> pills-height;
    // Moves glide, except right after the panel's width changed (the pills then follow its edge at once).
    property <bool> settled: true;
    in property <int> tag-count: 0;
    in property <bool> has-selection: true;

    callback tag-clicked(int /* tag_id */);
    callback geometry-changed(length /* available_width */);
    callback pill-measured(int /* tag_id */, bool /* check */, length /* natural width */);

    title: "TAG HISTORY";
    count-badge: root.tag-count > 0 ? (root.tag-count + "") : "";

    changed width => {
        if self.width > 20px {
            root.settled = false;
            // `restart()` alone does nothing on a stopped timer.
            settle.running = true;
            settle.restart();
            root.geometry-changed(self.width);
        }
    }

    settle := Timer {
        interval: 300ms;
        running: false;
        triggered => {
            self.running = false;
            root.settled = true;
        }
    }

    Rectangle {
        width: 100%;
        height: 100%;

        if root.pills.length == 0 : VerticalLayout {
            alignment: center;
            Text {
                text: "No recent tags in history";
                font-size: 10px;
                color: Theme.text-muted;
                horizontal-alignment: center;
            }
        }

        if root.pills.length > 0 : SmoothScrollArea {
            width: 100%;
            height: 100%;
            enable-horizontal: false;
            enable-vertical: true;
            content-width: self.width;
            content-height: root.pills-height + 8px;
            scrollbar-size: 6px;

            // Placed at the top left (a bare child of a plain element would be centered).
            Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: root.pills-height + 8px;

                for item in root.pills : TagHistoryItemView {
                    x: 6px + item.x;
                    y: 4px + item.y;
                    width: item.width;
                    // The newest pill lies over the others while it glides to the front.
                    z: item.front ? 1 : 0;
                    item: item;
                    is-enabled: root.has-selection;

                    animate x, y {
                        duration: root.settled ? 260ms : 0ms;
                        easing: ease-in-out;
                    }

                    init => {
                        root.pill-measured(item.id, item.is-assigned || item.is-partial, self.natural-width);
                    }
                    changed natural-width => {
                        root.pill-measured(item.id, item.is-assigned || item.is-partial, self.natural-width);
                    }
                    clicked => {
                        root.tag-clicked(item.id);
                    }
                }
            }
        }
    }
}
