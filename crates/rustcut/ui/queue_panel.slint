// The queue panel (src/ui/queue/ fills `Queue`; HANDOFF 8.Q, M4.1): the processing switches with the queue's summary
// and the overall progress of the current run, the search and the state chips, the list (compact two-line rows in a
// narrow sidebar, a table with more columns as it gets wider), and the actions for the selected jobs. Several jobs can
// be selected (Ctrl, Shift), dragged to another place, and reached through the context menu; removing and canceling
// are held (hold.slint, user decision Q-Q4).

import { Theme } from "styles.slint";
import { AppIcon, IconId, IconSize } from "icons.slint";
import { IconButton, UpDownButton } from "controls.slint";
import { TooltipHost } from "tooltip.slint";
import { SearchField } from "search_field.slint";
import { Export } from "export_types.slint";
import { Queue, QueueChipView } from "queue_types.slint";
import { QueueColors, QueueHeader, QueueRow } from "queue_row.slint";
import { Jump } from "jump.slint";
import { DragGhost, DragLogic, DropGap } from "drag.slint";

component Chip inherits Rectangle {
    in property <QueueChipView> chip;
    in property <int> kind;

    height: 20px;
    width: row.preferred-width + 12px;
    border-radius: 10px;
    background: root.chip.on ? Theme.primary.with-alpha(0.22) : touch.has-hover ? Theme.surface-hover : Theme.surface;
    border-width: 1px;
    border-color: root.chip.on ? Theme.primary : Theme.border;

    host := TooltipHost {
        text: (root.chip.on ? "Showing " : "Show only ") + root.chip.title.to-lowercase() + " jobs (" + root.chip.count + ")";
    }

    row := HorizontalLayout {
        x: 6px;
        spacing: 4px;

        Rectangle {
            width: 7px;

            Rectangle {
                y: (parent.height - 7px) / 2;
                height: 7px;
                border-radius: 3.5px;
                background: QueueColors.of(root.kind);
            }
        }

        Text {
            text: root.chip.count;
            color: root.chip.count == 0 ? Theme.status-deleted : Theme.text;
            font-size: 11px;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => {
            host.press();
            Queue.toggle-chip(root.chip.id);
        }
        changed has-hover => {
            if self.has-hover {
                host.enter();
            } else {
                host.leave();
            }
        }
    }
}

export component QueuePanel inherits Rectangle {
    property <length> row-step: Queue.row-height + 2px;
    // The pointer of a drag, from the list's top edge (the edge scrolling asks with it).
    property <length> drag-pointer;

    // The width reaches Rust once more after the panel was created: a `changed width` during the dock's first layout
    // can come before the handler is connected (M3.2).
    Timer {
        interval: 50ms;
        running: true;
        triggered => {
            self.running = false;
            Queue.width-changed(list-area.width);
        }
    }

    VerticalLayout {
        padding: 6px;
        spacing: 6px;

        if Queue.temporary-line != "": Rectangle {
            border-radius: 4px;
            background: temporary-touch.has-hover ? Theme.status-corrupt.with-alpha(0.24)
                : Theme.status-corrupt.with-alpha(0.16);
            border-width: 1px;
            border-color: Theme.status-corrupt.with-alpha(0.7);
            min-height: temporary-row.min-height;

            temporary-touch := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { Queue.temporary-clicked(); }
            }

            temporary-row := HorizontalLayout {
                padding: 5px;
                spacing: 6px;

                AppIcon {
                    icon: IconId.status-error;
                    size: IconSize.sm;
                    color: Theme.status-corrupt;
                }

                Text {
                    horizontal-stretch: 1;
                    text: Queue.temporary-line + " Click for the ways out.";
                    color: Theme.text;
                    font-size: 11px;
                    wrap: word-wrap;
                }
            }
        }

        // Processing, summary, overall progress.
        HorizontalLayout {
            spacing: 4px;

            IconButton {
                icon: Queue.paused ? IconId.queue-resume : IconId.queue-pause;
                checked: Queue.paused;
                tooltip: Queue.paused ? "Processing is paused: resume" : "Pause processing (running renders stop where they are)";
                clicked => { Queue.toggle-paused(); }
            }

            IconButton {
                icon: IconId.queue-pause-after;
                checked: Queue.pause-after;
                tooltip: Queue.pause-after ? "Pausing after the running jobs: keep going instead"
                    : "Pause after the running jobs (they finish, nothing new starts)";
                clicked => { Queue.toggle-pause-after(); }
            }

            when-done := IconButton {
                icon: IconId.when-done;
                checked: Queue.when-done != 0;
                tooltip: Queue.when-done-tip;
                clicked => {
                    Queue.when-done-menu(when-done.absolute-position.x, when-done.absolute-position.y + when-done.height);
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;

                Text {
                    text: Queue.has-overall ? Queue.overall-text : Queue.summary;
                    color: Theme.text-muted;
                    font-size: 11px;
                    overflow: elide;
                }

                if Queue.has-overall: Rectangle {
                    height: 3px;
                    border-radius: 1.5px;
                    background: Theme.surface-selected;

                    Rectangle {
                        x: 0;
                        width: parent.width * Math.clamp(Queue.overall, 0, 1);
                        border-radius: 1.5px;
                        background: Queue.paused ? Theme.accent : Theme.primary;
                    }
                }
            }
        }

        // Search and state chips.
        HorizontalLayout {
            spacing: 4px;

            search := SearchField {
                horizontal-stretch: 1;
                // The field keeps this width: the row's width without the buttons beside it.
                field-width: Math.max(60px, parent.width - 30px);
                text: Queue.search;
                placeholder-text: "Search jobs";
                enable-regex-toggle: false;
                show-search-icon: true;
                clear-tooltip: "Clear the search (Esc)";
                search-changed(text) => { Queue.search-edited(text); }
                cleared => { Queue.search-edited(""); }
            }

            IconButton {
                icon: IconId.filter-clear;
                enabled: Queue.filtered;
                tooltip: Queue.filtered ? Queue.filter-note + ": show every job" : "Every job is shown";
                clicked => { Queue.clear-filter(); }
            }
        }

        HorizontalLayout {
            spacing: 4px;
            alignment: start;

            for chip[i] in Queue.chips: Chip {
                chip: chip;
                // waiting, running, held, finished, failed, canceled -> the colors of their states
                kind: i == 0 ? 0 : i == 1 ? 2 : i == 2 ? 1 : i == 3 ? 4 : i == 4 ? 5 : 6;
            }
        }

        if !Queue.compact: QueueHeader { }

        list-area := Rectangle {
            vertical-stretch: 1;

            changed width => {
                Queue.width-changed(self.width);
            }

            flick := Flickable {
                content-height: list.preferred-height;
                // While jobs are dragged the list does not take the gesture for scrolling (the edges scroll it).
                interactive: !Queue.dragging;

                // A jump mark reached a job of this list: it scrolls into view (`jump.slint`).
                property <int> jump: Jump.target-serial;
                changed jump => {
                    if Jump.inside(self.absolute-position.x, self.width, self.absolute-position.y + self.content-y, self.content-height) {
                        self.content-y = Jump.scroll-to(self.absolute-position.y + self.content-y, self.content-y, self.height, self.content-height);
                    }
                }

                list := VerticalLayout {
                    alignment: start;
                    spacing: 2px;

                    for job[i] in Queue.rows: QueueRow {
                        job: job;
                        index: i;
                        drag-shift: i < Queue.drag-shifts.length ? Queue.drag-shifts[i] : 0px;
                        lifted: Queue.dragging && job.selected;
                        // Drag & drop (P9.4): window coordinates turn into the list's content coordinates.
                        drag-started(y) => {
                            Queue.drag-start(i, y - list.absolute-position.y, root.row-step, Queue.row-height);
                        }
                        drag-moved(y) => {
                            root.drag-pointer = y - flick.absolute-position.y;
                            Queue.drag-move(y - list.absolute-position.y);
                        }
                        drag-ended => { Queue.drag-end(); }
                    }
                }

                // Where the dragged jobs would land (the other rows moved aside).
                if Queue.dragging: DropGap {
                    x: 4px;
                    y: Queue.drag-gap-y;
                    width: parent.width - 8px;
                    height: Math.max(0px, Queue.drag-gap-height - 2px);
                }
            }

            // The dragged jobs under the pointer.
            if Queue.dragging: DragGhost {
                x: 4px;
                y: Queue.drag-ghost-y + flick.content-y;
                width: parent.width - 8px;
                height: Queue.row-height;
                title: Queue.drag-title;
                detail: Queue.drag-detail;
                count: Queue.drag-count;
            }

            // Near the top and bottom edge the list scrolls along, faster toward the edge.
            Timer {
                interval: 16ms;
                running: Queue.dragging;
                triggered => {
                    let step = DragLogic.scroll-step(root.drag-pointer, flick.height);
                    let to = Math.max(Math.min(0px, flick.height - flick.content-height),
                        Math.min(0px, flick.content-y - step));
                    // Only a real move: setting the same place again would end the row's pointer grab.
                    if to != flick.content-y {
                        flick.content-y = to;
                        Queue.drag-move(root.drag-pointer - flick.content-y);
                    }
                }
            }

            if Queue.rows.length == 0: Text {
                y: 12px;
                width: parent.width;
                text: Queue.empty-text;
                color: Theme.status-deleted;
                font-size: 11px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            // A right click below the rows: the menu for the selection.
            TouchArea {
                y: list.preferred-height + flick.content-y;
                height: Math.max(0px, parent.height - self.y);
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                        Queue.context-menu(-1, self.absolute-position.x + self.mouse-x,
                            self.absolute-position.y + self.mouse-y);
                    }
                }
            }
        }

        // Actions for the selected jobs.
        HorizontalLayout {
            spacing: 4px;

            UpDownButton {
                up-enabled: Queue.can-move-up;
                down-enabled: Queue.can-move-down;
                up-tooltip: Queue.move-up-tooltip;
                down-tooltip: Queue.move-down-tooltip;
                up-shortcut: Queue.key-move-up;
                down-shortcut: Queue.key-move-down;
                up => { Queue.move-up(); }
                down => { Queue.move-down(); }
            }

            IconButton {
                icon: IconId.job-hold;
                enabled: Queue.can-hold;
                checked: Queue.held;
                tooltip: Queue.hold-tooltip;
                clicked => { Queue.toggle-hold(); }
            }

            edit-button := IconButton {
                icon: IconId.job-edit;
                enabled: Queue.can-edit;
                tooltip: "Load the job into the editor: saving makes a new job, this one stays as it is";
                clicked => { Queue.edit(); }
            }

            IconButton {
                icon: IconId.job-tags;
                enabled: Queue.can-edit-tags;
                tooltip: "Edit the job's tags and rating in the Tag & Rate panel";
                clicked => { Queue.edit-tags(); }
            }

            IconButton {
                icon: IconId.job-retry;
                enabled: Queue.can-retry;
                tooltip: Queue.retry-tooltip;
                clicked => { Queue.retry(); }
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            IconButton {
                icon: IconId.job-cancel;
                enabled: Queue.can-cancel;
                hold: true;
                tooltip: Queue.cancel-tooltip;
                clicked => { Queue.cancel(); }
            }

            IconButton {
                icon: IconId.job-remove;
                enabled: Queue.can-remove;
                hold: true;
                tooltip: Queue.remove-tooltip;
                clicked => { Queue.remove(); }
            }

            IconButton {
                icon: IconId.remove-finished;
                enabled: Queue.can-remove-finished;
                hold: true;
                tooltip: Queue.remove-finished-tooltip;
                clicked => { Queue.remove-finished(); }
            }
        }
    }
}
