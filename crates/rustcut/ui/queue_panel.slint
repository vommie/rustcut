// The queue panel (src/ui/queue/ fills `Queue`; HANDOFF 8.Q, M4.1, P9.6): the processing switches and the filter button
// (its menu is `queue_filter.slint`) on top, the list (compact two-line rows in a narrow sidebar, a table with more
// columns as it gets wider), the queue's summary with the overall progress of the current run under it, and the
// actions for the selected jobs. Several jobs can be selected (Ctrl, Shift), dragged to another place, and reached
// through the context menu (the empty space has its own); removing and canceling are held (hold.slint, Q-Q4).

import { ListView } from "std-widgets.slint";
import { Theme } from "styles.slint";
import { AppIcon, IconId, IconSize } from "icons.slint";
import { IconButton, UpDownButton } from "controls.slint";
import { Export } from "export_types.slint";
import { Queue, QueueTotalView } from "queue_types.slint";
import { TooltipArea } from "tooltip.slint";
import { MenuTints } from "context_menu.slint";
import { QueueColors, QueueHeader, QueueRow } from "queue_row.slint";
import { Jump } from "jump.slint";
import { DragGhost, DragLogic, DropGap } from "drag.slint";

/// A state's symbol in its color with the count in a small badge at its upper right; the tooltip says it in words.
component TotalSymbol inherits Rectangle {
    in property <QueueTotalView> total;

    width: IconSize.sm + badge.width - 4px;

    TooltipArea {
        text: root.total.tooltip;

        AppIcon {
            x: 0;
            y: (parent.height - self.height) / 2;
            icon: QueueColors.icon(root.total.kind);
            size: IconSize.sm;
            color: QueueColors.of(root.total.kind);
        }

        badge := Rectangle {
            x: IconSize.sm - 4px;
            y: -2px;
            width: Math.max(13px, count.preferred-width + 6px);
            height: 13px;
            border-radius: 6.5px;
            background: QueueColors.of(root.total.kind);
            border-width: 1px;
            border-color: Theme.surface;

            count := Text {
                text: root.total.count;
                color: Theme.background;
                font-size: 9px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

export component QueuePanel inherits Rectangle {
    // A narrow sidebar shows a job's state as its colored symbol only, from 450 px with its word (user review
    // 2026-10-27).
    property <bool> state-words: root.width >= 450px;
    property <length> row-step: Queue.row-height + 2px;
    // The list's whole height (every row has the same pitch).
    property <length> content-height: Queue.rows.length * root.row-step;
    // The pointer of a drag, from the list's top edge (the edge scrolling asks with it).
    property <length> drag-pointer;
    // The list follows new jobs while it stands at the bottom (user request 2026-10-27): scrolled up it stays where
    // it is until it is scrolled to the bottom again. It starts at the bottom. Setting `queue.follow_new_jobs`.
    // The ListView's own scroll range (it learns a new row's height a moment after the model grew; measured against
    // `content-height` a jump to the bottom was clamped and switched the following off).
    property <length> bottom-y: Math.min(0px, flick.visible-height - flick.content-height);
    property <bool> follow: true;

    // The width reaches Rust once more after the panel was created: a `changed width` during the dock's first layout
    // can come before the handler is connected (M3.2).
    Timer {
        interval: 50ms;
        running: true;
        triggered => {
            self.running = false;
            Queue.width-changed(list-area.width);
        }
    }

    VerticalLayout {
        padding: 6px;
        spacing: 6px;

        if Queue.temporary-line != "": Rectangle {
            border-radius: 4px;
            background: temporary-touch.has-hover ? Theme.status-corrupt.with-alpha(0.24)
                : Theme.status-corrupt.with-alpha(0.16);
            border-width: 1px;
            border-color: Theme.status-corrupt.with-alpha(0.7);
            min-height: temporary-row.min-height;

            temporary-touch := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { Queue.temporary-clicked(); }
            }

            temporary-row := HorizontalLayout {
                padding: 5px;
                spacing: 6px;

                AppIcon {
                    icon: IconId.status-error;
                    size: IconSize.sm;
                    color: Theme.status-corrupt;
                }

                Text {
                    horizontal-stretch: 1;
                    text: Queue.temporary-line + " Click for the ways out.";
                    color: Theme.text;
                    font-size: 11px;
                    wrap: word-wrap;
                }
            }
        }

        // Processing and what happens when the queue finishes; the filter on the right.
        HorizontalLayout {
            spacing: 4px;

            IconButton {
                icon: Queue.paused ? IconId.queue-resume : IconId.queue-pause;
                checked: Queue.paused;
                tooltip: Queue.paused ? "Processing is paused: resume" : "Pause processing (running renders stop where they are)";
                clicked => { Queue.toggle-paused(); }
            }

            IconButton {
                icon: IconId.queue-pause-after;
                checked: Queue.pause-after;
                // Only while a job renders and processing runs (review 2); switched on, it can always be switched off.
                enabled: Queue.pause-after || Queue.can-pause-after;
                tooltip: Queue.pause-after ? "Pausing after the running jobs: keep going instead"
                    : "Pause after the running jobs (they finish, nothing new starts)";
                clicked => { Queue.toggle-pause-after(); }
            }

            when-done := IconButton {
                icon: IconId.when-done;
                tooltip: Queue.when-done-tip;
                clicked => {
                    Queue.when-done-menu(self.absolute-position.x, self.absolute-position.y, self.width, self.height);
                }
                secondary-clicked => { Queue.when-done-reset(); }

                // A dot in the chosen entry's color while one is chosen (the bell's badge is the model).
                if Queue.when-done != 0: Rectangle {
                    x: parent.width - 9px;
                    y: 2px;
                    width: 7px;
                    height: 7px;
                    border-radius: 3.5px;
                    background: MenuTints.of(Queue.when-done);
                    border-width: 1px;
                    border-color: Theme.surface;
                }
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            filter-button := IconButton {
                icon: IconId.queue-filter;
                checked: Queue.filter-open || Queue.filtered;
                tooltip: Queue.filter-count == 0 ? "Filter the jobs"
                    : Queue.filter-note + " (a right click shows every job)";
                clicked => {
                    Queue.filter-anchor-x = self.absolute-position.x;
                    Queue.filter-anchor-y = self.absolute-position.y;
                    Queue.filter-anchor-width = self.width;
                    Queue.filter-anchor-height = self.height;
                    Queue.filter-open = !Queue.filter-open;
                }
                secondary-clicked => {
                    Queue.filter-open = false;
                    Queue.clear-filter();
                }

                // How many filters are set.
                if Queue.filter-count > 0: Rectangle {
                    x: parent.width - self.width + 4px;
                    y: -4px;
                    width: Math.max(14px, badge.preferred-width + 6px);
                    height: 14px;
                    border-radius: 7px;
                    background: Theme.primary;

                    badge := Text {
                        text: Queue.filter-count;
                        color: Theme.background;
                        font-size: 9px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        if !Queue.compact: QueueHeader { }

        list-area := Rectangle {
            vertical-stretch: 1;

            changed width => {
                Queue.width-changed(self.width);
            }

            // A ListView creates only the rows in view (review 2: hundreds of jobs; measured in ~/claude/slint-lab:
            // 0.6 ms per frame with 10 000 rows, a plain `for` needed 96 ms). It does not pan with a mouse drag, so a
            // drag of jobs keeps the pointer.
            flick := ListView {
                // A jump mark reached a job of this list: it scrolls into view (`jump.slint`).
                property <int> jump: Jump.target-serial;
                changed jump => {
                    if Jump.inside(self.absolute-position.x, self.width, self.absolute-position.y + self.content-y, root.content-height) {
                        self.content-y = Jump.scroll-to(self.absolute-position.y + self.content-y, self.content-y, self.visible-height, root.content-height);
                    }
                }

                // The rows never grow wider than the list (a long name is cut, the state stays visible).
                horizontal-scrollbar-policy: always-off;

                changed content-y => {
                    root.follow = self.content-y <= root.bottom-y + 1px;
                }
                changed content-height => {
                    if root.follow && Queue.follow-new {
                        self.content-y = root.bottom-y;
                    }
                }
                changed visible-height => {
                    if root.follow && Queue.follow-new {
                        self.content-y = root.bottom-y;
                    }
                }

                for job[i] in Queue.rows: Rectangle {
                    width: flick.visible-width;
                    height: root.row-step;

                    QueueRow {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        job: job;
                        index: i;
                        state-words: root.state-words;
                        drag-shift: i < Queue.drag-shifts.length ? Queue.drag-shifts[i] : 0px;
                        lifted: Queue.dragging && job.selected;
                        // Drag & drop (P9.4): window coordinates turn into the list's content coordinates.
                        drag-started(y) => {
                            Queue.drag-start(i, y - flick.absolute-position.y - flick.content-y, root.row-step, Queue.row-height);
                        }
                        drag-moved(y) => {
                            root.drag-pointer = y - flick.absolute-position.y;
                            Queue.drag-move(y - flick.absolute-position.y - flick.content-y);
                        }
                        drag-ended => { Queue.drag-end(); }
                    }
                }
            }

            // Where the dragged jobs would land (the other rows moved aside).
            if Queue.dragging: DropGap {
                x: 4px;
                y: Queue.drag-gap-y + flick.content-y;
                width: parent.width - 8px;
                height: Math.max(0px, Queue.drag-gap-height - 2px);
            }

            // The dragged jobs under the pointer.
            if Queue.dragging: DragGhost {
                x: 4px;
                y: Queue.drag-ghost-y + flick.content-y;
                width: parent.width - 8px;
                height: Queue.row-height;
                title: Queue.drag-title;
                detail: Queue.drag-detail;
                count: Queue.drag-count;
            }

            // Near the top and bottom edge the list scrolls along, faster toward the edge.
            Timer {
                interval: 16ms;
                running: Queue.dragging;
                triggered => {
                    let step = DragLogic.scroll-step(root.drag-pointer, flick.visible-height);
                    let to = Math.max(Math.min(0px, flick.visible-height - root.content-height),
                        Math.min(0px, flick.content-y - step));
                    // Only a real move: setting the same place again would end the row's pointer grab.
                    if to != flick.content-y {
                        flick.content-y = to;
                        Queue.drag-move(root.drag-pointer - flick.content-y);
                    }
                }
            }

            if Queue.rows.length == 0: Text {
                y: 12px;
                width: parent.width;
                text: Queue.empty-text;
                color: Theme.status-deleted;
                font-size: 11px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            // Below the rows: a click clears the selection, a right click opens the menu for every job.
            TouchArea {
                y: root.content-height + flick.content-y;
                height: Math.max(0px, parent.height - self.y);
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                        Queue.context-menu(-1, self.absolute-position.x + self.mouse-x,
                            self.absolute-position.y + self.mouse-y);
                    }
                }
                clicked => { Queue.clear-selection(); }
            }
        }

        // The queue's summary and the overall progress of the current run (P9.6: under the list).
        VerticalLayout {
            vertical-stretch: 0;
            spacing: 2px;

            // A colored symbol per state that occurs with its count in a small raised badge, then the run's progress
            // (review 2). Symbols and text share one centered line; the badges sit above it.
            HorizontalLayout {
                height: 18px;
                spacing: 6px;

                for total in Queue.totals: TotalSymbol {
                    total: total;
                }

                Text {
                    horizontal-stretch: 1;
                    text: Queue.has-overall ? Queue.overall-text : Queue.summary;
                    color: Theme.text-muted;
                    font-size: 11px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            if Queue.has-overall: Rectangle {
                height: 3px;
                border-radius: 1.5px;
                background: Theme.surface-selected;

                Rectangle {
                    x: 0;
                    width: parent.width * Math.clamp(Queue.overall, 0, 1);
                    border-radius: 1.5px;
                    background: Queue.paused ? Theme.accent : Theme.primary;
                }
            }
        }

        // Actions for the selected jobs.
        HorizontalLayout {
            spacing: 4px;

            UpDownButton {
                up-enabled: Queue.can-move-up;
                down-enabled: Queue.can-move-down;
                up-tooltip: Queue.move-up-tooltip;
                down-tooltip: Queue.move-down-tooltip;
                up-shortcut: Queue.key-move-up;
                down-shortcut: Queue.key-move-down;
                up => { Queue.move-up(); }
                down => { Queue.move-down(); }
            }

            IconButton {
                icon: IconId.job-hold;
                enabled: Queue.can-hold;
                checked: Queue.held;
                tooltip: Queue.hold-tooltip;
                clicked => { Queue.toggle-hold(); }
            }

            edit-button := IconButton {
                icon: IconId.job-edit;
                enabled: Queue.can-edit;
                tooltip: "Load the job into the editor: saving makes a new job, this one stays as it is";
                clicked => { Queue.edit(); }
            }

            IconButton {
                icon: IconId.job-tags;
                enabled: Queue.can-edit-tags;
                tooltip: "Edit the job's tags and rating in the Tag & Rate panel";
                clicked => { Queue.edit-tags(); }
            }

            IconButton {
                icon: IconId.job-retry;
                enabled: Queue.can-retry;
                tooltip: Queue.retry-tooltip;
                clicked => { Queue.retry(); }
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            IconButton {
                icon: IconId.job-cancel;
                enabled: Queue.can-cancel;
                hold: true;
                tooltip: Queue.cancel-tooltip;
                clicked => { Queue.cancel(); }
            }

            IconButton {
                icon: IconId.job-remove;
                enabled: Queue.can-remove;
                hold: true;
                tooltip: Queue.remove-tooltip;
                clicked => { Queue.remove(); }
            }

            IconButton {
                icon: IconId.remove-finished;
                enabled: Queue.can-remove-finished;
                hold: true;
                tooltip: Queue.remove-finished-tooltip;
                clicked => { Queue.remove-finished(); }
            }
        }
    }
}
