// The Job Finalization card of the Export panel (src/ui/export/ fills `Export`; P9.7, the UI review's notes 03): two rows
// in three columns that line up: the name (the chosen container's extension dim inside it), the counter (empty = no
// counter) and the auto-increment toggle; the target folder (the source's folder or a named one), the jump to the
// folder list in Settings > Export & Naming, and Save. The live conflict check shows as bubbles at the name and the
// folder; clearing the sections after a save is in the Sections card's header (P9.5). Buttons are icons with tooltips
// (user rule 2026-10-23).

import { Theme } from "styles.slint";
import { IconId } from "icons.slint";
import { Shortcuts } from "shortcuts.slint";
import { ChoiceButton, IconButton, NumberField } from "controls.slint";
import { TooltipHost } from "tooltip.slint";
import { Export } from "export_types.slint";
import { BubbleAnchor } from "bubble.slint";
import { Playback } from "player_types.slint";

/// The name: shows the text, a click turns it into a field whose every edit updates the file name at once.
component NameField inherits Rectangle {
    in property <string> text;
    // The file's extension, dim at the right inside the field (".mkv").
    in property <string> suffix;
    in property <bool> enabled: true;
    callback edited(string);

    property <bool> editing;
    property <length> suffix-width: root.suffix == "" ? 0px : suffix-label.preferred-width + 6px;

    // As high as the row's counter and button (the layout stretches it; review 2).
    min-width: 40px;
    min-height: 22px;
    horizontal-stretch: 1;
    border-radius: 4px;
    background: root.editing ? Theme.background : touch.has-hover && root.enabled ? Theme.surface-hover : Theme.surface;
    border-width: 1px;
    border-color: root.editing ? Theme.primary : Theme.border;

    host := TooltipHost {
        text: "Name of the output (the naming template adds the counter)";
    }

    // The live check of the target (M6.5c); none while the card is dimmed for want of a playable video (M6.5e).
    BubbleAnchor {
        key: Playback.has-video ? "export.name" : "";
    }

    suffix-label := Text {
        x: parent.width - self.width - 5px;
        height: parent.height;
        text: root.suffix;
        color: Theme.status-deleted;
        font-size: 12px;
        vertical-alignment: center;
    }

    if !root.editing: Text {
        x: 5px;
        width: parent.width - 10px - root.suffix-width;
        text: root.text == "" ? "Name" : root.text;
        color: !root.enabled || root.text == "" ? Theme.status-deleted : Theme.text;
        font-size: 12px;
        vertical-alignment: center;
        overflow: elide;
    }

    touch := TouchArea {
        enabled: root.enabled && !root.editing;
        mouse-cursor: MouseCursor.text;
        clicked => {
            host.press();
            input.text = root.text;
            root.editing = true;
            input.focus();
            input.select-all();
        }
        changed has-hover => {
            if self.has-hover {
                host.enter();
            } else {
                host.leave();
            }
        }
    }

    input := TextInput {
        x: 5px;
        width: parent.width - 10px - root.suffix-width;
        height: parent.height;
        visible: root.editing;
        enabled: root.editing;
        single-line: true;
        color: Theme.text;
        font-size: 12px;
        vertical-alignment: center;
        selection-background-color: Theme.primary.with-alpha(0.4);

        edited => { root.edited(self.text); }
        accepted => {
            root.editing = false;
            Shortcuts.release-focus();
        }
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.editing = false;
                Shortcuts.release-focus();
                return accept;
            }
            reject
        }
        changed has-focus => {
            if !self.has-focus {
                root.editing = false;
            }
        }
    }
}

/// The card's columns: the counter's width (the jump below it takes it too) and the toggle's (Save below it).
global FinalizeMetrics {
    out property <length> counter-width: 54px;
    out property <length> button-width: 26px;
}

export component FinalizeCardBody inherits VerticalLayout {
    padding: 8px;
    padding-top: 2px;
    spacing: 6px;

    HorizontalLayout {
        spacing: 4px;

        NameField {
            text: Export.name;
            suffix: Export.extension;
            enabled: Export.has-source;
            edited(text) => { Export.name-edited(text); }
        }

        NumberField {
            width: FinalizeMetrics.counter-width;
            text: Export.counter-enabled ? Export.counter : "";
            placeholder: Export.auto-increment ? "01" : "None";
            tooltip: Export.auto-increment
                ? "The counter of the next job (empty: 01)"
                : "The counter of the next job (empty: no counter in the file name)";
            committed(text) => { return Export.counter-committed(text); }
            stepped(steps) => { Export.counter-stepped(steps); }
        }

        IconButton {
            width: FinalizeMetrics.button-width;
            icon: IconId.auto-increment;
            checked: Export.auto-increment;
            tooltip: Export.auto-increment ? "The counter goes up after each save" : "The counter stays after a save";
            clicked => { Export.toggle-auto-increment(); }
        }
    }

    HorizontalLayout {
        spacing: 4px;

        ChoiceButton {
            stretch-fully: true;
            items: Export.folders;
            current: Export.folder-index;
            tooltip: Export.folder-path;
            bubble: Playback.has-video ? "export.folder" : "";
            selected(index) => { Export.select-folder(index); }
        }

        IconButton {
            width: FinalizeMetrics.counter-width;
            icon: IconId.jump-to;
            tooltip: "Edit the target folders (Settings > Export & Naming)";
            clicked => { Export.edit-folders(); }
        }

        IconButton {
            width: FinalizeMetrics.button-width;
            icon: IconId.job-save;
            enabled: Export.can-save;
            tooltip: Export.save-tooltip;
            shortcut: Export.key-save;
            clicked => { Export.save(); }
        }
    }
}
