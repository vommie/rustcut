// The folder navigator (Q-NF3): a bubble with the open video's folder, hanging from the plugin's button or bar it was
// opened on. A search over the whole folder (wildcards like Dolphin, `.*` = a regular expression), the files of one
// page (number, name with the hits marked, size), a pager. A click opens a file and the bubble stays; Escape (or a
// press outside) closes it and gives the keys back. Filled by src/ui/plugins/commands/navigator/.

import { Theme } from "styles.slint";
import { AppIcon, IconId, IconSize } from "icons.slint";
import { IconButton } from "controls.slint";
import { Flyout } from "flyout.slint";
import { SearchField } from "search_field.slint";
import { HoldLogic, HoldRing } from "hold.slint";
import { TooltipHost } from "tooltip.slint";
import { Shortcuts } from "shortcuts.slint";
// The editor has unsaved sections (`unsaved`): opening another file is held.
import { PluginCommands } from "plugin_commands.slint";

export struct NavSegment {
    text: string,
    hit: bool,
    // This piece gives way when the name does not fit; the others keep their width.
    shrink: bool,
}

export struct NavRow {
    number: string,
    segments: [NavSegment],
    size: string,
    current: bool,
    highlighted: bool,
}

export struct NavSlot {
    label: string,
    // -1 = the gap of left-out pages.
    page: int,
    on: bool,
    // The open video is on this page.
    has-current: bool,
}

export global FolderNavigator {
    in-out property <bool> open;
    // The element it hangs from, in window coordinates.
    in property <length> anchor-x;
    in property <length> anchor-y;
    in property <length> anchor-width;
    in property <length> anchor-height;
    in property <string> parent-folder;
    in property <string> folder;
    in property <string> order;
    // The order is names A to Z instead of Dolphin's.
    in property <bool> names-order;
    in property <[NavRow]> rows;
    in property <int> rows-per-page: 15;
    // How many rows the list is high: set when the bubble opens (a short folder gets a short list), kept while paging
    // and searching so nothing below moves.
    in property <int> list-rows: 15;
    // The widest number of the folder ("120"), so the column never changes its width.
    in property <string> widest-number: "000";
    in property <[NavSlot]> slots;
    in property <string> widest-page: "00";
    in property <string> range;
    in property <bool> has-prev;
    in property <bool> has-next;
    in property <string> empty-text;
    in-out property <string> query;
    in-out property <bool> regex;
    in property <string> badge;
    in property <bool> invalid;
    in property <string> error;
    in property <string> error-example;
    callback query-edited(string);
    callback regex-toggled(bool);
    // "up", "down", "page-up", "page-down", "home", "end", "open".
    callback key(string);
    callback hovered(/* row on the page */ int);
    callback activate(/* row on the page */ int);
    callback page(int);
    callback page-step(int);
    callback closed();
}

component NavName inherits HorizontalLayout {
    in property <[NavSegment]> segments;
    in property <color> color;

    alignment: start;

    for seg in root.segments: Rectangle {
        horizontal-stretch: seg.shrink ? 1 : 0;
        min-width: seg.shrink ? Math.min(12px, label.preferred-width) : label.preferred-width;
        max-width: label.preferred-width;
        border-radius: 2px;
        background: seg.hit ? Theme.accent.with-alpha(Theme.dark ? 0.16 : 0.18) : transparent;

        label := Text {
            width: parent.width;
            height: parent.height;
            text: seg.text;
            color: seg.hit ? (Theme.dark ? Theme.accent : Theme.text) : root.color;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

component NavRowItem inherits Rectangle {
    in property <NavRow> item;
    in property <int> index;
    in property <length> number-width;

    height: 24px;
    border-radius: 3px;
    clip: true;
    background: root.item.current ? Theme.surface-selected : root.item.highlighted ? Theme.surface-hover : transparent;

    logic := HoldLogic {
        pressed: touch.pressed;
        enabled: !root.item.current;
        hold: PluginCommands.unsaved;
        confirmed => {
            FolderNavigator.activate(root.index);
        }
        short-click => {
            host.reveal();
        }
    }

    host := TooltipHost {
        text: PluginCommands.unsaved && !root.item.current ? "Opens it (the sections are not saved)" : "";
        hold: PluginCommands.unsaved && !root.item.current;
    }

    if PluginCommands.unsaved && !root.item.current: HoldRing {
        progress: logic.progress;
        flash: logic.flash;
        ring: false;
    }

    if root.item.current: Rectangle {
        x: 0;
        y: 4px;
        width: 2px;
        height: parent.height - 8px;
        border-radius: 1px;
        background: Theme.primary;
    }

    HorizontalLayout {
        x: logic.nudge;
        padding-left: 6px;
        padding-right: 6px;
        spacing: 8px;

        Text {
            width: root.number-width;
            text: root.item.number;
            color: root.item.current ? Theme.primary : Theme.text-disabled;
            font-size: 11px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }

        Rectangle {
            horizontal-stretch: 1;
            clip: true;

            NavName {
                width: parent.width;
                height: parent.height;
                segments: root.item.segments;
                color: Theme.text;
            }
        }

        Text {
            width: 58px;
            text: root.item.size;
            color: Theme.text-muted;
            font-size: 11px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        changed has-hover => {
            if self.has-hover {
                FolderNavigator.hovered(root.index);
            } else {
                host.leave();
            }
        }
        pointer-event(event) => {
            if event.button == PointerEventButton.left {
                if event.kind == PointerEventKind.down {
                    host.press();
                    logic.pressed-down();
                } else if event.kind == PointerEventKind.up && self.has-hover {
                    logic.released-click();
                }
            }
        }
    }
}

component NavSlotItem inherits Rectangle {
    in property <NavSlot> slot;

    height: 24px;
    border-radius: 4px;
    background: root.slot.on ? Theme.surface-selected : touch.has-hover && root.slot.page >= 0 ? Theme.surface-hover : transparent;
    border-width: root.slot.on ? 1px : 0px;
    border-color: Theme.primary;

    Text {
        text: root.slot.page < 0 ? "…" : root.slot.label;
        color: root.slot.page < 0 ? Theme.text-disabled : Theme.text;
        font-size: 11px;
        font-weight: root.slot.on ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if root.slot.has-current: Rectangle {
        x: (parent.width - 6px) / 2;
        y: parent.height - 4px;
        width: 6px;
        height: 2px;
        border-radius: 1px;
        background: Theme.accent;
    }

    touch := TouchArea {
        enabled: root.slot.page >= 0;
        clicked => {
            FolderNavigator.page(root.slot.page);
        }
    }
}

/// The open navigator over the window's content (main.slint places it; the anchor in layer coordinates).
export component FolderNavigatorFlyout inherits Rectangle {
    in property <length> anchor-x;
    in property <length> anchor-y;
    in property <length> anchor-width;
    in property <length> anchor-height;

    property <length> panel-width: 400px;
    property <length> list-height: Math.max(1, FolderNavigator.list-rows) * 25px + 3px;
    property <length> number-width: number-measure.preferred-width + 2px;
    property <length> slot-width: Math.max(24px, page-measure.preferred-width + 12px);

    function close() {
        FolderNavigator.open = false;
        FolderNavigator.closed();
        Shortcuts.release-focus();
    }

    init => {
        search.focus-input();
    }

    number-measure := Text {
        visible: false;
        text: FolderNavigator.widest-number;
        font-size: 11px;
    }

    page-measure := Text {
        visible: false;
        text: FolderNavigator.widest-page;
        font-size: 11px;
        font-weight: 600;
    }

    Flyout {
        width: parent.width;
        height: parent.height;
        anchor-x: root.anchor-x;
        anchor-y: root.anchor-y;
        anchor-width: root.anchor-width;
        anchor-height: root.anchor-height;
        panel-width: root.panel-width;
        panel-height: body.preferred-height;
        closed => { root.close(); }

        keys := FocusScope {
            x: 0;
            y: 0;
            width: root.panel-width;
            height: body.preferred-height;

            capture-key-pressed(event) => {
                if event.text == Key.Escape {
                    if FolderNavigator.query != "" {
                        search.clear();
                    } else {
                        root.close();
                    }
                    return accept;
                }
                if event.text == Key.UpArrow {
                    FolderNavigator.key("up");
                    return accept;
                }
                if event.text == Key.DownArrow {
                    FolderNavigator.key("down");
                    return accept;
                }
                if event.text == Key.PageUp {
                    FolderNavigator.key("page-up");
                    return accept;
                }
                if event.text == Key.PageDown {
                    FolderNavigator.key("page-down");
                    return accept;
                }
                if event.text == Key.Home {
                    FolderNavigator.key("home");
                    return accept;
                }
                if event.text == Key.End {
                    FolderNavigator.key("end");
                    return accept;
                }
                if event.text == Key.Return {
                    FolderNavigator.key("open");
                    return accept;
                }
                reject
            }

            body := VerticalLayout {
                width: root.panel-width;
                padding: 8px;
                spacing: 6px;

                // The folder and its order.
                HorizontalLayout {
                    height: 24px;
                    spacing: 6px;

                    VerticalLayout {
                        alignment: center;
                        AppIcon {
                            icon: IconId.open-folder;
                            size: IconSize.sm;
                            color: Theme.text-muted;
                        }
                    }

                    // The path in one piece ("…/videos/holiday"), the open video's folder bold.
                    HorizontalLayout {
                        horizontal-stretch: 1;
                        spacing: 0px;

                        Text {
                            horizontal-stretch: 0;
                            max-width: 120px;
                            text: FolderNavigator.parent-folder;
                            color: Theme.text-muted;
                            font-size: 12px;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        Text {
                            horizontal-stretch: 1;
                            min-width: 40px;
                            text: FolderNavigator.folder;
                            color: Theme.text;
                            font-size: 12px;
                            font-weight: 600;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }

                    VerticalLayout {
                        alignment: center;

                        Rectangle {
                            height: 20px;
                            width: chip.preferred-width + 16px;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: Theme.border;
                            background: Theme.surface;

                            chip := Text {
                                text: FolderNavigator.order;
                                color: Theme.text-muted;
                                font-size: 11px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                search := SearchField {
                    field-width: root.panel-width - 16px;
                    field-height: 26px;
                    font-size: 12px;
                    text <=> FolderNavigator.query;
                    is-regex <=> FolderNavigator.regex;
                    placeholder-text: "Search files";
                    show-search-icon: true;
                    enable-escape-clear: false;
                    regex-tooltip: "Regular expression (else * and ? like Dolphin)";
                    clear-tooltip: "Clear the search";
                    badge: FolderNavigator.badge;
                    invalid: FolderNavigator.invalid;
                    error: FolderNavigator.error;
                    error-example: FolderNavigator.error-example;
                    search-changed(text) => { FolderNavigator.query-edited(text); }
                    regex-toggled(on) => { FolderNavigator.regex-toggled(on); }
                }

                // The page: as high as the rows it had when the bubble opened, so nothing below moves.
                Rectangle {
                    height: root.list-height;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Theme.border;
                    background: Theme.background;

                    VerticalLayout {
                        padding: 1px;
                        spacing: 1px;
                        alignment: start;

                        for item[i] in FolderNavigator.rows: NavRowItem {
                            item: item;
                            index: i;
                            number-width: root.number-width;
                        }
                    }

                    if FolderNavigator.rows.length == 0: Text {
                        text: FolderNavigator.empty-text;
                        color: Theme.text-muted;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // The pager and the range.
                HorizontalLayout {
                    height: 24px;
                    spacing: 2px;

                    IconButton {
                        width: 24px;
                        height: 24px;
                        icon: IconId.chevron-left;
                        tooltip: "Previous page";
                        shortcut: "PgUp";
                        enabled: FolderNavigator.has-prev;
                        clicked => { FolderNavigator.page-step(-1); }
                    }

                    for slot in FolderNavigator.slots: NavSlotItem {
                        width: root.slot-width;
                        slot: slot;
                    }

                    IconButton {
                        width: 24px;
                        height: 24px;
                        icon: IconId.chevron-right;
                        tooltip: "Next page";
                        shortcut: "PgDn";
                        enabled: FolderNavigator.has-next;
                        clicked => { FolderNavigator.page-step(1); }
                    }

                    Text {
                        horizontal-stretch: 1;
                        text: FolderNavigator.range;
                        color: Theme.text-muted;
                        font-size: 11px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }
    }
}
