// Main window of RustCut: the dock (ADR-12) with its two sidebars around the video, the banners above it (known source,
// probe render), the timeline and the transport bar, a
// slim status line, the menus (File, Playback, Sections, Filters, View) with the keymap's shortcuts, the key scope that
// hands every other key press to the keymap (src/ui/editor/), the modal conflict dialog of saving a job (src/ui/export/)
// and the tooltip layer on top.

import { Theme } from "styles.slint";
import { PlayerView } from "player_view.slint";
import { IconId } from "icons.slint";
import { ResizerBar } from "resizer_bar.slint";
import { Dock, DockCardView, DockGroupView, DockMetrics, DockRailItem, DockTabView } from "dock_types.slint";
import { DockSidebar } from "dock_sidebar.slint";
import { DockOverlay } from "dock_overlay.slint";
import { Playback } from "player_types.slint";
import { PlayerTransport } from "player_transport.slint";
import { Status, StatusLine } from "status_line.slint";
import { MediaInfoPanel, MediaInfoRow, MediaInfoSection } from "media_info_panel.slint";
import { KnownSource, KnownSourceBanner } from "source_banner.slint";
import { Shortcuts } from "shortcuts.slint";
import { Timeline, TimelineBlock, TimelineStrip, TimelineTick } from "timeline_view.slint";
import { SectionRowView, Sections } from "sections_card.slint";
import { FilterRowView, Filters } from "filters_card.slint";
import { CropOverlay } from "crop_overlay.slint";
import { TooltipLayer } from "tooltip.slint";
import { OptionRowView, Probe, RenderIssueView, RenderSettings } from "render_types.slint";
import { ProbeBanner } from "probe_banner.slint";
import { ConflictJobView, ConflictOptionView, Export, Queue, QueueRowView } from "export_types.slint";
import { ConflictDialog } from "export_dialog.slint";
import { TagColumnView, TagHistoryItemModel, TagHistoryRowModel, TagNodeView, TagRate } from "tag_types.slint";

export {
    Theme, IconId, Dock, DockMetrics, DockCardView, DockGroupView, DockRailItem, DockTabView, Playback, Status, MediaInfoPanel,
    MediaInfoRow, MediaInfoSection, KnownSource, Shortcuts, Timeline, TimelineBlock, TimelineTick, Sections,
    SectionRowView, Filters, FilterRowView, CropOverlay, RenderSettings, OptionRowView, RenderIssueView, Probe, Export,
    ConflictJobView, ConflictOptionView, Queue, QueueRowView, TagRate, TagNodeView, TagColumnView, TagHistoryItemModel,
    TagHistoryRowModel
}

export component MainWindow inherits Window {
    in property <string> app-name: "RustCut";
    in property <string> app-version;
    // The frame mpv drew into Slint's OpenGL context (rustcut-player); empty until the first video frame.
    in property <image> video-frame;
    // Size of the video area in logical pixels: the player renders its texture at this size times the scale factor.
    out property <length> video-width: player.width;
    out property <length> video-height: player.height;
    // Where the sidebars and the center are, in window coordinates (the dock's hit testing while a tab is dragged).
    out property <length> left-frame-x: left-sidebar.absolute-position.x;
    out property <length> left-frame-y: left-sidebar.absolute-position.y;
    out property <length> left-frame-width: left-sidebar.width;
    out property <length> left-frame-height: left-sidebar.height;
    out property <length> right-frame-x: right-sidebar.absolute-position.x;
    out property <length> right-frame-y: right-sidebar.absolute-position.y;
    out property <length> right-frame-width: right-sidebar.width;
    out property <length> right-frame-height: right-sidebar.height;
    out property <length> center-frame-x: center-area.absolute-position.x;
    out property <length> center-frame-y: center-area.absolute-position.y;
    out property <length> center-frame-width: center-area.width;
    out property <length> center-frame-height: center-area.height;
    out property <length> window-width: root.width;

    // File > Open: the file dialog (src/ui/open/).
    callback open-file();
    // Opens a path (UI-thread entry for the dialog, drops and a second start).
    callback open-path(string);
    // File > Quit: the same path as closing the window.
    callback quit();

    // "<file> (<folder>) - RustCut" while a file is open (src/app/window.rs).
    in property <string> window-title: root.app-name;

    title: root.window-title;

    // Gives the keyboard to the key scope (after a text field is done, or a click on the video or the timeline).
    public function focus-keys() {
        key-scope.focus();
    }

    init => {
        key-scope.focus();
    }
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 900px;
    min-height: 600px;
    background: Theme.background;
    default-font-size: Theme.font-size;

    MenuBar {
        Menu {
            title: "File";

            MenuItem {
                title: "Open...";
                shortcut: Shortcuts.open;
                activated => { root.open-file(); }
            }

            MenuItem {
                title: "Save Job";
                shortcut: Shortcuts.save;
                enabled: Export.can-save && !Export.dialog-open;
                activated => { Export.save(); }
            }

            MenuSeparator { }

            MenuItem {
                title: "Quit";
                shortcut: Shortcuts.quit;
                activated => { root.quit(); }
            }
        }

        Menu {
            title: "Playback";

            MenuItem {
                title: Playback.paused ? "Play" : "Pause";
                shortcut: Shortcuts.toggle-pause;
                enabled: Playback.has-file;
                activated => { Playback.toggle-pause(); }
            }

            MenuItem {
                title: "Previous Frame";
                shortcut: Shortcuts.frame-back;
                enabled: Playback.has-video;
                activated => { Playback.frame-step(true); }
            }

            MenuItem {
                title: "Next Frame";
                shortcut: Shortcuts.frame-forward;
                enabled: Playback.has-video;
                activated => { Playback.frame-step(false); }
            }

            MenuSeparator { }

            MenuItem {
                title: Playback.muted ? "Unmute" : "Mute";
                shortcut: Shortcuts.toggle-mute;
                activated => { Playback.toggle-mute(); }
            }

            MenuItem {
                title: "Reload";
                shortcut: Shortcuts.reload;
                enabled: Playback.has-file;
                activated => { Playback.reload(); }
            }
        }

        Menu {
            title: "Sections";

            MenuItem {
                title: "Set Start";
                shortcut: Shortcuts.set-start;
                enabled: Playback.has-video;
                activated => { Shortcuts.run("set_start"); }
            }

            MenuItem {
                title: "Set End";
                shortcut: Shortcuts.set-end;
                enabled: Playback.has-video;
                activated => { Shortcuts.run("set_end"); }
            }

            MenuItem {
                title: "Add Section";
                shortcut: Shortcuts.add-section;
                enabled: Sections.can-add;
                activated => { Shortcuts.run("add_section"); }
            }

            MenuSeparator { }

            MenuItem {
                title: "Go to Start";
                shortcut: Shortcuts.go-to-start;
                enabled: Playback.has-video && Sections.mark-start != "";
                activated => { Shortcuts.run("go_to_start"); }
            }

            MenuItem {
                title: "Go to End";
                shortcut: Shortcuts.go-to-end;
                enabled: Playback.has-video && Sections.mark-end != "";
                activated => { Shortcuts.run("go_to_end"); }
            }

            MenuItem {
                title: "Previous Cut Point";
                shortcut: Shortcuts.previous-cut;
                enabled: Playback.has-video;
                activated => { Shortcuts.run("previous_cut"); }
            }

            MenuItem {
                title: "Next Cut Point";
                shortcut: Shortcuts.next-cut;
                enabled: Playback.has-video;
                activated => { Shortcuts.run("next_cut"); }
            }
        }

        Menu {
            title: "Filters";

            MenuItem {
                title: Filters.preview ? "Show Video Without Filters" : "Show Filters in the Player";
                shortcut: Shortcuts.filter-preview;
                activated => { Shortcuts.run("toggle_filter_preview"); }
            }

            MenuItem {
                title: Filters.keep ? "Do Not Keep Filters" : "Keep Filters for the Next Video";
                shortcut: Shortcuts.filter-keep;
                activated => { Shortcuts.run("toggle_keep_filters"); }
            }

            MenuSeparator { }

            MenuItem {
                title: Filters.crop-editing ? "Finish Crop Editing" : "Edit Crop on the Video";
                shortcut: Shortcuts.crop-edit;
                enabled: Filters.can-edit-crop;
                activated => { Shortcuts.run("crop_edit"); }
            }

            MenuItem {
                title: "Detect Black Borders";
                shortcut: Shortcuts.auto-crop;
                enabled: Filters.has-media && !Filters.auto-crop-running;
                activated => { Shortcuts.run("auto_crop"); }
            }

            MenuSeparator { }

            MenuItem {
                title: "Rotate Left";
                shortcut: Shortcuts.rotate-left;
                activated => { Shortcuts.run("rotate_left"); }
            }

            MenuItem {
                title: "Rotate Right";
                shortcut: Shortcuts.rotate-right;
                activated => { Shortcuts.run("rotate_right"); }
            }

            MenuItem {
                title: "Mirror Left and Right";
                shortcut: Shortcuts.mirror-horizontal;
                activated => { Shortcuts.run("mirror_horizontal"); }
            }

            MenuItem {
                title: "Mirror Top and Bottom";
                shortcut: Shortcuts.mirror-vertical;
                activated => { Shortcuts.run("mirror_vertical"); }
            }

            MenuSeparator { }

            MenuItem {
                title: "Reset Filters";
                shortcut: Shortcuts.filter-reset;
                activated => { Shortcuts.run("reset_filters"); }
            }

            MenuSeparator { }

            MenuItem {
                title: "Probe Render";
                shortcut: Shortcuts.probe-render;
                enabled: (Playback.has-video || Probe.playing) && !Probe.running;
                activated => { Shortcuts.run("probe_render"); }
            }

            MenuItem {
                title: "Back to the Source";
                enabled: Probe.playing;
                activated => { Probe.back(); }
            }
        }

        Menu {
            title: "View";

            MenuItem {
                title: Dock.left-collapsed ? "Expand Left Sidebar" : "Collapse Left Sidebar";
                enabled: Dock.left-shown;
                activated => { Dock.toggle-sidebar(0); }
            }

            MenuItem {
                title: Dock.right-collapsed ? "Expand Right Sidebar" : "Collapse Right Sidebar";
                enabled: Dock.right-shown;
                activated => { Dock.toggle-sidebar(1); }
            }

            MenuSeparator { }

            MenuItem {
                title: "Zoom Timeline In";
                shortcut: Shortcuts.zoom-in;
                enabled: Timeline.active;
                activated => { Shortcuts.run("zoom_in"); }
            }

            MenuItem {
                title: "Zoom Timeline Out";
                shortcut: Shortcuts.zoom-out;
                enabled: Timeline.active && Timeline.zoomed;
                activated => { Shortcuts.run("zoom_out"); }
            }

            MenuItem {
                title: "Fit Timeline";
                shortcut: Shortcuts.zoom-fit;
                enabled: Timeline.active && Timeline.zoomed;
                activated => { Shortcuts.run("zoom_fit"); }
            }

            MenuSeparator { }

            MenuItem {
                title: "Reset Layout";
                activated => { Dock.reset-layout(); }
            }
        }
    }

    key-scope := FocusScope {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;

        key-pressed(event) => {
            if Shortcuts.key-pressed(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift,
                event.modifiers.meta, event.repeat) {
                return accept;
            }
            reject
        }

        key-released(event) => {
            Shortcuts.key-released(event.text);
            reject
        }

        VerticalLayout {
            HorizontalLayout {
                vertical-stretch: 1;

                left-sidebar := DockSidebar {
                    width: !Dock.left-shown ? 0px : (Dock.left-collapsed ? DockMetrics.rail-width : Dock.left-width);
                    side: 0;
                    groups: Dock.left-groups;
                    rail: Dock.left-rail;
                    total-fixed: Dock.left-total-fixed;
                    collapsed: Dock.left-collapsed;
                }

                if Dock.left-shown && !Dock.left-collapsed: ResizerBar {
                    is-horizontal: true;
                    thickness: 5px;
                    drag-started => { Dock.sidebar-resize-started(0); }
                    dragged(delta) => { Dock.sidebar-resized(0, delta); }
                }

                center-area := VerticalLayout {
                    horizontal-stretch: 1;
                    min-width: 240px;

                    KnownSourceBanner { }

                    ProbeBanner { }

                    player := PlayerView {
                        vertical-stretch: 1;
                        frame: root.video-frame;
                        app-name: root.app-name;
                        app-version: root.app-version;
                    }

                    TimelineStrip { }

                    PlayerTransport { }
                }

                if Dock.right-shown && !Dock.right-collapsed: ResizerBar {
                    is-horizontal: true;
                    thickness: 5px;
                    drag-started => { Dock.sidebar-resize-started(1); }
                    dragged(delta) => { Dock.sidebar-resized(1, delta); }
                }

                right-sidebar := DockSidebar {
                    width: !Dock.right-shown ? 0px : (Dock.right-collapsed ? DockMetrics.rail-width : Dock.right-width);
                    side: 1;
                    groups: Dock.right-groups;
                    rail: Dock.right-rail;
                    total-fixed: Dock.right-total-fixed;
                    collapsed: Dock.right-collapsed;
                }
            }

            StatusLine { }
        }
    }

    DockOverlay {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
    }

    if Export.dialog-open: ConflictDialog {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
    }

    TooltipLayer {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
    }
}
