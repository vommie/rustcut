// Main window of RustCut: the dock (ADR-12) with its two sidebars around the video, the notices (M6.5: the banner over
// the video, the toasts, the bell in the menu bar), the timeline and the transport bar, a
// slim status line, the menus (File, Playback, Sections, Filters, View) with the keymap's shortcuts, the key scope that
// hands every other key press to the keymap (src/ui/editor/), the modal dialogs of saving a job (conflict, missing
// tags or rating; src/ui/export/), the question before a job replaces the editor's draft (src/ui/editing/), the context
// menu (src/ui/menu/) and the tooltip layer on top.

import { Theme } from "styles.slint";
import { PlayerView } from "player_view.slint";
import { IconId } from "icons.slint";
import { ResizerBar } from "resizer_bar.slint";
import { Dock, DockCardView, DockGroupView, DockMetrics, DockRailItem, DockTabView, RailPeek } from "dock_types.slint";
import { DockPeek, DockSidebar } from "dock_sidebar.slint";
import { DockOverlay } from "dock_overlay.slint";
import { BarFit, Playback, PlayerPopup } from "player_types.slint";
import { PlayerPopups } from "player_popups.slint";
import { PlayerTransport } from "player_transport.slint";
import { ActivityView, Status, StatusLine } from "status_line.slint";
import { CropHistoryFlyout, CropHistoryRow, CropHistoryUi } from "crop_history.slint";
import { MediaInfoPanel, MediaInfoRow, MediaInfoSection } from "media_info_panel.slint";
import { Shortcuts } from "shortcuts.slint";
import { Timeline, TimelineBlock, TimelineMetrics, TimelineStrip, TimelineTick } from "timeline_view.slint";
import { ThumbPopup, ThumbStrip, Thumbs } from "thumb_popup.slint";
import { SectionRowView, Sections } from "sections_card.slint";
import { FilterRowView, FilterTips, Filters } from "filters_types.slint";
import { FilterMenuFlyout } from "filters_menu.slint";
import { TabView } from "tabs.slint";
import { CropOverlay } from "crop_overlay.slint";
import { GlobalTooltip, Tip, TipKey, TipKeys, TipPlacement, TipRect, TipRow, TipSide, TooltipLogic } from "tooltip.slint";
import { TooltipLayer } from "tooltip_layer.slint";
import { DialogState } from "dialog_frame.slint";
import { OptionRowView, Probe, RenderIssueView, RenderSettings } from "render_types.slint";
import { ConflictJobView, ConflictOptionView, Export, PreviewView } from "export_types.slint";
import { Queue, QueueColumnView, QueueRowView } from "queue_types.slint";
import { QueueFilterFlyout } from "queue_filter.slint";
import { FolderList, FolderListFlyout, FolderListRowView, FolderFieldView } from "folder_list.slint";
import { Relocate, RelocateDialog, RelocateRecordsDialog, RelocateChipView, RelocateConflictView, RelocateRecordView } from "relocate_dialog.slint";
import { FolderWheel, FolderWheelLayer, WheelHoldRing, WheelLookView, WheelMiddleView, WheelSlotView } from "folder_wheel.slint";
import { MultiChoiceItem } from "controls_choice.slint";
import { Job, JobLoad, JobRowView, JobSectionView, LogLineView, Logs } from "job_types.slint";
import { ContextMenu, ContextMenuLayer, MenuItemView, MenuLevelView } from "context_menu.slint";
import { AppMenu, AppMenuBar, MenuBarLayer, MenuBarMenu } from "menu_bar.slint";
import { HoldConfirm } from "hold.slint";
import { JobLoadDialog } from "job_load_dialog.slint";
import { ConflictDialog } from "export_dialog.slint";
import { MetadataDialog } from "export_metadata_dialog.slint";
import { TagColumnView, TagHistoryItemModel, TagHistoryRowModel, TagNodeView, TagRate } from "tag_types.slint";
import { DiagCheckView, DiagGroupView, HotkeyChipView, HotkeyRowView, MessageKindView, ProfileItemView, RatioChipView, SettingCardView, SettingRowView, SettingsPageItem, SettingsUi } from "settings_types.slint";
import { PluginAvailableView, PluginBlockView, PluginCardView, PluginCellView, PluginColumnView, PluginDetailView, PluginItemView, PluginTableRowView, PluginsUi } from "settings_plugin_types.slint";
import { FolderDetailsView, FolderIconRowView, FolderIconView, FolderTreeRowView, FolderTreeUi } from "settings_folder_types.slint";
import { FolderPictureView } from "folder_picture.slint";
import { SettingsWindow } from "settings_window.slint";
import { ColorCodec } from "color_picker.slint";
import { ColorPickerWindow } from "color_picker_window.slint";
import { TagFilterWindow, TagFilterRowView } from "tag_filter_window.slint";
import { TooltipSettings } from "tooltip.slint";
import { Power } from "power_types.slint";
import { QuitDialog } from "power_quit_dialog.slint";
import { AppTray } from "tray.slint";
import { Jump } from "jump.slint";
import { BannerView, HistoryView, Notices, ToastTagView, ToastView } from "notice_types.slint";
import { NoticeBanner } from "notice_banner.slint";
import { ToastLayer } from "notice_toasts.slint";
import { BellPopup, NoticeBell } from "notice_bell.slint";
import { BubbleButtonView, BubbleView, Bubbles } from "bubble.slint";
import { NewerFileDialog, Problems, QueueDatabaseDialog } from "problem_dialogs.slint";
import { TextLogic, TextSplit } from "controls_text.slint";
import { DragLogic, DragState } from "drag.slint";

export {
    Theme, IconId, Dock, DockMetrics, RailPeek, DockCardView, DockGroupView, DockRailItem, DockTabView, Playback, BarFit, PlayerPopup, Status, ActivityView,
    CropHistoryRow, CropHistoryUi, MediaInfoPanel,
    MediaInfoRow, MediaInfoSection, Shortcuts, Thumbs, Timeline, TimelineBlock, TimelineMetrics, TimelineTick, Sections,
    SectionRowView, Filters, FilterRowView, FilterTips, CropOverlay, RenderSettings, OptionRowView, RenderIssueView, Probe, Export,
    ConflictJobView, ConflictOptionView, PreviewView, TipRow, Tip, TipKey, TipKeys, TipPlacement, TipRect, TipSide,
    GlobalTooltip, TooltipLogic, DialogState, Queue, QueueRowView, QueueColumnView, MultiChoiceItem, TagRate, TagNodeView,
    TagColumnView, TagHistoryItemModel, TagHistoryRowModel, Job, JobRowView, JobSectionView, Logs, LogLineView, JobLoad,
    ContextMenu, MenuItemView, MenuLevelView, HoldConfirm, SettingsUi, SettingCardView, SettingRowView, SettingsPageItem, PluginsUi, PluginItemView, PluginDetailView, PluginAvailableView, PluginCardView, PluginBlockView, PluginCellView, PluginColumnView, PluginTableRowView, FolderTreeUi, FolderTreeRowView, FolderList, FolderListRowView, FolderFieldView, Relocate, RelocateChipView, RelocateConflictView, RelocateRecordView, FolderWheel, WheelSlotView, WheelLookView, WheelMiddleView, FolderDetailsView, FolderIconView, FolderIconRowView, FolderPictureView, RatioChipView, DiagCheckView, DiagGroupView,
    ProfileItemView, HotkeyRowView, HotkeyChipView, SettingsWindow, TooltipSettings, Power, AppTray, Jump, Notices,
    ToastView, ToastTagView, BannerView, HistoryView, MessageKindView, Bubbles, BubbleView, BubbleButtonView, Problems, ColorCodec, ColorPickerWindow, TagFilterWindow, TagFilterRowView,
    TextLogic, TextSplit, DragLogic, DragState, AppMenu, MenuBarMenu, TabView
}

export component MainWindow inherits Window {
    in property <string> app-name: "RustCut";
    in property <string> app-version;
    // The frame mpv drew into Slint's OpenGL context (rustcut-player); empty until the first video frame.
    in property <image> video-frame;
    // Size of the video area in logical pixels: the player renders its texture at this size times the scale factor.
    out property <length> video-width: player.width;
    out property <length> video-height: player.height;
    // Where the sidebars and the center are, in window coordinates (the dock's hit testing while a tab is dragged).
    out property <length> left-frame-x: left-sidebar.absolute-position.x;
    out property <length> left-frame-y: left-sidebar.absolute-position.y;
    out property <length> left-frame-width: left-sidebar.width;
    out property <length> left-frame-height: left-sidebar.height;
    out property <length> right-frame-x: right-sidebar.absolute-position.x;
    out property <length> right-frame-y: right-sidebar.absolute-position.y;
    out property <length> right-frame-width: right-sidebar.width;
    out property <length> right-frame-height: right-sidebar.height;
    out property <length> center-frame-x: center-area.absolute-position.x;
    out property <length> center-frame-y: center-area.absolute-position.y;
    out property <length> center-frame-width: center-area.width;
    out property <length> center-frame-height: center-area.height;
    out property <length> window-width: root.width;

    // File > Open: the file dialog (src/ui/open/).
    callback open-file();
    // Opens a path (UI-thread entry for the dialog, drops and a second start).
    callback open-path(string);
    // Quits now: the same path as closing the window once nothing has to be asked (signals, the countdown, "Quit now").
    callback quit();
    // The user wants to quit (window close, File > Quit, the Quit key): asks first while a job renders (src/ui/power/).
    callback request-quit();
    // File > Settings and Help > About: the Settings window on a page ("" = the page it showed last; src/ui/settings/).
    callback open-settings();
    callback open-settings-page(string);
    // Help: one of RustCut's folders in the file manager ("config", "data", "logs", "cache").
    callback open-folder(string);

    // Where the content starts in window coordinates (below the menu bar); the layers below the bar place themselves
    // with it.
    property <length> content-x: key-scope.absolute-position.x;
    property <length> content-y: key-scope.absolute-position.y;

    // "<file> (<folder>) - RustCut" while a file is open (src/app/window.rs).
    in property <string> window-title: root.app-name;

    title: root.window-title;
    icon: @image-url("../assets/app/window-icon.png");

    // A modal dialog covers the window: the menu bar's keys (which Slint gives the menu before any focused element) must
    // not act on the editor behind it (found by the P8 audit: I, O and Shift+I moved the marks under the save question).
    property <bool> modal-open: FolderList.open || Relocate.open || Relocate.records-open || CropHistoryUi.open || Export.dialog-open || Export.meta-open || Power.asking || Problems.newer-open
        || Problems.db-open || JobLoad.open || PlayerPopup.time-open;
    changed modal-open => {
        Shortcuts.modal-changed(root.modal-open);
    }

    // Gives the keyboard to the key scope (after a text field is done, or a click on the video or the timeline).
    public function focus-keys() {
        key-scope.focus();
    }

    init => {
        key-scope.focus();
    }
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 900px;
    min-height: 600px;
    background: Theme.background;
    default-font-size: Theme.font-size;

    // The menu bar (P9.12): RustCut's own, so entries that discard something are held. Every entry's `enabled` blanks
    // it behind a modal dialog (except Quit); `shortcut` is the keymap's label (the keys reach the keymap through the key
    // scope). What an entry does is `run-menu`.
    property <[MenuBarMenu]> menus: [
        {
            title: "File",
            items: [
                { id: "open", title: "Open...", enabled: !root.modal-open, shortcut: Shortcuts.open },
                { id: "save", title: "Save Job", shortcut: Shortcuts.save,
                    enabled: !root.modal-open && (Export.can-save && !Export.dialog-open && !Export.meta-open) },
                { kind: 1 },
                { id: "settings", title: "Settings...", enabled: !root.modal-open, shortcut: Shortcuts.settings },
                { kind: 1 },
                { id: "quit", title: "Quit", enabled: true, shortcut: Shortcuts.quit },
            ],
        },
        {
            title: "Playback",
            items: [
                { id: "toggle_pause", title: Playback.paused ? "Play" : "Pause", shortcut: Shortcuts.toggle-pause,
                    enabled: !root.modal-open && Playback.has-file },
                { id: "frame_back", title: "Previous Frame", shortcut: Shortcuts.frame-back,
                    enabled: !root.modal-open && Playback.has-video },
                { id: "frame_forward", title: "Next Frame", shortcut: Shortcuts.frame-forward,
                    enabled: !root.modal-open && Playback.has-video },
                { kind: 1 },
                { id: "toggle_mute", title: Playback.muted ? "Unmute" : "Mute", shortcut: Shortcuts.toggle-mute,
                    enabled: !root.modal-open },
                { id: "reload", title: "Reload", shortcut: Shortcuts.reload,
                    enabled: !root.modal-open && Playback.has-file },
            ],
        },
        {
            title: "Sections",
            items: [
                { id: "set_start", title: "Set Start", shortcut: Shortcuts.set-start,
                    enabled: !root.modal-open && Playback.has-video },
                { id: "set_end", title: "Set End", shortcut: Shortcuts.set-end,
                    enabled: !root.modal-open && Playback.has-video },
                { id: "add_section", title: "Add Section", shortcut: Shortcuts.add-section,
                    enabled: !root.modal-open && Sections.can-add },
                { kind: 1 },
                { id: "go_to_start", title: "Go to Start", shortcut: Shortcuts.go-to-start,
                    enabled: !root.modal-open && Playback.has-video && Sections.mark-start != "" },
                { id: "go_to_end", title: "Go to End", shortcut: Shortcuts.go-to-end,
                    enabled: !root.modal-open && Playback.has-video && Sections.mark-end != "" },
                { id: "previous_cut", title: "Previous Cut Point", shortcut: Shortcuts.previous-cut,
                    enabled: !root.modal-open && Playback.has-video },
                { id: "next_cut", title: "Next Cut Point", shortcut: Shortcuts.next-cut,
                    enabled: !root.modal-open && Playback.has-video },
                { kind: 1 },
                // Held (P9.12, review note 62); the same entry is in the Sections card's menu.
                { id: "clear_sections", title: "Clear All Sections", hold: true,
                    tooltip: "Delete every section of this video", enabled: !root.modal-open && Sections.rows.length > 0 },
            ],
        },
        {
            title: "Filters",
            items: [
                { id: "toggle_filter_preview", shortcut: Shortcuts.filter-preview, enabled: !root.modal-open,
                    title: Filters.preview ? "Show Video Without Filters" : "Show Filters in the Player" },
                { id: "toggle_keep_filters", shortcut: Shortcuts.filter-keep, enabled: !root.modal-open,
                    title: Filters.keep ? "Do Not Keep Filters" : "Keep Filters for the Next Video" },
                { kind: 1 },
                { id: "crop_edit", shortcut: Shortcuts.crop-edit, enabled: !root.modal-open && Filters.can-edit-crop,
                    title: Filters.crop-editing ? "Finish Crop Editing" : "Edit Crop on the Video" },
                { id: "auto_crop", title: "Detect Black Borders", shortcut: Shortcuts.auto-crop,
                    enabled: !root.modal-open && Filters.has-media && !Filters.auto-crop-running },
                { kind: 1 },
                { id: "rotate_left", title: "Rotate Left", shortcut: Shortcuts.rotate-left, enabled: !root.modal-open },
                { id: "rotate_right", title: "Rotate Right", shortcut: Shortcuts.rotate-right, enabled: !root.modal-open },
                { id: "mirror_horizontal", title: "Mirror Left and Right", shortcut: Shortcuts.mirror-horizontal,
                    enabled: !root.modal-open },
                { id: "mirror_vertical", title: "Mirror Top and Bottom", shortcut: Shortcuts.mirror-vertical,
                    enabled: !root.modal-open },
                { kind: 1 },
                // Held (P9.12, review note 63); its key acts at once (user decision Q-Q4).
                { id: "reset_filters", title: "Reset Filters", shortcut: Shortcuts.filter-reset, hold: true,
                    tooltip: "Switch every filter off and back to its defaults",
                    enabled: !root.modal-open },
                { kind: 1 },
                { id: "probe_render", title: "Probe Render", shortcut: Shortcuts.probe-render,
                    enabled: !root.modal-open && (Playback.has-video || Probe.playing) && !Probe.running },
                { id: "probe_back", title: "Back to the Source", enabled: !root.modal-open && Probe.playing },
            ],
        },
        {
            title: "View",
            items: [
                { id: "toggle_left", enabled: !root.modal-open && Dock.left-shown,
                    title: Dock.left-collapsed ? "Expand Left Sidebar" : "Collapse Left Sidebar" },
                { id: "toggle_right", enabled: !root.modal-open && Dock.right-shown,
                    title: Dock.right-collapsed ? "Expand Right Sidebar" : "Collapse Right Sidebar" },
                { kind: 1 },
                { id: "zoom_in", title: "Zoom Timeline In", shortcut: Shortcuts.zoom-in,
                    enabled: !root.modal-open && Timeline.active },
                { id: "zoom_out", title: "Zoom Timeline Out", shortcut: Shortcuts.zoom-out,
                    enabled: !root.modal-open && Timeline.active && Timeline.zoomed },
                { id: "zoom_fit", title: "Fit Timeline", shortcut: Shortcuts.zoom-fit,
                    enabled: !root.modal-open && Timeline.active && Timeline.zoomed },
                { id: "toggle_thumbnails", shortcut: Shortcuts.thumbnails, enabled: !root.modal-open,
                    title: Thumbs.enabled ? "Hide Timeline Thumbnails" : "Show Timeline Thumbnails" },
                { kind: 1 },
                // Held (P9.12, review note 64).
                { id: "reset_layout", title: "Reset Layout", hold: true,
                    tooltip: "Put every panel back where it was at the first start", enabled: !root.modal-open },
            ],
        },
        {
            title: "Help",
            items: [
                { id: "folder_config", title: "Open Settings Folder", enabled: !root.modal-open },
                { id: "folder_data", title: "Open Data Folder", enabled: !root.modal-open },
                { id: "folder_logs", title: "Open Log Folder", enabled: !root.modal-open },
                { kind: 1 },
                { id: "about", title: "About RustCut", enabled: !root.modal-open },
            ],
        },
    ];

    // What a menu entry does.
    function run-menu(id: string) {
        if id == "open" {
            root.open-file();
        } else if id == "save" {
            Export.save();
        } else if id == "settings" {
            root.open-settings();
        } else if id == "quit" {
            root.request-quit();
        } else if id == "toggle_pause" {
            Playback.toggle-pause();
        } else if id == "frame_back" {
            Playback.frame-step(true);
        } else if id == "frame_forward" {
            Playback.frame-step(false);
        } else if id == "toggle_mute" {
            Playback.toggle-mute();
        } else if id == "reload" {
            Playback.reload();
        } else if id == "clear_sections" {
            Sections.clear-all();
        } else if id == "probe_back" {
            Probe.back();
        } else if id == "toggle_left" {
            Dock.toggle-sidebar(0);
        } else if id == "toggle_right" {
            Dock.toggle-sidebar(1);
        } else if id == "reset_layout" {
            Dock.reset-layout();
        } else if id == "folder_config" {
            root.open-folder("config");
        } else if id == "folder_data" {
            root.open-folder("data");
        } else if id == "folder_logs" {
            root.open-folder("logs");
        } else if id == "about" {
            root.open-settings-page("about");
        } else {
            // Every other entry is a keymap action of the same id.
            Shortcuts.run(id);
        }
    }

    // The height of the menu bar; everything else starts below it.
    property <length> bar-height: bar.height;

    bar := AppMenuBar {
        x: 0;
        y: 0;
        width: parent.width;
        menus: root.menus;
        changed-open(open) => {
            if !open {
                key-scope.focus();
            }
        }
    }

    key-scope := FocusScope {
        x: 0;
        y: root.bar-height;
        width: parent.width;
        height: parent.height - root.bar-height;

        key-pressed(event) => {
            // A drag of list rows runs: Escape cancels it (P9.4).
            if event.text == Key.Escape && DragState.active {
                DragState.cancel();
                return accept;
            }
            if event.text == Key.Escape && PlayerPopup.volume-open {
                PlayerPopup.volume-open = false;
                return accept;
            }
            // A filter's options menu closes (a pinned one only when no action takes Escape, P9.13).
            if event.text == Key.Escape && Filters.menu-kind != "" && !Filters.menu-pinned {
                Filters.close-menu();
                return accept;
            }
            if Shortcuts.key-pressed(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift,
                event.modifiers.meta, event.repeat) {
                return accept;
            }
            if event.text == Key.Escape && Filters.menu-kind != "" {
                Filters.close-menu();
                return accept;
            }
            reject
        }

        key-released(event) => {
            Shortcuts.key-released(event.text);
            reject
        }

        VerticalLayout {
            HorizontalLayout {
                vertical-stretch: 1;

                left-sidebar := DockSidebar {
                    width: !Dock.left-shown ? 0px : (Dock.left-collapsed ? DockMetrics.rail-width : Dock.left-width);
                    side: 0;
                    groups: Dock.left-groups;
                    rail: Dock.left-rail;
                    total-fixed: Dock.left-total-fixed;
                    collapsed: Dock.left-collapsed;
                }

                if Dock.left-shown && !Dock.left-collapsed: ResizerBar {
                    is-horizontal: true;
                    thickness: 5px;
                    drag-started => { Dock.sidebar-resize-started(0); }
                    dragged(delta) => { Dock.sidebar-resized(0, delta); }
                }

                center-area := VerticalLayout {
                    horizontal-stretch: 1;
                    min-width: 240px;

                    player := PlayerView {
                        vertical-stretch: 1;
                        frame: root.video-frame;
                    }

                    if Thumbs.strip-shown: ThumbStrip { }

                    TimelineStrip { }

                    PlayerTransport { }
                }

                if Dock.right-shown && !Dock.right-collapsed: ResizerBar {
                    is-horizontal: true;
                    thickness: 5px;
                    drag-started => { Dock.sidebar-resize-started(1); }
                    dragged(delta) => { Dock.sidebar-resized(1, delta); }
                }

                right-sidebar := DockSidebar {
                    width: !Dock.right-shown ? 0px : (Dock.right-collapsed ? DockMetrics.rail-width : Dock.right-width);
                    side: 1;
                    groups: Dock.right-groups;
                    rail: Dock.right-rail;
                    total-fixed: Dock.right-total-fixed;
                    collapsed: Dock.right-collapsed;
                }
            }

            StatusLine { }
        }

        // It goes 0.4 s after the pointer left rail and group, unless it was held to stay.
        Timer {
            interval: 400ms;
            running: RailPeek.side >= 0 && RailPeek.pin(RailPeek.side) < 0 && RailPeek.hover-rail != RailPeek.side
                && !RailPeek.over-group;
            triggered => {
                RailPeek.side = -1;
                RailPeek.over-group = false;
            }
        }
    }

    // The banner lies on the top of the video, full width (Q-N8).
    notice-banner := NoticeBanner {
        x: player.absolute-position.x;
        y: player.absolute-position.y;
        width: player.width;
        area-height: player.height;
    }

    // The timeline's thumbnail, over the video (P12 block 6).
    if Thumbs.shown && !root.modal-open: ThumbPopup {
        x: center-area.absolute-position.x + Thumbs.left;
        y: player.absolute-position.y + player.height - self.height - 4px;
        available-height: player.height - 8px;
    }

    // A rail icon's group over the video while its sidebar is collapsed (P9.9, Q-P9.9), above the video's banner.
    // A held group stays (each side its own, user review 2026-10-27); hovering or clicking the rail shows another.
    if Dock.left-collapsed && (RailPeek.side == 0 || RailPeek.pin-left >= 0): DockPeek {
        x: left-sidebar.absolute-position.x + left-sidebar.width;
        y: left-sidebar.absolute-position.y;
        width: Dock.left-width;
        height: left-sidebar.height;
        side: 0;
        index: RailPeek.side == 0 ? RailPeek.group : RailPeek.pin-left;
        group: Dock.left-groups[self.index];
    }

    if Dock.right-collapsed && (RailPeek.side == 1 || RailPeek.pin-right >= 0): DockPeek {
        x: right-sidebar.absolute-position.x - Dock.right-width;
        y: right-sidebar.absolute-position.y;
        width: Dock.right-width;
        height: right-sidebar.height;
        side: 1;
        index: RailPeek.side == 1 ? RailPeek.group : RailPeek.pin-right;
        group: Dock.right-groups[self.index];
    }

    ToastLayer {
        x: 0;
        y: root.bar-height;
        width: parent.width;
        height: parent.height - root.bar-height;
        video-x: player.absolute-position.x - root.content-x;
        video-y: player.absolute-position.y - root.content-y;
        video-width: player.width;
        video-height: player.height;
        top-inset: notice-banner.shown-height;
        bottom-inset: Theme.status-bar-height;
    }

    DockOverlay {
        x: 0;
        y: root.bar-height;
        width: parent.width;
        height: parent.height - root.bar-height;
    }

    if Export.dialog-open: ConflictDialog {
        x: 0;
        y: root.bar-height;
        width: parent.width;
        height: parent.height - root.bar-height;
    }

    if Export.meta-open: MetadataDialog {
        x: 0;
        y: root.bar-height;
        width: parent.width;
        height: parent.height - root.bar-height;
    }

    if Relocate.open: RelocateDialog {
        x: 0;
        y: root.bar-height;
        width: parent.width;
        height: parent.height - root.bar-height;
    }

    if Relocate.records-open: RelocateRecordsDialog {
        x: 0;
        y: root.bar-height;
        width: parent.width;
        height: parent.height - root.bar-height;
    }

    if Power.asking: QuitDialog {
        x: 0;
        y: root.bar-height;
        width: parent.width;
        height: parent.height - root.bar-height;
    }

    if Problems.newer-open: NewerFileDialog {
        x: 0;
        y: root.bar-height;
        width: parent.width;
        height: parent.height - root.bar-height;
    }

    if Problems.db-open: QueueDatabaseDialog {
        x: 0;
        y: root.bar-height;
        width: parent.width;
        height: parent.height - root.bar-height;
    }

    if JobLoad.open: JobLoadDialog {
        x: 0;
        y: root.bar-height;
        width: parent.width;
        height: parent.height - root.bar-height;
    }

    if Notices.bell-open: BellPopup {
        x: 0;
        y: root.bar-height;
        width: parent.width;
        height: parent.height - root.bar-height;
        anchor-x: bell.x + bell.width;
        anchor-y: bell.y + bell.height - root.bar-height;
    }

    // The bell sits in the menu bar's row, at its right end.
    bell := NoticeBell {
        visible: Notices.bell;
        x: parent.width - self.width - 8px;
        y: (root.bar-height - self.height) / 2;
    }

    PlayerPopups {
        x: 0;
        y: root.bar-height;
        width: parent.width;
        height: parent.height - root.bar-height;
    }

    // The folder wheel over the video (P11.5): centered on it, as large as the window allows.
    if FolderWheel.shown: FolderWheelLayer {
        x: 0;
        y: root.bar-height;
        width: parent.width;
        height: parent.height - root.bar-height;
        center-x: player.absolute-position.x - root.content-x + player.width / 2;
        center-y: player.absolute-position.y - root.content-y + player.height / 2;
        video-x: player.absolute-position.x - root.content-x;
        video-y: player.absolute-position.y - root.content-y;
        video-width: player.width;
        video-height: player.height;
    }

    // The hold ring at the pointer while the middle button is held over the video.
    if FolderWheel.arming: WheelHoldRing {
        x: player.absolute-position.x + player.width / 2 + FolderWheel.ring-x - self.width / 2;
        y: player.absolute-position.y + player.height / 2 + FolderWheel.ring-y - self.height / 2;
    }

    // The Job Finalization card's folder list hangs from its field (P11.4).
    if FolderList.open: FolderListFlyout {
        x: 0;
        y: root.bar-height;
        width: parent.width;
        height: parent.height - root.bar-height;
        anchor-x: FolderList.anchor-x - root.content-x;
        anchor-y: FolderList.anchor-y - root.content-y;
        anchor-width: FolderList.anchor-width;
        anchor-height: FolderList.anchor-height;
    }

    // The queue's filter menu hangs from its button (P9.6).
    if Queue.filter-open: QueueFilterFlyout {
        x: 0;
        y: root.bar-height;
        width: parent.width;
        height: parent.height - root.bar-height;
        anchor-x: Queue.filter-anchor-x - root.content-x;
        anchor-y: Queue.filter-anchor-y - root.content-y;
        anchor-width: Queue.filter-anchor-width;
        anchor-height: Queue.filter-anchor-height;
    }

    // The crop history hangs from its button (P12 4.3).
    if CropHistoryUi.open: CropHistoryFlyout {
        x: 0;
        y: root.bar-height;
        width: parent.width;
        height: parent.height - root.bar-height;
        anchor-x: CropHistoryUi.anchor-x - root.content-x;
        anchor-y: CropHistoryUi.anchor-y - root.content-y;
        anchor-width: CropHistoryUi.anchor-width;
        anchor-height: CropHistoryUi.anchor-height;
    }

    // A filter's options menu hangs beside its adjustments button (P9.13).
    if Filters.menu-kind != "": FilterMenuFlyout {
        x: 0;
        y: root.bar-height;
        width: parent.width;
        height: parent.height - root.bar-height;
        anchor-x: Filters.menu-anchor-x - root.content-x;
        anchor-y: Filters.menu-anchor-y - root.content-y;
        anchor-width: Filters.menu-anchor-width;
        anchor-height: Filters.menu-anchor-height;
    }

    ContextMenuLayer {
        x: 0;
        y: root.bar-height;
        width: parent.width;
        height: parent.height - root.bar-height;
    }

    // The open menu of the menu bar (P9.12).
    MenuBarLayer {
        x: 0;
        y: root.bar-height;
        width: parent.width;
        height: parent.height - root.bar-height;
        menus: root.menus;
        activated(id) => { root.run-menu(id); }
        closed => { key-scope.focus(); }
    }

    TooltipLayer {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
    }
}
