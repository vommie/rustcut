// The Filters card of the Export panel (P9.13, Q-P9.13 layout A; src/ui/filters/ fills the `Filters` global and handles
// its callbacks). One row per filter in chain order: a grip to drag it to another place (P9.4), its name as the on/off
// button (filled when on), its basic values always visible (dimmed while it is off; typing a value keeps it off,
// Q-P9.13 C), and the adjustments button that opens its options menu (`filters_menu.slint`; Orientation has none, its
// slot stays empty). Every row is a whole number of lines high, so nothing jumps when a filter switches. The output
// size, the preview, keep and reset sit in the card's header (`dock_panels.slint`). Buttons are icons with tooltips
// (user rule 2026-10-23).

import { Theme } from "styles.slint";
import { AppIcon, IconId, IconSize } from "icons.slint";
import { ChoiceButton, FieldIcon, IconButton, NumberField } from "controls.slint";
import { TooltipArea, TooltipHost } from "tooltip.slint";
import { Playback } from "player_types.slint";
import { DragArea, DragGhost, DragMotion, DragState, DropGap } from "drag.slint";
import { FilterRowView, Filters } from "filters_types.slint";

/// The width of every filter's name button (the values start on one line).
global FilterMetrics {
    out property <length> name-width: 84px;
    out property <length> grip-width: 14px;
    out property <length> spacing: 4px;
    // The adjustments button (an `IconButton`) or the empty slot of Orientation.
    out property <length> options-width: 26px;
}

/// A filter's name: the on/off button (filled, bold and outlined when on; PyCutRv). Its width is fixed, so the bold
/// name never moves the values.
component NameButton inherits Rectangle {
    in property <FilterRowView> item;

    width: FilterMetrics.name-width;
    height: 24px;
    border-radius: 4px;
    background: root.item.enabled ? Theme.primary.with-alpha(touch.has-hover ? 0.3 : 0.22)
        : touch.pressed ? Theme.surface-selected : touch.has-hover ? Theme.surface-hover : Theme.surface;
    border-width: 1px;
    border-color: root.item.enabled ? Theme.primary : Theme.border;

    host := TooltipHost {
        text: (root.item.enabled ? "On (click: switch off). " : "Off (click: switch on). ") + root.item.tooltip;
    }

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            host.press();
            Filters.toggle(root.item.kind);
        }
        changed has-hover => {
            if self.has-hover {
                host.enter();
            } else {
                host.leave();
            }
        }
    }

    Text {
        x: 8px;
        width: parent.width - 12px;
        text: root.item.title;
        color: root.item.enabled ? Theme.text : Theme.text-muted;
        font-size: 12px;
        font-weight: root.item.enabled ? 700 : 400;
        vertical-alignment: center;
        overflow: elide;
    }
}

/// The button that opens (and closes) a filter's options menu; the menu hangs from it.
component OptionsButton inherits IconButton {
    in property <string> kind;

    icon: IconId.filter-options;
    checked: Filters.menu-kind == root.kind;
    tooltip: Filters.menu-kind == root.kind ? "Close the options" : "Options";
    // The stack scrolled: the open menu follows this button, kept at the stack's edge while the row is out of view.
    property <int> scrolls: Filters.stack-scrolls;
    changed scrolls => {
        if Filters.menu-kind == root.kind {
            Filters.menu-anchor-y = Math.max(Filters.stack-top,
                Math.min(Filters.stack-bottom - self.height, self.absolute-position.y));
        }
    }
    clicked => {
        Filters.menu-anchor-x = self.absolute-position.x;
        Filters.menu-anchor-y = self.absolute-position.y;
        Filters.menu-anchor-width = self.width;
        Filters.menu-anchor-height = self.height;
        Filters.open-menu(root.kind);
    }
}

/// The interlace check's short result next to the deinterlacer ("progressive", "interlaced"), its counts in the tooltip.
component InterlacePill inherits TooltipArea {
    title: "Interlace check";
    text: Filters.interlace-detail;
    rows: Filters.interlace-rows;
    min-width: 0;
    preferred-width: label.preferred-width + 12px;
    horizontal-stretch: 0;

    pill := Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: Math.min(parent.width, label.preferred-width + 12px);
        height: 18px;
        border-radius: 9px;
        border-width: 1px;
        border-color: Filters.interlace-level == 2 ? Theme.accent : Theme.border;

        label := Text {
            x: 6px;
            width: parent.width - 12px;
            text: Filters.interlace-hint;
            color: Filters.interlace-level == 2 ? Theme.accent : Theme.text-muted;
            font-size: 10px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

component DeinterlaceValues inherits HorizontalLayout {
    spacing: FilterMetrics.spacing;

    ChoiceButton {
        min-width: 40px;
        items: Filters.deinterlacers;
        current: Filters.deinterlacer;
        tip-title: "Deinterlacer";
        tooltip: Filters.tips.deinterlacer;
        selected(index) => { Filters.set-deinterlacer(index); }
    }

    // Only for a playable video: a file that does not play is never checked (P8).
    if Filters.interlace-level > 0 && Playback.has-video: InterlacePill { }

    Rectangle {
        horizontal-stretch: 0.01;
    }
}

/// Line 1 of Crop: edit on the video, auto-crop, and the size the crop keeps (the ratios are on the crop itself, P9.14).
component CropTools inherits HorizontalLayout {
    spacing: 2px;

    IconButton {
        icon: IconId.crop-edit;
        checked: Filters.crop-editing;
        enabled: Filters.can-edit-crop;
        tooltip: Filters.crop-editing
            ? "Done: keep the crop (Enter). Escape restores the crop from before."
            : "Edit the crop on the video: drag the corners, the edges or the area (Shift keeps the ratio; the button on the crop picks one). Quicker: hold Ctrl over the video and drag the nearest edge.";
        shortcut: Filters.key-crop-edit;
        clicked => { Filters.crop-edit(); }
    }

    IconButton {
        icon: IconId.crop-auto;
        enabled: Filters.has-media && !Filters.auto-crop-running;
        checked: Filters.auto-crop-running;
        tooltip: Filters.auto-crop-running
            ? "Looking for black borders..."
            : "Detect the black borders at several points of the video and crop them (the options menu says how).";
        shortcut: Filters.key-auto-crop;
        clicked => { Filters.auto-crop(); }
    }

    TooltipArea {
        text: "What the crop keeps, as seen in the output";
        horizontal-stretch: 1;
        min-width: 0;

        Text {
            width: parent.width;
            height: parent.height;
            text: Filters.crop-size;
            color: Theme.text-muted;
            font-size: 11px;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

component CropField inherits HorizontalLayout {
    in property <int> edge;
    in property <IconId> icon;
    in property <string> name;

    spacing: 1px;

    FieldIcon {
        icon: root.icon;
        tooltip: root.name + " edge as seen in the output (pixels)";
    }

    NumberField {
        min-width: 30px;
        text: Filters.crop-edges[root.edge];
        tooltip: root.name + " edge in pixels (click, then the wheel: 1, Ctrl 10, Shift 100)";
        spin: false;
        pixel-steps: true;
        committed(text) => { return Filters.edit-crop(root.edge, text); }
        stepped(steps) => { Filters.step-crop(root.edge, steps); }
    }
}

/// Line 2 of Crop: the four edges as seen in the output.
component CropEdges inherits HorizontalLayout {
    spacing: FilterMetrics.spacing;

    CropField {
        edge: 0;
        icon: IconId.edge-top;
        name: "Top";
    }

    CropField {
        edge: 1;
        icon: IconId.edge-right;
        name: "Right";
    }

    CropField {
        edge: 2;
        icon: IconId.edge-bottom;
        name: "Bottom";
    }

    CropField {
        edge: 3;
        icon: IconId.edge-left;
        name: "Left";
    }
}

/// A Deshake number labeled by a small symbol (its tooltip names and explains it; review 2).
component DeshakeValue inherits TooltipArea {
    in property <IconId> icon;
    in property <string> value;

    preferred-width: layout.preferred-width;
    horizontal-stretch: 0;

    layout := HorizontalLayout {
        spacing: 2px;

        VerticalLayout {
            alignment: center;

            AppIcon {
                icon: root.icon;
                size: IconSize.sm;
                color: Theme.text-muted;
            }
        }

        Text {
            text: root.value;
            color: Theme.text-muted;
            font-size: 11px;
            vertical-alignment: center;
        }
    }
}

/// Deshake shows only what is set (Q-P9.13: everything else is in its menu): shakiness and smoothing with symbols, the
/// rest in dim words. That it renders only is in the name button's tooltip (review 2).
component DeshakeValues inherits HorizontalLayout {
    spacing: 8px;

    DeshakeValue {
        icon: IconId.deshake-shakiness;
        value: Filters.deshake-values[0];
        title: "Shakiness";
        text: Filters.tips.shakiness;
    }

    DeshakeValue {
        icon: IconId.deshake-smoothing;
        value: Filters.deshake-values[3];
        title: "Smoothing";
        text: Filters.tips.smoothing;
    }

    TooltipArea {
        text: "Open the options to change them.";
        horizontal-stretch: 1;
        min-width: 0;

        Text {
            width: parent.width;
            height: parent.height;
            text: Filters.deshake-extra;
            color: Theme.text-muted;
            font-size: 11px;
            font-italic: true;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

/// The orientation's result: an "F" turned and mirrored like the picture.
component OrientationGlyph inherits Rectangle {
    in property <int> turns;
    in property <bool> mirrored;
    in property <bool> active: true;

    width: 24px;
    height: 24px;
    border-radius: 4px;
    background: Theme.background;
    border-width: 1px;
    border-color: Theme.border;

    // Drawn as lines (a turned text glyph renders smeared); Slint turns first and scales afterwards: the order of the
    // values (turns, then the mirror).
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M 9 5 L 9 19 M 9 5 L 16 5 M 9 12 L 14.5 12";
        stroke: root.active ? Theme.primary : Theme.text-muted;
        stroke-width: 2.4px;
        stroke-line-cap: round;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        transform-rotation: root.turns * 90deg;
        transform-scale-x: root.mirrored ? -1 : 1;
    }
}

component OrientationValues inherits HorizontalLayout {
    in property <bool> active;

    spacing: 2px;

    IconButton {
        icon: IconId.rotate-left;
        checked: Filters.orientation-turn == 3;
        tooltip: Filters.orientation-turn == 3 ? "Turned a quarter to the left (click: undo)" : "Turn a quarter to the left";
        shortcut: Filters.key-rotate-left;
        clicked => { Filters.rotate(false); }
    }

    IconButton {
        icon: IconId.rotate-right;
        checked: Filters.orientation-turn == 1;
        tooltip: Filters.orientation-turn == 1 ? "Turned a quarter to the right (click: undo)" : "Turn a quarter to the right";
        shortcut: Filters.key-rotate-right;
        clicked => { Filters.rotate(true); }
    }

    IconButton {
        icon: IconId.mirror-horizontal;
        checked: Filters.orientation-mirror-horizontal;
        tooltip: Filters.orientation-mirror-horizontal ? "Mirrored left and right (click: undo)" : "Mirror left and right";
        shortcut: Filters.key-mirror-horizontal;
        clicked => { Filters.mirror(true); }
    }

    IconButton {
        icon: IconId.mirror-vertical;
        checked: Filters.orientation-mirror-vertical;
        tooltip: Filters.orientation-mirror-vertical ? "Mirrored top and bottom (click: undo)" : "Mirror top and bottom";
        shortcut: Filters.key-mirror-vertical;
        clicked => { Filters.mirror(false); }
    }

    VerticalLayout {
        alignment: center;

        TooltipArea {
            width: 24px;
            height: 24px;
            text: "Result: " + Filters.orientation-label + ". Both mirrors turn the picture upside down.";

            OrientationGlyph {
                turns: Filters.orientation-turns;
                mirrored: Filters.orientation-mirrored;
                active: root.active;
            }
        }
    }

    Rectangle {
        horizontal-stretch: 0.01;
    }
}

component ResizeValues inherits HorizontalLayout {
    spacing: 2px;

    NumberField {
        min-width: 30px;
        text: Filters.resize-width;
        placeholder: Filters.resize-auto-width;
        unit: "px";
        spin: false;
        pixel-steps: true;
        tooltip: "Width in pixels; empty keeps the aspect ratio of the height (the dim number is what it comes to; click, then the wheel: 1, Ctrl 10, Shift 100)";
        committed(text) => { return Filters.edit-resize(0, text); }
        stepped(steps) => { Filters.step-resize(0, steps); }
    }

    Text {
        text: "×";
        color: Theme.text-muted;
        font-size: 11px;
        vertical-alignment: center;
    }

    NumberField {
        min-width: 30px;
        text: Filters.resize-height;
        placeholder: Filters.resize-auto-height;
        unit: "px";
        spin: false;
        pixel-steps: true;
        tooltip: "Height in pixels; empty keeps the aspect ratio of the width (the dim number is what it comes to; click, then the wheel: 1, Ctrl 10, Shift 100)";
        committed(text) => { return Filters.edit-resize(1, text); }
        stepped(steps) => { Filters.step-resize(1, steps); }
    }

    IconButton {
        icon: IconId.ratio-presets;
        tooltip: "The height for a ratio (16:9, 4:3) from the width";
        clicked => {
            Filters.resize-ratio-menu(self.absolute-position.x, self.absolute-position.y, self.width, self.height);
        }
    }
}

/// One filter. Its free space and its grip drag it (P9.4); a right click opens its menu.
component FilterRow inherits Rectangle {
    in property <FilterRowView> item;
    // How far the row moves aside while another one is dragged, and whether it is the dragged one (the ghost shows it
    // under the pointer, so it is hidden here and keeps its place: its grip holds the pointer).
    in property <length> drag-shift;
    in property <bool> lifted;
    callback drag-started(/* window y of the press */ length);
    callback drag-moved(/* window y */ length);
    callback drag-ended();

    height: root.item.lines * Filters.line-height;

    body := Rectangle {
        y: root.lifted ? 0px : root.drag-shift;
        animate y { duration: Filters.drag-instant ? 0ms : DragMotion.shift; easing: ease-out; }
        width: parent.width;
        height: parent.height;
        opacity: root.lifted ? 0 : 1;
        border-radius: 4px;
        // A light tint while the pointer is anywhere on the row, its buttons and fields too (Q-P9n): the hover area
        // wraps the content, the drag area and the controls take the presses.
        background: hover.has-hover && !Filters.dragging ? Theme.surface-hover.with-alpha(0.55) : transparent;

        hover := TouchArea {
            width: 100%;
            height: 100%;

            area := DragArea {
                mouse-cursor: MouseCursor.move;
                menu(x, y) => {
                    Filters.row-menu(root.item.kind, x, y,
                        body.absolute-position.x + body.width - FilterMetrics.options-width, body.absolute-position.y + 2px);
                }
                drag-started(y) => { root.drag-started(y); }
                drag-moved(y) => { root.drag-moved(y); }
                drag-ended => { root.drag-ended(); }
            }

            VerticalLayout {
                padding-top: 2px;
                padding-bottom: 2px;
                spacing: 4px;

                HorizontalLayout {
                    height: 24px;
                    spacing: FilterMetrics.spacing;

                    // The handle (the row's free space drags too).
                    Rectangle {
                        width: FilterMetrics.grip-width;

                        AppIcon {
                            y: (parent.height - self.height) / 2;
                            icon: IconId.drag-grip;
                            size: IconSize.sm;
                            color: Theme.status-deleted;
                        }
                    }

                    NameButton {
                        item: root.item;
                    }

                    // The values stay usable while the filter is off; they are dimmed (Q-P9.13).
                    values := Rectangle {
                        horizontal-stretch: 1;
                        min-width: 0;
                        opacity: root.item.enabled ? 1 : 0.5;

                        HorizontalLayout {
                            if root.item.kind == "deinterlace": DeinterlaceValues { }
                            if root.item.kind == "crop": CropTools { }
                            if root.item.kind == "deshake": DeshakeValues { }
                            if root.item.kind == "orientation": OrientationValues {
                                active: root.item.enabled;
                            }
                            if root.item.kind == "resize": ResizeValues { }
                        }
                    }

                    if root.item.has-menu: OptionsButton {
                        kind: root.item.kind;
                    }

                    if !root.item.has-menu: Rectangle {
                        width: FilterMetrics.options-width;
                    }
                }

                if root.item.kind == "crop": HorizontalLayout {
                    height: 24px;
                    padding-left: FilterMetrics.grip-width + FilterMetrics.spacing;

                    Rectangle {
                        opacity: root.item.enabled ? 1 : 0.5;

                        CropEdges { }
                    }
                }
            }
        }
    }
}

/// The body of the Filters card.
export component FiltersCardBody inherits Rectangle {
    VerticalLayout {
        padding: 8px;
        padding-top: 0px;
        padding-left: 4px;

        list-area := Rectangle {
            height: list.preferred-height;

            // The card stack scrolled under the pointer: the pointer is measured again (`DragState.scrolls`).
            property <int> scrolls: DragState.scrolls;
            changed scrolls => {
                if Filters.dragging {
                    Filters.drag-move(DragState.pointer-y - list.absolute-position.y);
                }
            }

            list := VerticalLayout {
                width: parent.width;
                height: parent.height;
                alignment: start;
                spacing: Filters.row-spacing;

                for row[index] in Filters.rows: FilterRow {
                    item: row;
                    drag-shift: index < Filters.drag-shifts.length ? Filters.drag-shifts[index] : 0px;
                    lifted: Filters.dragging && Filters.drag-kind == row.kind;
                    // Drag & drop (P9.4): window coordinates turn into the list's coordinates.
                    drag-started(y) => {
                        DragState.pointer-y = y;
                        Filters.drag-start(index, y - list.absolute-position.y);
                    }
                    drag-moved(y) => {
                        DragState.pointer-y = y;
                        Filters.drag-move(y - list.absolute-position.y);
                    }
                    drag-ended => { Filters.drag-end(); }
                }
            }

            // Where the dragged filter would land (the other rows moved aside).
            if Filters.dragging: DropGap {
                x: 0px;
                y: Filters.drag-gap-y;
                width: parent.width;
                height: Math.max(0px, Filters.drag-gap-height - Filters.row-spacing);
            }

            // The dragged filter under the pointer.
            if Filters.dragging: DragGhost {
                x: 0px;
                y: Filters.drag-ghost-y;
                width: parent.width;
                height: Filters.drag-ghost-height;
                title: Filters.drag-title;
            }
        }
    }
}
