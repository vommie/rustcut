// The Filters card of the Export panel (src/ui/filters/ fills the `Filters` global and handles its callbacks): the preview
// and keep switches, reset, the output size, and one row per filter in chain order (switch, title, move up/down) with
// its parameters while it is on. Buttons are icons with tooltips (user rule 2026-10-23).

import { Theme } from "styles.slint";
import { IconId, IconSize } from "icons.slint";
import { ChoiceButton, FieldIcon, IconButton, NumberField, Switch } from "controls.slint";
import { TipRow, TooltipArea } from "tooltip.slint";

export struct FilterRowView {
    kind: string,
    title: string,
    tooltip: string,
    enabled: bool,
    can-up: bool,
    can-down: bool,
}

export global Filters {
    // A video is probed: sizes and the crop on the video are known.
    in property <bool> has-media;
    in property <bool> preview;
    in property <bool> keep;
    // "Output 1920×1080"; a warning when the chain removes the whole picture.
    in property <string> output;
    in property <bool> output-warning;
    in property <[FilterRowView]> rows;

    in property <[string]> deinterlacers;
    in property <int> deinterlacer;
    in property <bool> field-rate;
    in property <bool> field-rate-supported;
    // The interlace check: 0 hidden, 1 plain, 2 worth acting on.
    in property <string> interlace-hint;
    in property <int> interlace-level;
    in property <string> interlace-detail;
    // What ffmpeg's idet counted (the note's tooltip).
    in property <[TipRow]> interlace-rows;

    // Top, right, bottom, left as seen in the output.
    in property <[string]> crop-edges: ["0", "0", "0", "0"];
    in property <bool> crop-editing;
    in property <bool> can-edit-crop;
    in property <bool> auto-crop-running;
    in property <[string]> aspects;
    in property <int> aspect;

    in property <int> quarter-turns;
    in property <bool> mirror-horizontal;
    in property <bool> mirror-vertical;

    in property <string> resize-width;
    in property <string> resize-height;
    in property <string> resize-auto-width;
    in property <string> resize-auto-height;
    in property <[string]> algorithms;
    in property <int> algorithm;

    // Shakiness, accuracy, step size, smoothing, zoom.
    in property <[string]> deshake-values: ["5", "10", "12", "10", "0"];
    in property <int> deshake-optzoom;
    in property <int> deshake-borders;
    in property <[string]> interpolations;
    in property <int> deshake-interpolation;
    in property <bool> deshake-tripod;

    // The keys of the actions, for the tooltips.
    in property <string> key-preview;
    in property <string> key-keep;
    in property <string> key-reset;
    in property <string> key-crop-edit;
    in property <string> key-auto-crop;
    in property <string> key-rotate-left;
    in property <string> key-rotate-right;
    in property <string> key-mirror-horizontal;
    in property <string> key-mirror-vertical;

    callback toggle(/* kind */ string);
    callback move(/* kind */ string, /* up */ bool);
    callback reset();
    callback set-preview(bool);
    callback set-keep(bool);
    callback set-deinterlacer(int);
    callback set-field-rate(bool);
    // A typed edge (0 top, 1 right, 2 bottom, 3 left); false = not a number (the field stays open and turns red).
    callback edit-crop(int, string) -> bool;
    callback step-crop(int, /* steps */ int);
    callback crop-edit();
    callback auto-crop();
    callback set-aspect(int);
    callback rotate(/* clockwise */ bool);
    callback mirror(/* horizontal */ bool);
    // 0 = width, 1 = height; empty = automatic.
    callback edit-resize(int, string) -> bool;
    callback step-resize(int, int);
    callback resize-ratio(/* 0 = 16:9, 1 = 4:3 */ int);
    callback set-algorithm(int);
    // 0 shakiness, 1 accuracy, 2 step size, 3 smoothing, 4 zoom.
    callback edit-deshake(int, string) -> bool;
    callback step-deshake(int, int);
    // 0 automatic zoom, 1 borders, 2 interpolation.
    callback set-deshake-choice(int, int);
    callback set-tripod(bool);
}

component Label inherits Text {
    color: Theme.text-muted;
    font-size: 11px;
    vertical-alignment: center;
    overflow: elide;
    min-width: 0;
}

component DeinterlaceParams inherits HorizontalLayout {
    spacing: 4px;

    ChoiceButton {
        items: Filters.deinterlacers;
        current: Filters.deinterlacer;
        tip-title: "Deinterlacer";
        tip-rows: [
            { label: "bwdif", value: "Motion adaptive, the best all-rounder" },
            { label: "yadif", value: "Faster and a bit softer" },
            { label: "w3fdif", value: "Sharp on calm footage" },
            { label: "kerndeint", value: "Fast" },
        ];
        selected(index) => { Filters.set-deinterlacer(index); }
    }

    IconButton {
        text: "2×";
        checked: Filters.field-rate && Filters.field-rate-supported;
        enabled: Filters.field-rate-supported;
        tooltip: Filters.field-rate-supported
            ? "One frame per field (50p from 25i): smoother motion, twice the frames to encode."
            : "kerndeint has one frame per frame only.";
        clicked => { Filters.set-field-rate(!Filters.field-rate); }
    }

    Rectangle { horizontal-stretch: 1; }
}

component CropField inherits HorizontalLayout {
    in property <int> edge;
    in property <IconId> icon;
    in property <string> name;

    spacing: 1px;

    FieldIcon {
        icon: root.icon;
        tooltip: root.name + " edge as seen in the output (pixels; the wheel changes it by 2)";
    }

    value := NumberField {
        text: Filters.crop-edges[root.edge];
        tooltip: root.name + " edge in pixels";
        committed(text) => { return Filters.edit-crop(root.edge, text); }
        stepped(steps) => { Filters.step-crop(root.edge, steps); }
    }
}

component CropParams inherits VerticalLayout {
    spacing: 4px;

    HorizontalLayout {
        spacing: 4px;

        CropField {
            edge: 0;
            icon: IconId.edge-top;
            name: "Top";
        }

        CropField {
            edge: 1;
            icon: IconId.edge-right;
            name: "Right";
        }

        CropField {
            edge: 2;
            icon: IconId.edge-bottom;
            name: "Bottom";
        }

        CropField {
            edge: 3;
            icon: IconId.edge-left;
            name: "Left";
        }
    }

    HorizontalLayout {
        spacing: 4px;

        IconButton {
            icon: IconId.crop-edit;
            checked: Filters.crop-editing;
            enabled: Filters.can-edit-crop;
            tooltip: Filters.crop-editing
                ? "Done: keep the crop (Enter). Escape restores the crop from before."
                : "Edit the crop on the video: drag the corners, the edges or the area. Quicker: hold Ctrl over the video and drag the nearest edge.";
            shortcut: Filters.key-crop-edit;
            clicked => { Filters.crop-edit(); }
        }

        IconButton {
            icon: IconId.crop-auto;
            enabled: Filters.has-media && !Filters.auto-crop-running;
            checked: Filters.auto-crop-running;
            tooltip: Filters.auto-crop-running
                ? "Looking for black borders..."
                : "Detect the black borders at several points of the video and crop them.";
            shortcut: Filters.key-auto-crop;
            clicked => { Filters.auto-crop(); }
        }

        ChoiceButton {
            icon: IconId.crop-aspect;
            items: Filters.aspects;
            current: Filters.aspect;
            tooltip: "Aspect ratio the crop keeps while it is dragged on the video (Source = the uncropped picture's).";
            selected(index) => { Filters.set-aspect(index); }
        }

        Rectangle { horizontal-stretch: 1; }
    }
}

component RotateParams inherits HorizontalLayout {
    spacing: 4px;

    IconButton {
        icon: IconId.rotate-left;
        tooltip: "Rotate a quarter turn counter-clockwise";
        shortcut: Filters.key-rotate-left;
        clicked => { Filters.rotate(false); }
    }

    IconButton {
        icon: IconId.rotate-right;
        tooltip: "Rotate a quarter turn clockwise";
        shortcut: Filters.key-rotate-right;
        clicked => { Filters.rotate(true); }
    }

    Label {
        text: Filters.quarter-turns == 1 ? "90° clockwise" : Filters.quarter-turns == 2 ? "180°"
            : Filters.quarter-turns == 3 ? "90° counter-clockwise" : "Not rotated";
        horizontal-stretch: 1;
    }
}

component MirrorParams inherits HorizontalLayout {
    spacing: 4px;

    IconButton {
        icon: IconId.mirror-horizontal;
        checked: Filters.mirror-horizontal;
        tooltip: "Mirror left and right";
        shortcut: Filters.key-mirror-horizontal;
        clicked => { Filters.mirror(true); }
    }

    IconButton {
        icon: IconId.mirror-vertical;
        checked: Filters.mirror-vertical;
        tooltip: "Mirror top and bottom";
        shortcut: Filters.key-mirror-vertical;
        clicked => { Filters.mirror(false); }
    }

    Rectangle { horizontal-stretch: 1; }
}

component ResizeParams inherits VerticalLayout {
    spacing: 4px;

    HorizontalLayout {
        spacing: 4px;

        FieldIcon {
            icon: IconId.size-width;
            tooltip: "Width in pixels; empty keeps the aspect ratio of the height";
        }

        NumberField {
            text: Filters.resize-width;
            placeholder: Filters.resize-auto-width;
            tooltip: "Width in pixels (empty = automatic)";
            committed(text) => { return Filters.edit-resize(0, text); }
            stepped(steps) => { Filters.step-resize(0, steps); }
        }

        FieldIcon {
            icon: IconId.size-height;
            tooltip: "Height in pixels; empty keeps the aspect ratio of the width";
        }

        NumberField {
            text: Filters.resize-height;
            placeholder: Filters.resize-auto-height;
            tooltip: "Height in pixels (empty = automatic)";
            committed(text) => { return Filters.edit-resize(1, text); }
            stepped(steps) => { Filters.step-resize(1, steps); }
        }
    }

    HorizontalLayout {
        spacing: 4px;

        IconButton {
            text: "16:9";
            tooltip: "Height for 16:9 from the width (even)";
            clicked => { Filters.resize-ratio(0); }
        }

        IconButton {
            text: "4:3";
            tooltip: "Height for 4:3 from the width (even)";
            clicked => { Filters.resize-ratio(1); }
        }

        ChoiceButton {
            items: Filters.algorithms;
            current: Filters.algorithm;
            tip-title: "Scaling algorithm";
            tooltip: "The output has square pixels.";
            tip-rows: [
                { label: "bicubic", value: "ffmpeg's balanced default" },
                { label: "lanczos", value: "The sharpest for shrinking" },
                { label: "spline", value: "Sharp, close to lanczos" },
                { label: "bilinear", value: "The fastest" },
            ];
            selected(index) => { Filters.set-algorithm(index); }
        }

        Rectangle { horizontal-stretch: 1; }
    }
}

component DeshakeField inherits HorizontalLayout {
    in property <int> param;
    in property <string> name;
    in property <string> tooltip;

    spacing: 4px;

    TooltipArea {
        text: root.tooltip;
        horizontal-stretch: 1;
        min-width: 30px;

        Label {
            width: parent.width;
            height: parent.height;
            text: root.name;
        }
    }

    NumberField {
        width: 44px;
        horizontal-stretch: 0;
        text: Filters.deshake-values[root.param];
        tooltip: root.tooltip;
        committed(text) => { return Filters.edit-deshake(root.param, text); }
        stepped(steps) => { Filters.step-deshake(root.param, steps); }
    }
}

component DeshakeParams inherits VerticalLayout {
    spacing: 4px;

    Label {
        text: "Applied in the render (two passes); the preview does not show it.";
        wrap: word-wrap;
    }

    HorizontalLayout {
        spacing: 8px;

        VerticalLayout {
            spacing: 4px;

            DeshakeField {
                param: 0;
                name: "Shakiness";
                tooltip: "How shaky the video is: 1 (little) to 10 (very). Higher is slower.";
            }

            DeshakeField {
                param: 1;
                name: "Accuracy";
                tooltip: "Detection accuracy, 1 to 15 (at least the shakiness). Higher is slower.";
            }

            DeshakeField {
                param: 2;
                name: "Step size";
                tooltip: "Search step in pixels, 1 to 32: smaller is more accurate and slower.";
            }
        }

        VerticalLayout {
            spacing: 4px;

            DeshakeField {
                param: 3;
                name: "Smoothing";
                tooltip: "Frames that smooth the camera path (2n + 1), 0 to 1000: higher is steadier but follows pans later.";
            }

            DeshakeField {
                param: 4;
                name: "Zoom %";
                tooltip: "Extra zoom in percent, -100 to 100 (hides moving borders).";
            }

            HorizontalLayout {
                spacing: 4px;

                TooltipArea {
                    text: "Virtual tripod: keep the camera fixed on the first frame.";
                    horizontal-stretch: 1;
                    min-width: 30px;

                    Label {
                        width: parent.width;
                        height: parent.height;
                        text: "Tripod";
                    }
                }

                VerticalLayout {
                    alignment: center;
                    width: 44px;

                    Switch {
                        checked: Filters.deshake-tripod;
                        tooltip: "Virtual tripod: keep the camera fixed on the first frame.";
                        toggled => { Filters.set-tripod(!Filters.deshake-tripod); }
                    }
                }
            }
        }
    }

    HorizontalLayout {
        spacing: 4px;

        ChoiceButton {
            items: ["No auto zoom", "Static zoom", "Adaptive zoom"];
            current: Filters.deshake-optzoom;
            tip-title: "Automatic zoom against moving borders";
            tip-rows: [
                { label: "Static", value: "One zoom for the whole video" },
                { label: "Adaptive", value: "Follows the motion" },
            ];
            selected(index) => { Filters.set-deshake-choice(0, index); }
        }

        ChoiceButton {
            items: ["Black borders", "Previous frame"];
            current: Filters.deshake-borders;
            tooltip: "What fills the area the stabilized picture leaves: black, or the previous frame's content.";
            selected(index) => { Filters.set-deshake-choice(1, index); }
        }

        Rectangle { horizontal-stretch: 0.01; }
    }

    HorizontalLayout {
        spacing: 4px;

        ChoiceButton {
            items: Filters.interpolations;
            current: Filters.deshake-interpolation;
            tooltip: "Interpolation of the moved picture: bicubic is the smoothest, no is the fastest.";
            selected(index) => { Filters.set-deshake-choice(2, index); }
        }

        Rectangle { horizontal-stretch: 1; }
    }
}

component FilterRow inherits Rectangle {
    in property <FilterRowView> item;

    border-radius: 4px;
    background: root.item.enabled ? Theme.surface : transparent;

    VerticalLayout {
        padding: 4px;
        spacing: 4px;

        HorizontalLayout {
            spacing: 6px;
            height: 24px;

            VerticalLayout {
                alignment: center;

                Switch {
                    checked: root.item.enabled;
                    tooltip: (root.item.enabled ? "Switch off: " : "Switch on: ") + root.item.tooltip;
                    toggled => { Filters.toggle(root.item.kind); }
                }
            }

            TooltipArea {
                text: root.item.tooltip;
                horizontal-stretch: 0;
                min-width: title.preferred-width;

                title := Text {
                    width: parent.width;
                    height: parent.height;
                    text: root.item.title;
                    color: root.item.enabled ? Theme.text : Theme.text-muted;
                    font-size: 12px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }

            if root.item.kind == "deinterlace" && Filters.interlace-level > 0: TooltipArea {
                title: "Interlace check";
                text: Filters.interlace-detail;
                rows: Filters.interlace-rows;
                horizontal-stretch: 1;

                Text {
                    width: parent.width;
                    height: parent.height;
                    text: Filters.interlace-hint;
                    color: Filters.interlace-level == 2 ? Theme.accent : Theme.text-muted;
                    font-size: 11px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            if !(root.item.kind == "deinterlace" && Filters.interlace-level > 0): Rectangle { horizontal-stretch: 1; }

            IconButton {
                icon: IconId.move-up;
                icon-size: IconSize.sm;
                enabled: root.item.can-up;
                tooltip: "Earlier in the chain (the filters run from top to bottom)";
                clicked => { Filters.move(root.item.kind, true); }
            }

            IconButton {
                icon: IconId.move-down;
                icon-size: IconSize.sm;
                enabled: root.item.can-down;
                tooltip: "Later in the chain (the filters run from top to bottom)";
                clicked => { Filters.move(root.item.kind, false); }
            }
        }

        if root.item.enabled && root.item.kind == "deinterlace": DeinterlaceParams { }
        if root.item.enabled && root.item.kind == "crop": CropParams { }
        if root.item.enabled && root.item.kind == "deshake": DeshakeParams { }
        if root.item.enabled && root.item.kind == "rotate": RotateParams { }
        if root.item.enabled && root.item.kind == "mirror": MirrorParams { }
        if root.item.enabled && root.item.kind == "resize": ResizeParams { }
    }
}

/// The body of the Filters card.
export component FiltersCardBody inherits VerticalLayout {
    padding: 8px;
    padding-top: 0px;
    spacing: 4px;

    HorizontalLayout {
        spacing: 4px;

        IconButton {
            icon: Filters.preview ? IconId.filter-preview : IconId.filter-preview-off;
            checked: Filters.preview;
            tooltip: Filters.preview ? "The player shows the filters (click: show the video without them)"
                : "The player shows the video without filters (click: show them)";
            shortcut: Filters.key-preview;
            clicked => { Filters.set-preview(!Filters.preview); }
        }

        IconButton {
            icon: Filters.keep ? IconId.filter-kept : IconId.filter-keep;
            checked: Filters.keep;
            tooltip: Filters.keep ? "The filters stay for the next video and the next start (click: start each video without filters)"
                : "Keep these filters for the next video and the next start";
            shortcut: Filters.key-keep;
            clicked => { Filters.set-keep(!Filters.keep); }
        }

        IconButton {
            icon: IconId.filter-reset;
            hold: true;
            tooltip: "Reset every filter: off, default values, default order (the key resets at once)";
            shortcut: Filters.key-reset;
            clicked => { Filters.reset(); }
        }

        Text {
            text: Filters.output;
            horizontal-stretch: 1;
            horizontal-alignment: right;
            color: Filters.output-warning ? Theme.status-corrupt : Theme.text-muted;
            font-size: 11px;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    for row in Filters.rows: FilterRow {
        item: row;
    }
}
