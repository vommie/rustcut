// Export & Naming: the named target folders of the export card (PyCutRv's folder dialog): add, label, reorder, remove
// (held, user decision Q-Q4). "Next to the source" is always the first choice of the card and is not listed here. The card's
// jump button leads here (`settings:export.folders`, P9.7).

import { Theme } from "styles.slint";
import { AppIcon, IconId, IconSize } from "icons.slint";
import { IconButton, NumberField, UpDownButton } from "controls.slint";
import { SettingsCard } from "settings_card.slint";
import { FolderRowView, SettingsUi } from "settings_types.slint";
import { DragArea, DragGhost, DragMotion, DragState, DropGap } from "drag.slint";
import { JumpFlash } from "jump.slint";

/// One folder: its label, its path, the move buttons and the held remove button; the free space drags the row.
component FolderRow inherits Rectangle {
    in property <FolderRowView> folder;
    in property <int> index;
    // Drag & drop (P9.4): how far the row moves aside, and whether it is the dragged one (the ghost shows it; it keeps
    // its place, so its pointer area keeps the pointer).
    in property <length> drag-shift;
    in property <bool> lifted;
    callback drag-started(/* window y of the press */ length);
    callback drag-moved(/* window y */ length);
    callback drag-ended();

    height: SettingsUi.folder-row-height;

    Rectangle {
        y: root.lifted ? 0px : root.drag-shift;
        animate y { duration: SettingsUi.folder-drag-instant ? 0ms : DragMotion.shift; easing: ease-out; }
        height: parent.height;
        opacity: root.lifted ? 0 : 1;
        border-radius: 4px;
        background: area.has-hover && !SettingsUi.folder-dragging ? Theme.surface-hover : transparent;

        area := DragArea {
            mouse-cursor: MouseCursor.move;
            drag-started(y) => { root.drag-started(y); }
            drag-moved(y) => { root.drag-moved(y); }
            drag-ended => { root.drag-ended(); }
        }

        HorizontalLayout {
            spacing: 6px;
            padding-left: 2px;
            padding-right: 8px;

            // The handle to drag the row (the row's free space drags too).
            VerticalLayout {
                alignment: center;

                AppIcon {
                    icon: IconId.drag-grip;
                    size: IconSize.sm;
                    color: Theme.status-deleted;
                }
            }

            NumberField {
                width: 150px;
                horizontal-stretch: 0;
                text: root.folder.label;
                placeholder: "Label";
                tooltip: "The name the export card shows";
                alignment: left;
                committed(text) => { return SettingsUi.rename-folder(root.index, text); }
            }

            NumberField {
                horizontal-stretch: 1;
                max-width: 100000px;
                text: root.folder.path;
                placeholder: "/home/you/Videos";
                tooltip: root.folder.missing ? "The folder does not exist yet: it is made when a job writes into it"
                    : "The folder's path (a folder that does not exist yet is made when a job writes into it)";
                mark: root.folder.missing ? IconId.status-warning : IconId.none;
                alignment: left;
                bubble: "settings:folder." + root.index + ".path";
                committed(text) => { return SettingsUi.set-folder-path(root.index, text); }
                typed(text) => { SettingsUi.folder-path-typed(root.index, text); }
                canceled => { SettingsUi.folder-path-canceled(root.index); }
            }

            IconButton {
                icon: IconId.browse;
                tooltip: "Choose the folder";
                clicked => { SettingsUi.pick-folder-path(root.index); }
            }


            UpDownButton {
                up-tooltip: "Move up (or drag the row)";
                down-tooltip: "Move down (or drag the row)";
                up-enabled: root.index > 0;
                down-enabled: root.index < SettingsUi.folders.length - 1;
                up => { SettingsUi.move-folder(root.index, -1); }
                down => { SettingsUi.move-folder(root.index, 1); }
            }

            IconButton {
                icon: IconId.folder-remove;
                hold: true;
                tooltip: "Remove the folder from the list (the folder itself stays)";
                clicked => { SettingsUi.remove-folder(root.index); }
            }
        }
    }
}

component FoldersCard inherits SettingsCard {
    title: "Target folders";
    description: "The folders the export card offers after \"Next to the source\", in this order (drag a row to move it). The label is what the card shows.";

    if SettingsUi.folders.length > 0: list-area := Rectangle {
        height: list.preferred-height;

        // The page scrolled under the pointer: the pointer is measured again (`DragState.scrolls`).
        property <int> scrolls: DragState.scrolls;
        changed scrolls => {
            if SettingsUi.folder-dragging {
                SettingsUi.folder-drag-move(DragState.pointer-y - list.absolute-position.y);
            }
        }

        list := VerticalLayout {
            width: parent.width;
            height: parent.height;
            alignment: start;
            spacing: 4px;

            for folder[index] in SettingsUi.folders: FolderRow {
                folder: folder;
                index: index;
                drag-shift: index < SettingsUi.folder-drag-shifts.length ? SettingsUi.folder-drag-shifts[index] : 0px;
                lifted: SettingsUi.folder-dragging && index == SettingsUi.folder-drag-row;
                drag-started(y) => {
                    DragState.pointer-y = y;
                    SettingsUi.folder-drag-start(index, y - list.absolute-position.y, SettingsUi.folder-row-height + 4px,
                        SettingsUi.folder-row-height);
                }
                drag-moved(y) => {
                    DragState.pointer-y = y;
                    SettingsUi.folder-drag-move(y - list.absolute-position.y);
                }
                drag-ended => { SettingsUi.folder-drag-end(); }
            }
        }

        if SettingsUi.folder-dragging: DropGap {
            y: SettingsUi.folder-drag-gap-y;
            width: parent.width;
            height: Math.max(0px, SettingsUi.folder-drag-gap-height - 4px);
        }

        if SettingsUi.folder-dragging: DragGhost {
            y: SettingsUi.folder-drag-ghost-y;
            width: parent.width;
            height: SettingsUi.folder-row-height;
            title: SettingsUi.folder-drag-title;
        }
    }

    if SettingsUi.folders.length == 0: Text {
        text: "No named folders yet: jobs go next to their source.";
        color: Theme.text-muted;
        font-size: 11px;
    }

    HorizontalLayout {
        alignment: start;
        padding-left: 8px;

        IconButton {
            icon: IconId.folder-add;
            tooltip: "Add a folder";
            clicked => { SettingsUi.add-folder(); }
        }
    }
}

/// The card with its jump mark (the flash lies over the whole card).
export component SettingsFolders inherits Rectangle {
    VerticalLayout {
        FoldersCard { }
    }

    JumpFlash {
        key: "settings:export.folders";
    }
}
