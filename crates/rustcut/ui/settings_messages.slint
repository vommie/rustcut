// The Messages page (M6.5b, user decisions Q-N8/Q-N10): three tabs. "Look & behavior" shows the generic cards of the
// page (toasts, banners, history, desktop); "Message kinds" lists every kind with where it appears (only the places it
// allows; a critical kind is locked), whether it also goes to the desktop, a test that shows the real message at its
// real place (the row says where for a few seconds), and "Don't show again" for hints and confirmations; "Muted" lists
// what is muted with the way back. The search filters the two lists. Data and callbacks: `SettingsUi`.

import { TabStrip } from "tabs.slint";
import { Theme } from "styles.slint";
import { AppIcon, IconId, IconSize } from "icons.slint";
import { ChoiceButton, IconButton, Switch } from "controls.slint";
import { TooltipHost } from "tooltip.slint";
import { SettingsCard } from "settings_card.slint";
import { SettingsRow } from "settings_row.slint";
import { SettingsSearch } from "settings_search.slint";
import { MessageKindView, SettingsUi } from "settings_types.slint";
import { BubbleAnchor } from "bubble.slint";

// The level's color dot.
component LevelDot inherits Rectangle {
    in property <int> level;

    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: root.level == 3 ? Theme.status-corrupt : root.level == 2 ? Theme.accent
        : root.level == 1 ? Theme.status-ok : Theme.primary;
}

component KindRow inherits VerticalLayout {
    in property <MessageKindView> kind;
    // The Muted tab: only the way back.
    in property <bool> muted-list;

    spacing: 2px;

    if root.kind.header != "": Text {
        text: root.kind.header;
        color: Theme.text-muted;
        font-size: 10px;
        font-weight: 700;
    }

    Rectangle {
        min-height: 40px;
        border-radius: 5px;
        background: root.kind.tested != "" ? Theme.status-ok.with-alpha(0.10)
            : hover.has-hover ? Theme.surface-hover : Theme.surface-variant;
        animate background { duration: 250ms; }

        hover := TouchArea { }

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 6px;
            padding-top: 4px;
            padding-bottom: 4px;
            spacing: 8px;

            VerticalLayout {
                alignment: center;

                LevelDot {
                    level: root.kind.level;
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 1px;

                Text {
                    text: root.kind.title;
                    color: Theme.text;
                    font-size: 12px;
                    font-weight: 600;
                    overflow: elide;
                    min-width: 0px;
                }

                HorizontalLayout {
                    spacing: 4px;

                    if root.kind.tested != "": VerticalLayout {
                        alignment: center;

                        AppIcon {
                            icon: IconId.status-ok;
                            size: IconSize.xs;
                            color: Theme.status-ok;
                        }
                    }

                    Text {
                        horizontal-stretch: 1;
                        text: root.kind.tested != "" ? root.kind.tested : root.kind.sample;
                        color: root.kind.tested != "" ? Theme.status-ok : Theme.text-muted;
                        font-size: 11px;
                        overflow: elide;
                        min-width: 0px;
                    }
                }
            }

            if !root.muted-list && !root.kind.locked: VerticalLayout {
                alignment: center;

                // As wide as the locked place beside it, so the column lines up.
                place-choice := ChoiceButton {
                    width: 110px;
                    horizontal-stretch: 0;
                    items: root.kind.places;
                    current: root.kind.place-index;
                    tooltip: "Where this message appears";
                    selected(index) => { SettingsUi.kind-place(root.kind.id, index); }
                }
            }

            if !root.muted-list && root.kind.locked: Rectangle {
                width: 110px;
                horizontal-stretch: 0;

                lock-tip := TooltipHost {
                    text: "A critical message: it always appears here and cannot be muted";
                }

                lock-hover := TouchArea {
                    changed has-hover => {
                        if self.has-hover {
                            lock-tip.enter();
                        } else {
                            lock-tip.leave();
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 5px;
                    alignment: start;

                    VerticalLayout {
                        alignment: center;

                        AppIcon {
                            icon: IconId.tag-locked;
                            size: IconSize.sm;
                            color: Theme.status-deleted;
                        }
                    }

                    Text {
                        text: root.kind.places[root.kind.place-index];
                        color: Theme.text-muted;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }
            }

            if !root.muted-list: HorizontalLayout {
                spacing: 5px;
                horizontal-stretch: 0;

                // Kept in place (hidden) for a bubble kind, so the rows stay aligned.
                Text {
                    visible: root.kind.desktop-allowed;
                    text: "Desktop";
                    color: Theme.text-muted;
                    font-size: 11px;
                    vertical-alignment: center;
                }

                VerticalLayout {
                    alignment: center;

                    Switch {
                        visible: root.kind.desktop-allowed;
                        checked: root.kind.desktop;
                        enabled: !root.kind.locked && root.kind.desktop-allowed;
                        tooltip: root.kind.desktop ? "Also a desktop notification (while RustCut is not in front)"
                            : "No desktop notification";
                        toggled => { SettingsUi.kind-desktop(root.kind.id); }
                    }
                }
            }

            if !root.muted-list: VerticalLayout {
                alignment: center;

                test-button := IconButton {
                    icon: IconId.play;
                    checked: root.kind.tested != "";
                    tooltip: "Test: show this message where it appears now";
                    clicked => { SettingsUi.kind-test(root.kind.id); }

                    // A bubble's test shows at this button (its input may not be on screen).
                    BubbleAnchor {
                        key: "test:" + root.kind.id;
                    }
                }
            }

            if !root.muted-list && root.kind.mutable: VerticalLayout {
                alignment: center;

                mute-button := IconButton {
                    icon: IconId.notice-mute;
                    checked: root.kind.muted;
                    tooltip: root.kind.muted ? "Muted: click to show it again" : "Don't show this kind again";
                    clicked => { SettingsUi.kind-mute(root.kind.id); }
                }
            }

            if !root.muted-list && !root.kind.mutable: Rectangle {
                width: 26px;
            }

            if root.muted-list: VerticalLayout {
                alignment: center;

                IconButton {
                    text: "Show again";
                    tooltip: "It appears at its place again";
                    clicked => { SettingsUi.kind-mute(root.kind.id); }
                }
            }
        }
    }
}

export component SettingsMessages inherits VerticalLayout {
    // The page's tabs (P9.15, Q-P9.15 scope A: the panels' browser-like tabs, counts as badges) over their own surface:
    // the selected tab merges into it like the main window's tab groups (Q-P9n "msgtabs" B).
    TabStrip {
        tabs: [
            { title: "Look & behavior", icon: IconId.tab-look, count: "", enabled: true },
            { title: "Message kinds", icon: IconId.tab-kinds, count: SettingsUi.kinds-count, enabled: true },
            { title: "Muted", icon: IconId.tab-muted, count: SettingsUi.muted-count, enabled: true },
        ];
        current: SettingsUi.messages-tab;
        bar: transparent;
        panel: Theme.surface-variant;
        picked(index) => { SettingsUi.messages-tab-selected(index); }
    }

    Rectangle {
        background: Theme.surface-variant;
        border-bottom-left-radius: 6px;
        border-bottom-right-radius: 6px;

        VerticalLayout {
            padding: 12px;

            if SettingsUi.messages-tab == 0: VerticalLayout {
                spacing: 16px;

                for card in SettingsUi.cards: SettingsCard {
                    title: card.title;
                    description: card.description;

                    for option in card.rows: SettingsRow {
                        option: option;
                    }
                }
            }

            if SettingsUi.messages-tab == 1: SettingsCard {
                title: "Where each message appears";
                description: "Choose a place per kind of message; \"Desktop\" adds a desktop notification. The test button shows the real message where it appears now (you can move this window aside). Critical messages (lock) always appear.";

                SettingsSearch {
                    initial: SettingsUi.messages-search;
                    placeholder: "Search messages";
                    edited(text) => { SettingsUi.messages-search-edited(text); }
                }

                for kind in SettingsUi.kinds: KindRow {
                    kind: kind;
                }

                if SettingsUi.kinds.length == 0: Text {
                    text: "No kind of message matches the search.";
                    color: Theme.text-muted;
                    font-size: 12px;
                }
            }

            if SettingsUi.messages-tab == 2: SettingsCard {
                title: "Muted";
                description: "Hints and confirmations you chose not to see again (\"Don't show again\" on a toast or above). The bell's history still lists them.";

                SettingsSearch {
                    initial: SettingsUi.messages-search;
                    placeholder: "Search muted messages";
                    edited(text) => { SettingsUi.messages-search-edited(text); }
                }

                for kind in SettingsUi.muted: KindRow {
                    kind: kind;
                    muted-list: true;
                }

                if SettingsUi.muted.length == 0: Text {
                    text: SettingsUi.muted-count == 0 ? "Nothing is muted." : "No muted message matches the search.";
                    color: Theme.text-muted;
                    font-size: 12px;
                }
            }
        }
    }
}
