// The known-source banner above the video: RustView knows the open file's MD5, so it was cut before. Non-modal (PyCutRv
// showed a message box), dismissable, and the only place this warning appears. Set from src/ui/media_info/known_source.rs;
// the RustView lookup that fills it arrives with the RustView client (M3.1).

import { Theme } from "styles.slint";
import { AppIcon, IconId, IconSize } from "icons.slint";

export global KnownSource {
    in property <bool> shown;
    in property <string> title;
    in property <string> detail;
    // Library files made from this source (at most a few; `detail` says how many there are).
    in property <[string]> files;

    callback dismiss();
}

export component KnownSourceBanner inherits Rectangle {
    background: Theme.accent.with-alpha(0.12);
    height: KnownSource.shown ? content.preferred-height : 0;
    clip: true;

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.accent.with-alpha(0.35);
    }

    content := HorizontalLayout {
        padding: 8px;
        padding-left: 12px;
        spacing: 10px;

        VerticalLayout {
            alignment: start;
            AppIcon {
                icon: IconId.status-warning;
                size: IconSize.md;
                color: Theme.accent;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;

            Text {
                text: KnownSource.title;
                color: Theme.text;
                font-weight: 600;
                wrap: word-wrap;
            }

            if KnownSource.detail != "": Text {
                text: KnownSource.detail;
                color: Theme.text-muted;
                wrap: word-wrap;
            }

            for file in KnownSource.files: Text {
                text: file;
                color: Theme.text-muted;
                font-size: 11px;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: start;

            dismiss := Rectangle {
                width: 22px;
                height: 22px;
                border-radius: 4px;
                background: dismiss-touch.pressed ? Theme.surface-selected
                    : dismiss-touch.has-hover ? Theme.surface-hover : transparent;

                dismiss-touch := TouchArea {
                    clicked => { KnownSource.dismiss(); }
                }

                AppIcon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    icon: IconId.close;
                    size: IconSize.sm;
                    color: Theme.text-muted;
                }
            }
        }
    }
}
