// A one-line text input that follows its cursor (user report 2026-11-02: in the target's name field, typing past the
// end, the arrow keys and End left the text standing at its start). Slint's `TextInput` never scrolls by itself; this
// is the scrolling of Slint's std `LineEdit` (`widgets/common/lineedit-base.slint`) without its look: the input is as
// wide as its text and moves inside a clipped area so the cursor always stays in view. Every text field of RustCut uses
// it instead of a bare `TextInput`; a new one does too.

export component TextLine {
    in-out property <string> text <=> input.text;
    in property <brush> color <=> input.color;
    in property <length> font-size <=> input.font-size;
    in property <string> font-family <=> input.font-family;
    in property <int> font-weight <=> input.font-weight;
    in property <bool> enabled <=> input.enabled;
    in property <TextHorizontalAlignment> horizontal-alignment <=> input.horizontal-alignment;
    in property <InputType> input-type <=> input.input-type;
    in property <color> selection-background-color <=> input.selection-background-color;
    in property <color> selection-foreground-color <=> input.selection-foreground-color;
    out property <bool> has-focus: input.has-focus;
    // Kept free between the cursor and the edges while it moves.
    in property <length> margin: 2px;

    callback edited();
    callback accepted();
    callback key-pressed(KeyEvent) -> EventResult;

    // A clipped `TextInput` of no width cannot take the focus.
    min-width: 1px;
    forward-focus: input;

    public function select-all() {
        input.select-all();
    }

    public function set-selection-offsets(start: int, end: int) {
        input.set-selection-offsets(start, end);
    }

    // `Rectangle` would bring a `color` of its own: the clip is a child.
    Rectangle {
        width: 100%;
        height: 100%;
        clip: true;

        input := TextInput {
            property <length> computed-x;

            x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.computed-x));
            width: max(parent.width - self.text-cursor-width, self.preferred-width);
            height: 100%;
            single-line: true;
            vertical-alignment: center;

            cursor-position-changed(position) => {
                if position.x + self.computed-x < root.margin {
                    self.computed-x = root.margin - position.x;
                } else if position.x + self.computed-x > parent.width - root.margin - self.text-cursor-width {
                    self.computed-x = parent.width - position.x - root.margin - self.text-cursor-width;
                }
            }
            edited => { root.edited(); }
            accepted => { root.accepted(); }
            key-pressed(event) => { return root.key-pressed(event); }
        }
    }
}
