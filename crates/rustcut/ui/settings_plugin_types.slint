// The data of Settings > Plugins and of each plugin's page (P12 block 8; src/ui/settings/plugins/ fills `PluginsUi`).
// A plugin page's simple fields are ordinary `SettingRowView`s (keys `plugin:<id>:<key>`, the same callbacks as every
// option); tables have their own view and callbacks.

import { SettingRowView } from "settings_types.slint";

export struct PluginDetailView {
    label: string,
    value: string,
}

export struct PluginItemView {
    id: string,
    name: string,
    version: string,
    description: string,
    icon: image,
    // The state's text and kind: 0 runs, 1 off, 2 warning (paused, shadowed), 3 error (broken, incompatible).
    state: string,
    state-kind: int,
    enabled: bool,
    can-toggle: bool,
    development: bool,
    // "1.1.0 available" ("" = none).
    update: string,
    expanded: bool,
    details: [PluginDetailView],
    can-remove: bool,
    can-move-up: bool,
    can-move-down: bool,
}

export struct PluginAvailableView {
    name: string,
    version: string,
    description: string,
}

// One cell of a table row. kind: 0 text, 1 folder path, 2 switch, 3 choice, 4 target folder, 5 tag, 6 rating.
export struct PluginCellView {
    kind: int,
    text: string,
    checked: bool,
    items: [string],
    index: int,
    enabled: bool,
    placeholder: string,
    // The rating (-1 = none).
    stars: int,
    // A problem of this value (a tag or folder that no longer exists), its tooltip.
    issue: string,
}

export struct PluginTableRowView {
    cells: [PluginCellView],
    // What the plugin or RustCut found about the row (the warning mark's tooltip; "" = nothing). level 1 warning, 2 error.
    issue: string,
    issue-level: int,
}

export struct PluginColumnView {
    label: string,
    help: string,
    kind: int,
}

// A part of a card: one option row, or a table.
export struct PluginBlockView {
    table: bool,
    row: SettingRowView,
    key: string,
    label: string,
    help: string,
    columns: [PluginColumnView],
    rows: [PluginTableRowView],
    add-label: string,
    empty: string,
    // A finding about the whole table.
    issue: string,
}

export struct PluginCardView {
    title: string,
    description: string,
    blocks: [PluginBlockView],
}

export global PluginsUi {
    // Settings > Plugins.
    in property <[PluginItemView]> plugins;
    in property <[string]> dev-folders;
    in property <[PluginAvailableView]> available;
    in property <bool> checking;
    in property <bool> installing;
    // A plugin file is dragged over the window.
    in property <bool> drop-hover;
    callback toggle(/* id */ string);
    callback expand(/* id */ string);
    callback move(/* id */ string, /* -1 up, 1 down */ int);
    callback install();
    callback add-dev();
    callback remove-dev(int);
    callback check-updates();
    callback install-available(int);
    callback update(/* id */ string);
    // "" = every plugin.
    callback reload(/* id */ string);
    callback open-folder(/* id; "" = the plugins' folder */ string);
    callback remove(/* id */ string);
    callback export-settings(/* id */ string);
    callback import-settings(/* id */ string);
    callback open-page(/* id */ string);

    // One plugin's page: its cards (the first is RustCut's "Plugin" card).
    in property <PluginItemView> current;
    in property <[PluginCardView]> cards;
    callback cell-text(/* table key */ string, /* row */ int, /* column */ int, string) -> bool;
    callback cell-toggle(string, int, int);
    callback cell-choose(string, int, int, /* index */ int);
    callback cell-pick(string, int, int);
    callback cell-rate(string, int, int, /* stars */ int);
    callback row-add(/* table key */ string);
    callback row-remove(string, int);
    callback row-move(string, int, /* -1 up, 1 down */ int);
}
