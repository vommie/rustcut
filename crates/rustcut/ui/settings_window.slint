// The Settings window (M4.2), styled like RustView's (crates/rustview/ui/settings_window.slint): the categories on the
// left, the page's cards on the right. Every change is saved at once (src/ui/settings/), so there is no Save button;
// buttons that put options back to their defaults are held (user decision Q-Q4).

import { Theme } from "styles.slint";
import { IconId } from "icons.slint";
import { IconButton } from "controls.slint";
import { TooltipLayer } from "tooltip_layer.slint";
import { SettingsSidebar } from "settings_sidebar.slint";
import { SettingsScroll } from "settings_scroll.slint";
import { SettingsCard } from "settings_card.slint";
import { SettingsRow } from "settings_row.slint";
import { SettingsUi } from "settings_types.slint";
import { Jump } from "jump.slint";
import { DragLogic, DragState } from "drag.slint";
import { BubbleLayer } from "bubble.slint";
import { SettingsFolderTree } from "settings_folder_tree.slint";
import { SettingsCropRatios } from "settings_ratios.slint";
import { SettingsDiagnostics } from "settings_diagnostics.slint";
import { SettingsProfiles } from "settings_profiles.slint";
import { SettingsHotkeys } from "settings_hotkeys.slint";
import { SettingsAbout } from "settings_about.slint";
import { SettingsMessages } from "settings_messages.slint";

export component SettingsWindow inherits Window {
    title: "RustCut - Settings";
    icon: @image-url("../assets/app/window-icon.png");
    preferred-width: 900px;
    preferred-height: 660px;
    min-width: 600px;
    min-height: 400px;
    background: Theme.background;
    default-font-size: Theme.font-size;

    forward-focus: dialog-focus;

    dialog-focus := FocusScope {
        key-pressed(event) => {
            // A drag of list rows runs: Escape cancels it (P9.4).
            if event.text == Key.Escape && DragState.active {
                DragState.cancel();
                return accept;
            }
            if event.text == Key.Escape && SettingsUi.recording == "" {
                SettingsUi.close();
                return accept;
            }
            return reject;
        }

        HorizontalLayout {
            SettingsSidebar {
                categories: SettingsUi.pages;
                active-category: SettingsUi.page;
                category-selected(index) => {
                    dialog-focus.focus();
                    SettingsUi.select-page(index);
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;

                Rectangle {
                    height: 48px;
                    background: Theme.surface;

                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.border;
                    }

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 12px;
                        spacing: 8px;

                        Text {
                            horizontal-stretch: 1;
                            text: SettingsUi.page-title;
                            color: Theme.text;
                            font-size: 16px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }

                        if SettingsUi.resettable: VerticalLayout {
                            alignment: center;

                            IconButton {
                                icon: IconId.settings-reset;
                                hold: true;
                                tooltip: "Put every option of this page back to its default";
                                clicked => { SettingsUi.reset-page(); }
                            }
                        }
                    }
                }

                if SettingsUi.read-only-note != "": Rectangle {
                    background: Theme.accent.with-alpha(0.15);

                    HorizontalLayout {
                        padding: 8px;
                        padding-left: 16px;

                        Text {
                            text: SettingsUi.read-only-note;
                            color: Theme.accent;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }

                // The page, with the bubbles of its fields over it (M6.5c; not scrolled with it).
                Rectangle {
                    vertical-stretch: 1;

                    // A list of the page is dragged (the target folders, P9.7): near the top and bottom edge the page
                    // scrolls along, faster toward the edge, and counts the scroll so the list measures again.
                    Timer {
                        interval: 16ms;
                        running: DragState.active && DragState.area == "settings";
                        triggered => {
                            let step = DragLogic.scroll-step(DragState.pointer-y - scroll.absolute-position.y, scroll.visible-height);
                            let to = Math.max(Math.min(0px, scroll.visible-height - scroll.content-height),
                                Math.min(0px, scroll.viewport-y - step));
                            if to != scroll.viewport-y {
                                scroll.viewport-y = to;
                                DragState.scrolls += 1;
                            }
                        }
                    }

                    // Every page keeps its own scroll position while RustCut runs (user review 2026-10-27): a page
                    // shown for the first time starts at its top.
                    scroll := SettingsScroll {
                        width: parent.width;
                        height: parent.height;
                        content-height: page.preferred-height;
                        interactive: !DragState.active && !DragState.holding;

                        property <int> page-now: SettingsUi.page;
                        // The page whose position `viewport-y` is (set before the position of a new page).
                        property <int> shown-page: -1;
                        init => {
                            self.shown-page = self.page-now;
                            self.viewport-y = SettingsUi.page-scroll[self.page-now];
                        }
                        changed page-now => {
                            self.shown-page = self.page-now;
                            self.viewport-y = SettingsUi.page-scroll[self.page-now];
                        }
                        changed viewport-y => {
                            if self.shown-page == self.page-now {
                                SettingsUi.page-scroll[self.shown-page] = self.viewport-y;
                            }
                        }

                        // A jump mark reached a row of this page: it scrolls into view (`jump.slint`).
                        property <int> jump: Jump.target-serial;
                        changed jump => {
                            if Jump.inside(self.absolute-position.x, self.width, self.absolute-position.y + self.viewport-y, self.content-height) {
                                self.viewport-y = Jump.scroll-to(self.absolute-position.y + self.viewport-y, self.viewport-y, self.visible-height, self.content-height);
                            }
                        }

                        page := VerticalLayout {
                            width: scroll.content-width;
                            padding: 16px;
                            spacing: 16px;
                            alignment: start;

                            // The Target Folders page shows its tree above its cards (the Folder Wheel's options).
                            if SettingsUi.special == 1: SettingsFolderTree { }

                            // The Messages page shows its cards on its first tab.
                            if SettingsUi.special != 5: VerticalLayout {
                                spacing: 16px;

                                for card in SettingsUi.cards: SettingsCard {
                                    title: card.title;
                                    description: card.description;

                                    for option in card.rows: SettingsRow {
                                        option: option;
                                    }
                                }
                            }

                            if SettingsUi.special == 2: SettingsProfiles { }

                            if SettingsUi.special == 3: SettingsHotkeys { }

                            if SettingsUi.special == 4: SettingsAbout { }

                            if SettingsUi.special == 5: SettingsMessages { }

                            if SettingsUi.special == 6: SettingsCropRatios { }

                            if SettingsUi.special == 7: SettingsDiagnostics { }
                        }
                    }

                    BubbleLayer {
                        x: 0;
                        y: 0;
                        width: scroll.content-width;
                        height: parent.height;
                        area: "settings";
                    }
                }

                Rectangle {
                    height: 40px;
                    background: Theme.surface;

                    Rectangle {
                        y: 0;
                        height: 1px;
                        background: Theme.border;
                    }

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 12px;
                        spacing: 8px;

                        Text {
                            horizontal-stretch: 1;
                            text: "Changes are saved at once.";
                            color: Theme.text-muted;
                            font-size: 11px;
                            vertical-alignment: center;
                        }

                        VerticalLayout {
                            alignment: center;

                            IconButton {
                                height: 30px;
                                width: 84px;
                                text: "Close";
                                tooltip: "Close the settings";
                                shortcut: "Esc";
                                clicked => { SettingsUi.close(); }
                            }
                        }
                    }
                }
            }
        }
    }

    // The color picker is open (D-P9h, review 69): the window is dimmed and takes no input; a click or a key brings
    // the picker forward.
    if SettingsUi.picker-open: Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: #000000a0;

        TouchArea {
            clicked => { SettingsUi.raise-picker(); }
        }

        FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                SettingsUi.raise-picker();
                accept
            }
        }
    }

    TooltipLayer {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
    }
}
