// Started as a copy of RustView's crates/rustview/ui/rating_bar.slint. RustCut's own since 0.0.72 (no parity check any more, user decision 2026-10-27): change it here freely.
// The outlined 20 px look (user review 2026-10-27) goes to RustView at the user's "finalisiere".

import { Theme } from "styles.slint";

export component RatingButton inherits Rectangle {
    in property <int> rating: 0;
    in property <bool> is-selected: false;
    in property <bool> is-partial: false;
    in property <bool> is-enabled: true;
    // An owner whose own touch area lies over the button passes its pointer state (the last saved job's rating).
    in property <bool> outer-hover;
    in property <bool> outer-pressed;
    // Only shows a rating (the saved job's toast): it looks chosen and takes no pointer.
    in property <bool> display-only;
    callback clicked();

    // Dark with the rating's color as its border; hovered or chosen it is filled with the color and the digit turns
    // dark (RustCut 0.0.72, user review 2026-10-27). The chosen one has no border of its own (it was white): all of it
    // is its color, a little lighter under the pointer (0.0.74). A partial rating is filled faintly.
    // A press darkens the fill a little (click feedback, 0.0.75).
    property <bool> hovered: (touch.has-hover || root.outer-hover) && root.is-enabled;
    property <bool> pressed: (touch.pressed || root.outer-pressed) && root.is-enabled;
    property <bool> filled: root.is-selected || root.hovered;
    property <color> tint: Theme.rating-color(root.rating);
    property <color> fill: root.pressed ? root.tint.darker(0.2)
        : root.is-selected && root.hovered ? root.tint.brighter(0.15) : root.tint;

    border-width: 1px;
    border-color: root.filled ? root.fill : root.tint;
    background: root.filled ? root.fill : root.is-partial ? root.tint.with-alpha(0.35) : Theme.background;
    border-radius: 3px;
    opacity: root.is-enabled ? 1.0 : 0.38;

    touch := TouchArea {
        enabled: root.is-enabled && !root.display-only;
        mouse-cursor: root.is-enabled ? pointer : default;
        clicked => { root.clicked(); }
    }

    // The whole box, so the digit is centered in it exactly (block 10: it stood a pixel off in the 18 px job card box).
    Text {
        width: parent.width;
        height: parent.height;
        text: root.rating;
        color: root.filled ? #000000 : Theme.text;
        font-weight: 700;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component RatingBar inherits HorizontalLayout {
    spacing: 4px;
    height: 20px;

    in-out property <int> selected-rating: 0;
    in property <bool> is-assign-mode: false;
    in property <bool> has-selection: true;
    in property <[bool]> partial-ratings: [false, false, false, false, false, false];
    callback rating-selected(int);

    for rate[idx] in [0, 1, 2, 3, 4, 5]: RatingButton {
        rating: rate;
        is-enabled: !root.is-assign-mode || root.has-selection;
        is-selected: root.selected-rating == rate;
        is-partial: root.is-assign-mode && root.partial-ratings[idx];
        clicked => {
            root.selected-rating = rate;
            root.rating-selected(rate);
        }
    }
}
