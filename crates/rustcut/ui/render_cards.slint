// The cards of the Render Settings panel: the profile (quick selection, save, rename, delete, the issues of the working
// copy), the simple view (video, audio and container rows), the expert view (rows per codec) and the probe render.
// Rows come from Rust with their label, tooltip (what the option does and what it costs) and value; buttons are icons
// with tooltips (user rule 2026-10-23).

import { Theme } from "styles.slint";
import { AppIcon, IconId, IconSize } from "icons.slint";
import { ChoiceButton, IconButton, NumberField, Switch } from "controls.slint";
import { TooltipArea } from "tooltip.slint";
import { OptionRow } from "render_option_row.slint";
import { PlayerSeekBar } from "player_seek_bar.slint";
import { Shortcuts } from "shortcuts.slint";
import { OptionRowView, Probe, RenderSettings } from "render_types.slint";
import { Playback } from "player_types.slint";

/// A stack of option rows.
component OptionRows inherits VerticalLayout {
    in property <[OptionRowView]> rows;

    padding: 8px;
    padding-top: 0px;
    spacing: 4px;

    for item in root.rows: OptionRow {
        option: item;
        jump-prefix: "codecs:";
        bubble-prefix: "codecs:";
        choose(key, index) => { RenderSettings.choose(key, index); }
        slide(key, position) => { RenderSettings.slide(key, position); }
        toggle(key) => { RenderSettings.toggle(key); }
        type-text(key, text) => { return RenderSettings.type-text(key, text); }
        step(key, steps) => { RenderSettings.step(key, steps); }
        text-typed(key, text) => { RenderSettings.text-typed(key, text); }
        text-canceled(key) => { RenderSettings.text-canceled(key); }
    }
}

export component RenderVideoBody inherits OptionRows {
    rows: RenderSettings.video-rows;
}

export component RenderAudioBody inherits OptionRows {
    rows: RenderSettings.audio-rows;
}

export component RenderExpertBody inherits OptionRows {
    rows: RenderSettings.expert-rows;
}

/// A one-line name field: Enter keeps (when `accepted` agrees), Escape cancels.
component NameField inherits Rectangle {
    in-out property <string> text;
    callback accepted(string) -> bool;
    callback canceled();

    property <bool> invalid;

    height: 22px;
    horizontal-stretch: 1;
    border-radius: 3px;
    background: Theme.background;
    border-width: 1px;
    border-color: root.invalid ? Theme.status-corrupt : Theme.primary;

    public function start(initial: string) {
        input.text = initial;
        root.invalid = false;
        input.focus();
        input.select-all();
    }

    public function confirm() {
        if root.accepted(input.text) {
            Shortcuts.release-focus();
        } else {
            root.invalid = true;
        }
    }

    input := TextInput {
        x: 5px;
        width: parent.width - 10px;
        height: parent.height;
        single-line: true;
        color: Theme.text;
        font-size: 12px;
        vertical-alignment: center;
        selection-background-color: Theme.primary.with-alpha(0.4);

        accepted => { root.confirm(); }
        edited => { root.invalid = false; }

        key-pressed(event) => {
            if event.text == Key.Escape {
                root.canceled();
                Shortcuts.release-focus();
                return accept;
            }
            reject
        }

    }

    if input.text == "": Text {
        x: 5px;
        text: "Profile name";
        color: Theme.status-deleted;
        font-size: 12px;
        vertical-alignment: center;
        height: parent.height;
    }
}

/// The Profile card: quick selection, reset, save, save as, rename, delete; the issues of the working copy.
export component RenderProfileBody inherits VerticalLayout {
    // 0 no name field, 1 saving as a new profile, 2 renaming.
    property <int> naming;

    padding: 8px;
    padding-top: 0px;
    spacing: 4px;

    HorizontalLayout {
        spacing: 4px;

        // The profile takes the row's whole width up to its buttons (P9.10, review note 08#2).
        ChoiceButton {
            items: RenderSettings.profiles;
            current: RenderSettings.profile-index;
            tooltip: RenderSettings.profile-tooltip;
            stretch-fully: true;
            // The issues of options whose card is folded (M6.5c).
            bubble: "codecs:profile";
            selected(index) => {
                root.naming = 0;
                RenderSettings.select-profile(index);
            }
        }

        IconButton {
            icon: IconId.profile-reset;
            hold: true;
            enabled: RenderSettings.modified;
            tooltip: "Drop the changes: back to the saved profile";
            clicked => { RenderSettings.reset-profile(); }
        }

        if RenderSettings.user-profile: IconButton {
            icon: IconId.profile-save;
            enabled: RenderSettings.modified;
            tooltip: "Save the changes into this profile";
            clicked => { RenderSettings.save-profile(); }
        }

        IconButton {
            icon: IconId.profile-save-as;
            checked: root.naming == 1;
            tooltip: "Save these settings as a new profile";
            clicked => {
                root.naming = root.naming == 1 ? 0 : 1;
            }
        }

        if RenderSettings.user-profile: IconButton {
            icon: IconId.profile-rename;
            checked: root.naming == 2;
            tooltip: "Rename this profile";
            clicked => {
                root.naming = root.naming == 2 ? 0 : 2;
            }
        }

        if RenderSettings.user-profile: IconButton {
            icon: IconId.profile-delete;
            hold: true;
            tooltip: "Delete this profile (the settings stay as a modified copy until another profile is chosen)";
            clicked => {
                root.naming = 0;
                RenderSettings.delete-profile();
            }
        }
    }

    if root.naming != 0: HorizontalLayout {
        spacing: 4px;

        name := NameField {
            init => {
                self.start(root.naming == 2 ? RenderSettings.profile-name : "");
            }
            accepted(text) => {
                if (root.naming == 1 ? RenderSettings.save-profile-as(text) : RenderSettings.rename-profile(text)) {
                    root.naming = 0;
                    return true;
                }
                false
            }
            canceled => {
                root.naming = 0;
            }
        }

        IconButton {
            icon: IconId.confirm;
            tooltip: root.naming == 1 ? "Save as a new profile (Enter)" : "Rename (Enter)";
            clicked => { name.confirm(); }
        }

        IconButton {
            icon: IconId.close;
            tooltip: "Cancel (Escape)";
            clicked => {
                root.naming = 0;
                Shortcuts.release-focus();
            }
        }
    }

    if RenderSettings.check-text != "": HorizontalLayout {
        spacing: 6px;

        if !RenderSettings.check-running: AppIcon {
            icon: IconId.status-ok;
            size: IconSize.sm;
            color: Theme.status-ok;
        }

        Text {
            horizontal-stretch: 1;
            text: RenderSettings.check-text;
            color: Theme.text-muted;
            font-size: 11px;
            wrap: word-wrap;
        }
    }

    if RenderSettings.encoders-note != "": Text {
        text: RenderSettings.encoders-note;
        color: Theme.text-muted;
        font-size: 11px;
        wrap: word-wrap;
    }
}

/// The Probe render card: render around the playhead, cancel, play again, exact settings, length; progress and result.
export component RenderProbeBody inherits VerticalLayout {
    padding: 8px;
    padding-top: 0px;
    spacing: 4px;

    HorizontalLayout {
        spacing: 4px;

        // One button that turns into "stop" while the probe renders (swapping two buttons under the pointer would
        // leave the first one's tooltip behind).
        IconButton {
            icon: Probe.running ? IconId.probe-cancel : IconId.probe-render;
            enabled: Probe.running || Playback.has-video || Probe.playing;
            tooltip: Probe.running ? "Stop the probe render" : Probe.tip-render;
            shortcut: Probe.running ? "" : Probe.key-render;
            clicked => {
                if Probe.running {
                    Probe.cancel();
                } else {
                    Probe.render();
                }
            }
        }

        IconButton {
            icon: IconId.probe-play;
            enabled: Probe.ready && !Probe.running && !Probe.playing;
            tooltip: "Play the last probe render again";
            clicked => { Probe.play(); }
        }

        IconButton {
            icon: IconId.probe-exact;
            checked: Probe.exact;
            tooltip: Probe.tip-exact;
            clicked => { Probe.toggle-exact(); }
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        NumberField {
            width: 56px;
            horizontal-stretch: 0;
            text: Probe.seconds;
            unit: "s";
            tooltip: Probe.tip-seconds;
            committed(text) => { return Probe.seconds-typed(text); }
            stepped(steps) => { Probe.seconds-stepped(steps); }
        }
    }

    if Probe.running: Rectangle {
        height: 4px;
        border-radius: 2px;
        background: Theme.surface-hover;

        Rectangle {
            x: 0;
            width: parent.width * Math.clamp(Probe.progress, 0, 1);
            height: parent.height;
            border-radius: parent.border-radius;
            background: Theme.primary;
        }
    }

    if Probe.status != "": Text {
        text: Probe.status;
        color: Probe.failed ? Theme.status-corrupt : Theme.text-muted;
        font-size: 11px;
        wrap: word-wrap;
    }
}
