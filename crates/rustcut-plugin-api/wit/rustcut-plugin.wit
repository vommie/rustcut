// The contract between RustCut and its plugins. A plugin is a WebAssembly component of the world `plugin`.
//
// Versioning: the package version is the plugin API version. A minor version only adds host functions, imported
// interfaces or types no export uses; a plugin built against 1.0 runs on every 1.x RustCut. The types the exports pass
// (`event`, `context`, `action`, `issue` and every type inside them) are frozen within a major version: wasmtime checks
// an export's types exactly, so a new case, field or export keeps every older plugin from loading. Those changes need
// a new major version, and RustCut keeps loading the previous major for a while. An optional exported interface (like
// `commands` of the world `plugin-with-commands`, since 1.2) is no change to the world `plugin`: RustCut looks for it
// per plugin, and plugins without it load as before. docs/plugins.md in RustCut's repository explains everything.
package rustcut:plugin@1.2.0;

/// What RustCut offers a plugin to call.
interface host {
    /// How important a log line or a message is.
    enum level {
        debug,
        info,
        warning,
        error,
    }

    /// Writes a line into the plugin log (the Logs panel, source "Plugins", and RustCut's log file).
    log: func(level: level, message: string);

    /// Since 1.1. The folder of Settings > Target Folders that is the target of Job Finalization when the event
    /// happened, by its id (0 is "Next to the source"); none when the target is no folder of that list (a loaded
    /// job's own folder) or outside `handle`. Earlier actions of other plugins for the same event count.
    target-folder: func() -> option<u32>;

    /// Since 1.1. The `set-target` and `set-rating` actions this call of `handle` returns get no plugin mark: RustCut
    /// applies them and removes an earlier mark at the same place, but shows no plugin icon there. Outside `handle`
    /// it does nothing.
    hide-marks: func();
}

/// The values RustCut and a plugin exchange.
interface types {
    use host.{level};

    /// A tag of RustView's tag tree.
    record tag {
        /// RustView's id of the tag; stable while the tag exists.
        id: u32,
        name: string,
        /// The names from the root down to this tag, its own name last: ["Nature", "Waterfall"].
        path: list<string>,
    }

    /// What the editor holds when an event happens.
    record context {
        /// The open video's path, if a video is open.
        video: option<string>,
        /// The rating set in the Tag & Rate panel (0 to 5), if any.
        rating: option<u8>,
        /// The tags set in the Tag & Rate panel.
        tags: list<tag>,
        /// The target folder of Job Finalization as a path, if it is known.
        target: option<string>,
    }

    /// Who opened a video.
    enum opened-by {
        /// The user opened a new video (File > Open, a drop, the command line, a second start).
        user,
        /// A queued job was loaded into the editor.
        job,
    }

    /// Something that happened in RustCut.
    variant event {
        /// A video was opened; `context.video` is its path.
        video-opened(opened-by),
        /// The user assigned a tag in the Tag & Rate panel.
        tag-assigned(tag),
        /// The user removed a tag in the Tag & Rate panel.
        tag-removed(tag),
    }

    /// Where a message appears.
    enum place {
        /// Only the plugin log.
        none,
        /// A toast that goes away by itself.
        toast,
        /// A banner that stays until it is closed.
        banner,
    }

    /// A message to show; RustCut puts the plugin's name in front of the title.
    record notice {
        place: place,
        level: level,
        title: string,
        detail: string,
    }

    /// A target folder.
    variant target {
        /// A folder of Settings > Target Folders, by its id.
        folder(u32),
        /// Any folder on disk (shown as "Job target", like the folder of a loaded job).
        path(string),
    }

    /// Sets the target folder of Job Finalization.
    record set-target {
        target: target,
        /// Why, for the tooltip of the plugin mark at the folder field: "rule ~/Videos/Holiday".
        reason: string,
    }

    /// Sets the rating in the Tag & Rate panel.
    record set-rating {
        /// 0 to 5 stars.
        stars: u8,
        /// Why, for the tooltip of the plugin mark at the rating: "tag Nature › Waterfall".
        reason: string,
    }

    /// What RustCut should do after an event. Actions apply in order; the user's own change wins over a plugin's
    /// until the next video.
    variant action {
        set-target(set-target),
        set-rating(set-rating),
        notify(notice),
    }

    /// A finding about the plugin's settings, shown on the plugin's Settings page.
    record issue {
        /// The setting's key (`plugin.toml`, `[[cards.fields]] key`).
        field: string,
        /// For a table: the row, counted from 0.
        row: option<u32>,
        level: level,
        /// One explaining sentence; it is the tooltip of the issue's mark.
        message: string,
    }
}

/// Since 1.2. What RustCut offers a plugin while it runs one of its commands (`plugin.toml`, `[[commands]]`). Outside
/// `run` the functions answer with an error or do nothing.
interface command-host {
    /// When a file manager's order counts.
    enum file-manager-mode {
        /// Never: names A to Z.
        off,
        /// Only while the folder is open in a tab of a Dolphin window.
        open-tab,
        /// While any Dolphin window exists (Dolphin's stored order for the folder).
        running,
        /// Always, read from Dolphin's stored view properties; Dolphin is never started.
        always,
    }

    /// Which hidden files (a name starting with a dot) count.
    enum hidden-files {
        skip,
        show,
        /// Like Dolphin's "Show hidden files" for that folder.
        like-file-manager,
    }

    /// What to list.
    record folder-request {
        file-manager: file-manager-mode,
        hidden: hidden-files,
        /// Only the formats RustCut opens; the open video always counts.
        videos-only: bool,
    }

    /// One file of the folder.
    record folder-file {
        path: string,
        name: string,
        /// A job of RustCut's queue (any state) has this file as its source.
        has-job: bool,
    }

    /// Where the order came from.
    enum order-source {
        /// The file manager's order.
        file-manager,
        /// Names A to Z: the file manager's order is switched off.
        names-off,
        /// Names A to Z: no Dolphin window exists.
        names-not-running,
        /// Names A to Z: no Dolphin tab shows the folder.
        names-not-open,
        /// Names A to Z: Dolphin sorts by something RustCut cannot rebuild (`role` names it).
        names-unsupported,
        /// Names A to Z: Dolphin could not be asked (`detail` says why).
        names-failed,
    }

    /// The order that was used.
    record folder-order {
        source: order-source,
        /// Dolphin's role id: `text`, `size`, `modificationtime`, `creationtime`, `accesstime`, `type`, or the
        /// unsupported one.
        role: string,
        descending: bool,
        detail: string,
    }

    /// The open video's folder.
    record folder-listing {
        files: list<folder-file>,
        /// The open video's place in `files`.
        current: option<u32>,
        order: folder-order,
    }

    /// The files of the open video's folder, in the order asked for. Errors: no video is open, the folder cannot be
    /// read, or the call is outside `run`.
    list-folder: func(request: folder-request) -> result<folder-listing, string>;

    /// Opens a video in RustCut after `run` returned (the last call wins). RustCut opens it like a dropped file.
    open-video: func(path: string);

    /// Shows a short bubble at the menu bar button that ran the command, or as a toast when there is no such button
    /// (key, menu); after `run` returned, with the plugin's name in front.
    bubble: func(text: string);
}

/// Since 1.2. The commands a plugin declares in `plugin.toml` (`[[commands]]`): RustCut runs them by their key, their
/// File menu entry or their menu bar button.
interface commands {
    use types.{context, action};

    /// Runs the command `command` (its `id` in `plugin.toml`); returns what RustCut should do, like `handle`.
    run: func(command: string, context: context) -> result<list<action>, string>;
}

/// A RustCut plugin.
world plugin {
    import host;
    use types.{context, event, action, issue};

    /// Called after the plugin is loaded and whenever its settings change. `settings` is a JSON object with one
    /// member per field declared in `plugin.toml`. An error keeps the plugin from handling events until the next
    /// successful call.
    export configure: func(settings: string) -> result<_, string>;

    /// Called for every event; returns what RustCut should do.
    export handle: func(event: event, context: context) -> result<list<action>, string>;

    /// Checks settings that the user is editing, without applying them (`settings` as in `configure`).
    export check: func(settings: string) -> list<issue>;
}

/// Since 1.2. A plugin with commands: everything of `plugin`, plus `commands` and the functions it may call while one
/// runs.
world plugin-with-commands {
    include plugin;
    import command-host;
    export commands;
}
