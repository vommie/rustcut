---
source: crates/rustcut-core/src/render/args.rs
expression: "lines.join(\"\\n\")"
---
av1-balanced: -c:v libsvtav1 -preset 6 -crf 26 -pix_fmt yuv420p10le -svtav1-params tune=0:film-grain=8:enable-variance-boost=1:variance-boost-strength=2 -c:a libopus -b:a 128k -ar 48000 -f matroska
av1-archive: -c:v libsvtav1 -preset 4 -crf 24 -pix_fmt yuv420p10le -svtav1-params tune=0:film-grain=8:enable-variance-boost=1:variance-boost-strength=2 -c:a libopus -b:a 160k -ar 48000 -f matroska
x265-quality: -c:v libx265 -preset slow -crf 20 -pix_fmt yuv420p10le -profile:v main10 -c:a libopus -b:a 128k -ar 48000 -f matroska
x264-fast-share: -c:v libx264 -preset veryfast -crf 23 -pix_fmt yuv420p -c:a aac -b:a 160k -movflags +faststart -f mp4
x264-compatible: -c:v libx264 -preset medium -crf 20 -pix_fmt yuv420p -profile:v high -x264-params level=4.1 -c:a aac -b:a 192k -movflags +faststart -f mp4
