---
source: crates/rustcut-core/src/render/args.rs
expression: "lines.join(\"\\n\")"
---
-c:v libx264 -preset medium -qp 22 -pix_fmt yuv420p -color_primaries bt709 -color_trc bt709 -colorspace bt709 -color_range tv -x264-params aq-mode=3:scenecut=0
-c:v libx265 -preset medium -qp 26 -pix_fmt yuv420p -color_primaries bt709 -color_trc bt709 -colorspace bt709 -color_range tv -x265-params aq-mode=4:scenecut=0
-c:v libsvtav1 -preset 6 -qp 30 -pix_fmt yuv420p -color_primaries bt709 -color_trc bt709 -colorspace bt709 -color_range tv -svtav1-params enable-variance-boost=1:variance-boost-strength=3:aq-mode=2
-c:v libaom-av1 -cpu-used 4 -crf 30 -b:v 0 -pix_fmt yuv420p -aq-mode 3 -color_primaries bt709 -color_trc bt709 -colorspace bt709 -color_range tv
-c:v libsvtav1 -preset 6 -crf 26 -pix_fmt yuv420p -svtav1-params enable-variance-boost=0
